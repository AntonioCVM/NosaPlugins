<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Warnings Triage v1.0" Height="660" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding"    Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"    Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="WARNINGS TRIAGE" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Structural Priority Analysis" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">
                    <TextBlock Text="Show severity" FontWeight="Bold"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <CheckBox Name="ChkHigh"   Content="High (Critical)"  IsChecked="True"/>
                    <CheckBox Name="ChkMedium" Content="Medium"           IsChecked="True"/>
                    <CheckBox Name="ChkLow"    Content="Low (Info)"       IsChecked="True"/>

                    <Separator Margin="0,16,0,12"/>
                    <CheckBox Name="ChkShowIgnored" Content="Show ignored warnings"
                              IsChecked="False" Click="Filter_Changed"/>
                    <Separator Margin="0,16,0,12"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="RUN TRIAGE" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="3" Content="Export CSV" Name="BtnExport"
                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,8" IsEnabled="False"/>
            <Button Grid.Row="4" Content="Ignore Selected" Name="BtnIgnore"
                    Click="Ignore_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,8" IsEnabled="False"/>
            <Button Grid.Row="5" Content="Auto-Fix Selected" Name="BtnAutoFix"
                    Click="AutoFix_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <!-- MAIN -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Counter pills -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtHigh"   Text="0 High"   FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtMedium" Text="0 Medium" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                    <TextBlock Name="TxtLow"    Text="0 Low"    FontSize="11" Foreground="#666666" FontWeight="Bold"/>
                </Border>
                <TextBlock Name="TxtTotal" Text="" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
            </StackPanel>

            <!-- Search -->
            <TextBox Grid.Row="1" Name="TxtSearch" Height="28" Margin="0,0,0,10"
                     Padding="6,2" VerticalContentAlignment="Center"
                     TextChanged="Search_Changed"/>

            <!-- DataGrid -->
            <DataGrid Name="GridResults" Grid.Row="2"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#06000000" Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"          Binding="{Binding Index}"          Width="40"/>
                    <DataGridTextColumn Header="Severity"   Binding="{Binding Severity}"       Width="80"/>
                    <DataGridTextColumn Header="Warning"    Binding="{Binding Description}"    Width="*"/>
                    <DataGridTextColumn Header="Elements"   Binding="{Binding ElementsStr}"    Width="200"/>
                    <DataGridTextColumn Header="Count"      Binding="{Binding CountElements}"  Width="55"/>
                    <DataGridTextColumn Header="Action"     Binding="{Binding Action}"         Width="260"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="High">
                                <Setter Property="Background" Value="#10FF0000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                <Setter Property="Background" Value="#10FF5F00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Loading -->
            <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Reading model warnings..." HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="240" Height="12" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Action suggestion box -->
            <Border Grid.Row="3" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,12,0,0"
                    Visibility="Collapsed" Name="PanelAction">
                <StackPanel>
                    <TextBlock Text="Suggested action:" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4"/>
                    <TextBlock Name="TxtAction" Text="" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </Border>

            <!-- Bottom actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Select in Model" Name="BtnSelect"
                        Click="Select_Click" Style="{DynamicResource SecondaryButton}"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
