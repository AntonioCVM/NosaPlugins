<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Model Health Score v1.0" Height="660" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="border"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter TargetName="border" Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════
             SIDEBAR
             ════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="HEALTH SCORE" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Structural Model Audit" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <!-- Checks to run -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">
                    <TextBlock Text="Checks to run" FontWeight="Bold"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>

                    <CheckBox Name="ChkMaterial"    Content="Missing material"       IsChecked="True"/>
                    <CheckBox Name="ChkAnalytical"  Content="Analytical disabled"    IsChecked="True"/>
                    <CheckBox Name="ChkOrphan"      Content="Orphan foundations"     IsChecked="True"/>
                    <CheckBox Name="ChkWarnings"    Content="Model warnings"         IsChecked="True"/>
                    <CheckBox Name="ChkParams"      Content="Missing Mark parameter" IsChecked="True"/>
                    <CheckBox Name="ChkOffsets"     Content="Excessive level offsets" IsChecked="True"/>
                    <CheckBox Name="ChkDupMarks"    Content="Duplicate Mark values"  IsChecked="True"/>
                    <CheckBox Name="ChkNoLevel"     Content="Elements not on a level" IsChecked="True"/>
                    <CheckBox Name="ChkUnhostedRebar" Content="Unhosted rebar"       IsChecked="True"/>

                    <Separator Margin="0,16,0,12"/>

                    <!-- Dark mode toggle -->
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode"
                              Click="Theme_Toggled" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Run button -->
            <Button Grid.Row="2" Content="RUN HEALTH CHECK" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}" Margin="20,0,20,10"/>

            <!-- Export + History buttons -->
            <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <Button Content="Export CSV" Name="BtnExport"
                        Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,0,8" IsEnabled="False"/>
                <Button Content="Score History" Name="BtnHistory"
                        Click="History_Click" Style="{DynamicResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════
             MAIN CONTENT
             ════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="24,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Score panel -->
                <RowDefinition Height="Auto"/>  <!-- Summary bar -->
                <RowDefinition Height="*"/>     <!-- Results table -->
                <RowDefinition Height="Auto"/>  <!-- Loading overlay trigger -->
                <RowDefinition Height="Auto"/>  <!-- Actions bottom -->
            </Grid.RowDefinitions>

            <!-- ── Score gauge ── -->
            <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Overall Score" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                        <Grid>
                            <ProgressBar Name="ScoreBar" Height="18" Minimum="0" Maximum="100" Value="0"
                                         Foreground="{DynamicResource AccentColor}"
                                         Background="#E0E0E0" BorderThickness="0"/>
                        </Grid>
                        <TextBlock Name="TxtScoreLabel" Text="— Run check to calculate score —"
                                   FontSize="11" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.6" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Name="TxtScore" Text="—"
                               FontSize="42" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
            </Border>

            <!-- ── Summary pills ── -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtCountHigh" Text="0 High" FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtCountMed" Text="0 Medium" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                    <TextBlock Name="TxtCountLow" Text="0 Low" FontSize="11" Foreground="#666666" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- ── Results DataGrid ── -->
            <DataGrid Name="GridResults" Grid.Row="2"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#06000000"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Check"       Binding="{Binding Label}"    Width="220"/>
                    <DataGridTextColumn Header="Issues"      Binding="{Binding Count}"    Width="60"/>
                    <DataGridTextColumn Header="Severity"    Binding="{Binding Severity}" Width="90"/>
                    <DataGridTextColumn Header="Score impact" Binding="{Binding Impact}" Width="100"/>
                    <DataGridTextColumn Header="Detail"      Binding="{Binding Detail}"   Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Loading panel ── -->
            <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Analysing model..." HorizontalAlignment="Center"
                               FontSize="14" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="260" Height="14"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextColor}"
                               Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ── Bottom actions ── -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Fix Issues..." Name="BtnFix"
                        Click="Fix_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,10,0" IsEnabled="False"/>
                <Button Content="Select in Model" Name="BtnSelect"
                        Click="Select_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,10,0" IsEnabled="False"/>
                <Button Content="View Issue Details" Name="BtnDetails"
                        Click="Details_Click" Style="{DynamicResource SecondaryButton}"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
