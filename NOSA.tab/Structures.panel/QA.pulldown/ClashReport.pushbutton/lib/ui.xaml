<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Report Pro v2.1" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,28,20,12">
                <TextBlock Text="CLASH" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="REPORT PRO" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Geometric interference detection" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Select ≥ 2 categories:" FontWeight="Bold"
                       FontSize="11" Foreground="{DynamicResource AccentColor}" Margin="20,0,20,2"/>
            <TextBlock Grid.Row="1" Text="(Ctrl+Click to multi-select)" FontSize="10"
                       Foreground="{DynamicResource TextColor}" Opacity="0.5"
                       Margin="20,18,20,6" VerticalAlignment="Bottom"/>

            <ListBox Name="ListCategories" Grid.Row="2" Margin="20,0,20,10"
                     SelectionMode="Extended"
                     BorderBrush="{DynamicResource BorderColor}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="4,3"
                                   Foreground="{DynamicResource TextColor}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <CheckBox Name="ChkDarkMode" Grid.Row="3" Content="Dark Mode"
                      Click="Theme_Toggled" Margin="20,0,20,8"/>

            <Button Grid.Row="4" Content="RUN CHECK" Name="BtnRun" Click="Run_Click"
                    Style="{DynamicResource ActionButton}" Margin="20,0,20,20"/>
        </Grid>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Name="TxtSummary" Text="Run a check to see results."
                           FontSize="12" Foreground="{DynamicResource TextColor}"
                           Opacity="0.7" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Results grid -->
            <Grid Grid.Row="1">
                <DataGrid Name="GridResults"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"         Binding="{Binding Index}"     Width="40"/>
                        <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}"  Width="70"/>
                        <DataGridTextColumn Header="Volume"    Binding="{Binding VolumeStr}" Width="85"/>
                        <DataGridTextColumn Header="Element 1" Binding="{Binding Name1}"     Width="*"/>
                        <DataGridTextColumn Header="Cat 1"     Binding="{Binding Cat1}"      Width="110"/>
                        <DataGridTextColumn Header="Element 2" Binding="{Binding Name2}"     Width="*"/>
                        <DataGridTextColumn Header="Cat 2"     Binding="{Binding Cat2}"      Width="110"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                    <Setter Property="Background" Value="#10FF0000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                    <Setter Property="Background" Value="#10FF5F00"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Loading overlay -->
                <Grid Name="LoadingPanel" Visibility="Collapsed"
                      Background="#AAFAFAFA" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Running clash check..." HorizontalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProcessBar" Width="220" Height="12"
                                     IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Select Both"   Name="BtnSelectBoth" Click="SelectBoth_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                        IsEnabled="False" ToolTip="Select both clashing elements in model"/>
                <Button Content="Isolate"       Name="BtnIsolate"   Click="Isolate_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                        IsEnabled="False"/>
                <Button Content="Export CSV"    Name="BtnExportCSV"  Click="ExportCSV_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                        IsEnabled="False"/>
                <Button Content="Export HTML"   Name="BtnExportHTML" Click="ExportHTML_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                        IsEnabled="False"/>
                <Button Content="Export BCF 2.1" Name="BtnExportBCF" Click="ExportBCF_Click"
                        Style="{DynamicResource SecondaryButton}"
                        IsEnabled="False"
                        ToolTip="Export clashes as BCF 2.1 file (compatible with Navisworks, Tekla, etc.)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
