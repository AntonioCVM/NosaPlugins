<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Impact Analyser — NOSA"
        Height="520" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="14,9">
            <DockPanel>
                <CheckBox Name="ChkDarkMode" DockPanel.Dock="Right" Content="Dark"
                          Foreground="White" VerticalAlignment="Center" FontSize="11"
                          Click="Theme_Toggled"/>
                <StackPanel>
                    <TextBlock Text="Schedule Impact Analyser" FontSize="15" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Find all schedules and sheets affected by an element category"
                               FontSize="10" Foreground="#FFD0B0" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Category selector -->
        <Border Grid.Row="1" Padding="14,10"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Analyse" Click="Analyse_Click"
                        Padding="20,8" Background="{DynamicResource AccentColor}"
                        Foreground="White" FontSize="12" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
                <TextBlock DockPanel.Dock="Right" Text="Search:" VerticalAlignment="Center"
                           FontSize="11" Opacity="0.6" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextColor}"/>
                <TextBox DockPanel.Dock="Right" Name="TxtSearch" Width="150" FontSize="11"
                         Padding="4,2" VerticalContentAlignment="Center" Margin="0,0,10,0"
                         BorderBrush="{DynamicResource BorderColor}"
                         TextChanged="Search_Changed"/>
                <TextBlock Text="Category:" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextColor}" Margin="0,0,10,0"/>
                <ComboBox Name="CboCategory" FontSize="12"
                          Foreground="{DynamicResource TextColor}"
                          Background="{DynamicResource PanelColor}"
                          VerticalContentAlignment="Center" Padding="6,4"
                          Margin="0,0,10,0" MinWidth="280"/>
            </DockPanel>
        </Border>

        <!-- Results DataGrid -->
        <DataGrid Name="ImpactGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  AlternatingRowBackground="#F6F6F6"
                  RowBackground="{DynamicResource PanelColor}"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                  BorderThickness="0" FontSize="11"
                  MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#555"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Schedule Name"
                                    Binding="{Binding ScheduleName}" Width="220"/>
                <DataGridTextColumn Header="Fields"
                                    Binding="{Binding FieldCount}"   Width="55"/>
                <DataGridTextColumn Header="Sheets"
                                    Binding="{Binding SheetCount}"   Width="55"/>
                <DataGridTextColumn Header="Sheet Numbers / Names"
                                    Binding="{Binding Sheets}"       Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="12,7"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
                        Padding="12,6" Background="#E0E0E0" FontSize="11"
                        Foreground="{DynamicResource TextColor}" BorderThickness="0" Cursor="Hand"/>
                <Button DockPanel.Dock="Right" Content="Export CSV" Click="ExportCsv_Click"
                        Padding="12,6" Margin="0,0,8,0" Background="Transparent"
                        BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                        Foreground="{DynamicResource AccentColor}" FontSize="11" Cursor="Hand"/>
                <TextBlock Name="TxtResult" FontSize="11"
                           Foreground="{DynamicResource TextColor}"
                           VerticalAlignment="Center"
                           Text="Select a category and click Analyse. Double-click a row to open the schedule."/>
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.RowSpan="4" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Background="{DynamicResource PanelColor}" CornerRadius="6"
                    Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Analysing…" HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="8" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Background="#EEE"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="10" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
