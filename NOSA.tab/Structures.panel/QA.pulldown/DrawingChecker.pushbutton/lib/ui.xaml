<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Drawing Checker v1.0"
        Height="580" Width="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="DRAWING CHECKER" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="Pre-emission quality checks for structural drawings"
                       FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="ResultsPanel"/>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Name="ChkDarkMode" Grid.Column="0" Content="Dark Mode"
                      Click="Theme_Toggled" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="RE-RUN CHECKS" Click="Refresh_Click"
                    Background="{DynamicResource AccentColor}" Foreground="White"
                    FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
