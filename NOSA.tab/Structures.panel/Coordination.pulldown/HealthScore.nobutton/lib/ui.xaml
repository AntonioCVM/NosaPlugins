<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Model Health Score v2.0" Height="720" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="Slider" x:Key="WeightSlider">
            <Setter Property="Minimum"     Value="1"/>
            <Setter Property="Maximum"     Value="30"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Height" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════ SIDEBAR ════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,24,20,14">
                <TextBlock Text="HEALTH SCORE" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Structural Model Audit" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <!-- Checks -->
                    <TextBlock Text="Checks" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                    <CheckBox Name="ChkMaterial"      Content="Missing material"        IsChecked="True"/>
                    <CheckBox Name="ChkAnalytical"    Content="Analytical disabled"     IsChecked="True"/>
                    <CheckBox Name="ChkOrphan"        Content="Orphan foundations"      IsChecked="True"/>
                    <CheckBox Name="ChkWarnings"      Content="Model warnings"          IsChecked="True"/>
                    <CheckBox Name="ChkParams"        Content="Missing Mark parameter"  IsChecked="True"/>
                    <CheckBox Name="ChkOffsets"       Content="Excessive level offsets" IsChecked="True"/>
                    <CheckBox Name="ChkDupMarks"      Content="Duplicate Mark values"   IsChecked="True"/>
                    <CheckBox Name="ChkNoLevel"       Content="Elements not on a level" IsChecked="True"/>
                    <CheckBox Name="ChkUnhostedRebar" Content="Unhosted rebar"          IsChecked="True"/>

                    <Separator Margin="0,14,0,10"/>

                    <!-- Weight sliders -->
                    <TextBlock Text="Check Weights" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                    <TextBlock Text="Adjust importance per check (1–30 pts)." FontSize="10"
                               Opacity="0.55" Margin="0,0,0,8"/>

                    <TextBlock Text="Missing material" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldMaterial"   Style="{DynamicResource WeightSlider}" Value="20"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldMaterial, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Analytical disabled" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldAnalytical" Style="{DynamicResource WeightSlider}" Value="15"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldAnalytical, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Orphan foundations" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldOrphan"     Style="{DynamicResource WeightSlider}" Value="10"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldOrphan, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Model warnings" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldWarnings"   Style="{DynamicResource WeightSlider}" Value="20"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldWarnings, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Missing Mark" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldParams"     Style="{DynamicResource WeightSlider}" Value="15"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldParams, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Level offsets" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldOffsets"    Style="{DynamicResource WeightSlider}" Value="10"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldOffsets, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Duplicate marks" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldDupMarks"   Style="{DynamicResource WeightSlider}" Value="10"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldDupMarks, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="No level" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldNoLevel"    Style="{DynamicResource WeightSlider}" Value="5"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldNoLevel, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <TextBlock Text="Unhosted rebar" FontSize="10" Opacity="0.7"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SldRebar"      Style="{DynamicResource WeightSlider}" Value="5"/>
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Text="{Binding ElementName=SldRebar, Path=Value, StringFormat={}{0:0}}"/>
                    </Grid>

                    <Separator Margin="0,12,0,10"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode"
                              Click="Theme_Toggled" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="▶ RUN HEALTH CHECK" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}" Margin="20,0,20,8"/>

            <StackPanel Grid.Row="3" Margin="20,0,20,16">
                <Button Content="Export CSV" Name="BtnExport"
                        Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Export HTML Report" Name="BtnReport"
                        Click="Report_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Score History" Name="BtnHistory"
                        Click="History_Click" Style="{DynamicResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- ════════ MAIN CONTENT ════════ -->
        <Grid Grid.Column="1" Margin="20,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Score gauge -->
                <RowDefinition Height="Auto"/>   <!-- Trend chart -->
                <RowDefinition Height="Auto"/>   <!-- Summary pills -->
                <RowDefinition Height="*"/>      <!-- DataGrid -->
                <RowDefinition Height="Auto"/>   <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Score gauge -->
            <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="6" Padding="20,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Overall Score" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                        <ProgressBar Name="ScoreBar" Height="18" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource AccentColor}"
                                     Background="#E0E0E0" BorderThickness="0"/>
                        <TextBlock Name="TxtScoreLabel" Text="— Run check to calculate score —"
                                   FontSize="11" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.6" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Name="TxtScore" Text="—"
                               FontSize="42" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
            </Border>

            <!-- Trend chart (score history) -->
            <Border Grid.Row="1" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Score History" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,0,0,6"/>
                    <Canvas Grid.Row="1" Name="TrendCanvas" Background="Transparent"
                            ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- Summary pills -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtCountHigh" Text="0 High" FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtCountMed" Text="0 Medium" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                    <TextBlock Name="TxtCountLow" Text="0 Low" FontSize="11" Foreground="#666666" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- Results DataGrid -->
            <DataGrid Name="GridResults" Grid.Row="3"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#06000000"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Check"        Binding="{Binding Label}"    Width="200"/>
                    <DataGridTextColumn Header="Issues"       Binding="{Binding Count}"    Width="60"/>
                    <DataGridTextColumn Header="Severity"     Binding="{Binding Severity}" Width="80"/>
                    <DataGridTextColumn Header="Weight"       Binding="{Binding Weight}"   Width="60"/>
                    <DataGridTextColumn Header="Score impact" Binding="{Binding Impact}"   Width="100"/>
                    <DataGridTextColumn Header="Detail"       Binding="{Binding Detail}"   Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading panel -->
            <Grid Grid.Row="3" Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Analysing model..." HorizontalAlignment="Center"
                               FontSize="14" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="260" Height="14"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextColor}"
                               Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Bottom actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Fix Issues..." Name="BtnFix"
                        Click="Fix_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="Select in Model" Name="BtnSelect"
                        Click="Select_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="View Issue Details" Name="BtnDetails"
                        Click="Details_Click" Style="{DynamicResource SecondaryButton}"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
