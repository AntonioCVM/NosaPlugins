<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Drift Monitor — NOSA"
        Height="580" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="14,9">
            <DockPanel>
                <CheckBox Name="ChkDarkMode" DockPanel.Dock="Right" Content="Dark"
                          Foreground="White" VerticalAlignment="Center" FontSize="11"
                          Click="Theme_Toggled"/>
                <StackPanel>
                    <TextBlock Text="Parameter Drift Monitor" FontSize="15" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Name="TxtBaselineInfo" FontSize="10" Foreground="#FFD0B0"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2-col main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="190" MaxWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: param list -->
            <Grid Grid.Column="0" Background="{DynamicResource BgColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,8,10,6"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="SHARED PARAMETERS" FontSize="9" FontWeight="Bold"
                                   Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="None" Style="{DynamicResource GhostButton}"
                                    Click="ClearAll_Click" Margin="4,0,0,0"/>
                            <Button Content="All" Style="{DynamicResource GhostButton}"
                                    Click="SelectAll_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ListBox Name="ParamList" Grid.Row="1" BorderThickness="0"
                         Background="{DynamicResource BgColor}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Name}" FontSize="11"
                                      Foreground="{DynamicResource TextColor}"
                                      Padding="4,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="10,8,10,8">
                    <Button Content="Save Baseline" Click="SaveBaseline_Click"
                            Style="{DynamicResource ActionButton}" Margin="0,0,0,6"/>
                    <Button Content="Import from Excel…" Click="ImportExcel_Click"
                            Style="{DynamicResource SecondaryButton}"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6"
                          Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- RIGHT: drift grid -->
            <Grid Grid.Column="2" Margin="16,16,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Export CSV"
                                Click="ExportCSV_Click" Style="{DynamicResource SecondaryButton}"
                                Padding="12,6"/>
                        <Button DockPanel.Dock="Right" Content="Select in Model"
                                Click="SelectInModel_Click" Style="{DynamicResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,8,0"
                                ToolTip="Selects the drifted elements (highlighted rows, or all rows if none is highlighted)"/>
                        <Button DockPanel.Dock="Right" Content="Compare" Click="Compare_Click"
                                Style="{DynamicResource ActionButton}" Padding="14,6" Margin="0,0,8,0"/>
                        <TextBlock Text="Drift Report" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextColor}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,16">
                    <DataGrid Name="DriftGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              AlternatingRowBackground="#F6F6F6"
                              RowBackground="{DynamicResource PanelColor}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                              BorderThickness="0" FontSize="11">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Element"   Binding="{Binding Element}"   Width="180"/>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="160"/>
                            <DataGridTextColumn Header="Change"    Binding="{Binding Change}"    Width="75"/>
                            <DataGridTextColumn Header="Baseline"  Binding="{Binding Baseline}"  Width="*"/>
                            <DataGridTextColumn Header="Current"   Binding="{Binding Current}"   Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="12,7"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}"
                       Text="Select parameters and save a baseline to start monitoring."/>
        </Border>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}"
                    Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Working…" HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="8" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Background="#EEE"/>
                    <TextBlock Name="TxtLoadingStatus" HorizontalAlignment="Center"
                               FontSize="10" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
