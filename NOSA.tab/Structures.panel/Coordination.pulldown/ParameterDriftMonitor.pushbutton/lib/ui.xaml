<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Drift Monitor — NOSA"
        Height="580" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="14,9">
            <DockPanel>
                <CheckBox Name="ChkDarkMode" DockPanel.Dock="Right" Content="Dark"
                          Foreground="White" VerticalAlignment="Center" FontSize="11"
                          Click="Theme_Toggled"/>
                <StackPanel>
                    <TextBlock Text="Parameter Drift Monitor" FontSize="15" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Name="TxtBaselineInfo" FontSize="10" Foreground="#FFD0B0"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2-col main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: param list -->
            <Grid Grid.Column="0" Background="{DynamicResource BgColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,8,10,6"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="SHARED PARAMETERS" FontSize="9" FontWeight="Bold"
                                   Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="None" FontSize="10"
                                    Padding="6,3" Click="ClearAll_Click" Margin="4,0,0,0"
                                    Background="#F0F0F0" BorderThickness="0"/>
                            <Button Content="All" FontSize="10" Padding="6,3"
                                    Click="SelectAll_Click"
                                    Background="#F0F0F0" BorderThickness="0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ListBox Name="ParamList" Grid.Row="1" BorderThickness="0"
                         Background="{DynamicResource BgColor}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Name}" FontSize="11"
                                      Foreground="{DynamicResource TextColor}"
                                      Padding="4,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="10,8"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button Content="Save Baseline" Click="SaveBaseline_Click"
                                Padding="0,8" Background="{DynamicResource AccentColor}"
                                Foreground="White" FontSize="11" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,4"/>
                        <Button Content="Import from Excel…" Click="ImportExcel_Click"
                                Padding="0,7" Background="#E8E8E8"
                                Foreground="{DynamicResource TextColor}" FontSize="11"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1"
                          Background="{DynamicResource BorderColor}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- RIGHT: drift grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource PanelColor}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Export CSV"
                                Click="ExportCSV_Click" Padding="12,6"
                                Background="#E8E8E8" FontSize="11"
                                Foreground="{DynamicResource TextColor}" BorderThickness="0"
                                Cursor="Hand"/>
                        <Button DockPanel.Dock="Right" Content="Select in Model"
                                Click="SelectInModel_Click" Padding="12,6" Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource AccentColor}"
                                Foreground="{DynamicResource AccentColor}" FontSize="11"
                                Cursor="Hand"
                                ToolTip="Selects the drifted elements (highlighted rows, or all rows if none is highlighted)"/>
                        <Button DockPanel.Dock="Right" Content="Compare" Click="Compare_Click"
                                Padding="14,6" Margin="0,0,8,0"
                                Background="{DynamicResource AccentColor}"
                                Foreground="White" FontSize="11" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Text="Drift Report" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextColor}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <DataGrid Name="DriftGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          AlternatingRowBackground="#F6F6F6"
                          RowBackground="{DynamicResource PanelColor}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          BorderThickness="0" FontSize="11">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Element"   Binding="{Binding Element}"   Width="180"/>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="160"/>
                        <DataGridTextColumn Header="Change"    Binding="{Binding Change}"    Width="75"/>
                        <DataGridTextColumn Header="Baseline"  Binding="{Binding Baseline}"  Width="*"/>
                        <DataGridTextColumn Header="Current"   Binding="{Binding Current}"   Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="12,7"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}"
                       Text="Select parameters and save a baseline to start monitoring."/>
        </Border>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Background="{DynamicResource PanelColor}" CornerRadius="6"
                    Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Working…" HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="8" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Background="#EEE"/>
                    <TextBlock Name="TxtLoadingStatus" HorizontalAlignment="Center"
                               FontSize="10" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
