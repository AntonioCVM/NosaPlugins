<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Connection Checker v2.0" Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="210" MaxWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,28,20,12">
                <TextBlock Text="CONNECTION CHECK" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="End Join and Analytical" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,10">
                <Button Content="Results" Style="{DynamicResource NavBtn}" Tag="results" Click="NavTab_Click"
                        FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,4,0"/>
                <Button Content="Rules" Style="{DynamicResource NavBtn}" Tag="rules" Click="NavTab_Click"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Built-in checks" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkAnalytical"  Content="Analytical model disabled"       IsChecked="True"/>
                            <CheckBox Name="ChkUsage"       Content="Structural usage empty"          IsChecked="True"/>
                            <CheckBox Name="ChkAttachment"  Content="Column attachment missing"       IsChecked="True"/>
                            <CheckBox Name="ChkJoins"       Content="Beam end no adjacent element"    IsChecked="True"/>
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,16,0,12"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="3" Content="RUN CHECK" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}" Margin="20,0,20,8"/>
            <Button Grid.Row="4" Content="Export CSV" Name="BtnExport"
                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="24">
            <Grid Name="TabResults">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Name="TxtHigh"   Text="0 High"   FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                    </Border>
                    <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Name="TxtMedium" Text="0 Medium" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                    </Border>
                    <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                        <TextBlock Name="TxtLow"    Text="0 Low"    FontSize="11" Foreground="#666666" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
                    <DataGrid Name="GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="Category"  Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Level"     Binding="{Binding Level}"    Width="100"/>
                            <DataGridTextColumn Header="Name"      Binding="{Binding Name}"     Width="*"/>
                            <DataGridTextColumn Header="Check"     Binding="{Binding Check}"    Width="260"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="High">
                                        <Setter Property="Background" Value="#10FF0000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                        <Setter Property="Background" Value="#10FF5F00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
                <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Checking connections..." HorizontalAlignment="Center" FontSize="13" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="12" IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Select in Model" Name="BtnSelect" Click="Select_Click"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button Content="Export CSV" Name="BtnExport2" Click="Export_Click"
                            Style="{DynamicResource SecondaryButton}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
            <Grid Name="TabRules" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Custom Check Rules" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="Parameter-based rules that run alongside built-in checks."
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Parameter name" FontSize="10" Opacity="0.6" Margin="0,0,0,3"/>
                                <TextBox Name="TxtRuleParam" Height="28" Padding="6,4" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Condition" FontSize="10" Opacity="0.6" Margin="0,0,0,3"/>
                                <ComboBox Name="CboCondition" Height="28" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Threshold" FontSize="10" Opacity="0.6" Margin="0,0,0,3"/>
                                <TextBox Name="TxtThreshold" Height="28" Padding="6,4" BorderBrush="{DynamicResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Severity" FontSize="10" Opacity="0.6" Margin="0,0,0,3"/>
                                <ComboBox Name="CboSeverity" Height="28" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Category" FontSize="10" Opacity="0.6" Margin="0,0,0,3"/>
                                <ComboBox Name="CboRuleCat" Height="28" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Label (optional):" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" Name="TxtRuleLabel" Height="26" FontSize="11" Padding="6,3"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                            <Button Grid.Column="4" Content="Add Rule" Style="{DynamicResource ActionButton}"
                                    Padding="16,6" Click="AddRule_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="4">
                    <ListBox Name="LstRules"
                             Background="Transparent" BorderThickness="0"
                             FontSize="11" Padding="4"/>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Remove Selected" Style="{DynamicResource SecondaryButton}"
                            Click="RemoveRule_Click" Margin="0,0,8,0"/>
                    <Button Content="Import JSON" Style="{DynamicResource SecondaryButton}"
                            Click="ImportRules_Click" Margin="0,0,8,0"/>
                    <Button Content="Export JSON" Style="{DynamicResource SecondaryButton}"
                            Click="ExportRules_Click" Margin="0,0,8,0"/>
                    <Button Content="Save Rules" Style="{DynamicResource ActionButton}"
                            Click="SaveRules_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
