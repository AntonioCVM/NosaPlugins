<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analytical Model Health Check v1.0" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="24,16,0,16">
                    <TextBlock Text="ANALYTICAL MODEL HEALTH CHECK" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="Structural analytical model validation"
                               FontSize="11" Opacity="0.5" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,24,0">
                    <Button Name="BtnRun" Content="▶ RUN CHECKS"
                            Style="{DynamicResource ActionButton}" Click="Run_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary badges -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,14,20,8">
            <Border CornerRadius="8" Background="#FFEEEE" Padding="12,5" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ERRORS: " FontSize="11" FontWeight="Bold"
                               Foreground="#CC0000"/>
                    <TextBlock Name="TxtErrors" Text="—" FontSize="11" FontWeight="Bold"
                               Foreground="#CC0000"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="#FFF3E0" Padding="12,5" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="WARNINGS: " FontSize="11" FontWeight="Bold"
                               Foreground="#E65C00"/>
                    <TextBlock Name="TxtWarnings" Text="—" FontSize="11" FontWeight="Bold"
                               Foreground="#E65C00"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="#F5F5F5" Padding="12,5" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TOTAL: " FontSize="11" Foreground="#555"/>
                    <TextBlock Name="TxtTotal" Text="—" FontSize="11" Foreground="#555"/>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <ProgressBar Name="ProgBar" Width="160" Height="4"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource AccentColor}"
                         BorderThickness="0"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"/>
            <TextBlock Name="TxtStatus" Text="" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextColor}"
                       FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Results grid -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0" Margin="20,0,20,0">
            <DataGrid Name="GridResults"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      AlternatingRowBackground="#06000000" Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal" FontSize="11"
                      SelectionChanged="GridResults_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity"  Binding="{Binding severity}"  Width="80"/>
                    <DataGridTextColumn Header="Type"      Binding="{Binding etype}"       Width="110"/>
                    <DataGridTextColumn Header="Mark"      Binding="{Binding mark}"       Width="90"/>
                    <DataGridTextColumn Header="Level"     Binding="{Binding level}"      Width="110"/>
                    <DataGridTextColumn Header="ID"        Binding="{Binding id}"         Width="80"/>
                    <DataGridTextColumn Header="Issue"     Binding="{Binding issue}"      Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding severity}" Value="ERROR">
                                <Setter Property="Background" Value="#12CC0000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding severity}" Value="WARNING">
                                <Setter Property="Background" Value="#0AFF6600"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="20,14,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Name="ChkDarkMode" Grid.Column="0" Content="Dark Mode"
                      Foreground="{DynamicResource TextColor}"
                      Click="Theme_Toggled" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Name="TxtSummary" Grid.Column="1"
                       Text="Click ▶ RUN CHECKS to analyse the model."
                       Foreground="{DynamicResource TextColor}"
                       FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Name="BtnSelect" Content="Select in model"
                    Style="{DynamicResource SecondaryButton}" Click="Select_Click"
                    IsEnabled="False"/>
            <Button Grid.Column="4" Name="BtnExport" Content="Export CSV"
                    Style="{DynamicResource SecondaryButton}" Click="Export_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
