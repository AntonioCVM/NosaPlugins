<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level &amp; Grid Sync v1.0"
        Height="600" Width="640"
        MinHeight="440" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LEVEL &amp; GRID SYNC" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="Compare levels and grids against a linked model"
                       FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
        </StackPanel>

        <!-- Controls -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="CboLinks" Grid.Column="0" Height="30" Margin="0,0,10,0"
                          VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tolerance:" VerticalAlignment="Center"
                           Margin="0,0,6,0" FontSize="11" Foreground="{DynamicResource TextColor}"/>
                <TextBox Name="TxtTolerance" Grid.Column="2" Text="1" Width="50" Height="30"
                         TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0"
                         BorderBrush="{DynamicResource BorderColor}"/>
                <TextBlock Grid.Column="3" Text="mm" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextColor}"/>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ResultsPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Name="ChkDarkMode" Grid.Column="0" Content="Dark Mode"
                      Click="Theme_Toggled" VerticalAlignment="Center" Margin="0,0,16,0"
                      Foreground="{DynamicResource TextColor}"/>
            <TextBlock Name="TxtStatus" Grid.Column="1" Text=""
                       Foreground="{DynamicResource TextColor}"
                       Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="RUN COMPARISON" Click="Run_Click"
                    Style="{StaticResource ActionButton}"/>
        </Grid>
    </Grid>
</Window>
