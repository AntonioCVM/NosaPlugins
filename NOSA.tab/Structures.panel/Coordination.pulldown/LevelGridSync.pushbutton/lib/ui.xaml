<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level &amp; Grid Sync v1.0"
        Height="560" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LEVEL &amp; GRID SYNC" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="Compare levels and grids against a linked model"
                       FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Name="CboLinks" Grid.Column="0" Height="30" Margin="0,0,10,0"
                      VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Tolerance:" VerticalAlignment="Center"
                       Margin="0,0,6,0" FontSize="11" Foreground="{DynamicResource TextColor}"/>
            <TextBox Name="TxtTolerance" Grid.Column="2" Text="1" Width="50" Height="30"
                     TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Grid.Column="3" Text="mm" VerticalAlignment="Center"
                       Margin="0,0,10,0" FontSize="11" Foreground="{DynamicResource TextColor}"/>
        </Grid>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="ResultsPanel"/>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Name="ChkDarkMode" Grid.Column="0" Content="Dark Mode"
                      Click="Theme_Toggled" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Name="TxtStatus" Grid.Column="1" Text=""
                       Foreground="{DynamicResource TextColor}"
                       Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="RUN COMPARISON" Click="Run_Click"
                    Background="{DynamicResource AccentColor}" Foreground="White"
                    FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
