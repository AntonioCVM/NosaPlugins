<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebar Coverage Checker" Height="660" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding"    Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Background="{DynamicResource AccentColor}"/>
                    <TextBlock Text="Rebar Coverage Checker" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Content="Close" Style="{DynamicResource SecondaryButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="340"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Controls -->
            <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Exposure class (EC2)" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="CboExposure" FontSize="11" Margin="0,0,0,10"
                                          SelectionChanged="Exposure_Changed"/>

                                <TextBlock Text="Min. cover (mm):" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Name="TxtMinCover" Style="{DynamicResource FieldBox}"
                                         TextChanged="MinCover_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="Summary" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total rebar:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}"/>
                                    <TextBlock Name="TxtTotal" Grid.Column="1" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextColor}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="OK:" FontSize="11" Foreground="Green"/>
                                    <TextBlock Name="TxtOk" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="Green"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Below minimum:" FontSize="11" Foreground="#CC3300"/>
                                    <TextBlock Name="TxtFail" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="#CC3300"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="RUN CHECK" Style="{DynamicResource ActionButton}"
                                Click="RunCheck_Click" Margin="0,14,0,6"/>
                        <Button Content="Show Failing Only" Style="{DynamicResource SecondaryButton}"
                                Click="FilterFail_Click" Margin="0,0,0,6"/>
                        <Button Content="Select in Model" Style="{DynamicResource SecondaryButton}"
                                Click="SelectInModel_Click" Margin="0,0,0,6"
                                ToolTip="Selects the grid rows you have highlighted, or all failing bars if none are highlighted"/>
                        <Button Content="Export CSV" Style="{DynamicResource SecondaryButton}"
                                Click="ExportCsv_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Results grid -->
            <Grid Grid.Column="2" Margin="12,12,20,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Results — rebar elements"
                           FontWeight="Bold" FontSize="12"
                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
                    <DataGrid Name="GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single"
                              AlternatingRowBackground="#06000000"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              CanUserReorderColumns="False" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Host element"   Binding="{Binding Host}"     Width="200"/>
                            <DataGridTextColumn Header="Category"       Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Cover (mm)"     Binding="{Binding CoverMm}"  Width="80"/>
                            <DataGridTextColumn Header="Min. (mm)"      Binding="{Binding MinMm}"    Width="70"/>
                            <DataGridTextColumn Header="Status"         Binding="{Binding Status}"   Width="70"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                        <Setter Property="Background" Value="#18CC3300"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Border>

        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" Background="#CCFAFAFA"
              Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Checking rebar coverage..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
