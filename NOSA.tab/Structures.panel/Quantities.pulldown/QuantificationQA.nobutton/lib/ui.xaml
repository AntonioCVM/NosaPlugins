<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantification QA v2.0 — Concrete / Steel / Rebar" Height="760" Width="1180"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="border" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter TargetName="border" Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="RowBackground"            Value="{DynamicResource PanelColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgColor}"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="230" MaxWidth="380"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="QUANTIFICATION QA" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Concrete · Steel · Rebar" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Categories" Style="{StaticResource SectionTitle}"/>
                            <ListBox Name="ListCats" SelectionMode="Multiple" Height="100"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource PanelColor}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Levels" Style="{StaticResource SectionTitle}"/>
                            <ListBox Name="ListLevels" SelectionMode="Multiple" Height="100"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource PanelColor}"
                                     Margin="0,0,0,10"/>

                            <Button Content="Select All" Click="SelectAll_Click"
                                    Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Exclude Families" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Select families to exclude from results"
                                       FontSize="10" Foreground="{DynamicResource TextColor}"
                                       Opacity="0.55" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ListBox Name="ListExcludeFamilies" SelectionMode="Multiple" Height="90"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource PanelColor}"
                                     Margin="0,0,0,10"/>
                            <Button Name="BtnApplyExclusion" Content="Apply Exclusion"
                                    Click="ApplyExclusion_Click"
                                    Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Phase / Type Filters" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Name="ChkExcludeExisting" Content="Exclude existing phase elements"/>
                            <CheckBox Name="ChkExcludePiles" Content="Exclude pile elements"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,14">
                <Button Content="CALCULATE" Name="BtnRun"
                        Click="Run_Click" Style="{DynamicResource ActionButton}"
                        Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                <Button Content="Export CSV" Name="BtnExport"
                        Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                        IsEnabled="False" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Tab navigation -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        Background="{DynamicResource PanelColor}">
                <Button Name="BtnTabConcrete" Content="Concrete (m³)"
                        Style="{DynamicResource NavButton}" Tag="Selected"
                        Click="NavButton_Click"/>
                <Button Name="BtnTabSteel" Content="Steel (kg)"
                        Style="{DynamicResource NavButton}"
                        Click="NavButton_Click"/>
                <Button Name="BtnTabRebar" Content="Rebar (kg)"
                        Style="{DynamicResource NavButton}"
                        Click="NavButton_Click"/>
                <Button Name="BtnTabQA" Content="QA Issues"
                        Style="{DynamicResource NavButton}"
                        Click="NavButton_Click"/>
            </StackPanel>

            <!-- Totals bar -->
            <Border Grid.Row="1" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,1"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="TxtTotalVol" Text="Concrete: —" Margin="0,0,24,0"
                               FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtTotalSteel" Text="Steel: —" Margin="0,0,24,0"
                               FontWeight="Bold" Foreground="#1A6FCF"/>
                    <TextBlock Name="TxtTotalRebar" Text="Rebar: —" Margin="0,0,24,0"
                               FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                    <TextBlock Name="TxtQACount" Text="" Foreground="#CC3333" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- ── Tab: Concrete ── -->
            <Border Grid.Row="2" Name="TabConcrete" Style="{StaticResource Card}" Padding="1" Margin="20,16,20,20">
                <DataGrid Name="GridConcrete">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category"    Binding="{Binding Category}" Width="165"/>
                        <DataGridTextColumn Header="Material"    Binding="{Binding Material}" Width="155"/>
                        <DataGridTextColumn Header="Level"       Binding="{Binding Level}"    Width="110"/>
                        <DataGridTextColumn Header="Volume (m³)" Binding="{Binding VolStr}"   Width="110"/>
                        <DataGridTextColumn Header="Area (m²)"  Binding="{Binding AreaStr}"  Width="95"/>
                        <DataGridTextColumn Header="Count"       Binding="{Binding Count}"    Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Tab: Steel ── -->
            <Border Grid.Row="2" Name="TabSteel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="1" Margin="20,16,20,20">
                <DataGrid Name="GridSteel">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category"    Binding="{Binding Category}"    Width="165"/>
                        <DataGridTextColumn Header="Material"    Binding="{Binding Material}"    Width="155"/>
                        <DataGridTextColumn Header="Level"       Binding="{Binding Level}"       Width="110"/>
                        <DataGridTextColumn Header="Weight (kg)" Binding="{Binding WeightKg}"    Width="110"/>
                        <DataGridTextColumn Header="Weight (t)"  Binding="{Binding WeightTonne}" Width="95"/>
                        <DataGridTextColumn Header="Count"       Binding="{Binding Count}"       Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Tab: Rebar ── -->
            <Border Grid.Row="2" Name="TabRebar" Visibility="Collapsed" Style="{StaticResource Card}" Padding="1" Margin="20,16,20,20">
                <DataGrid Name="GridRebar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Level"       Binding="{Binding Level}"     Width="130"/>
                        <DataGridTextColumn Header="&#216; (mm)" Binding="{Binding DiamStr}"   Width="80"/>
                        <DataGridTextColumn Header="Count"       Binding="{Binding Count}"     Width="70"/>
                        <DataGridTextColumn Header="Length (m)"  Binding="{Binding LengthStr}" Width="110"/>
                        <DataGridTextColumn Header="Weight (kg)" Binding="{Binding WeightStr}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Tab: QA Issues ── -->
            <Grid Grid.Row="2" Name="TabQA" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1" Margin="20,16,20,0">
                    <DataGrid Name="GridQA" SelectionChanged="QAGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="Category"  Binding="{Binding Category}" Width="160"/>
                            <DataGridTextColumn Header="Level"     Binding="{Binding Level}"    Width="100"/>
                            <DataGridTextColumn Header="Element"   Binding="{Binding Name}"     Width="200"/>
                            <DataGridTextColumn Header="Problem"   Binding="{Binding Problem}"  Width="280"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="High">
                                        <Setter Property="Background" Value="#10FF0000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                        <Setter Property="Background" Value="#10FF5F00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10,20,16">
                    <Button Content="Select in Model" Name="BtnQASelect" Click="QASelect_Click"
                            Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,10,0" IsEnabled="False"/>
                    <Button Content="Assign Material..." Name="BtnAssignMaterial"
                            Click="AssignMaterial_Click"
                            Style="{DynamicResource ActionButton}"
                            IsEnabled="False"/>
                    <TextBlock Name="TxtQASelection" Text="" Margin="16,0,0,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
                </StackPanel>
            </Grid>

            <!-- Loading overlay -->
            <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Calculating quantities..." HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="240" Height="12" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
