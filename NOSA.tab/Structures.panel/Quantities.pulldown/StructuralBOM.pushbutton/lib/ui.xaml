<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural BOM v2.0" Height="760" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SubtotalBg"  Color="#FFD5B0"/>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.6"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin"     Value="0,12,0,6"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
        <Style x:Key="DensBox" TargetType="TextBox">
            <Setter Property="Height"                 Value="24"/>
            <Setter Property="FontSize"               Value="10"/>
            <Setter Property="TextAlignment"          Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"            Value="{DynamicResource BorderColor}"/>
            <Setter Property="Padding"                Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,18,16,0">
                <TextBlock Text="STRUCTURAL BOM" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Bill of Materials v2.0" FontSize="10"
                           Opacity="0.5" Margin="0,2,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">

                    <!-- Grouping -->
                    <TextBlock Text="GROUP BY" Style="{DynamicResource SHead}"/>
                    <RadioButton Name="RbLevel"    Content="Level"    GroupName="Group"
                                 IsChecked="True" FontSize="11" Margin="0,0,0,4"/>
                    <RadioButton Name="RbCategory" Content="Category" GroupName="Group"
                                 FontSize="11" Margin="0,0,0,4"/>
                    <RadioButton Name="RbMaterial" Content="Material" GroupName="Group"
                                 FontSize="11" Margin="0,0,0,4"/>

                    <!-- Level filter -->
                    <TextBlock Text="LEVEL FILTER" Style="{DynamicResource SHead}"/>
                    <ComboBox Name="CboLevel" Height="26" FontSize="11"
                              VerticalContentAlignment="Center" Margin="0,0,0,4"/>

                    <!-- Phase filter -->
                    <TextBlock Text="EXCLUDE PHASE" Style="{DynamicResource SHead}"/>
                    <ComboBox Name="CboPhase" Height="26" FontSize="11"
                              VerticalContentAlignment="Center" Margin="0,0,0,4"/>

                    <!-- Options -->
                    <TextBlock Text="OPTIONS" Style="{DynamicResource SHead}"/>
                    <CheckBox Name="ChkRebar" Content="Include rebar weight"
                              IsChecked="True" FontSize="11" Margin="0,0,0,4"/>
                    <CheckBox Name="ChkSubtotals" Content="Show subtotals"
                              IsChecked="True" FontSize="11" Margin="0,0,0,4"/>

                    <!-- Densities -->
                    <TextBlock Text="CONCRETE DENSITIES (kg/m³)" Style="{DynamicResource SHead}"/>
                    <TextBlock Text="Used for estimated total weight"
                               Style="{DynamicResource SideLabel}" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Columns" FontSize="10" VerticalAlignment="Center"/>
                        <TextBox Name="TxtDensCols" Grid.Column="1"
                                 Style="{DynamicResource DensBox}" Text="2500"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Framing / Beams" FontSize="10" VerticalAlignment="Center"/>
                        <TextBox Name="TxtDensFrame" Grid.Column="1"
                                 Style="{DynamicResource DensBox}" Text="2500"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Foundations" FontSize="10" VerticalAlignment="Center"/>
                        <TextBox Name="TxtDensFound" Grid.Column="1"
                                 Style="{DynamicResource DensBox}" Text="2500"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Floors / Slabs" FontSize="10" VerticalAlignment="Center"/>
                        <TextBox Name="TxtDensFloors" Grid.Column="1"
                                 Style="{DynamicResource DensBox}" Text="2500"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Walls" FontSize="10" VerticalAlignment="Center"/>
                        <TextBox Name="TxtDensWalls" Grid.Column="1"
                                 Style="{DynamicResource DensBox}" Text="2500"/>
                    </Grid>

                    <!-- Generate -->
                    <Button Name="BtnGenerate" Content="▶ GENERATE BOM"
                            Style="{DynamicResource ActionBtn}"
                            Click="Generate_Click" Margin="0,6,0,0"/>

                    <ProgressBar Name="ProgBar" Height="3" Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"
                                 BorderThickness="0" Visibility="Collapsed"/>
                    <TextBlock Name="TxtProgress" Text="" FontSize="10"
                               Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Export -->
            <StackPanel Grid.Row="2" Margin="16,0,16,16">
                <Button Name="BtnXlsx" Content="📥 Export Excel"
                        Style="{DynamicResource ActionBtn}"
                        Click="ExportXlsx_Click" IsEnabled="False" Margin="0,0,0,6"/>
                <Button Name="BtnCsv" Content="Export CSV"
                        Style="{DynamicResource SecBtn}"
                        Click="ExportCsv_Click" IsEnabled="False" Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- ══ MAIN ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Name="GridBOM" Grid.Row="0" Margin="12,12,12,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      AlternatingRowBackground="#06000000"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal" FontSize="11"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Group"      Binding="{Binding group}"      Width="110"/>
                    <DataGridTextColumn Header="Category"   Binding="{Binding category}"   Width="145"/>
                    <DataGridTextColumn Header="Family"     Binding="{Binding family}"     Width="140"/>
                    <DataGridTextColumn Header="Type"       Binding="{Binding type_name}"  Width="*"/>
                    <DataGridTextColumn Header="Level"      Binding="{Binding level}"      Width="80"/>
                    <DataGridTextColumn Header="Material"   Binding="{Binding material}"   Width="100"/>
                    <DataGridTextColumn Header="Mat. Type"  Binding="{Binding el_type_str}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="No."        Binding="{Binding count_str}"  Width="40">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vol. (m³)"  Binding="{Binding vol_str}"    Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin"              Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Area (m²)"  Binding="{Binding area_str}"   Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin"              Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Length (m)" Binding="{Binding len_str}"    Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin"              Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Rebar (kg)" Binding="{Binding rebar_str}"  Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin"              Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Steel"      Binding="{Binding steel_str}"  Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin"              Value="0,0,6,0"/>
                                <Setter Property="Foreground"          Value="#1565C0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Est. Wt."   Binding="{Binding est_str}"    Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin"              Value="0,0,6,0"/>
                                <Setter Property="Opacity"             Value="0.7"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding is_subtotal}" Value="True">
                                <Setter Property="Background" Value="#FFD5B0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Totals bar -->
            <Border Grid.Row="1" Background="#FF5F00" Margin="12,4,12,12">
                <Grid Margin="14,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GRAND TOTAL"
                               FontWeight="Bold" FontSize="11" Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="No.: " FontSize="11" Foreground="White" Opacity="0.75"/>
                        <TextBlock Name="TxtTotalCount" Text="—" FontSize="11"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="Vol: " FontSize="11" Foreground="White" Opacity="0.75"/>
                        <TextBlock Name="TxtTotalVol" Text="—" FontSize="11"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="Area: " FontSize="11" Foreground="White" Opacity="0.75"/>
                        <TextBlock Name="TxtTotalArea" Text="—" FontSize="11"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="Rebar: " FontSize="11" Foreground="White" Opacity="0.75"/>
                        <TextBlock Name="TxtTotalRebar" Text="—" FontSize="11"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="Steel: " FontSize="11" Foreground="White" Opacity="0.75"/>
                        <TextBlock Name="TxtTotalSteel" Text="—" FontSize="11"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <TextBlock Text="Est. Wt.: " FontSize="11" Foreground="White" Opacity="0.75"/>
                        <TextBlock Name="TxtTotalEst" Text="—" FontSize="11"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
