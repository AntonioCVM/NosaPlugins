<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Structural Schedule Pro" Height="800" Width="1400"
        MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SubtotalBg"  Color="#FFD5B0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.6"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin"     Value="0,12,0,6"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DensBox" TargetType="TextBox">
            <Setter Property="Height"                 Value="24"/>
            <Setter Property="FontSize"               Value="10"/>
            <Setter Property="TextAlignment"          Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"            Value="{DynamicResource BorderColor}"/>
            <Setter Property="Padding"                Value="4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="STRUCTURAL SCHEDULE PRO" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="BtnModeSchedule" Content="Schedule" Tag="Active"
                                Click="ModeSchedule_Click" Style="{StaticResource ModeButton}" Margin="0,0,8,0"/>
                        <Button Name="BtnModeBOM" Content="Bill of Materials"
                                Click="ModeBOM_Click" Style="{StaticResource ModeButton}"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox Grid.Column="1" Name="ChkDarkMode" Content="Dark Mode"
                          Click="Theme_Toggled" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1">

            <!-- ══════════ SCHEDULE PANEL ══════════ -->
            <Grid Name="PanelSchedule">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="230" MaxWidth="380"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,20,20,10">

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Categories" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Name="SP_ChkColumns"     Content="Structural Columns" IsChecked="True"/>
                                    <CheckBox Name="SP_ChkBeams"       Content="Beams / Framing"    IsChecked="True"/>
                                    <CheckBox Name="SP_ChkFoundations" Content="Foundations"        IsChecked="True"/>
                                    <CheckBox Name="SP_ChkWalls"       Content="Walls"              IsChecked="False"/>
                                    <CheckBox Name="SP_ChkFloors"      Content="Floors"             IsChecked="False"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Group subtotals by" Style="{StaticResource SectionTitle}"/>
                                    <RadioButton Name="SP_RbGroupNone"     Content="None"     GroupName="SP_Group" IsChecked="True"/>
                                    <RadioButton Name="SP_RbGroupLevel"    Content="Level"    GroupName="SP_Group"/>
                                    <RadioButton Name="SP_RbGroupCat"      Content="Category" GroupName="SP_Group"/>
                                    <RadioButton Name="SP_RbGroupMaterial" Content="Material" GroupName="SP_Group"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Extra parameters (comma-separated)" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                    <TextBox Name="SP_TxtExtraParams" Height="28" FontSize="11"
                                             ToolTip="Parameter names to include as extra columns, e.g. Comments, Zone, Fire Rating"
                                             Margin="0,0,0,12"/>
                                    <TextBlock Text="Project header name" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                    <TextBox Name="SP_TxtProjectName" Height="28" FontSize="11"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="20,0,20,20">
                        <Button Content="▶ GENERATE SCHEDULE" Name="SP_BtnRun"
                                Style="{DynamicResource ActionBtn}" Click="SP_Run_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                        <Button Name="SP_BtnExport" Content="Export CSV"
                                Style="{DynamicResource SecBtn}" Click="SP_Export_Click"
                                IsEnabled="False" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                        <Button Name="SP_BtnExportPDF" Content="Export PDF"
                                Style="{DynamicResource SecBtn}" Click="SP_ExportPDF_Click"
                                IsEnabled="False" HorizontalAlignment="Stretch"
                                ToolTip="Export schedule as a formatted PDF report"/>
                    </StackPanel>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <!-- MAIN -->
                <Grid Grid.Column="2" Margin="22,20,22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"
                                   Text="NOSA STRUCTURAL SCHEDULE"/>
                        <ProgressBar Grid.Column="1" Name="SP_ProgBar" Width="120" Height="4"
                                     IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"
                                     BorderThickness="0" Visibility="Collapsed"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="SP_GridSchedule"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mark"       Binding="{Binding mark}"      Width="80"/>
                                <DataGridTextColumn Header="Type"       Binding="{Binding etype}"     Width="*"/>
                                <DataGridTextColumn Header="Level"      Binding="{Binding level}"     Width="100"/>
                                <DataGridTextColumn Header="Length (m)" Binding="{Binding length_m}"  Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Material"   Binding="{Binding material}"  Width="120"/>
                                <DataGridTextColumn Header="Category"   Binding="{Binding category}"  Width="120"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding is_subtotal}" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="2" Name="SP_TxtStatus"
                               Text="Configure options and click ▶ GENERATE SCHEDULE."
                               Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                </Grid>
            </Grid>

            <!-- ══════════ BOM PANEL ══════════ -->
            <Grid Name="PanelBOM" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" MinWidth="210" MaxWidth="340"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="580"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,4,18,16">

                            <TextBlock Text="GROUP BY" Style="{DynamicResource SHead}" Margin="0,10,0,6"/>
                            <RadioButton Name="BOM_RbLevel"    Content="Level"    GroupName="BOM_Group"
                                         IsChecked="True" FontSize="11"/>
                            <RadioButton Name="BOM_RbCategory" Content="Category" GroupName="BOM_Group"
                                         FontSize="11"/>
                            <RadioButton Name="BOM_RbMaterial" Content="Material" GroupName="BOM_Group"
                                         FontSize="11"/>

                            <TextBlock Text="LEVEL FILTER" Style="{DynamicResource SHead}"/>
                            <ComboBox Name="BOM_CboLevel" Height="27" FontSize="11"
                                      VerticalContentAlignment="Center"/>

                            <TextBlock Text="EXCLUDE PHASE" Style="{DynamicResource SHead}"/>
                            <ComboBox Name="BOM_CboPhase" Height="27" FontSize="11"
                                      VerticalContentAlignment="Center"/>

                            <TextBlock Text="OPTIONS" Style="{DynamicResource SHead}"/>
                            <CheckBox Name="BOM_ChkRebar" Content="Include rebar weight"
                                      IsChecked="True" FontSize="11"/>
                            <CheckBox Name="BOM_ChkSubtotals" Content="Show subtotals"
                                      IsChecked="True" FontSize="11"/>

                            <TextBlock Text="CONCRETE DENSITIES (kg/m³)" Style="{DynamicResource SHead}"/>
                            <TextBlock Text="Used for estimated total weight"
                                       Style="{StaticResource SideLabel}" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Columns" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Name="BOM_TxtDensCols" Grid.Column="1"
                                         Style="{DynamicResource DensBox}" Text="2500"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Framing / Beams" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Name="BOM_TxtDensFrame" Grid.Column="1"
                                         Style="{DynamicResource DensBox}" Text="2500"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Foundations" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Name="BOM_TxtDensFound" Grid.Column="1"
                                         Style="{DynamicResource DensBox}" Text="2500"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Floors / Slabs" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Name="BOM_TxtDensFloors" Grid.Column="1"
                                         Style="{DynamicResource DensBox}" Text="2500"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Walls" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Name="BOM_TxtDensWalls" Grid.Column="1"
                                         Style="{DynamicResource DensBox}" Text="2500"/>
                            </Grid>

                            <Button Name="BOM_BtnGenerate" Content="▶ GENERATE BOM"
                                    Style="{DynamicResource ActionBtn}"
                                    Click="BOM_Generate_Click" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>

                            <ProgressBar Name="BOM_ProgBar" Height="3" Margin="0,8,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}"
                                         BorderThickness="0" Visibility="Collapsed"/>
                            <TextBlock Name="BOM_TxtProgress" Text="" Style="{StaticResource SideLabel}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="18,0,18,18">
                        <Button Name="BOM_BtnXlsx" Content="📥 Export Excel"
                                Style="{DynamicResource ActionBtn}"
                                Click="BOM_ExportXlsx_Click" IsEnabled="False" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                        <Button Name="BOM_BtnCsv" Content="Export CSV"
                                Style="{DynamicResource SecBtn}"
                                Click="BOM_ExportCsv_Click" IsEnabled="False" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <!-- MAIN -->
                <Grid Grid.Column="2" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="BOM_GridBOM"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  AlternatingRowBackground="#06000000"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" FontSize="11"
                                  SelectionChanged="BOM_Grid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group"      Binding="{Binding group}"      Width="110"/>
                                <DataGridTextColumn Header="Category"   Binding="{Binding category}"   Width="145"/>
                                <DataGridTextColumn Header="Family"     Binding="{Binding family}"     Width="140"/>
                                <DataGridTextColumn Header="Type"       Binding="{Binding type_name}"  Width="*"/>
                                <DataGridTextColumn Header="Level"      Binding="{Binding level}"      Width="80"/>
                                <DataGridTextColumn Header="Material"   Binding="{Binding material}"   Width="100"/>
                                <DataGridTextColumn Header="Mat. Type"  Binding="{Binding el_type_str}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="No."        Binding="{Binding count_str}"  Width="40">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Vol. (m³)"  Binding="{Binding vol_str}"    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin"              Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Area (m²)"  Binding="{Binding area_str}"   Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin"              Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Length (m)" Binding="{Binding len_str}"    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin"              Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Rebar (kg)" Binding="{Binding rebar_str}"  Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin"              Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Steel"      Binding="{Binding steel_str}"  Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin"              Value="0,0,6,0"/>
                                            <Setter Property="Foreground"          Value="#1565C0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Est. Wt."   Binding="{Binding est_str}"    Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin"              Value="0,0,6,0"/>
                                            <Setter Property="Opacity"             Value="0.7"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding is_subtotal}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtotalBg}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource AccentColor}" CornerRadius="10"
                            Margin="0,12,0,0" Effect="{StaticResource CardShadow}">
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GRAND TOTAL"
                                       FontWeight="Bold" FontSize="11" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,22,0">
                                <TextBlock Text="No.: " FontSize="11" Foreground="White" Opacity="0.75"/>
                                <TextBlock Name="BOM_TxtTotalCount" Text="—" FontSize="11"
                                           Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,22,0">
                                <TextBlock Text="Vol: " FontSize="11" Foreground="White" Opacity="0.75"/>
                                <TextBlock Name="BOM_TxtTotalVol" Text="—" FontSize="11"
                                           Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,22,0">
