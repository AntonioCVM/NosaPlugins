<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Schedule Pro v1.0" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,24,20,14">
                <TextBlock Text="SCHEDULE PRO" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Structural element schedule" FontSize="11"
                           Opacity="0.55"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <TextBlock Text="Categories" FontWeight="Bold" FontSize="11"
                               Opacity="0.65" Margin="0,0,0,6"/>
                    <CheckBox Name="ChkColumns"     Content="Structural Columns" IsChecked="True" Margin="0,3"/>
                    <CheckBox Name="ChkBeams"       Content="Beams / Framing"    IsChecked="True" Margin="0,3"/>
                    <CheckBox Name="ChkFoundations" Content="Foundations"        IsChecked="True" Margin="0,3"/>
                    <CheckBox Name="ChkWalls"       Content="Walls"              IsChecked="False" Margin="0,3"/>
                    <CheckBox Name="ChkFloors"      Content="Floors"             IsChecked="False" Margin="0,3"/>

                    <Separator Margin="0,14,0,12"/>

                    <TextBlock Text="Group subtotals by" FontWeight="Bold" FontSize="11"
                               Opacity="0.65" Margin="0,0,0,6"/>
                    <RadioButton Name="RbGroupNone"     Content="None"     GroupName="GrpGroup" IsChecked="True" Margin="0,3"/>
                    <RadioButton Name="RbGroupLevel"    Content="Level"    GroupName="GrpGroup" Margin="0,3"/>
                    <RadioButton Name="RbGroupCat"      Content="Category" GroupName="GrpGroup" Margin="0,3"/>
                    <RadioButton Name="RbGroupMaterial" Content="Material" GroupName="GrpGroup" Margin="0,3"/>

                    <Separator Margin="0,14,0,12"/>

                    <TextBlock Text="Extra parameters (comma-separated)" FontSize="10" Opacity="0.65" Margin="0,0,0,4"/>
                    <TextBox Name="TxtExtraParams" Height="28" FontSize="11" Padding="6,4"
                             BorderBrush="{DynamicResource BorderColor}"
                             ToolTip="Parameter names to include as extra columns, e.g. Comments, Zone, Fire Rating"/>

                    <Separator Margin="0,14,0,12"/>

                    <TextBlock Text="Project header name" FontSize="10" Opacity="0.65" Margin="0,0,0,4"/>
                    <TextBox Name="TxtProjectName" Height="28" FontSize="11" Padding="6,4"
                             BorderBrush="{DynamicResource BorderColor}"/>

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="▶ GENERATE SCHEDULE" Name="BtnRun"
                    Style="{DynamicResource ActionBtn}" Click="Run_Click" Margin="20,0,20,8"/>
            <Button Grid.Row="3" Name="BtnExport" Content="Export CSV"
                    Style="{DynamicResource SecBtn}" Click="Export_Click"
                    IsEnabled="False" Margin="20,0,20,4"/>
            <Button Grid.Row="4" Name="BtnExportPDF" Content="Export PDF"
                    Style="{DynamicResource SecBtn}" Click="ExportPDF_Click"
                    IsEnabled="False" Margin="20,0,20,8"
                    ToolTip="Export schedule as a formatted PDF report"/>
            <CheckBox Grid.Row="5" Name="ChkDarkMode" Content="Dark Mode"
                      Click="Theme_Toggled" Margin="20,0,20,16"/>
        </Grid>

        <!-- Main grid -->
        <Grid Grid.Column="1" Margin="16,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"
                           Text="NOSA STRUCTURAL SCHEDULE"/>
                <ProgressBar Grid.Column="1" Name="ProgBar" Width="120" Height="4"
                             IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"
                             BorderThickness="0" Visibility="Collapsed"/>
            </Grid>

            <!-- DataGrid -->
            <DataGrid Name="GridSchedule" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#06000000" Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal" FontSize="11">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mark"       Binding="{Binding mark}"      Width="80"/>
                    <DataGridTextColumn Header="Type"       Binding="{Binding etype}"     Width="*"/>
                    <DataGridTextColumn Header="Level"      Binding="{Binding level}"     Width="100"/>
                    <DataGridTextColumn Header="Length (m)" Binding="{Binding length_m}"  Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Material"   Binding="{Binding material}"  Width="120"/>
                    <DataGridTextColumn Header="Category"   Binding="{Binding category}"  Width="120"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding is_subtotal}" Value="True">
                                <Setter Property="Background" Value="#FFF3E0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Footer status -->
            <TextBlock Grid.Row="2" Name="TxtStatus"
                       Text="Configure options and click ▶ GENERATE SCHEDULE."
                       FontSize="11" Opacity="0.6" Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
