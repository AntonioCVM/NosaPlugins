<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebar Manager — NOSA"
        Width="820" Height="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Century Gothic, Segoe UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rebar Manager" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  BS 8666 Schedule &amp; Bar Mark Management"
                           Foreground="#FFD0A0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tab bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Background="{DynamicResource PanelColor}" Margin="0,0,0,1">
            <Button Name="BtnTabSchedule" Content="BS 8666 Schedule" Width="150"
                    Background="{DynamicResource AccentColor}" Foreground="White"
                    BorderThickness="0" Click="Tab_Click" Tag="Schedule"/>
            <Button Name="BtnTabMarks"    Content="Bar Mark Manager" Width="150"
                    Background="Transparent" Foreground="{DynamicResource TextColor}"
                    BorderThickness="0" Click="Tab_Click" Tag="Marks"/>
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Margin="16,0,0,0"
                      VerticalAlignment="Center" Click="Theme_Toggled"/>
        </StackPanel>

        <!-- ======== BS 8666 SCHEDULE TAB ======== -->
        <Grid Name="PanelSchedule" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Export options -->
            <Border Grid.Row="0" Background="{DynamicResource PanelColor}" Margin="8,8,8,0"
                    Padding="12,8" CornerRadius="4"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Project No.:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   Grid.Column="1" Name="TxtProjectNo" Height="26"
                               VerticalContentAlignment="Center" Padding="4,0"/>
                    <TextBlock Grid.Column="3" Text="Revision:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   Grid.Column="4" Name="TxtRevision" Text="P01" Height="26"
                               VerticalContentAlignment="Center" Padding="4,0"/>
                    <Button    Grid.Column="6" Name="BtnLoad" Content="Load Rebar"
                               Click="Load_Click" Margin="0,0,8,0"/>
                    <Button    Grid.Column="7" Name="BtnExportExcel" Content="Export BS 8666 Excel"
                               Click="ExportExcel_Click"
                               Background="{DynamicResource AccentColor}"
                               Foreground="White" BorderThickness="0"
                               HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <!-- Schedule table -->
            <DataGrid Grid.Row="1" Name="GridSchedule" Margin="8,6,8,0"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" RowHeight="22" FontSize="11"
                      SelectionMode="Extended" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bar Mark"   Binding="{Binding Mark}"         Width="80"/>
                    <DataGridTextColumn Header="Size"       Binding="{Binding DiamLabel}"     Width="55"/>
                    <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"      Width="50"/>
                    <DataGridTextColumn Header="Shape"      Binding="{Binding Shape}"         Width="55"/>
                    <DataGridTextColumn Header="Shape Desc" Binding="{Binding ShapeDesc}"     Width="160"/>
                    <DataGridTextColumn Header="Total L (m)" Binding="{Binding TotalLenM}"    Width="90"/>
                    <DataGridTextColumn Header="Mass (kg)"  Binding="{Binding MassKg}"        Width="80"/>
                    <DataGridTextColumn Header="Level"      Binding="{Binding Levels}"        Width="100"/>
                    <DataGridTextColumn Header="Host"       Binding="{Binding Hosts}"         Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Name="TxtScheduleStatus" Margin="10,4"
                       FontSize="11" Foreground="#666"/>
        </Grid>

        <!-- ======== BAR MARK MANAGER TAB ======== -->
        <Grid Name="PanelMarks" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Duplicate warnings -->
            <Border Grid.Row="0" Name="PanelDuplicates" Background="#FFF3E0" Margin="8,8,8,0"
                    Padding="10,6" CornerRadius="4" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
                <TextBlock Name="TxtDuplicates" TextWrapping="Wrap"
                           Foreground="#CC3300" FontSize="11"/>
            </Border>

            <!-- Renumber options -->
            <Border Grid.Row="1" Background="{DynamicResource PanelColor}" Margin="8,6,8,0"
                    Padding="12,8" CornerRadius="4"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Prefix:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Name="TxtMarkPrefix" Text="S" Width="60" Height="26"
                             VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,12,0"/>
                    <TextBlock Text="Start at:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Name="TxtMarkStart" Text="1" Width="60" Height="26"
                             VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,12,0"/>
                    <Button Name="BtnRenumber" Content="Renumber Selected"
                            Click="Renumber_Click" Margin="0,0,8,0"/>
                    <Button Name="BtnDetectDupes" Content="Detect Duplicates"
                            Click="DetectDupes_Click" Margin="0,0,8,0"/>
                    <Button Name="BtnLoadMarks" Content="Refresh"
                            Click="LoadMarks_Click"/>
                </StackPanel>
            </Border>

            <!-- Bar marks table -->
            <DataGrid Grid.Row="2" Name="GridMarks" Margin="8,6,8,0"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" RowHeight="22" FontSize="11"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="✔" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mark"       Binding="{Binding Mark}"       Width="80"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ø (mm)"     Binding="{Binding Diameter}"   Width="55"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"   Width="50"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Shape"      Binding="{Binding Shape}"      Width="55"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Level"      Binding="{Binding Levels}"     Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Duplicate?" Binding="{Binding DupeWarning}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Name="TxtMarksStatus" Margin="10,4"
                       FontSize="11" Foreground="#666"/>
        </Grid>

        <!-- Log -->
        <TextBox Grid.Row="3" Name="TxtLog" Height="55" Margin="8,4,8,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="11" Foreground="#555" Background="{DynamicResource PanelColor}"
                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="8,6">
            <Button Content="Close" Click="Close_Click" Width="80"
                    HorizontalAlignment="Right"/>
        </Border>

        <!-- Loading -->
        <Grid Name="LoadingPanel" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
