<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebar Manager — NOSA" Height="720" Width="1060"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Pill-style tab buttons — python paints Background/Foreground directly on click -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"   Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="RowHeight"                Value="24"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="RowBackground"            Value="{DynamicResource PanelColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgColor}"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="SelectionMode"            Value="Extended"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,25,20,16">
                <TextBlock Text="REBAR MANAGER" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="BS 8666 Schedule &amp; Bar Mark Management" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="BS 8666 Export" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Project No." Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="TxtProjectNo" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Revision" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="TxtRevision" Text="P01" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>
                            <Button Name="BtnLoad" Content="Load Rebar"
                                    Click="Load_Click" Style="{DynamicResource ActionButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Name="BtnExportExcel" Content="Export BS 8666 Excel"
                                    Click="ExportExcel_Click" Style="{DynamicResource SecondaryButton}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Renumber Bar Marks" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="TxtMarkPrefix" Text="S" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Start at" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="TxtMarkStart" Text="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>
                            <Button Name="BtnRenumber" Content="Renumber Selected"
                                    Click="Renumber_Click" Style="{DynamicResource ActionButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Name="BtnDetectDupes" Content="Detect Duplicates"
                                    Click="DetectDupes_Click" Style="{DynamicResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Name="BtnLoadMarks" Content="Refresh"
                                    Click="LoadMarks_Click" Style="{DynamicResource SecondaryButton}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled" Margin="0,0,0,10"/>
                <Button Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="2" Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Tab bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="{DynamicResource BgColor}" CornerRadius="16" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="BtnTabSchedule" Content="BS 8666 Schedule"
                                Style="{DynamicResource TabBtn}" Click="Tab_Click" Tag="Schedule"
                                Background="{DynamicResource AccentColor}" Foreground="White"/>
                        <Button Name="BtnTabMarks"    Content="Bar Mark Manager"
                                Style="{DynamicResource TabBtn}" Click="Tab_Click" Tag="Marks"
                                Background="Transparent" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">

                <!-- ======== BS 8666 SCHEDULE TAB ======== -->
                <Grid Name="PanelSchedule">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="GridSchedule" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bar Mark"   Binding="{Binding Mark}"         Width="80"/>
                                <DataGridTextColumn Header="Size"       Binding="{Binding DiamLabel}"     Width="55"/>
                                <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"      Width="50"/>
                                <DataGridTextColumn Header="Shape"      Binding="{Binding Shape}"         Width="55"/>
                                <DataGridTextColumn Header="Shape Desc" Binding="{Binding ShapeDesc}"     Width="160"/>
                                <DataGridTextColumn Header="Total L (m)" Binding="{Binding TotalLenM}"    Width="90"/>
                                <DataGridTextColumn Header="Mass (kg)"  Binding="{Binding MassKg}"        Width="80"/>
                                <DataGridTextColumn Header="Level"      Binding="{Binding Levels}"        Width="100"/>
                                <DataGridTextColumn Header="Host"       Binding="{Binding Hosts}"         Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="1" Name="TxtScheduleStatus" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                </Grid>

                <!-- ======== BAR MARK MANAGER TAB ======== -->
                <Grid Name="PanelMarks" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Name="PanelDuplicates" Background="#FFF3E0" Margin="0,0,0,10"
                            Padding="10,8" CornerRadius="8" Visibility="Collapsed"
                            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
                        <TextBlock Name="TxtDuplicates" TextWrapping="Wrap"
                                   Foreground="#CC3300" FontSize="11"/>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="GridMarks">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="✔" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mark"       Binding="{Binding Mark}"       Width="80"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ø (mm)"     Binding="{Binding Diameter}"   Width="55"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"   Width="50"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Shape"      Binding="{Binding Shape}"      Width="55"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Level"      Binding="{Binding Levels}"     Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Duplicate?" Binding="{Binding DupeWarning}" Width="80" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Grid.Row="2" Name="TxtMarksStatus" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                </Grid>
            </Grid>

            <!-- Log -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="10,8">
                <TextBox Name="TxtLog"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="10" Foreground="{DynamicResource TextColor}"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas, Courier New"/>
            </Border>
        </Grid>

        <!-- Loading -->
        <Grid Name="LoadingPanel" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Background="{DynamicResource PanelColor}" CornerRadius="10" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True" Margin="0,8,0,0"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
