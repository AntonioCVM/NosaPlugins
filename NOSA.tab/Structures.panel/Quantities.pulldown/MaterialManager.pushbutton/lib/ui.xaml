<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material Manager Pro v2.0" Height="720" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CC3333"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#CC3333"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="TextBox" x:Key="SearchBox">
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Padding"   Value="6,4"/>
            <Setter Property="Height"    Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <!-- Root grid: sidebar + main -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="MATERIAL" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="MANAGER PRO" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtMatCount" Text="Ready" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Contextual panels -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <!-- MATERIALS sidebar -->
                    <StackPanel Name="SidebarMaterials" Visibility="Visible">
                        <TextBlock Text="Filters" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                        <TextBlock Text="Material class:" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                        <ComboBox Name="CboClass" Height="26" FontSize="11"
                                  SelectionChanged="Class_Changed"/>
                        <CheckBox Name="ChkOnlyUnused" Content="Unused only (0 uses)"
                                  IsChecked="False" Click="Filter_Changed" Margin="0,10,0,0"/>
                        <CheckBox Name="ChkNearDups"   Content="Near-duplicates only"
                                  IsChecked="False" Click="Filter_Changed"/>
                        <Separator Margin="0,14,0,12"/>
                        <Button Content="SCAN MATERIALS" Name="BtnScan"
                                Click="Scan_Click" Style="{DynamicResource ActionButton}"
                                Margin="0,0,0,8"/>
                        <Button Content="Delete Unused" Name="BtnDelete"
                                Click="Delete_Click" Style="{DynamicResource DangerButton}"
                                Margin="0,0,0,8" IsEnabled="False"
                                ToolTip="Delete all unused materials from the project"/>
                        <Button Content="Export CSV" Name="BtnExport"
                                Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,0,0" IsEnabled="False"/>
                    </StackPanel>

                    <!-- ELEMENTS sidebar -->
                    <StackPanel Name="SidebarElements" Visibility="Collapsed">
                        <TextBlock Text="Filters" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                        <TextBlock Text="Category:" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                        <ComboBox Name="CboElCategory" Height="26" FontSize="11"
                                  SelectionChanged="ElementFilter_Changed"/>
                        <TextBlock Text="Level:" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Margin="0,8,0,3"/>
                        <ComboBox Name="CboElLevel" Height="26" FontSize="11"
                                  SelectionChanged="ElementFilter_Changed"/>
                        <CheckBox Name="ChkMissingOnly" Content="Missing material only"
                                  IsChecked="False" Click="ElementFilter_Changed" Margin="0,10,0,0"/>
                        <CheckBox Name="ChkUseSelection" Content="Use current selection (any category)"
                                  IsChecked="False" Margin="0,6,0,0"
                                  ToolTip="Scan only the elements currently selected in Revit, instead of the fixed Framing/Columns/Walls/Floors/Foundation category list."/>
                        <Separator Margin="0,14,0,12"/>
                        <Button Content="SCAN ELEMENTS" Name="BtnScanElements"
                                Click="ScanElements_Click" Style="{DynamicResource ActionButton}"
                                Margin="0,0,0,8"/>
                        <Separator Margin="0,6,0,12"/>
                        <TextBlock Text="Assign material:" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox Name="CboAssignMaterial" Height="26" FontSize="10"
                                  DisplayMemberPath="Name"/>
                        <Button Content="Assign to Selected" Name="BtnAssign"
                                Click="AssignMaterial_Click" Style="{DynamicResource ActionButton}"
                                Margin="0,8,0,8" IsEnabled="False"
                                ToolTip="Assign material to selected rows in the grid"/>
                        <Button Content="Export CSV" Name="BtnExportElements"
                                Click="ExportElements_Click" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,0,0" IsEnabled="False"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Dark mode -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN TabControl ═══ -->
        <TabControl Grid.Column="1" Name="TabMain"
                    SelectionChanged="Tab_Changed"
                    Background="{DynamicResource BgColor}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderColor}">

            <!-- ─── TAB 1: Materials ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="  Materials  " Padding="4,2"/>
                </TabItem.Header>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Pills -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtPillTotal"  Text="0 materials"      FontSize="11" Foreground="#666"    FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtPillUnused" Text="0 unused"          FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="12" Background="#FFF3E6" Padding="10,4">
                            <TextBlock Name="TxtPillDups"   Text="0 near-duplicates" FontSize="11" Foreground="#FF5F00" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Search -->
                    <TextBox Grid.Row="1" Name="TxtSearch"
                             Style="{DynamicResource SearchBox}"
                             Text="Search materials..." Foreground="Gray"
                             GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                             TextChanged="Search_Changed"
                             Margin="0,0,0,10"/>

                    <!-- Grid container with overlay -->
                    <Grid Grid.Row="2">
                        <DataGrid Name="GridMaterials"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="*"/>
                                <DataGridTextColumn Header="Class"    Binding="{Binding MatClass}" Width="130"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding MatCat}"   Width="130"/>
                                <DataGridTextColumn Header="Uses"     Binding="{Binding UseCount}" Width="60"/>
                                <DataGridTextColumn Header="Status"   Binding="{Binding Status}"   Width="100"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                            <Setter Property="Background" Value="#10CC0000"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNearDup}" Value="True">
                                            <Setter Property="Foreground" Value="#CC6600"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- Loading overlay (covers the whole right area) -->
                        <Grid Name="LoadingPanel" Visibility="Collapsed"
                              Background="#CCFAFAFA">
                            <Border Background="White" CornerRadius="6" Padding="28,20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Working..." HorizontalAlignment="Center"
                                               FontSize="13" Foreground="{DynamicResource TextColor}"
                                               Margin="0,0,0,12"/>
                                    <ProgressBar Name="ProcessBar" Width="240" Height="10"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: Elements ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="  Elements  " Padding="4,2"/>
                </TabItem.Header>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Pills -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtPillElTotal"    Text="0 elements"          FontSize="11" Foreground="#666"    FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtPillElMissing"  Text="0 missing material"  FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="12" Background="#E6F0FF" Padding="10,4">
                            <TextBlock Name="TxtPillElProposed" Text="0 with proposal"     FontSize="11" Foreground="#1155CC" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Elements DataGrid -->
                    <DataGrid Grid.Row="1" Name="GridElements"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}"     Width="120"/>
                            <DataGridTextColumn Header="Level"    Binding="{Binding Level}"        Width="90"/>
                            <DataGridTextColumn Header="Type"     Binding="{Binding TypeName}"     Width="*"/>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="Status"   Binding="{Binding Status}"       Width="80"/>
                            <DataGridTextColumn Header="Proposed" Binding="{Binding ProposedName}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Background" Value="#10CC0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
