<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Robustness Ties" Height="680" Width="1000"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="18">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Robustness ties" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" Foreground="{DynamicResource TextColor}"
                           Text="IStructE SMDSC 5.1.9 / EC2 9.10 (UK NA): peripheral, internal, column and wall, and vertical ties. Calculate the forces and steel, then select floors to check the continuous, lapped ties their own bars give. Read-only."/>
            </StackPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Storeys (n0):" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextColor}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TxtStoreys" Margin="0,4,16,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="gk + qk (kN/m2):" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextColor}"/>
                <TextBox Grid.Row="0" Grid.Column="3" Name="TxtLoads" Margin="0,4,16,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Greatest span lr (m):" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextColor}"/>
                <TextBox Grid.Row="0" Grid.Column="5" Name="TxtSpan" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Floor to ceiling ls (m):" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextColor}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtHeight" Margin="0,4,16,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Edge column load (kN):" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextColor}"/>
                <TextBox Grid.Row="1" Grid.Column="3" Name="TxtColumnLoad" Margin="0,4,16,4"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Tie bar size (mm):" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextColor}"/>
                <TextBox Grid.Row="1" Grid.Column="5" Name="TxtDia" Margin="0,4,0,4"/>
            </Grid>
            <TextBox DockPanel.Dock="Top" Name="TxtResult" IsReadOnly="True" TextWrapping="Wrap" MinHeight="110"
                     Margin="0,0,0,10" FontSize="12" Background="{DynamicResource PanelColor}"/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Name="BtnCheck" Content="Check selected floors" Click="Check_Click" Padding="16,8" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Name="BtnCalculate" Content="Calculate" Click="Calculate_Click" Padding="16,8"
                        Background="{DynamicResource AccentColor}" Foreground="White" FontWeight="Bold"/>
                <TextBlock Name="TxtStatus" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
            </DockPanel>
            <DataGrid Name="GridChecks" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderBrush="{DynamicResource BorderColor}"
                      Background="{DynamicResource PanelColor}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="110"/>
                    <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="120"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtLoading" HorizontalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
