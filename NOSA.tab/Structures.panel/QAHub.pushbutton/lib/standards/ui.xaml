<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Standards Audit" Height="700" Width="1100"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="18">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Standards audit" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" Foreground="{DynamicResource TextColor}"
                           Text="Leftovers from Spanish templates and DWG imports, duplicates, imperial names, non-NOSA fonts, unused filters, broken images, duplicate project parameters, model views without a template and copied types. Read-only: nothing is changed."/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Name="BtnExport" Content="Export CSV..." Click="Export_Click" Padding="16,8" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Name="BtnRun" Content="Run audit" Click="Run_Click" Padding="16,8"
                        Background="{DynamicResource AccentColor}" Foreground="White" FontWeight="Bold"/>
                <CheckBox DockPanel.Dock="Left" Name="ChkPurge" Content="Also ask Revit what is unused (slower)"
                          VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" Margin="0,0,16,0"/>
                <TextBlock Name="TxtStatus" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextColor}"/>
            </DockPanel>
            <DataGrid Name="GridFindings" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderBrush="{DynamicResource BorderColor}"
                      Background="{DynamicResource PanelColor}" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="130"/>
                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="300"/>
                    <DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="*"/>
                    <DataGridTextColumn Header="Unused" Binding="{Binding Unused}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtLoading" HorizontalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
