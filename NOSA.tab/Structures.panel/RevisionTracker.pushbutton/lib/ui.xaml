<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Revision Tracker v1.0" Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="REVISION TRACKER" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Structural Model Delta" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>
            <ListBox Name="ListSnapshots" Grid.Row="1" Margin="20,0,20,10"
                     BorderBrush="{DynamicResource BorderColor}" Background="White"
                     SelectionChanged="Snapshot_SelectionChanged"/>
            <Button Grid.Row="2" Content="Take Snapshot Now" Name="BtnSnapshot"
                    Click="TakeSnapshot_Click" Style="{DynamicResource ActionButton}" Margin="20,0,20,8"/>
            <Button Grid.Row="3" Content="Compare Selected" Name="BtnCompare"
                    Click="Compare_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,8" IsEnabled="False"/>
            <Button Grid.Row="4" Content="Delete Snapshot" Name="BtnDelete"
                    Click="Delete_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>
        <!-- MAIN -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#DDFFDD" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtAdded" Text="0 Added" FontSize="11" Foreground="#226622" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtRemoved" Text="0 Removed" FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtChanged" Text="0 Changed" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <TextBlock Name="TxtSnapInfo" Text="Select a snapshot and click Compare" Margin="16,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" Opacity="0.6" FontSize="11"/>
            </StackPanel>
            <DataGrid Name="GridDelta" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#06000000" Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}" GridLinesVisibility="Horizontal"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Change"    Binding="{Binding ChangeType}" Width="80"/>
                    <DataGridTextColumn Header="Category"  Binding="{Binding Category}"   Width="160"/>
                    <DataGridTextColumn Header="Name"      Binding="{Binding Name}"        Width="*"/>
                    <DataGridTextColumn Header="Detail"    Binding="{Binding Detail}"      Width="300"/>
                    <DataGridTextColumn Header="ID"        Binding="{Binding Id}"          Width="80"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChangeType}" Value="ADDED">
                                <Setter Property="Background" Value="#10009900"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChangeType}" Value="REMOVED">
                                <Setter Property="Background" Value="#10CC0000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChangeType}" Value="CHANGED">
                                <Setter Property="Background" Value="#10FF5F00"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Comparing..." HorizontalAlignment="Center" FontSize="13" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="12" IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Select in Model" Name="BtnSelect" Click="Select_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" IsEnabled="False"/>
                <Button Content="Export CSV" Name="BtnExport" Click="Export_Click"
                        Style="{DynamicResource SecondaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
