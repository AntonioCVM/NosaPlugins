<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structural Type Manager v2.0" Height="800" Width="1320"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="RowBackground"            Value="{DynamicResource PanelColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgColor}"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="SelectionMode"            Value="Extended"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="290" MaxWidth="440"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="18,24,18,14">
                <TextBlock Text="STRUCTURAL TYPE MANAGER" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                <TextBlock Name="TxtStatusHint" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.62" Margin="0,8,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,0,18,12">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource SectionTitle}"/>
                            <ComboBox Name="ComboPresetPick" Height="26" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Name="TxtPresetSaveName" Width="150" Margin="0,0,8,0" Style="{DynamicResource FieldBox}"/>
                                <Button Content="Save preset" Click="PresetSave_Click" Width="140" Style="{DynamicResource SecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Category &amp; Scan" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Name="ComboCategory" Height="28" DisplayMemberPath="Title" Margin="0,0,0,10"/>

                            <CheckBox Name="ChkRestrictSelection"
                                      Content="Limit types to intersection with Revit selection"/>
                            <CheckBox Name="ChkExcludeNonModifiable"
                                      Content="Exclude non-modifiable type symbols"/>
                            <CheckBox Name="ChkOpenWorksetsOnly"
                                      Content="Exclude types on closed worksets" Margin="0,3,0,6"/>
                            <TextBlock Style="{StaticResource HintText}" FontStyle="Italic" TextWrapping="Wrap"
                                       Text="Active doc only — linked docs out of scope. Selection filter inspects Families + ElementTypes picked in canvas."
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Family contains" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="TxtFamFilter" Style="{DynamicResource FieldBox}" Margin="0,0,0,8"/>
                            <TextBlock Text="Type contains" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="TxtTypeFilter" Style="{DynamicResource FieldBox}" Margin="0,0,0,10"/>

                            <Button Content="SCAN TYPES" Name="BtnScan" Click="Scan_Click"
                                    Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                            <TextBlock Name="TxtRowCount" Margin="0,8,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}" Text="0 types"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Parameter Filter &amp; Scope" Style="{StaticResource SectionTitle}"/>
                            <TextBox Name="TxtParamFilter" Height="26" Style="{DynamicResource FieldBox}"
                                     TextChanged="ParamFilter_TextChanged" Margin="0,0,0,8"/>
                            <ComboBox Name="ComboParamScope" Height="26" Margin="0,0,0,10"/>

                            <TextBlock Text="Primary (editable)" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                            <ComboBox Name="ComboParam" Height="26" IsEditable="True" Margin="0,0,0,8"/>

                            <TextBlock Text="Secondary (read-only column)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Name="ComboParamAux" Height="26" Margin="0,0,0,8"/>

                            <CheckBox Name="ChkWritableOnlyDiscover" Content="Discover writable-only"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Duplicate Selected Row" Style="{StaticResource SectionTitle}"/>
                            <TextBox Name="TxtDupTypeName" Style="{DynamicResource FieldBox}" Margin="0,0,0,8"/>
                            <Button Content="DUPLICATE ROW" Style="{DynamicResource SecondaryButton}"
                                    Click="Duplicate_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Bulk Fill &amp; Apply" Style="{StaticResource SectionTitle}"/>
                            <TextBox Name="TxtApplyAll" Style="{DynamicResource FieldBox}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Fill New" Click="FillAll_Click" Padding="12,6"
                                        Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0"/>
                                <CheckBox Name="ChkWritableApply" VerticalAlignment="Center" IsChecked="True" Content="Hide read-only"/>
                            </StackPanel>
                            <CheckBox Name="ChkDryRunPreview" Content="Dry-run preview before APPLY" IsChecked="True" Margin="0,0,0,10"/>
                            <Button Content="APPLY TYPE PARAMETERS" Click="Apply_Click"
                                    Style="{DynamicResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Content="EXPORT CSV" Click="Export_Click"
                                    Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="18,0,18,18">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="2" Margin="22">
            <Border Style="{StaticResource Card}" Padding="1">
                <DataGrid Name="GridMain"
                          BeginningEdit="Grid_Main_BeginningEdit">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="358" Binding="{Binding FamType}" Header="Family : Type" IsReadOnly="True"/>
                        <DataGridTextColumn Width="120" Binding="{Binding TypeId}" Header="Type Id" IsReadOnly="True"/>
                        <DataGridTextColumn Width="160" Binding="{Binding AuxVal}" Header="Aux ref" IsReadOnly="True"/>
                        <DataGridTextColumn Width="220" Binding="{Binding CurrentVal}" Header="Current" IsReadOnly="True"/>
                        <DataGridTextColumn Width="320" Binding="{Binding NewVal}" Header="New"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                <Border Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="26"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel MinWidth="220">
                        <TextBlock Name="TxtLoadingMsg" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}"/>
                        <ProgressBar Height="11" Margin="0,14,0,0" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
