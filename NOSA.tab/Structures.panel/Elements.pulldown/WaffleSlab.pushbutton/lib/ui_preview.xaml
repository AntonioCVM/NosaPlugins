<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waffle Slab — 2D Preview" Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#F8F8F8" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#F8F8F8"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="White" Margin="0,0,0,1">
            <StackPanel Margin="20,14,20,14">
                <TextBlock Text="WAFFLE SLAB PREVIEW" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Review the 2D rib pattern before confirming creation."
                           FontSize="11" Opacity="0.55"/>
            </StackPanel>
        </StackPanel>

        <!-- Canvas -->
        <Border Grid.Row="1" Background="White" Margin="16,12,16,0"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Canvas Name="PreviewCanvas" Background="Transparent"/>
        </Border>

        <!-- Quantification bar -->
        <Border Grid.Row="2" Background="#FFF3E0" Margin="16,8,16,0"
                BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <TextBlock Name="TxtQuant" FontSize="11" FontWeight="SemiBold"
                       Foreground="#E65C00" HorizontalAlignment="Center"/>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,12,16,16">
            <Button Content="Cancel" Style="{DynamicResource SecBtn}"
                    Click="Cancel_Click" Margin="0,0,12,0"/>
            <Button Content="✓ Confirm &amp; Create Slab" Style="{DynamicResource ActionBtn}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
