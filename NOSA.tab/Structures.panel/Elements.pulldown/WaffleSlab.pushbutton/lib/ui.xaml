<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waffle Slab v2.2" Height="640" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="Padding"   Value="6,2"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="WAFFLE SLAB" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Real voids + compression layer" FontSize="10"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">
                    <TextBlock Text="Rib spacing (mm):" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtIntereje" Style="{DynamicResource FieldBox}" Margin="0,0,0,10"/>

                    <TextBlock Text="Rib width (mm):" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtAncho" Style="{DynamicResource FieldBox}" Margin="0,0,0,10"/>

                    <TextBlock Text="Total depth (mm):" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtCanto" Style="{DynamicResource FieldBox}" Margin="0,0,0,10"/>

                    <TextBlock Text="Compression slab (mm):" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Name="TxtLosa" Style="{DynamicResource FieldBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Slab area" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                    <RadioButton Name="RbRect" Content="Rectangular area" GroupName="Area" IsChecked="True"/>
                    <RadioButton Name="RbLines" Content="Select existing lines" GroupName="Area"/>

                    <Button Name="BtnCreate" Content="CREATE WAFFLE SLAB"
                            Style="{DynamicResource ActionButton}"
                            Click="Create_Click" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Preview + Log -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Live Preview — 5 × 5 m example" FontWeight="Bold"
                       FontSize="13" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>

            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Background="White" CornerRadius="4">
                <Canvas Name="InlinePreviewCanvas" ClipToBounds="True"/>
            </Border>

            <TextBlock Grid.Row="2" Name="TxtPreviewDims" FontSize="10"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"
                       Margin="0,4,0,8" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="3" Text="Output log" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

            <TextBox Grid.Row="4" Name="TxtLog" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderBrush="{DynamicResource BorderColor}" Padding="8"/>

            <Grid Grid.Row="4" Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                <Border Background="White" CornerRadius="6" Padding="24,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Creating waffle slab..." HorizontalAlignment="Center" FontSize="13"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}" Margin="0,12,0,0"/>
                        <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
