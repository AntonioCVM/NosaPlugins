<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element Join v2.0" Height="760" Width="1160"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="border" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter TargetName="border" Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SmallButton">
            <Setter Property="Background"      Value="#F0F0F0"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextColor}"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="MinWidth"        Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PickButton">
            <Setter Property="Background"      Value="#1A1A1A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="230" MaxWidth="380"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,12">
                <TextBlock Text="ELEMENT JOIN" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Priority-Aware Join System" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <!-- Tab navigation -->
            <StackPanel Grid.Row="1">
                <Button Name="BtnTabJoin"     Content="Join / Unjoin"    Tag="Selected"
                        Style="{DynamicResource NavButton}" Click="TabJoin_Click"/>
                <Button Name="BtnTabPriority" Content="Priority Order"
                        Style="{DynamicResource NavButton}" Click="TabPriority_Click"/>
                <Button Name="BtnTabManual"   Content="Manual Pick"
                        Style="{DynamicResource NavButton}" Click="TabManual_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>

                <!-- ─── TAB: Join / Unjoin ─── -->
                <StackPanel Name="PanelTabJoin" Margin="14,10,14,10">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Operation" Style="{StaticResource SectionTitle}"/>
                            <RadioButton Name="RbJoin"        Content="Join (priority order)" IsChecked="True"  GroupName="Op"/>
                            <RadioButton Name="RbJoinSimple"  Content="Join (no order fix)"   IsChecked="False" GroupName="Op"/>
                            <RadioButton Name="RbUnjoin"      Content="Unjoin"                IsChecked="False" GroupName="Op"/>
                            <RadioButton Name="RbSwap"        Content="Swap order"            IsChecked="False" GroupName="Op"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Categories" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Name="ChkFloors"      Content="Floors"      IsChecked="True"/>
                            <CheckBox Name="ChkFraming"     Content="Framing"     IsChecked="True"/>
                            <CheckBox Name="ChkColumns"     Content="Columns"     IsChecked="True"/>
                            <CheckBox Name="ChkWalls"       Content="Walls"       IsChecked="False"/>
                            <CheckBox Name="ChkFoundations" Content="Foundations" IsChecked="False"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Scope" Style="{StaticResource SectionTitle}"/>
                            <RadioButton Name="RbAll"       Content="All elements"        IsChecked="True"  GroupName="Scope"/>
                            <RadioButton Name="RbSelection" Content="Current selection"   IsChecked="False" GroupName="Scope"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Proximity tolerance (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <TextBox Name="TxtTolerance" Text="50" Height="28" Padding="6,4" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                            <CheckBox Name="ChkFixExisting" Content="Fix existing wrong-order joins"
                                      IsChecked="True" Margin="0,10,0,0"/>
                            <CheckBox Name="ChkDarkMode"    Content="Dark Mode"
                                      Click="Theme_Toggled" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─── TAB: Priority Order ─── -->
                <StackPanel Name="PanelTabPriority" Margin="14,10,14,10" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Join Priority" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                       Text="Top = dominant (cuts elements below it). Use ▲ ▼ to reorder."/>

                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,0,10">
                                <ListBox Name="LstPriority" SelectionMode="Single"
                                         Background="Transparent" BorderThickness="0"
                                         FontSize="13">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,4">
                                                <TextBlock Text="{Binding Rank}" FontSize="11" Width="24"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,14">
                                <Button Content="▲  Up"   Name="BtnMoveUp"   Click="MoveUp_Click"
                                        Style="{DynamicResource SmallButton}" Margin="0,0,8,0"/>
                                <Button Content="▼  Down" Name="BtnMoveDown" Click="MoveDown_Click"
                                        Style="{DynamicResource SmallButton}"/>
                            </StackPanel>

                            <Button Content="Reset to Default" Name="BtnResetPriority"
                                    Click="ResetPriority_Click" Style="{DynamicResource SecondaryButton}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─── TAB: Manual Pick ─── -->
                <StackPanel Name="PanelTabManual" Margin="14,10,14,10" Visibility="Collapsed">
                    <TextBlock Text="Manual Join" Style="{StaticResource SectionTitle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextColor}" Opacity="0.7"
                               Text="Pick two elements. Element A will cut Element B."/>

                    <Border Background="#FFF4EE" BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Element A  (dominant — cuts B)" FontSize="11"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentColor}"
                                       Margin="0,0,0,6"/>
                            <Button Content="Pick Element A" Click="PickA_Click"
                                    Style="{DynamicResource PickButton}" HorizontalAlignment="Left"
                                    Margin="0,0,0,6"/>
                            <TextBlock Name="TxtPickedA" Text="A: (none)" FontSize="10"
                                       Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EEF4FF" BorderBrush="#1A6FCF"
                            BorderThickness="1" CornerRadius="8" Padding="12,10"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Element B  (subordinate)" FontSize="11"
                                       FontWeight="Bold" Foreground="#1A6FCF" Margin="0,0,0,6"/>
                            <Button Content="Pick Element B" Click="PickB_Click"
                                    Style="{DynamicResource PickButton}" HorizontalAlignment="Left"
                                    Margin="0,0,0,6"/>
                            <TextBlock Name="TxtPickedB" Text="B: (none)" FontSize="10"
                                       Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Operation" Style="{StaticResource SectionTitle}"/>
                            <RadioButton Name="RbManualJoin"   Content="Join A cuts B" IsChecked="True"  GroupName="ManualOp"/>
                            <RadioButton Name="RbManualUnjoin" Content="Unjoin"        IsChecked="False" GroupName="ManualOp"/>
                            <RadioButton Name="RbManualSwap"   Content="Swap order"    IsChecked="False" GroupName="ManualOp"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- Bottom actions -->
            <Button Grid.Row="3" Content="RUN" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="4" Content="Select in Model" Name="BtnSelect"
                    Click="Select_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,8" IsEnabled="False"/>
            <Button Grid.Row="5" Content="Export CSV" Name="BtnExport"
                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Summary pills -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#DDFFDD" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtJoined"  Text="0 joined"    FontSize="11" Foreground="#226622" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#E8F0FF" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtFixed"   Text="0 fixed"     FontSize="11" Foreground="#1A6FCF" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtFailed"  Text="0 failed"    FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                    <TextBlock Name="TxtSkipped" Text="0 skipped"   FontSize="11" Foreground="#666666" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- Results DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                <DataGrid Name="GridResults"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status"      Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Category A"  Binding="{Binding Cat1}"   Width="90"/>
                        <DataGridTextColumn Header="Element A"   Binding="{Binding Name1}"  Width="180"/>
                        <DataGridTextColumn Header="Category B"  Binding="{Binding Cat2}"   Width="90"/>
                        <DataGridTextColumn Header="Element B"   Binding="{Binding Name2}"  Width="180"/>
                        <DataGridTextColumn Header="Note"        Binding="{Binding Msg}"    Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                    <Setter Property="Background" Value="#12CC0000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="joined">
                                    <Setter Property="Background" Value="#10009900"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="fixed">
                                    <Setter Property="Background" Value="#10003399"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Loading overlay -->
            <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Processing joins..." HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="240" Height="12"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextColor}"
                               Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
