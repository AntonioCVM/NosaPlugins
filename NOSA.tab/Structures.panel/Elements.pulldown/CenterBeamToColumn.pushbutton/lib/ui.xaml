<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align Element to Column" Height="580" Width="820"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background"      Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CountLabel">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CountValue">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin"     Value="0,2"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,24,20,12">
                <TextBlock Text="ALIGN TO COLUMN" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Beams, ground beams and pilecaps" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,4,14,10">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Selection" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Beams"        Style="{StaticResource CountLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtBeams"       Text="0" Style="{StaticResource CountValue}"/>
                                <TextBlock Grid.Row="1" Text="Ground beams" Style="{StaticResource CountLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtGroundBeams" Text="0" Style="{StaticResource CountValue}"/>
                                <TextBlock Grid.Row="2" Text="Pilecaps"     Style="{StaticResource CountLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtPilecaps"    Text="0" Style="{StaticResource CountValue}"/>
                                <TextBlock Grid.Row="3" Text="Columns"      Style="{StaticResource CountLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtColumns"     Text="0" Style="{StaticResource CountValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Options" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Name="ChkBothEnds">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Align both ends of beams / ground beams (each to its closest column)"/>
                            </CheckBox>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="20,0,0,8"
                                       Foreground="{DynamicResource TextColor}"
                                       Text="Unticked: align only the end closest to a column."/>
                            <TextBlock Text="Maximum distance (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,4,0,4"/>
                            <TextBox Name="TxtMaxDistance" Text="1000" Height="28" Padding="6,4" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource BorderColor}"/>
                            <CheckBox Name="ChkDarkMode" Content="Dark mode"
                                      Click="Theme_Toggled" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Button Name="BtnAlign" Content="ALIGN" Click="Align_Click"
                        Style="{DynamicResource ActionButton}" Margin="0,0,0,8"/>
                <Button Name="BtnCancel" Content="Cancel" Click="Cancel_Click"
                        Style="{DynamicResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ PREVIEW ═══ -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Preview of alignments" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Name="TxtSummary" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.75"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                <DataGrid Name="GridPreview"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Element"       Binding="{Binding Element}"  Width="100"/>
                        <DataGridTextColumn Header="ID"            Binding="{Binding ElemId}"   Width="80"/>
                        <DataGridTextColumn Header="End"           Binding="{Binding End}"      Width="45"/>
                        <DataGridTextColumn Header="Column"        Binding="{Binding Column}"   Width="80"/>
                        <DataGridTextColumn Header="Distance (mm)" Binding="{Binding Distance}" Width="100"/>
                        <DataGridTextColumn Header="Action"        Binding="{Binding Action}"   Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding is_skip}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                <Border Background="White" CornerRadius="6" Padding="24,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="10" Margin="0,8,0,0"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
