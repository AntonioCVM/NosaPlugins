<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Clash Viewer" Height="840" Width="1200"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CLASH VIEWER" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtFileInfo" Text="Load a Navisworks clash report (.xlsm) to start."
                               FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.65"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Name="BtnLoad" Content="Load report…" Click="Load_Click"
                        Style="{DynamicResource ActionButton}" Padding="20,9" Margin="12,0,16,0"
                        ToolTip="Open a clash report exported from Navisworks (.xlsm / .xlsx)"/>
                <CheckBox Grid.Column="2" Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= SUMMARY ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,6">
            <Expander Name="ExpSummary" Header="Summary by test" IsExpanded="False" FontWeight="SemiBold" FontSize="13"
                      Foreground="{DynamicResource TextColor}">
                <DataGrid Name="GridSummary" FontWeight="Normal" FontSize="12" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="190" Margin="0,8,0,4"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Test" Binding="{Binding Test}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="70"/>
                        <DataGridTextColumn Header="New" Binding="{Binding New}" Width="70"/>
                        <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="70"/>
                        <DataGridTextColumn Header="Reviewed" Binding="{Binding Reviewed}" Width="80"/>
                        <DataGridTextColumn Header="Approved" Binding="{Binding Approved}" Width="80"/>
                        <DataGridTextColumn Header="Resolved" Binding="{Binding Resolved}" Width="80"/>
                        <DataGridTextColumn Header="% Closed" Binding="{Binding Closed}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="340"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: filters + tree -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="SEARCH" Style="{StaticResource Caption}"/>
                        <TextBox Name="TxtSearch" Style="{StaticResource FieldBox}"
                                 ToolTip="Clash name, Element Id, tag, family, category or assignee"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                            <TextBlock Text="TEST" Style="{StaticResource Caption}"/>
                            <ComboBox Name="CboTest"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                            <TextBlock Text="ASSIGNED TO" Style="{StaticResource Caption}"/>
                            <ComboBox Name="CboAssigned"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                            <TextBlock Text="CATEGORY" Style="{StaticResource Caption}"/>
                            <ComboBox Name="CboCategory"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                            <TextBlock Text="MODEL" Style="{StaticResource Caption}"/>
                            <ComboBox Name="CboModel" ToolTip="Show clashes where either element belongs to this model"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="REVIEW" Style="{StaticResource Caption}"/>
                            <ComboBox Name="CboReview" ToolTip="Filter by the Done tick kept by the team"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="STATUS" Style="{StaticResource Caption}"/>
                        <WrapPanel>
                            <CheckBox Name="ChkNew" Margin="0,0,12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#FF5F00" Margin="0,0,4,0"/>
                                    <TextBlock Text="New" Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Name="ChkActive" Margin="0,0,12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#D32F2F" Margin="0,0,4,0"/>
                                    <TextBlock Text="Active" Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Name="ChkReviewed" Margin="0,0,12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#1976D2" Margin="0,0,4,0"/>
                                    <TextBlock Text="Reviewed" Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Name="ChkApproved" Margin="0,0,12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#2EAA4A" Margin="0,0,4,0"/>
                                    <TextBlock Text="Approved" Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Name="ChkResolved" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#9E9E9E" Margin="0,0,4,0"/>
                                    <TextBlock Text="Resolved" Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </CheckBox>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Name="TxtCount" Text="" Style="{StaticResource Caption}" Margin="0,2,0,6"/>

                    <TreeView Grid.Row="4" Name="TreeClashes" Background="Transparent"
                              Foreground="{DynamicResource TextColor}"
                              BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#55FF5F00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#40FF5F00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF5F00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF5F00"/>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- RIGHT: detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <Border Background="{DynamicResource BgColor}" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="6" MinHeight="120" Margin="0,0,0,12">
                            <Grid>
                                <Image Name="ImgClash" MaxHeight="240" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                                <TextBlock Name="TxtNoImage" Text="No image for this clash"
                                           Style="{DynamicResource HintText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Name="TxtDetTitle" Text="Select a clash" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Name="TxtDetSub" Text="" Style="{DynamicResource HintText}" Margin="0,2,0,10"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="STATUS" Style="{StaticResource Caption}" Margin="0,3,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtDetStatus" Style="{StaticResource Value}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="ASSIGNED TO" Style="{StaticResource Caption}" Margin="0,3,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtDetAssigned" Style="{StaticResource Value}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="DATE APPROVED" Style="{StaticResource Caption}" Margin="0,3,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtDetDate" Style="{StaticResource Value}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Text="CLASH POINT (MM)" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtDetPoint" Style="{StaticResource Value}"/>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
                            <StackPanel>
                                <CheckBox Name="ChkMarkDone" Click="MarkDone_Click" IsEnabled="False"
                                          Content="Done (ticked by the team, kept next to the report)"
                                          Foreground="{DynamicResource TextColor}"
                                          ToolTip="Mark this clash as dealt with. Ctrl+D toggles it for the selected clash."/>
                                <TextBlock Name="TxtDoneInfo" Style="{DynamicResource HintText}" Margin="22,2,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="NOTE" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                <TextBox Name="TxtNote" Style="{StaticResource FieldBox}" Height="Auto" MinHeight="54"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" IsEnabled="False"
                                         ToolTip="Free text kept with the clash (saved when you leave the box) and printed in the report"/>
                                <TextBlock Name="TxtNoteInfo" Style="{DynamicResource HintText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GEOMETRY RE-CHECK" Style="{StaticResource Caption}"/>
                                    <TextBlock Name="TxtCheck" Style="{StaticResource Value}" FontWeight="SemiBold"
                                               Text="Not checked yet"/>
                                </StackPanel>
                                <Button Grid.Column="1" Name="BtnRecheck" Content="Re-check" Click="Recheck_Click"
                                        IsEnabled="False" VerticalAlignment="Center" Margin="10,0,0,0"
                                        ToolTip="Intersect the two elements as they are in the model now (indicative)"/>
                            </Grid>
                        </Border>
                        <Border Name="CardItem1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10"
                                BorderThickness="6,1,1,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Name="TxtItem1Head" Text="ITEM 1" Style="{StaticResource Caption}"/>
                                    <TextBlock Name="TxtItem1Info" Style="{StaticResource Value}"/>
                                    <TextBlock Name="TxtItem1State" Style="{StaticResource Value}" FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Name="BtnSelect1" Content="Select" Click="Select1_Click"
                                        VerticalAlignment="Top" Margin="10,0,0,0" IsEnabled="False"
                                        ToolTip="Select only this element in Revit and zoom to it"/>
                            </Grid>
                        </Border>
                        <Border Name="CardItem2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10"
                                BorderThickness="6,1,1,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Name="TxtItem2Head" Text="ITEM 2" Style="{StaticResource Caption}"/>
                                    <TextBlock Name="TxtItem2Info" Style="{StaticResource Value}"/>
                                    <TextBlock Name="TxtItem2State" Style="{StaticResource Value}" FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Name="BtnSelect2" Content="Select" Click="Select2_Click"
                                        VerticalAlignment="Top" Margin="10,0,0,0" IsEnabled="False"
                                        ToolTip="Select only this element in Revit and zoom to it"/>
                            </Grid>
                        </Border>
                        <TextBlock Name="TxtDetWarn" Style="{StaticResource Value}" Foreground="#C77700"
                                   Margin="0,0,0,10"/>

                        <Expander Header="View settings" Foreground="{DynamicResource TextColor}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="SECTION BOX MARGIN (M)" Style="{StaticResource Caption}"/>
                                    <TextBox Name="TxtMargin" Style="{StaticResource FieldBox}"
                                             ToolTip="Margin added around both elements"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="LIMIT TO CLASH AREA (M, 0 = OFF)" Style="{StaticResource Caption}"/>
                                    <TextBox Name="TxtCrop" Style="{StaticResource FieldBox}"
                                             ToolTip="Crops the section box around the clash point for very long elements"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="ITEM 1 COLOUR (#RRGGBB)" Style="{StaticResource Caption}"/>
                                    <TextBox Name="TxtColour1" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="ITEM 2 COLOUR (#RRGGBB)" Style="{StaticResource Caption}"/>
                                    <TextBox Name="TxtColour2" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <CheckBox Name="ChkAutoCheck" Content="Re-check the geometry automatically when a clash is selected"
                                              Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                    <CheckBox Name="ChkProxies" Content="Highlight linked and CAD items with temporary copies"
                                              Foreground="{DynamicResource TextColor}"
                                              ToolTip="Revit cannot colour or isolate one element of a link. Temporary Generic Model copies are made in this project and removed on Reset, on the next clash and when the window closes."/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= ACTIONS ================= -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="BtnPrev" Content="◀ Previous" Click="Prev_Click" Margin="0,0,6,0"
                            ToolTip="Previous clash in the list (Ctrl+Left)"/>
                    <Button Name="BtnNext" Content="Next ▶" Click="Next_Click" Margin="0,0,12,0"
                            ToolTip="Next clash in the list (Ctrl+Right)"/>
                    <Button Name="BtnGoto" Content="Go to clash" Click="Goto_Click"
                            Style="{DynamicResource ActionButton}" Padding="22,9" Margin="0,0,6,0"
                            ToolTip="Select, isolate and zoom to the clash in the 3D view (Enter or double-click)"/>
                    <Button Name="BtnReset" Content="Reset view" Click="Reset_Click"
                            ToolTip="Remove isolation, colours and section box from the clash view"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="12,0">
                    <CheckBox Name="ChkIsolate" Content="Isolate" Margin="0,0,14,0"
                              ToolTip="Hide everything except the two elements"/>
                    <CheckBox Name="ChkPermanent" Content="Permanent" Margin="0,0,14,0"
                              ToolTip="Make the isolation permanent in the clash view"/>
                    <CheckBox Name="ChkDim" Content="Dim the rest" Margin="0,0,14,0"
                              ToolTip="When not isolating, show other elements halftone"/>
                    <CheckBox Name="ChkKeepCam" Content="Keep camera"
                              ToolTip="Do not reorient the 3D view on each clash"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Name="BtnReport" Content="Report…" Click="Report_Click" Margin="0,0,6,0"
                            ToolTip="HTML report of the clashes in the list: the Navisworks picture next to the one taken from Revit now"/>
                    <Button Name="BtnExport" Content="Export list…" Click="Export_Click"
                            ToolTip="Save the filtered list with its Revit location state to CSV"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Name="TxtInfo" Text="" Style="{DynamicResource HintText}" Margin="4,8,0,0"
                   TextWrapping="Wrap"/>

        <!-- ================= LOADING ================= -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" Margin="0,8,0,0"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"
                               Margin="0,8,0,0"/>
                    <Button Name="BtnCancelBusy" Content="Cancel" Click="CancelBusy_Click" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
