<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA QR Code Generator v1.4"
        Height="680" Width="460"
        MinHeight="620" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SubText"     Color="#888888"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"   Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontFamily"   Value="Century Gothic"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Padding"      Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E05500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontFamily"    Value="Century Gothic"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Padding"       Value="0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0FFF5F00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="FontFamily"    Value="Century Gothic"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"    Value="White"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding"       Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header           -->
            <RowDefinition Height="16"/>     <!-- spacer           -->
            <RowDefinition Height="Auto"/>   <!-- URL label        -->
            <RowDefinition Height="Auto"/>   <!-- URL input        -->
            <RowDefinition Height="14"/>     <!-- spacer           -->
            <RowDefinition Height="40"/>     <!-- Generate button  -->
            <RowDefinition Height="14"/>     <!-- spacer           -->
            <RowDefinition Height="*"/>      <!-- Preview          -->
            <RowDefinition Height="12"/>     <!-- spacer           -->
            <RowDefinition Height="Auto"/>   <!-- Bottom bar       -->
            <RowDefinition Height="12"/>     <!-- spacer           -->
            <RowDefinition Height="Auto"/>   <!-- Titleblock bar   -->
            <RowDefinition Height="Auto"/>   <!-- Dark mode        -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="QR CODE GENERATOR"
                       FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <WrapPanel Margin="0,6,0,0">
                <!-- Badge: size -->
                <Border Background="#FFF0E6" CornerRadius="10" Padding="7,3" Margin="0,0,5,0">
                    <TextBlock Text="24 × 24 mm"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentColor}"/>
                </Border>
                <!-- Badge: DPI -->
                <Border Background="#FFF0E6" CornerRadius="10" Padding="7,3" Margin="0,0,5,0">
                    <TextBlock Text="1200 dpi"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentColor}"/>
                </Border>
                <!-- Badge: supersampling -->
                <Border Background="#F0F0F0" CornerRadius="10" Padding="7,3" Margin="0,0,5,0">
                    <TextBlock Text="2× supersampling"
                               FontSize="10"
                               Foreground="{DynamicResource SubText}"/>
                </Border>
                <!-- Badge: format -->
                <Border Background="#F0F0F0" CornerRadius="10" Padding="7,3">
                    <TextBlock Text="PNG · M error correction"
                               FontSize="10"
                               Foreground="{DynamicResource SubText}"/>
                </Border>
            </WrapPanel>
        </StackPanel>

        <!-- ── URL label ──────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2"
                   Text="URL / Content to encode"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"
                   Margin="0,0,0,5"/>

        <!-- ── URL input ──────────────────────────────────────────────── -->
        <TextBox Grid.Row="3" Name="TxtUrl"
                 Style="{DynamicResource InputBox}"
                 Height="36"
                 Text="https://"
                 KeyDown="TxtUrl_KeyDown"/>

        <!-- ── Generate button ────────────────────────────────────────── -->
        <Button Grid.Row="5" Name="BtnGenerate"
                Content="Generate QR Code"
                Style="{DynamicResource ActionButton}"
                Click="Generate_Click"/>

        <!-- ── Preview area ───────────────────────────────────────────── -->
        <Border Grid.Row="7" Style="{StaticResource Card}" Padding="1">
            <Grid>
                <TextBlock Name="TxtPlaceholder"
                           Text="Preview will appear here after generating"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SubText}"
                           FontSize="11"/>

                <!-- Checkerboard hint for transparency -->
                <Rectangle Name="RectChecker"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="200" Height="200"
                           Visibility="Collapsed">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,10,10"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#CCCCCC">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,10,10"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="White">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,5,5"/>
                                                <RectangleGeometry Rect="5,5,5,5"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Image Name="PreviewImage"
                       MaxWidth="260" MaxHeight="260"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ── Bottom bar (status + Save PNG) ───────────────────────── -->
        <Border Grid.Row="9" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="TxtStatus"
                           Grid.Column="0"
                           Text=""
                           FontSize="10"
                           Foreground="{DynamicResource SubText}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="2" Name="BtnSave"
                        Content="  Save PNG  "
                        Style="{DynamicResource SecondaryButton}"
                        Height="32" MinWidth="90"
                        IsEnabled="False"
                        Click="Save_Click"/>
            </Grid>
        </Border>

        <!-- ── Place in Titleblocks bar ──────────────────────────────── -->
        <Border Grid.Row="11" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info text -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Place in Titleblocks"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock Name="TxtTBStatus"
                               Text="Updates every titleblock family in the project"
                               FontSize="10"
                               Foreground="{DynamicResource SubText}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2" Name="BtnPlaceTB"
                        Content="  Place in Titleblocks  "
                        Style="{DynamicResource ActionButton}"
                        Height="32" MinWidth="150"
                        IsEnabled="False"
                        Click="PlaceTitleblocks_Click"/>
            </Grid>
        </Border>

        <CheckBox Grid.Row="12" Name="ChkDarkMode" Content="Dark Mode"
                  Click="Theme_Toggled" Margin="0,12,0,0"
                  Foreground="{DynamicResource TextColor}"/>
    </Grid>
</Window>
