<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing Check — NOSA protocol and content" Height="620" Width="980"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E3E3E3"/>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Name="TxtTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
            <TextBlock Name="TxtSubtitle" FontSize="12" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextColor}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="BtnExportAll" Content="Export all" Click="ExportAll_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button Name="BtnExportCompliant" Content="Export compliant only" Click="ExportCompliant_Click"
                    Padding="16,8" Margin="0,0,8,0" Background="{DynamicResource AccentColor}" Foreground="White"/>
            <Button Name="BtnCancel" Content="Cancel" Click="Cancel_Click" Padding="16,8"/>
        </StackPanel>

        <DataGrid Name="GridFindings" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" BorderBrush="{DynamicResource BorderColor}"
                  Background="{DynamicResource PanelColor}" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="220"/>
                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="100"/>
                <DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
