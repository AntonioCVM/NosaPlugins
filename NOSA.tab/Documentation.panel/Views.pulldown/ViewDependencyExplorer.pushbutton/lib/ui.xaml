<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Dependency Explorer" Height="560" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background"   Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Padding"      Value="16,7"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource AccentColor}"/>
            <Setter Property="Padding"      Value="14,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowBackground"            Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="RowHeight"                Value="28"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextColor}"/>
            <Setter Property="ColumnHeaderHeight"       Value="30"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="View Dependency Explorer" FontSize="15" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text=" — template · filters · sheets · revisions · dependents"
                               FontSize="11" Foreground="White" Opacity="0.75"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Name="ChkDarkMode" Content="Dark" Foreground="White"
                          VerticalAlignment="Center" Click="Theme_Toggled"/>
            </Grid>
        </Border>

        <!-- Main body -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: view list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SELECT VIEW" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" Margin="0,0,0,6"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="4">
                    <ListBox Name="ViewList" BorderThickness="0" Background="Transparent"
                             FontSize="11" Foreground="{DynamicResource TextColor}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <Button Grid.Row="2" Content="▶  Analyse" Style="{DynamicResource ActionBtn}"
                        Margin="0,8,0,0" HorizontalAlignment="Stretch"
                        Click="Analyse_Click"/>
            </Grid>

            <!-- Right: dependency grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DEPENDENCIES" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" Margin="0,0,0,6"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="4">
                    <DataGrid Name="DepGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type"   Binding="{Binding DepType}" Width="90"/>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"    Width="1*"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}"  Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="TxtResult" Text="Select a view and click Analyse."
                       FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Style="{DynamicResource SecBtn}"
                    Click="Close_Click"/>
        </Grid>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Analysing…" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10" Margin="0,10,0,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
