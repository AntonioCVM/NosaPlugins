<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Organiser" Height="680" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding"    Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Background="{DynamicResource AccentColor}"/>
                    <TextBlock Text="View Organiser" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Name="TxtSummary" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Content="Close" Style="{StaticResource SecBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls -->
            <Border Grid.Column="0" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">
                        <TextBlock Text="Filter by type" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                        <ComboBox Name="CboViewType" FontSize="11" Margin="0,0,0,10"
                                  SelectionChanged="ViewType_Changed"/>
                        <CheckBox Name="ChkUnplacedOnly" Content="Unplaced only"
                                  FontSize="11" Foreground="{DynamicResource TextColor}"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"
                                  Margin="0,0,0,14"/>

                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="Rename mode" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                        <RadioButton Name="RbFindReplace" Content="Find &amp; Replace"
                                     GroupName="Mode" Checked="Mode_Changed"/>
                        <RadioButton Name="RbPrefixSuffix" Content="Add Prefix / Suffix"
                                     GroupName="Mode" Checked="Mode_Changed"/>

                        <StackPanel Name="PnlFindReplace" Margin="0,10,0,0">
                            <TextBlock Text="Find:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtFind" Style="{StaticResource FieldBox}" Margin="0,0,0,8"
                                     TextChanged="Rule_Changed"/>
                            <TextBlock Text="Replace with:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtReplace" Style="{StaticResource FieldBox}"
                                     TextChanged="Rule_Changed"/>
                        </StackPanel>

                        <StackPanel Name="PnlPrefixSuffix" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Prefix:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtPrefix" Style="{StaticResource FieldBox}" Margin="0,0,0,8"
                                     TextChanged="Rule_Changed"/>
                            <TextBlock Text="Suffix:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtSuffix" Style="{StaticResource FieldBox}"
                                     TextChanged="Rule_Changed"/>
                        </StackPanel>

                        <Separator Margin="0,16,0,12"/>
                        <Button Content="SELECT ALL" Style="{StaticResource SecBtn}"
                                Click="SelectAll_Click" Margin="0,0,0,6"/>
                        <Button Content="RENAME SELECTED" Style="{StaticResource ActionBtn}"
                                Click="RenameSelected_Click" Margin="0,0,0,6"/>
                        <Button Content="DELETE SELECTED" Style="{StaticResource SecBtn}"
                                Click="DeleteSelected_Click" Margin="0,0,0,6"/>
                        <Button Content="DELETE ALL UNPLACED" Style="{StaticResource SecBtn}"
                                Click="DeleteUnplaced_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- View grid -->
            <Grid Grid.Column="1" Margin="12,12,12,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Views — select rows to act on"
                           FontWeight="Bold" FontSize="12"
                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" Name="GridViews"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          AlternatingRowBackground="#06000000"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="False" FontSize="11"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="View name"   Binding="{Binding Name}"    Width="*"/>
                        <DataGridTextColumn Header="New name"    Binding="{Binding NewName}" Width="*"/>
                        <DataGridTextColumn Header="Type"        Binding="{Binding Vtype}"   Width="110"/>
                        <DataGridTextColumn Header="Level"       Binding="{Binding Level}"   Width="90"/>
                        <DataGridTextColumn Header="Placed"      Binding="{Binding Placed}"  Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Border>

        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" Background="#CCFAFAFA"
              Panel.ZIndex="100">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Applying changes..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
