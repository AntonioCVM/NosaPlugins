<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align View Titles v3.0" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Configuration -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,20,20,10">
                <TextBlock Text="ALIGN TITLES" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Standardize Locations" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,20">
                    
                    <!-- Reference -->
                    <TextBlock Text="1. Reference Viewport" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>
                    <Button Name="BtnPickRef" Content="Pick Reference..." Height="30" Click="PickRef_Click" Background="#EEE" Foreground="#333" BorderThickness="1" BorderBrush="#CCC"/>
                    <StackPanel Name="PanelRefInfo" Visibility="Collapsed" Margin="0,5,0,0">
                        <TextBlock Name="TxtRefView" Text="View Name" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Name="TxtRefScale" Text="Scale 1:50" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
                    </StackPanel>
                    
                    <Separator Margin="0,15"/>

                    <!-- Alignment Mode -->
                    <TextBlock Text="2. Alignment Mode" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,5"/>
                    <ComboBox Name="ComboMode" SelectedIndex="0" Margin="0,0,0,5">
                        <ComboBoxItem Content="Same as Reference"/>
                        <ComboBoxItem Content="Left"/>
                        <ComboBoxItem Content="Center"/>
                        <ComboBoxItem Content="Right"/>
                    </ComboBox>
                    
                    <CheckBox Name="ChkVertical" Content="Align Vertical Position" Foreground="{DynamicResource TextColor}" Margin="0,5"/>
                    
                    <Separator Margin="0,15"/>
                    
                    <!-- Filters -->
                    <TextBlock Text="3. Filter Sheets" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,5"/>
                    <CheckBox Name="ChkFilterSheets" Content="Filter by Sheet Set" Checked="Filter_Toggled" Unchecked="Filter_Toggled" Foreground="{DynamicResource TextColor}"/>

                    <ListBox Name="ListSheetSets" Height="100" Margin="0,5,0,0" Visibility="Collapsed" SelectionMode="Multiple" BorderBrush="{DynamicResource BorderColor}"/>

                    <Separator Margin="0,16,0,8"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Foreground="{DynamicResource TextColor}"
                              Click="Theme_Toggled"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Refresh Button -->
            <Button Grid.Row="3" Content="PREVIEW MATCHES" Name="BtnPreview" Click="Preview_Click" Style="{DynamicResource ActionButton}" Margin="20"/>
        </Grid>

        <!-- Main Content: Preview -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15" Orientation="Horizontal">
                <TextBlock Text="Matching Viewports" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                <TextBlock Name="TxtCount" Text="0 found" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
            </StackPanel>

            <!-- Data Grid -->
            <DataGrid Name="GridPreview" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      AlternatingRowBackground="#10000000" Background="Transparent" 
                      BorderBrush="{DynamicResource BorderColor}" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sheet" Binding="{Binding SheetNumber}" Width="80"/>
                    <DataGridTextColumn Header="View Name" Binding="{Binding ViewName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="APPLY ALIGNMENT" Name="BtnApply" Click="Apply_Click" Style="{DynamicResource ActionButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
