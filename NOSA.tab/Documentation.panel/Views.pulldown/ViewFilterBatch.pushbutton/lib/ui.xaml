<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViewFilter Batch v1.0" Height="720" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CC3333"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#CC3333"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="TextBox" x:Key="SearchBox">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Padding"        Value="6,4"/>
            <Setter Property="Height"         Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="FILTER" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="BATCH" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtStatusBar" Text="Ready" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Mode tabs -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <TextBlock Text="Mode" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                    <RadioButton Name="RbCopy"   Content="Copy from view"   IsChecked="True"
                                 Click="Mode_Changed" GroupName="Mode"/>
                    <RadioButton Name="RbApply"  Content="Apply filter(s)"
                                 Click="Mode_Changed" GroupName="Mode"/>
                    <RadioButton Name="RbToggle" Content="Toggle visibility"
                                 Click="Mode_Changed" GroupName="Mode"/>
                    <RadioButton Name="RbRemove" Content="Remove filter(s)"
                                 Click="Mode_Changed" GroupName="Mode"/>

                    <Separator Margin="0,14,0,12"/>

                    <!-- Copy-from-view options (shown only in Copy mode) -->
                    <StackPanel Name="PanelCopyOptions">
                        <TextBlock Text="Source View" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                        <ComboBox Name="CboSourceView" Height="26" FontSize="11"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="SourceView_Changed"/>
                        <CheckBox Name="ChkIncludeOverrides" Content="Copy graphic overrides"
                                  IsChecked="True" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Filter-picker options (hidden in Copy mode) -->
                    <StackPanel Name="PanelFilterOptions" Visibility="Collapsed">
                        <TextBlock Text="Filters" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                        <TextBox Name="TxtFilterSearch" Style="{DynamicResource SearchBox}"
                                 Text="Search filters..." Foreground="Gray"
                                 GotFocus="FilterSearch_GotFocus" LostFocus="FilterSearch_LostFocus"
                                 TextChanged="FilterSearch_Changed"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                Margin="0,6,0,0" Height="180">
                            <ListBox Name="LstFilters" BorderThickness="0"
                                     Background="{DynamicResource BgColor}"
                                     SelectionMode="Extended"
                                     SelectionChanged="FilterList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextColor}"
                                                  Click="FilterCheck_Click"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="All"  Click="FilterSelectAll_Click"
                                    Style="{DynamicResource SecondaryButton}"
                                    Padding="8,4" Margin="0,0,6,0" FontSize="11"/>
                            <Button Content="None" Click="FilterSelectNone_Click"
                                    Style="{DynamicResource SecondaryButton}"
                                    Padding="8,4" FontSize="11"/>
                        </StackPanel>

                        <!-- Toggle extra options -->
                        <StackPanel Name="PanelToggleOpts" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Action" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4"/>
                            <RadioButton Name="RbEnable"  Content="Enable (show)" IsChecked="True"
                                         GroupName="Toggle"/>
                            <RadioButton Name="RbDisable" Content="Disable (hide)" GroupName="Toggle"/>
                        </StackPanel>

                        <!-- Apply-from-view overrides option -->
                        <StackPanel Name="PanelApplyOpts" Visibility="Collapsed" Margin="0,10,0,0">
                            <CheckBox Name="ChkApplyFromView" Content="Copy overrides from view"
                                      IsChecked="False" Click="ApplyFromView_Changed"/>
                            <ComboBox Name="CboApplySourceView" Height="26" FontSize="11"
                                      DisplayMemberPath="Name" Margin="0,4,0,0"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,14,0,12"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode"
                              Click="Theme_Toggled" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Button Name="BtnExecute" Content="EXECUTE" Click="Execute_Click"
                        Style="{DynamicResource ActionButton}" Margin="0,0,0,8"/>
                <TextBlock Name="TxtLastResult" Text="" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.65"/>
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + pills row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtPillViews" Text="0 views" FontSize="11"
                               Foreground="#666" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E6" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtPillFilters" Text="0 filters" FontSize="11"
                               Foreground="#FF5F00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#E8F5E9" Padding="10,4">
                    <TextBlock Name="TxtPillSelected" Text="0 selected" FontSize="11"
                               Foreground="#2E7D32" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- View search + type filter -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="TxtViewSearch" Style="{DynamicResource SearchBox}"
                         Text="Search views..." Foreground="Gray"
                         GotFocus="ViewSearch_GotFocus" LostFocus="ViewSearch_LostFocus"
                         TextChanged="ViewSearch_Changed"/>
                <ComboBox Grid.Column="1" Name="CboViewType" Width="140" Height="28"
                          Margin="8,0,0,0" FontSize="11"
                          SelectionChanged="ViewType_Changed"/>
            </Grid>

            <!-- Views list -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <DataGrid Name="GridViews"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Extended"
                              SelectionChanged="ViewGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  Click="ViewCheck_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="View Name"  Binding="{Binding Name}"     Width="*"/>
                            <DataGridTextColumn Header="Type"       Binding="{Binding ViewType}"  Width="120"/>
                            <DataGridTextColumn Header="Filters"    Binding="{Binding FilterCount}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading overlay -->
                    <Grid Name="LoadingPanel" Visibility="Collapsed"
                          Background="#AAFAFAFA" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Working..." HorizontalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                            <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                         IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom toolbar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Select All"  Click="SelectAllViews_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" FontSize="11" Padding="10,5"/>
                <Button Content="Select None" Click="SelectNoneViews_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" FontSize="11" Padding="10,5"/>
                <Button Content="Invert"      Click="InvertViews_Click"
                        Style="{DynamicResource SecondaryButton}" FontSize="11" Padding="10,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
