<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level Navigator v1.0" Height="560" Width="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,22,24,12">
            <TextBlock Text="LEVEL NAVIGATOR" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="Activate structural plan views by level" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Summary pills -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,12">
            <Border CornerRadius="12" Background="#EEF6FF" Padding="12,4" Margin="0,0,8,0">
                <TextBlock Name="TxtTotal" Text="0 levels" FontSize="11"
                           Foreground="#2255AA" FontWeight="Bold"/>
            </Border>
            <Border CornerRadius="12" Background="#FFF4EE" Padding="12,4">
                <TextBlock Name="TxtNoView" Text="0 without view" FontSize="11"
                           Foreground="#CC5500" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Double-click or select + Activate to open view"
                       FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.5"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="24,0,24,0" Padding="1">
            <Grid>
                <DataGrid Name="GridLevels"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          SelectionChanged="Grid_SelectionChanged"
                          MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="✓" Binding="{Binding StatusIcon}" Width="30">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Level"      Binding="{Binding Name}"       Width="160"/>
                        <DataGridTextColumn Header="Elevation"  Binding="{Binding Elevation}"  Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Discipline"  Binding="{Binding Discipline}" Width="110"/>
                        <DataGridTextColumn Header="View"        Binding="{Binding ViewName}"   Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasView}" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Loading overlay -->
                <Grid Name="LoadingPanel" Visibility="Collapsed"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Loading levels..." HorizontalAlignment="Center"
                                   FontSize="13" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="12"
                                     IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Refresh" Click="Refresh_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Name="BtnActivate" Content="Activate View" Click="Activate_Click"
                        Style="{DynamicResource ActionButton}" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
