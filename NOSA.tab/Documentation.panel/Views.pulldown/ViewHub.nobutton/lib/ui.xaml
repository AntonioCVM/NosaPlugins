<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Hub" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin"     Value="0,12"/>
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Background="{DynamicResource AccentColor}" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="VIEW HUB" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtViewCount" Text="—" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled" Margin="0,0,12,0"/>
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Padding="14,7"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TAB CONTROL ═══ -->
        <TabControl Grid.Row="1" Name="TabMain"
                    Background="{DynamicResource BgColor}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderColor}">

            <!-- ─── TAB 0: RENAME VIEWS ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header><TextBlock Text="  Rename Views  " Padding="4,2"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Rename Views" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>

                                <TextBlock Text="Filter views:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                <TextBox Name="TxtFilter" Style="{StaticResource FieldBox}"
                                         TextChanged="Filter_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="Rename mode:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="CboMode" Height="26" FontSize="11"
                                          SelectionChanged="Mode_Changed" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Find &amp; Replace"/>
                                    <ComboBoxItem Content="Add Prefix / Suffix"/>
                                    <ComboBoxItem Content="Case Transform"/>
                                </ComboBox>

                                <StackPanel Name="PanelFindReplace" Visibility="Visible">
                                    <TextBlock Text="Find:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtFind" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,6"/>
                                    <TextBlock Text="Replace with:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtReplace" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,6"/>
                                    <CheckBox Name="ChkCaseSensitive" Content="Case sensitive"
                                              Checked="Preview_Changed" Unchecked="Preview_Changed"
                                              Margin="0,0,0,12"/>
                                </StackPanel>

                                <StackPanel Name="PanelPrefixSuffix" Visibility="Collapsed">
                                    <TextBlock Text="Prefix:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtPrefix" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,6"/>
                                    <TextBlock Text="Suffix:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtSuffix" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,12"/>
                                </StackPanel>

                                <StackPanel Name="PanelCase" Visibility="Collapsed">
                                    <RadioButton Name="RbTitle"    Content="Title Case"    GroupName="CaseMode"
                                                 IsChecked="True" Checked="Preview_Changed"/>
                                    <RadioButton Name="RbUpper"    Content="UPPER CASE"    GroupName="CaseMode"
                                                 Checked="Preview_Changed"/>
                                    <RadioButton Name="RbLower"    Content="lower case"    GroupName="CaseMode"
                                                 Checked="Preview_Changed"/>
                                    <RadioButton Name="RbSentence" Content="Sentence case" GroupName="CaseMode"
                                                 Checked="Preview_Changed" Margin="0,2,0,12"/>
                                </StackPanel>

                                <Button Name="BtnRename" Content="RENAME SELECTED"
                                        Click="Rename_Click" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextColor}"
                                           Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0">
                                    Select rows (Ctrl/Shift). New Name column shows preview.
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
                        <DataGrid Name="GridRename" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Extended"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" FontSize="11">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChange}" Value="True">
                                            <Setter Property="Background" Value="#E8F4E8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"            Binding="{Binding RowNum}"   Width="40"/>
                                <DataGridTextColumn Header="Type"         Binding="{Binding ViewType}" Width="110"/>
                                <DataGridTextColumn Header="Current Name" Binding="{Binding Name}"     Width="*"/>
                                <DataGridTextColumn Header="New Name"     Binding="{Binding NewName}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── TAB 1: APPLY TEMPLATE ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header><TextBlock Text="  Apply Template  " Padding="4,2"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Apply Template" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>

                                <TextBlock Text="Filter views:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                <TextBox Name="TxtFilterT" Style="{StaticResource FieldBox}"
                                         TextChanged="FilterT_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="View template:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                <ComboBox Name="CboTemplate" Height="26" FontSize="10"
                                          DisplayMemberPath="Name" Margin="0,0,0,12"/>

                                <Button Name="BtnApplyTemplate" Content="APPLY TEMPLATE"
                                        Click="ApplyTemplate_Click" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <Button Name="BtnRemoveTemplate" Content="Remove Template"
                                        Click="RemoveTemplate_Click" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextColor}"
                                           Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0">
                                    Select rows in the grid then click Apply or Remove Template.
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
                        <DataGrid Name="GridTemplate"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"                Binding="{Binding RowNum}"   Width="40"/>
                                <DataGridTextColumn Header="Type"             Binding="{Binding ViewType}" Width="110"/>
                                <DataGridTextColumn Header="Name"             Binding="{Binding Name}"     Width="*"/>
                                <DataGridTextColumn Header="Current Template" Binding="{Binding Template}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: ORGANISE ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header><TextBlock Text="  Organise  " Padding="4,2"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="230" MaxWidth="330"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Filter by type" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="OrgCboViewType" FontSize="11" Margin="0,0,0,8"
                                          SelectionChanged="Org_ViewType_Changed"/>
                                <CheckBox Name="OrgChkUnplacedOnly" Content="Unplaced only"
                                          Checked="Org_Filter_Changed" Unchecked="Org_Filter_Changed"
                                          Margin="0,0,0,4"/>

                                <Separator/>
                                <TextBlock Text="Rename mode" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                <RadioButton Name="OrgRbFindReplace" Content="Find &amp; Replace"
                                             GroupName="OrgMode" Checked="Org_Mode_Changed"/>
                                <RadioButton Name="OrgRbPrefixSuffix" Content="Add Prefix / Suffix"
                                             GroupName="OrgMode" Checked="Org_Mode_Changed"/>

                                <StackPanel Name="OrgPnlFindReplace" Margin="0,10,0,0">
                                    <TextBlock Text="Find:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                    <TextBox Name="OrgTxtFind" Style="{StaticResource FieldBox}"
                                             TextChanged="Org_Rule_Changed" Margin="0,0,0,8"/>
                                    <TextBlock Text="Replace with:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                    <TextBox Name="OrgTxtReplace" Style="{StaticResource FieldBox}"
                                             TextChanged="Org_Rule_Changed"/>
                                </StackPanel>

                                <StackPanel Name="OrgPnlPrefixSuffix" Margin="0,10,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Prefix:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                    <TextBox Name="OrgTxtPrefix" Style="{StaticResource FieldBox}"
                                             TextChanged="Org_Rule_Changed" Margin="0,0,0,8"/>
                                    <TextBlock Text="Suffix:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                    <TextBox Name="OrgTxtSuffix" Style="{StaticResource FieldBox}"
                                             TextChanged="Org_Rule_Changed"/>
                                </StackPanel>

                                <Separator/>
                                <Button Content="SELECT ALL" Style="{StaticResource SecondaryButton}"
                                        Click="Org_SelectAll_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <Button Content="RENAME SELECTED" Style="{StaticResource ActionButton}"
                                        Click="Org_RenameSelected_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <Button Content="DELETE SELECTED" Style="{StaticResource SecondaryButton}"
                                        Click="Org_DeleteSelected_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <Button Content="DELETE ALL UNPLACED" Style="{StaticResource SecondaryButton}"
                                        Click="Org_DeleteUnplaced_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Name="OrgTxtSummary" FontSize="11"
                                   Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                            <DataGrid Name="OrgGridViews"
                                      AutoGenerateColumns="False" SelectionMode="Extended"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal" CanUserReorderColumns="False"
                                      FontSize="11" SelectionChanged="Org_Grid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="View name" Binding="{Binding Name}"    Width="*"/>
                                    <DataGridTextColumn Header="New name"  Binding="{Binding NewName}" Width="*"/>
                                    <DataGridTextColumn Header="Type"      Binding="{Binding Vtype}"   Width="110"/>
                                    <DataGridTextColumn Header="Level"     Binding="{Binding Level}"   Width="90"/>
                                    <DataGridTextColumn Header="Placed"    Binding="{Binding Placed}"  Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock Grid.Row="2" Name="OrgTxtStatus" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                   Margin="0,6,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ LOADING OVERLAY ═══ -->
        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{StaticResource Card}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Working..." HorizontalAlignment="Center"
                               FontSize="13" Margin="0,0,0,12"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
