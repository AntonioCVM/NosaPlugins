<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Batch Manager" Height="720" Width="1180"
        MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="560"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,25,20,16">
                <TextBlock Text="VIEW BATCH" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="MANAGER" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtViewCount" Text="—" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,10">

                    <!-- ── RENAME sidebar ── -->
                    <StackPanel Name="SidebarRename" Visibility="Visible">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Rename Views" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Filter views:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBox Name="TxtFilter" Style="{StaticResource FieldBox}"
                                         TextChanged="Filter_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="Rename mode:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="CboMode" Height="26" FontSize="11" Margin="0,0,0,12"
                                          SelectionChanged="Mode_Changed">
                                    <ComboBoxItem Content="Find &amp; Replace"/>
                                    <ComboBoxItem Content="Add Prefix / Suffix"/>
                                    <ComboBoxItem Content="Case Transform"/>
                                </ComboBox>

                                <!-- Find & Replace panel -->
                                <StackPanel Name="PanelFindReplace" Visibility="Visible">
                                    <TextBlock Text="Find:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtFind" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,8"/>
                                    <TextBlock Text="Replace with:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtReplace" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,8"/>
                                    <CheckBox Name="ChkCaseSensitive" Content="Case sensitive"
                                              Checked="Preview_Changed" Unchecked="Preview_Changed"
                                              Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- Prefix / Suffix panel -->
                                <StackPanel Name="PanelPrefixSuffix" Visibility="Collapsed">
                                    <TextBlock Text="Prefix:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtPrefix" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,8"/>
                                    <TextBlock Text="Suffix:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtSuffix" Style="{StaticResource FieldBox}"
                                             TextChanged="Preview_Changed" Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- Case Transform panel -->
                                <StackPanel Name="PanelCase" Visibility="Collapsed">
                                    <RadioButton Name="RbTitle"    Content="Title Case"   GroupName="CaseMode"
                                                 IsChecked="True" Checked="Preview_Changed"/>
                                    <RadioButton Name="RbUpper"    Content="UPPER CASE"   GroupName="CaseMode"
                                                 Checked="Preview_Changed"/>
                                    <RadioButton Name="RbLower"    Content="lower case"   GroupName="CaseMode"
                                                 Checked="Preview_Changed"/>
                                    <RadioButton Name="RbSentence" Content="Sentence case" GroupName="CaseMode"
                                                 Checked="Preview_Changed" Margin="0,3,0,12"/>
                                </StackPanel>

                                <Button Content="RENAME SELECTED" Name="BtnRename"
                                        Click="Rename_Click" Style="{StaticResource ActionButton}"
                                        Margin="0,0,0,6"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                           TextWrapping="Wrap">
                                    Select rows then click Rename. Preview shows in "New Name" column.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── TEMPLATE sidebar ── -->
                    <StackPanel Name="SidebarTemplate" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Apply Template" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Filter views:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBox Name="TxtFilterT" Style="{StaticResource FieldBox}"
                                         TextChanged="FilterT_Changed" Margin="0,0,0,12"/>

                                <TextBlock Text="View template:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <ComboBox Name="CboTemplate" Height="26" FontSize="10"
                                          DisplayMemberPath="Name" Margin="0,0,0,12"/>

                                <Button Content="APPLY TEMPLATE" Name="BtnApplyTemplate"
                                        Click="ApplyTemplate_Click" Style="{StaticResource ActionButton}"
                                        Margin="0,0,0,6"/>
                                <Button Content="Remove Template" Name="BtnRemoveTemplate"
                                        Click="RemoveTemplate_Click" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,6"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                           TextWrapping="Wrap">
                                    Select rows in the grid then click Apply or Remove Template.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <Button Content="Refresh Views" Name="BtnRefresh"
                        Click="Refresh_Click" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN TabControl ═══ -->
        <TabControl Grid.Column="2" Name="TabMain"
                    SelectionChanged="Tab_Changed"
                    Background="{DynamicResource BgColor}"
                    BorderThickness="0"
                    Margin="6,20,20,20">

            <!-- ─── Tab 1: Rename Views ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header><TextBlock Text="  Rename Views  " Padding="4,2"/></TabItem.Header>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}" Opacity="0.7"
                               Margin="0,0,0,12">
                        Configure rename mode in the sidebar. "New Name" shows the preview.
                        Select rows (Ctrl/Shift) and click Rename Selected.
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <Border Style="{StaticResource Card}" Padding="1">
                            <DataGrid Name="GridRename" AutoGenerateColumns="False"
                                      IsReadOnly="True" SelectionMode="Extended"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasChange}" Value="True">
                                                <Setter Property="Background" Value="#E8F4E8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"          Binding="{Binding RowNum}"   Width="40"  IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Type"       Binding="{Binding ViewType}" Width="110"/>
                                    <DataGridTextColumn Header="Current Name" Binding="{Binding Name}"   Width="*"/>
                                    <DataGridTextColumn Header="New Name"   Binding="{Binding NewName}"  Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <!-- Loading overlay -->
                        <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Border Background="White" CornerRadius="6" Padding="24,16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Working..." HorizontalAlignment="Center"
                                               FontSize="13" Margin="0,0,0,12"/>
                                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─── Tab 2: Apply Template ─── -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header><TextBlock Text="  Apply Template  " Padding="4,2"/></TabItem.Header>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}" Opacity="0.7"
                               Margin="0,0,0,12">
                        Select views (Ctrl/Shift), pick a template in the sidebar, then click Apply Template.
                    </TextBlock>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="GridTemplate" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Extended"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"               Binding="{Binding RowNum}"   Width="40"/>
                                <DataGridTextColumn Header="Type"            Binding="{Binding ViewType}" Width="110"/>
                                <DataGridTextColumn Header="Name"            Binding="{Binding Name}"     Width="*"/>
                                <DataGridTextColumn Header="Current Template" Binding="{Binding Template}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
