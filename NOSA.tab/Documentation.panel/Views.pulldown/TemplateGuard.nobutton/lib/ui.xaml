<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Template Compliance Guard v1.0" Height="660" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="TEMPLATE GUARD" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="View &amp; Sheet Compliance" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Rules to check" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkNoTemplate"    Content="Views without template"  IsChecked="True"/>
                            <CheckBox Name="ChkWrongScale"    Content="Non-standard scale"      IsChecked="True"/>
                            <CheckBox Name="ChkSheetNaming"   Content="Sheet naming convention" IsChecked="True"/>
                            <CheckBox Name="ChkOverrides"     Content="Manual graphic overrides" IsChecked="True"/>
                            <CheckBox Name="ChkCrop"          Content="Missing crop region"     IsChecked="True"/>
                            <CheckBox Name="ChkDetailLevel"   Content="Wrong detail level"      IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkOnlyOnSheets" Content="Only views placed on sheets"
                                      IsChecked="False" Foreground="{DynamicResource TextColor}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Filter by severity" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkSevHigh"   Content="High"   IsChecked="True"/>
                            <CheckBox Name="ChkSevMedium" Content="Medium" IsChecked="True"/>
                            <CheckBox Name="ChkSevLow"    Content="Low"    IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="RUN CHECK" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="3" Content="Edit Rules (rules.json)" Name="BtnEditRules"
                    Click="EditRules_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="4" Content="Export CSV" Name="BtnExport"
                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- MAIN -->
        <Grid Grid.Column="2" Margin="16,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stats -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtHigh"   Text="0 High"   FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtMedium" Text="0 Medium" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                    <TextBlock Name="TxtLow"    Text="0 Low"    FontSize="11" Foreground="#666666" FontWeight="Bold"/>
                </Border>
                <TextBlock Name="TxtTotal" Text="" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
            </StackPanel>

            <!-- Search -->
            <TextBox Grid.Row="1" Name="TxtSearch" Height="28" Margin="0,0,0,10"
                     Padding="6,2" VerticalContentAlignment="Center"
                     BorderBrush="{DynamicResource BorderColor}"
                     TextChanged="Search_Changed"/>

            <!-- Results grid -->
            <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="1">
                <Grid>
                    <DataGrid Name="GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="Rule"      Binding="{Binding Label}"    Width="200"/>
                            <DataGridTextColumn Header="Sheet"     Binding="{Binding Sheet}"    Width="90"/>
                            <DataGridTextColumn Header="View"      Binding="{Binding ViewName}" Width="*"/>
                            <DataGridTextColumn Header="Type"      Binding="{Binding ViewType}" Width="110"/>
                            <DataGridTextColumn Header="Detail"    Binding="{Binding Detail}"   Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading -->
                    <Grid Name="LoadingPanel" Visibility="Collapsed"
                          VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Checking views &amp; sheets..." HorizontalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                            <ProgressBar Name="ProcessBar" Width="240" Height="12" IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                       FontSize="11" Foreground="{DynamicResource TextColor}"
                                       Opacity="0.6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Select in Model" Name="BtnSelect"
                        Click="Select_Click" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,10,0" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
