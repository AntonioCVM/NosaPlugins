<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level Navigator v1.0" Height="540" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LEVEL NAVIGATOR" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  Activate structural plan views by level"
                           FontSize="11" Foreground="White" Opacity="0.75"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Summary pills -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,12,20,8">
            <Border CornerRadius="12" Background="#EEF6FF" Padding="12,4" Margin="0,0,8,0">
                <TextBlock Name="TxtTotal" Text="0 levels" FontSize="11"
                           Foreground="#2255AA" FontWeight="Bold"/>
            </Border>
            <Border CornerRadius="12" Background="#FFF4EE" Padding="12,4">
                <TextBlock Name="TxtNoView" Text="0 without view" FontSize="11"
                           Foreground="#CC5500" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Double-click or select + Activate to open view"
                       FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.5"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Name="GridLevels" Grid.Row="2" Margin="20,0,20,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="#06000000" Background="Transparent"
                  BorderBrush="{DynamicResource BorderColor}"
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="Grid_SelectionChanged"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="✓" Binding="{Binding StatusIcon}" Width="30">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Level"      Binding="{Binding Name}"       Width="160"/>
                <DataGridTextColumn Header="Elevation"  Binding="{Binding Elevation}"  Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Discipline"  Binding="{Binding Discipline}" Width="110"/>
                <DataGridTextColumn Header="View"        Binding="{Binding ViewName}"   Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasView}" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Loading overlay -->
        <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
              VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Loading levels..." HorizontalAlignment="Center"
                           FontSize="13" Margin="0,0,0,10"/>
                <ProgressBar Name="ProcessBar" Width="200" Height="12"
                             IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
            </StackPanel>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Refresh" Click="Refresh_Click"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Name="BtnActivate" Content="Activate View" Click="Activate_Click"
                        Style="{DynamicResource ActionButton}" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
