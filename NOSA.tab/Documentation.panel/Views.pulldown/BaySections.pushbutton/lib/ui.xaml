<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bay Sections — NOSA"
        Width="580" Height="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Century Gothic, Segoe UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Bay Sections" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  Auto-generate structural sections between grids"
                           Foreground="#FFD0A0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Options -->
        <Border Grid.Row="1" Background="{DynamicResource PanelColor}" Margin="8,8,8,0"
                Padding="12,10" CornerRadius="4"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Section view type:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                           Name="CmbViewType"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Name prefix:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Name="TxtPrefix"
                           Text="S" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Depth offset (mm):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="2" Grid.Column="4" Name="TxtDepthOffset"
                           Text="3000" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>

                <CheckBox  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                           Name="ChkLongitudinal" Content="Longitudinal section (along grid A)"
                           IsChecked="True" VerticalAlignment="Center"/>
                <CheckBox  Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2"
                           Name="ChkTransverse" Content="Transverse section (perpendicular)"
                           IsChecked="True" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Grid selection -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}" Margin="8,6,8,0"
                Padding="8" CornerRadius="4"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Select grid pairs (each selected pair generates sections):"
                           Margin="0,0,0,4" FontSize="11" Foreground="#666"/>
                <DataGrid Grid.Row="1" Name="GridList" AutoGenerateColumns="False"
                          CanUserAddRows="False" SelectionMode="Extended"
                          GridLinesVisibility="Horizontal" RowHeight="24" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="A" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SelA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="B" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SelB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn     Header="Grid" Binding="{Binding Name}"  Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn     Header="Type" Binding="{Binding GridType}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status log -->
        <TextBox Grid.Row="3" Name="TxtLog" Height="60" Margin="8,6,8,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="11" Foreground="#555" Background="{DynamicResource PanelColor}"
                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,8,8,0">
            <Button Name="BtnGenerate" Content="Generate Sections" Click="Generate_Click"
                    Height="30" Padding="16,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Name="BtnSelectAll" Content="Select All as A" Click="SelectAllA_Click"
                    Height="30" Padding="10,0" Margin="0,0,8,0"/>
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="5" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="8,6" Margin="0,6,0,0">
            <Button Content="Close" Click="Close_Click" Width="80"
                    HorizontalAlignment="Right"/>
        </Border>

        <!-- Loading -->
        <Grid Name="LoadingPanel" Grid.Row="0" Grid.RowSpan="6" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Generating sections..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
