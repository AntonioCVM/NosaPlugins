<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Template Manager" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VIEW TEMPLATE MANAGER" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Guard · Apply · Copy overrides" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize"     Value="12"/>
                    <Setter Property="FontFamily"   Value="Century Gothic"/>
                    <Setter Property="Padding"      Value="16,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </TabControl.Resources>

            <!-- ═══ TAB 1: GUARD ═══ -->
            <TabItem Header="Template Guard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="Rules to check" FontWeight="Bold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                                <CheckBox Name="TG_ChkNoTemplate"  Content="Views without template"   IsChecked="True"/>
                                <CheckBox Name="TG_ChkWrongScale"  Content="Non-standard scale"       IsChecked="True"/>
                                <CheckBox Name="TG_ChkSheetNaming" Content="Sheet naming convention"  IsChecked="True"/>
                                <CheckBox Name="TG_ChkOverrides"   Content="Manual graphic overrides" IsChecked="True"/>
                                <CheckBox Name="TG_ChkCrop"        Content="Missing crop region"      IsChecked="True"/>
                                <CheckBox Name="TG_ChkDetailLevel" Content="Wrong detail level"       IsChecked="True"/>
                                <Separator Margin="0,12,0,10"/>
                                <CheckBox Name="TG_ChkOnlySheets"  Content="Only views on sheets"     IsChecked="False"/>
                                <Separator Margin="0,10,0,10"/>
                                <TextBlock Text="Severity filter" FontWeight="Bold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                                <CheckBox Name="TG_ChkHigh"   Content="High"   IsChecked="True"/>
                                <CheckBox Name="TG_ChkMedium" Content="Medium" IsChecked="True"/>
                                <CheckBox Name="TG_ChkLow"    Content="Low"    IsChecked="True"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="1" Name="TG_BtnRun" Content="RUN CHECK"
                                Style="{DynamicResource ActionBtn}" Margin="16,4,16,4"
                                Click="TG_Run_Click"/>
                        <Button Grid.Row="2" Name="TG_BtnEditRules" Content="Edit rules.json"
                                Style="{DynamicResource SecBtn}" Margin="16,4,16,4"
                                Click="TG_EditRules_Click"/>
                        <Button Grid.Row="3" Name="TG_BtnExport" Content="Export CSV"
                                Style="{DynamicResource SecBtn}" Margin="16,4,16,16"
                                Click="TG_Export_Click" IsEnabled="False"/>
                    </Grid>

                    <!-- Main results -->
                    <Grid Grid.Column="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="TG_TxtHigh"   Text="0 High"   FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="TG_TxtMedium" Text="0 Medium" FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4">
                                <TextBlock Name="TG_TxtLow"    Text="0 Low"    FontSize="11" Foreground="#666" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Name="TG_TxtTotal" Text="" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Name="TG_TxtSearch" Height="28" Padding="6,2"
                                 VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 TextChanged="TG_Search_Changed"/>
                        <DataGrid Grid.Row="2" Name="TG_GridResults"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderBrush="{DynamicResource BorderColor}"
                                  GridLinesVisibility="Horizontal" SelectionMode="Single"
                                  SelectionChanged="TG_Grid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                                <DataGridTextColumn Header="Rule"     Binding="{Binding Label}"    Width="190"/>
                                <DataGridTextColumn Header="Sheet"    Binding="{Binding Sheet}"    Width="90"/>
                                <DataGridTextColumn Header="View"     Binding="{Binding ViewName}" Width="*"/>
                                <DataGridTextColumn Header="Type"     Binding="{Binding ViewType}" Width="110"/>
                                <DataGridTextColumn Header="Detail"   Binding="{Binding Detail}"   Width="240"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Loading -->
                        <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Checking views &amp; sheets..." HorizontalAlignment="Center"
                                           FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                                <ProgressBar Name="ProcessBar" Width="240" Height="12" IsIndeterminate="True"
                                             Foreground="{DynamicResource AccentColor}"/>
                                <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextColor}"
                                           Opacity="0.6" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button Grid.Row="3" Name="TG_BtnSelect" Content="Select in model"
                                Style="{DynamicResource SecBtn}" HorizontalAlignment="Right"
                                Margin="0,10,0,0" IsEnabled="False" Click="TG_Select_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ TAB 2: APPLY TEMPLATE ═══ -->
            <TabItem Header="Apply Template">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,20,16,16">
                                <TextBlock Text="1. Source template" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="CT_ComboTemplates" Height="28" Margin="0,0,0,10"
                                          DisplayMemberPath="Name"/>
                                <StackPanel Name="CT_PanelInfo" Visibility="Collapsed">
                                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                            CornerRadius="4" Padding="10" Background="#F5F5F5" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Name="CT_TxtScale"   Text="" FontSize="11"/>
                                            <TextBlock Name="CT_TxtFilters" Text="" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Separator Margin="0,8,0,12"/>
                                <TextBlock Text="2. Target views" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBlock Text="Select in the list on the right." FontSize="10"
                                           Foreground="Gray" Margin="0,0,0,20"/>
                                <Button Name="CT_BtnApply" Content="APPLY TEMPLATE" Height="40"
                                        Style="{DynamicResource ActionBtn}" Click="CT_Apply_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Name="CT_TxtFilter" Grid.Row="0" Height="30" Padding="6,2"
                                 VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 TextChanged="CT_Filter_Changed"/>
                        <ListBox Name="CT_ListViews" Grid.Row="1" SelectionMode="Extended"
                                 BorderBrush="{DynamicResource BorderColor}" Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="5,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Name="CT_ChkAll" Content="Select all"
                                      Checked="CT_CheckAll_Checked" Unchecked="CT_CheckAll_Unchecked"
                                      Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Overlay -->
                    <Grid Name="CT_Overlay" Grid.ColumnSpan="2" Background="#CCFAFAFA" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="6" Padding="24,16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                                <ProgressBar Width="200" Height="8" IsIndeterminate="True"
                                             Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ TAB 3: COPY OVERRIDES ═══ -->
            <TabItem Header="Copy Overrides">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,20,16,16">
                                <TextBlock Text="1. Source view" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="CO_ComboSource" Height="28" Margin="0,0,0,10"
                                          DisplayMemberPath="Name"/>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Background="#FFF9F0" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Will copy:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColor}"/>
                                        <TextBlock Text="• Category overrides" FontSize="11"
                                                   Foreground="{DynamicResource TextColor}" Margin="0,2"/>
                                        <TextBlock Text="• View filters" FontSize="11"
                                                   Foreground="{DynamicResource TextColor}" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                                <Separator Margin="0,0,0,12"/>
                                <TextBlock Text="2. Target views" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBlock Text="Select in the list on the right." FontSize="10"
                                           Foreground="Gray" Margin="0,0,0,20"/>
                                <Button Name="CO_BtnCopy" Content="COPY OVERRIDES" Height="40"
                                        Style="{DynamicResource ActionBtn}" Click="CO_Copy_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Name="CO_TxtFilter" Grid.Row="0" Height="30" Padding="6,2"
                                 VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 TextChanged="CO_Filter_Changed"/>
                        <ListBox Name="CO_ListViews" Grid.Row="1" SelectionMode="Extended"
                                 BorderBrush="{DynamicResource BorderColor}" Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="5,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Name="CO_ChkAll" Content="Select all"
                                      Checked="CO_CheckAll_Checked" Unchecked="CO_CheckAll_Unchecked"
                                      Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Overlay -->
                    <Grid Name="CO_Overlay" Grid.ColumnSpan="2" Background="#CCFAFAFA" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="6" Padding="24,16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                                <ProgressBar Width="200" Height="8" IsIndeterminate="True"
                                             Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      Foreground="{DynamicResource TextColor}"/>
        </Border>
    </Grid>
</Window>
