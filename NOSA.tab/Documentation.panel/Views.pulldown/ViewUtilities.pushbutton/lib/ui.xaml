<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — View Utilities" Height="780" Width="1180"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Colors (swapped at runtime by NOSAWindow.ApplyTheme via Dark Mode toggle) -->
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Sidebar nav buttons (PileMaster-style left rail) -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,0" BorderBrush="{DynamicResource AccentColor}" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary / outline button — also used for the Quick Action buttons
             in the sidebar, since those execute immediately rather than
             toggling a panel like NavButton does. -->
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowBackground"      Value="Transparent"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="RowHeight"          Value="28"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="Foreground"         Value="{DynamicResource TextColor}"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" MaxWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="640"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL — NAVIGATION ==================== -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,20">
                <TextBlock Text="VIEW UTILITIES" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="View Tools · NOSA" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Navigation + Quick Actions -->
            <StackPanel Grid.Row="1">
                <Button Content="Align View Titles"   Style="{DynamicResource NavButton}" Name="BtnTabAlign"   Click="NavButton_Click" Tag="Selected"/>
                <Button Content="Bay Sections"         Style="{DynamicResource NavButton}" Name="BtnTabBay"    Click="NavButton_Click"/>
                <Button Content="Level Navigator"      Style="{DynamicResource NavButton}" Name="BtnTabLevel"  Click="NavButton_Click"/>
                <Button Content="View Dependencies"    Style="{DynamicResource NavButton}" Name="BtnTabViewDep" Click="NavButton_Click"/>

                <Separator Margin="20,14,20,10"/>
                <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="20,0,20,8"/>
                <StackPanel Margin="20,0,20,0">
                    <Button Name="BtnQuickHalftone" Content="Halftone Selection" Click="QuickHalftone_Click"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Name="BtnQuickSectionBox" Content="Section Boxer" Click="QuickSectionBox_Click"
                            Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>

            <!-- Dark mode footer -->
            <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <Separator Margin="0,10,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ==================== RIGHT PANEL — CONTENT ==================== -->
        <Grid Grid.Column="2" Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name="ContentGrid">

                <!-- ══ TAB 1: ALIGN VIEW TITLES ══ -->
                <Grid Name="PanelAlign" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="ALIGN VIEW TITLES" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="Standardize title block locations" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="1. Reference Viewport" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <Button Name="AV_BtnPickRef" Content="Pick Reference..." Click="AV_PickRef_Click"
                                                Style="{DynamicResource SecondaryButton}"/>
                                        <StackPanel Name="AV_PanelRefInfo" Visibility="Collapsed" Margin="0,8,0,0">
                                            <TextBlock Name="AV_TxtRefView" Text="View Name" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
                                            <TextBlock Name="AV_TxtRefScale" Text="Scale 1:50" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="2. Alignment Mode" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <ComboBox Name="AV_ComboMode" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Same as Reference"/>
                                            <ComboBoxItem Content="Left"/>
                                            <ComboBoxItem Content="Center"/>
                                            <ComboBoxItem Content="Right"/>
                                        </ComboBox>
                                        <CheckBox Name="AV_ChkVertical" Content="Align Vertical Position"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="3. Filter Sheets" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <CheckBox Name="AV_ChkFilterSheets" Content="Filter by Sheet Set"
                                                  Checked="AV_Filter_Toggled" Unchecked="AV_Filter_Toggled"/>
                                        <ListBox Name="AV_ListSheetSets" Height="100" Margin="0,8,0,0" Visibility="Collapsed"
                                                 SelectionMode="Multiple" BorderBrush="{DynamicResource BorderColor}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="PREVIEW MATCHES" Name="AV_BtnPreview" Click="AV_Preview_Click"
                                Style="{DynamicResource ActionButton}" Margin="0,12,0,0"/>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <Grid Grid.Column="2" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
                            <TextBlock Text="Matching Viewports" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                            <TextBlock Name="AV_TxtCount" Text="0 found" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.7" FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                            <DataGrid Name="AV_GridPreview" AutoGenerateColumns="False" IsReadOnly="True"
                                      AlternatingRowBackground="#10000000" Background="Transparent"
                                      BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sheet" Binding="{Binding SheetNumber}" Width="80"/>
                                    <DataGridTextColumn Header="View Name" Binding="{Binding ViewName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="APPLY ALIGNMENT" Name="AV_BtnApply" Click="AV_Apply_Click" Style="{DynamicResource ActionButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ══ TAB 2: BAY SECTIONS ══ -->
                <Grid Name="PanelBay" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="BAY SECTIONS" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text="Auto-generate structural sections between grids" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Section view type:"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                       Name="BS_CmbViewType"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Name prefix:"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Name="BS_TxtPrefix"
                                       Text="S" Height="28" VerticalContentAlignment="Center" Padding="6,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Depth offset (mm):"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox   Grid.Row="2" Grid.Column="4" Name="BS_TxtDepthOffset"
                                       Text="3000" Height="28" VerticalContentAlignment="Center" Padding="6,2"/>

                            <CheckBox  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                       Name="BS_ChkLongitudinal" Content="Longitudinal section (along grid A)"
                                       IsChecked="True" VerticalAlignment="Center"/>
                            <CheckBox  Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2"
                                       Name="BS_ChkTransverse" Content="Transverse section (perpendicular)"
                                       IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,0,0,14" Padding="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Select grid pairs (each selected pair generates sections):"
                                       Margin="12,10,12,6" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.65"/>
                            <DataGrid Grid.Row="1" Name="BS_GridList" AutoGenerateColumns="False"
                                      CanUserAddRows="False" SelectionMode="Extended" BorderThickness="0"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      GridLinesVisibility="Horizontal" RowHeight="26" FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="A" Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding SelA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="B" Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding SelB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn     Header="Grid" Binding="{Binding Name}"  Width="*"   IsReadOnly="True"/>
                                    <DataGridTextColumn     Header="Type" Binding="{Binding GridType}" Width="80" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Name="BS_TxtLog" Height="64" Margin="0,0,0,14"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.75"
                                 Background="{DynamicResource PanelColor}"
                                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="BS_BtnClose" Content="Close" Click="BS_Close_Click"
                                    Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Name="BS_BtnSelectAll" Content="Select All as A" Click="BS_SelectAllA_Click"
                                    Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Name="BS_BtnGenerate" Content="Generate Sections" Click="BS_Generate_Click"
                                    Style="{DynamicResource ActionButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ══ TAB 3: LEVEL NAVIGATOR ══ -->
                <Grid Name="PanelLevel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="LEVEL NAVIGATOR" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text="Activate structural plan views by level" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border CornerRadius="12" Background="#EEF6FF" Padding="12,4" Margin="0,0,8,0">
                            <TextBlock Name="LN_TxtTotal" Text="0 levels" FontSize="11"
                                       Foreground="#2255AA" FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="12" Background="#FFF4EE" Padding="12,4">
                            <TextBlock Name="LN_TxtNoView" Text="0 without view" FontSize="11"
                                       Foreground="#CC5500" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Double-click or select + Activate to open view"
                                   FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.5"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="1">
                        <DataGrid Name="LN_GridLevels"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  MouseDoubleClick="LN_Grid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="✓" Binding="{Binding StatusIcon}" Width="30">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Level"      Binding="{Binding Name}"       Width="160"/>
                                <DataGridTextColumn Header="Elevation"  Binding="{Binding Elevation}"  Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Discipline"  Binding="{Binding Discipline}" Width="110"/>
                                <DataGridTextColumn Header="View"        Binding="{Binding ViewName}"   Width="*"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasView}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="LN_BtnRefresh" Content="Refresh" Click="LN_Refresh_Click"
                                    Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Name="LN_BtnActivate" Content="Activate View" Click="LN_Activate_Click"
                                    Style="{DynamicResource ActionButton}" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ TAB 4: VIEW DEPENDENCY EXPLORER ══ -->
                <Grid Name="PanelViewDep" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="4" Background="{DynamicResource AccentColor}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="View Dependency Explorer" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text=" — template · filters · sheets · revisions · dependents"
                                   FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="330"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SELECT VIEW" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColor}" Opacity="0.8" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="1" Name="VD_ViewList" BorderThickness="0" Background="Transparent"
                                         FontSize="11" Foreground="{DynamicResource TextColor}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <Button Grid.Row="2" Content="▶  Analyse" Style="{DynamicResource ActionButton}"
                                        Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                        Click="VD_Analyse_Click"/>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                      HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                        <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="14,12,4,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="DEPENDENCIES" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColor}" Opacity="0.8" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" Name="VD_DepGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          AlternatingRowBackground="#06000000" Background="Transparent"
                                          BorderThickness="0" GridLinesVisibility="Horizontal"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type"   Binding="{Binding DepType}" Width="90"/>
                                        <DataGridTextColumn Header="Name"   Binding="{Binding Name}"    Width="1*"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}"  Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="VD_TxtResult" Text="Select a view and click Analyse."
                                   FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="VD_BtnClose" Content="Close" Style="{DynamicResource SecondaryButton}"
                                Click="VD_Close_Click"/>
                    </Grid>
                </Grid>

                <!-- Loading overlay (shared — SetLoading() always targets these fixed names) -->
                <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                    <Border Background="{DynamicResource PanelColor}" CornerRadius="10" Padding="28,18"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextColor}"/>
                            <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer (shared — SetLoading() writes its message here) -->
            <TextBlock Grid.Row="1" Name="TxtStatus" Text="Ready." FontSize="11" Margin="0,10,0,0"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Grid>
    </Grid>
</Window>
