<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bay Sections — NOSA"
        Width="620" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        FontSize="12"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,22,24,12">
            <TextBlock Text="BAY SECTIONS" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="Auto-generate structural sections between grids" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Options -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="24,0,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Section view type:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                           Name="CmbViewType"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Name prefix:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Name="TxtPrefix"
                           Text="S" Height="28" VerticalContentAlignment="Center" Padding="6,2"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Depth offset (mm):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="2" Grid.Column="4" Name="TxtDepthOffset"
                           Text="3000" Height="28" VerticalContentAlignment="Center" Padding="6,2"/>

                <CheckBox  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                           Name="ChkLongitudinal" Content="Longitudinal section (along grid A)"
                           IsChecked="True" VerticalAlignment="Center"/>
                <CheckBox  Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2"
                           Name="ChkTransverse" Content="Transverse section (perpendicular)"
                           IsChecked="True" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Grid selection -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="24,0,24,14" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Select grid pairs (each selected pair generates sections):"
                           Margin="12,10,12,6" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.65"/>
                <DataGrid Grid.Row="1" Name="GridList" AutoGenerateColumns="False"
                          CanUserAddRows="False" SelectionMode="Extended" BorderThickness="0"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          GridLinesVisibility="Horizontal" RowHeight="26" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="A" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SelA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="B" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SelB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn     Header="Grid" Binding="{Binding Name}"  Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn     Header="Type" Binding="{Binding GridType}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status log -->
        <TextBox Grid.Row="3" Name="TxtLog" Height="64" Margin="24,0,24,14"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.75"
                 Background="{DynamicResource PanelColor}"
                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8"/>

        <!-- Footer -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Close" Click="Close_Click"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnSelectAll" Content="Select All as A" Click="SelectAllA_Click"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnGenerate" Content="Generate Sections" Click="Generate_Click"
                            Style="{DynamicResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading -->
        <Grid Name="LoadingPanel" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Generating sections..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,12,0,0"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
