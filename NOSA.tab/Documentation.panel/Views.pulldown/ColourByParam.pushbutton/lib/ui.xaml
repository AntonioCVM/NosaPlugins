<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colour by Parameter"
        Width="620" Height="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Century Gothic, Segoe UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Colour by Parameter" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  Apply graphic overrides by parameter value"
                           Foreground="#FFD0A0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Selectors -->
        <Border Grid.Row="1" Background="{DynamicResource PanelColor}" Margin="8,8,8,0"
                Padding="12,10" CornerRadius="4"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" Name="CmbCategory" SelectionChanged="Category_Changed"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Parameter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="4" Name="CmbParam" SelectionChanged="Param_Changed"/>
                <CheckBox  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Name="ChkDarkMode" Content="Dark mode"
                           Click="Theme_Toggled" VerticalAlignment="Center"/>
                <Button    Grid.Row="2" Grid.Column="4" Name="BtnRefresh"
                           Content="Refresh" Click="Refresh_Click" Height="26"/>
            </Grid>
        </Border>

        <!-- Colour assignment table -->
        <TextBlock Grid.Row="2" Text="Colour assignments (click swatch to change):"
                   Margin="10,8,0,2" FontSize="11" Foreground="#666"/>

        <DataGrid Grid.Row="3" Name="GridColors" AutoGenerateColumns="False"
                  Margin="8,0,8,0" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" RowHeight="28" FontSize="11"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Value"  Binding="{Binding Value}"  Width="*"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Count"  Binding="{Binding Count}"  Width="60" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Colour" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding SwatchHex}" CornerRadius="3"
                                    Margin="4,2" BorderThickness="1" BorderBrush="#AAA"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Hex"    Binding="{Binding HexStr}"  Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,8,8,0">
            <Button Name="BtnApply" Content="Apply Overrides" Click="Apply_Click"
                    Height="30" Padding="16,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Name="BtnClear" Content="Clear Overrides" Click="Clear_Click"
                    Height="30" Padding="12,0" Margin="0,0,8,0"/>
            <TextBlock Name="TxtStatus" VerticalAlignment="Center" Foreground="#666" FontSize="11"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="5" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="8,6" Margin="0,8,0,0">
            <Button Content="Close" Click="Close_Click" Width="80"
                    HorizontalAlignment="Right"/>
        </Border>

        <!-- Loading -->
        <Grid Name="LoadingPanel" Grid.Row="0" Grid.RowSpan="6" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Applying overrides..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
