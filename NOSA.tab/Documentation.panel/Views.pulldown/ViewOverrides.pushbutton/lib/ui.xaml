<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Overrides" Height="740" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CC3333"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#CC3333"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Background="{DynamicResource AccentColor}" CornerRadius="2" Margin="0,0,12,0"/>
                <TextBlock Text="VIEW OVERRIDES" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Filter batch · Colour by parameter" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontFamily" Value="Century Gothic"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </TabControl.Resources>

            <!-- ═══ TAB 1: VIEW FILTER BATCH ═══ -->
            <TabItem Header="View Filter Batch">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="230" MaxWidth="330"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="FILTER BATCH" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColor}"/>
                                <TextBlock Name="VF_TxtStatusBar" Text="Ready" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Mode" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                    <RadioButton Name="VF_RbCopy"   Content="Copy from view"   IsChecked="True"
                                                 Click="VF_Mode_Changed" GroupName="VF_Mode"/>
                                    <RadioButton Name="VF_RbApply"  Content="Apply filter(s)"
                                                 Click="VF_Mode_Changed" GroupName="VF_Mode"/>
                                    <RadioButton Name="VF_RbToggle" Content="Toggle visibility"
                                                 Click="VF_Mode_Changed" GroupName="VF_Mode"/>
                                    <RadioButton Name="VF_RbRemove" Content="Remove filter(s)"
                                                 Click="VF_Mode_Changed" GroupName="VF_Mode"/>

                                    <Separator Margin="0,14,0,12"/>

                                    <!-- Copy options -->
                                    <StackPanel Name="VF_PanelCopyOptions">
                                        <TextBlock Text="Source view" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                        <ComboBox Name="VF_CboSourceView" Height="26" FontSize="11"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="VF_SourceView_Changed"/>
                                        <CheckBox Name="VF_ChkIncludeOverrides" Content="Copy graphic overrides"
                                                  IsChecked="True" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- Filter picker -->
                                    <StackPanel Name="VF_PanelFilterOptions" Visibility="Collapsed">
                                        <TextBlock Text="Filters" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                        <TextBox Name="VF_TxtFilterSearch" Height="28" FontSize="12"
                                                 Padding="6,4" VerticalContentAlignment="Center"
                                                 BorderBrush="{DynamicResource BorderColor}"
                                                 Text="Search filters..." Foreground="Gray"
                                                 GotFocus="VF_FilterSearch_GotFocus"
                                                 LostFocus="VF_FilterSearch_LostFocus"
                                                 TextChanged="VF_FilterSearch_Changed"/>
                                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="6" Margin="0,6,0,0" Height="180">
                                            <ListBox Name="VF_LstFilters" BorderThickness="0"
                                                     Background="{DynamicResource BgColor}"
                                                     SelectionMode="Extended"
                                                     SelectionChanged="VF_FilterList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Foreground="{DynamicResource TextColor}"
                                                                  Click="VF_FilterCheck_Click"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="All"  Click="VF_FilterSelectAll_Click"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="None" Click="VF_FilterSelectNone_Click"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Name="VF_PanelToggleOpts" Visibility="Collapsed" Margin="0,10,0,0">
                                            <TextBlock Text="Action" FontWeight="Bold" FontSize="11"
                                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4"/>
                                            <RadioButton Name="VF_RbEnable"  Content="Enable (show)" IsChecked="True"
                                                         GroupName="VF_Toggle"/>
                                            <RadioButton Name="VF_RbDisable" Content="Disable (hide)"
                                                         GroupName="VF_Toggle"/>
                                        </StackPanel>

                                        <StackPanel Name="VF_PanelApplyOpts" Visibility="Collapsed" Margin="0,10,0,0">
                                            <CheckBox Name="VF_ChkApplyFromView" Content="Copy overrides from view"
                                                      IsChecked="False" Click="VF_ApplyFromView_Changed"/>
                                            <ComboBox Name="VF_CboApplySourceView" Height="26" FontSize="11"
                                                      DisplayMemberPath="Name" Margin="0,4,0,0" IsEnabled="False"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Name="VF_BtnExecute" Content="EXECUTE" Click="VF_Execute_Click"
                                        Style="{StaticResource ActionButton}" Margin="0,0,0,8"/>
                                <TextBlock Name="VF_TxtLastResult" Text="" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.65"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <!-- Main -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Pills -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="VF_TxtPillViews" Text="0 views" FontSize="11"
                                           Foreground="#666" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="12" Background="#FFF3E6" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="VF_TxtPillFilters" Text="0 filters" FontSize="11"
                                           Foreground="#FF5F00" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="12" Background="#E8F5E9" Padding="10,4">
                                <TextBlock Name="VF_TxtPillSelected" Text="0 selected" FontSize="11"
                                           Foreground="#2E7D32" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Search row -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="VF_TxtViewSearch"
                                     Height="28" FontSize="12" Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     Text="Search views..." Foreground="Gray"
                                     GotFocus="VF_ViewSearch_GotFocus"
                                     LostFocus="VF_ViewSearch_LostFocus"
                                     TextChanged="VF_ViewSearch_Changed"/>
                            <ComboBox Grid.Column="1" Name="VF_CboViewType" Width="140" Height="28"
                                      Margin="8,0,0,0" FontSize="11"
                                      SelectionChanged="VF_ViewType_Changed"/>
                        </Grid>

                        <!-- Views grid -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                            <DataGrid Name="VF_GridViews"
                                      AutoGenerateColumns="False" IsReadOnly="False"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0" GridLinesVisibility="Horizontal"
                                      SelectionMode="Extended"
                                      SelectionChanged="VF_ViewGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" Click="VF_ViewCheck_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="View name" Binding="{Binding Name}"        Width="*"/>
                                    <DataGridTextColumn Header="Type"      Binding="{Binding ViewType}"    Width="120"/>
                                    <DataGridTextColumn Header="Filters"   Binding="{Binding FilterCount}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Bottom toolbar -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Select all"  Click="VF_SelectAllViews_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" FontSize="11" Padding="10,5"/>
                            <Button Content="Select none" Click="VF_SelectNoneViews_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" FontSize="11" Padding="10,5"/>
                            <Button Content="Invert"      Click="VF_InvertViews_Click"
                                    Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ TAB 2: COLOUR BY PARAMETER ═══ -->
            <TabItem Header="Colour by Parameter">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selector row -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox  Grid.Column="1" Name="CP_CmbCategory" Height="26"
                                       VerticalContentAlignment="Center"
                                       SelectionChanged="CP_Category_Changed"/>
                            <TextBlock Grid.Column="3" Text="Parameter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox  Grid.Column="4" Name="CP_CmbParam" Height="26"
                                       VerticalContentAlignment="Center"
                                       SelectionChanged="CP_Param_Changed"/>
                            <Button    Grid.Column="5" Name="CP_BtnRefresh" Content="Refresh"
                                       Click="CP_Refresh_Click" Height="26" Margin="12,0,0,0"
                                       Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Colour assignments — run fills table automatically on parameter change:"
                               FontSize="11" Opacity="0.6" Margin="0,0,0,6"/>

                    <!-- Colour grid -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <DataGrid Name="CP_GridColors" AutoGenerateColumns="False"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  RowHeight="28" FontSize="11" SelectionMode="Single"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value"  Binding="{Binding Value}"   Width="*"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Count"  Binding="{Binding Count}"   Width="60" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Colour" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SwatchHex}" CornerRadius="3"
                                                    Margin="4,2" BorderThickness="1" BorderBrush="#AAA"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Hex"    Binding="{Binding HexStr}"  Width="70" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Name="CP_BtnApply" Content="Apply overrides"
                                Style="{StaticResource ActionButton}" Click="CP_Apply_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Name="CP_BtnClear" Content="Clear overrides"
                                Style="{StaticResource DangerButton}" Click="CP_Clear_Click" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Name="CP_TxtStatus" Text=""
                                   VerticalAlignment="Center" FontSize="11" Opacity="0.65"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Shared loading overlay -->
        <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{StaticResource Card}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Working..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      Foreground="{DynamicResource TextColor}"/>
        </Border>
    </Grid>
</Window>
