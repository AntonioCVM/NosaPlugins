<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align View Titles v3.0" Height="580" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="230" MaxWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Configuration -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="ALIGN TITLES" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Standardize Locations" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <!-- Reference -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. Reference Viewport" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <Button Name="BtnPickRef" Content="Pick Reference..." Click="PickRef_Click"
                                    Style="{DynamicResource SecondaryButton}"/>
                            <StackPanel Name="PanelRefInfo" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Name="TxtRefView" Text="View Name" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Name="TxtRefScale" Text="Scale 1:50" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Alignment Mode -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2. Alignment Mode" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <ComboBox Name="ComboMode" SelectedIndex="0" Margin="0,0,0,8">
                                <ComboBoxItem Content="Same as Reference"/>
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Right"/>
                            </ComboBox>
                            <CheckBox Name="ChkVertical" Content="Align Vertical Position"/>
                        </StackPanel>
                    </Border>

                    <!-- Filters -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3. Filter Sheets" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkFilterSheets" Content="Filter by Sheet Set"
                                      Checked="Filter_Toggled" Unchecked="Filter_Toggled"/>
                            <ListBox Name="ListSheetSets" Height="100" Margin="0,8,0,0" Visibility="Collapsed"
                                     SelectionMode="Multiple" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>
                    </Border>

                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Refresh Button -->
            <Button Grid.Row="2" Content="PREVIEW MATCHES" Name="BtnPreview" Click="Preview_Click"
                    Style="{DynamicResource ActionButton}" Margin="20"/>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Main Content: Preview -->
        <Grid Grid.Column="2" Margin="16,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
                <TextBlock Text="Matching Viewports" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Name="TxtCount" Text="0 found" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextColor}" Opacity="0.7" FontSize="12"/>
            </StackPanel>

            <!-- Data Grid -->
            <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                <DataGrid Name="GridPreview" AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="#10000000" Background="Transparent"
                          BorderThickness="0" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sheet" Binding="{Binding SheetNumber}" Width="80"/>
                        <DataGridTextColumn Header="View Name" Binding="{Binding ViewName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="APPLY ALIGNMENT" Name="BtnApply" Click="Apply_Click" Style="{DynamicResource ActionButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
