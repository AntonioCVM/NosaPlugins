<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotation Suite" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="220" MaxWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ VIEW SELECTION SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,28,20,12">
                <TextBlock Text="ANNOTATION" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="SUITE" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Structural Views" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="20,0,20,6">
                <TextBlock Text="Target views" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                <TextBox Name="SuiteTxtSearch" Height="26" Padding="4,2" FontSize="11"
                         VerticalContentAlignment="Center" Margin="0,0,0,6"
                         BorderBrush="{DynamicResource BorderColor}"
                         TextChanged="Suite_SearchViews_Changed"/>
                <CheckBox Name="SuiteChkOnlySheets" Content="Only views on sheets"
                          FontSize="11" Click="Suite_FilterViews_Changed"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="20,6,20,6" Padding="1">
                <ListBox Name="SuiteListViews"
                         BorderThickness="0" Background="Transparent" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Button Grid.Row="3" Content="Select All Views" Style="{StaticResource SecBtn}"
                    Click="Suite_SelectAll_Click" Margin="20,0,20,6"/>
            <CheckBox Grid.Row="4" Name="ChkDarkMode" Content="Dark Mode"
                      Click="Theme_Toggled" Margin="20,4,20,20"/>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN TABS ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Name="TabMain"
                        Background="{DynamicResource BgColor}"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderColor}">

                <!-- ─── TAB 0: STRUCTURAL TAGS ─── -->
                <TabItem FontSize="12" FontWeight="SemiBold">
                    <TabItem.Header><TextBlock Text="  Tag All  " Padding="4,2"/></TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="Tag every element and the reinforcement in the selected views"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextColor}"
                                   Text="Each tag starts beside its element (column corner, over a beam, on a slab), moves to the nearest free spot when it would overlap another tag or a column, gets a leader only when it ended away from its element, and crossing leaders are untangled. Plans: structure and stairs (piles on foundation plans, bars on RC plans); sections and details: the structure they cut and its bars. 3D views, sheets and schedules are skipped. Type '(NOSA default)' picks the NOSA tag by material and view."/>

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                            <StackPanel Name="PanelTagCategories"/>
                        </Border>

                        <CheckBox Name="ChkTagRecommended" Content="Only the categories recommended for each view"
                                  IsChecked="True" Margin="0,0,0,6"/>
                        <CheckBox Name="ChkTagRearrange" Content="Re-arrange the existing tags of these categories too"
                                  IsChecked="True"/>

                        <Button Content="TAG SELECTED VIEWS" Style="{StaticResource ActionBtn}"
                                Click="RunTags_Click" Margin="0,20,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ─── TAB 1: GRID BUBBLES ─── -->
                <TabItem FontSize="12" FontWeight="SemiBold">
                    <TabItem.Header><TextBlock Text="  Grid Bubbles  " Padding="4,2"/></TabItem.Header>
                    <StackPanel Margin="24">
                        <TextBlock Text="Grid bubble visibility in selected views"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,16"/>

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Action:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                                <RadioButton Name="GbbRbShow"        Content="Show bubbles"
                                             GroupName="GbbAction" IsChecked="True"/>
                                <RadioButton Name="GbbRbHide"        Content="Hide bubbles"
                                             GroupName="GbbAction"/>
                                <RadioButton Name="GbbRbStandardise" Content="Standardise (show at both ends)"
                                             GroupName="GbbAction"/>
                            </StackPanel>
                        </Border>

                        <CheckBox Name="GbbChkBothEnds" Content="Apply to both grid ends" IsChecked="True"/>

                        <Button Content="APPLY TO SELECTED VIEWS" Style="{StaticResource ActionBtn}"
                                Click="RunGbb_Click" Margin="0,20,0,0"
                                HorizontalAlignment="Left"/>

                        <TextBlock Name="GbbTxtStatus" FontSize="11" Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <!-- ─── TAB 2: SPOT ELEVATIONS ─── -->
                <TabItem FontSize="12" FontWeight="SemiBold">
                    <TabItem.Header><TextBlock Text="  Spot Elevations  " Padding="4,2"/></TabItem.Header>
                    <StackPanel Margin="24">
                        <TextBlock Text="Place spot elevations on structural elements in selected views"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                        <TextBlock Text="Target views must be Floor Plan or Ceiling Plan."
                                   FontSize="11" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.6" Margin="0,0,0,14"/>
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spot elevation type:"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Name="CboSpotType" Height="26"
                                          VerticalContentAlignment="Center" FontSize="11"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Leave type blank to use the default spot elevation style."
                                   FontSize="10" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.55" Margin="0,0,0,0" TextWrapping="Wrap"/>

                        <Button Content="PLACE SPOT ELEVATIONS" Style="{StaticResource ActionBtn}"
                                Click="RunSpotElevs_Click" Margin="0,20,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- Result strip -->
            <Border Grid.Row="1" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                    Padding="16,8">
                <TextBlock Name="SuiteTxtResult" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.8"/>
            </Border>

            <!-- Loading overlay -->
            <Grid Name="LoadingPanel" Grid.Row="0" Visibility="Collapsed"
                  Background="#CCFAFAFA" Panel.ZIndex="100">
                <Border Background="White" CornerRadius="6" Padding="24,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Processing..." HorizontalAlignment="Center"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
