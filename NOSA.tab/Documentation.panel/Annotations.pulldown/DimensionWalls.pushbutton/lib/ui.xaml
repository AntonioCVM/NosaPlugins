<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimension Walls v7.0" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Configuration -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,30,20,20">
                <TextBlock Text="DIMENSION WALLS" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Auto-Dimension" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,20">
                    
                    <!-- Settings -->
                    <TextBlock Text="1. Settings" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Dimension Type" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                    <ComboBox Name="ComboDimTypes" Height="28" Margin="0,0,0,15" DisplayMemberPath="Name"/>
                    
                    <TextBlock Text="Offset (mm)" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox Name="TxtOffset" Height="28" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center" Text="1000"/>
                    
                    <Separator Margin="0,5,0,15"/>
                    
                    <!-- Wall Types -->
                    <TextBlock Text="2. Wall Types" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    
                    <CheckBox Name="ChkStraight" Content="Straight Walls" IsChecked="True"/>
                    <CheckBox Name="ChkCurved" Content="Curved Walls (Radius + Arc)" IsChecked="True"/>
                    
                    <Separator Margin="0,15"/>
                    
                    <!-- Info -->
                    <Border Background="#FFF9F0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="10" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Curved Walls:" FontWeight="SemiBold" FontSize="11" Foreground="#FF5F00"/>
                            <TextBlock Text="Creates Radial (Radius) and Linear (Arc Length) dimensions." FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Name="BtnRun" Content="RUN DIMENSIONS" Height="40" Margin="0,30,0,0"
                            Style="{DynamicResource ActionButton}" Click="Run_Click"/>

                    <Separator Margin="0,16,0,8"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Main Content: View Selection -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Select Views" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="Views to process" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
            </StackPanel>

            <!-- Filter -->
            <TextBox Name="TxtFilterViews" Grid.Row="1" Height="32" Margin="0,0,0,10" Padding="8" VerticalContentAlignment="Center" BorderBrush="{DynamicResource BorderColor}"/>
            <TextBlock Grid.Row="1" Text="🔍 Filter views..." IsHitTestVisible="False" Foreground="#999" Margin="12,0,0,10" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtFilterViews}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- List -->
            <ListBox Name="ListViews" Grid.Row="2" SelectionMode="Extended" BorderBrush="{DynamicResource BorderColor}" Background="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="5,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox Name="ChkCheckAll" Content="Select All" Checked="CheckAll_Checked" Unchecked="CheckAll_Unchecked" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Name="TxtCount" Text="0 selected" Margin="15,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Progress Overlay -->
        <Grid Name="OverlayProgress" Background="#EEFFFFFF" Visibility="Collapsed">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Padding="40,30" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0">
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="20" Background="White">
                    <StackPanel>
                        <TextBlock Text="Processing..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                        <ProgressBar Name="ProgressBar" Width="300" Height="8" Margin="0,15" IsIndeterminate="True"/>
                        <TextBlock Text="Please wait..." FontSize="11" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
