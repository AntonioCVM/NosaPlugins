<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grid Bubble Batch" Height="600" Width="760"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="220" MaxWidth="340"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="GRID BUBBLE BATCH" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Show, hide or standardise grid bubbles across plan views"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,10">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Action" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <RadioButton Name="RbShow" GroupName="Action" Content="Show bubbles" IsChecked="True"/>
                            <RadioButton Name="RbHide" GroupName="Action" Content="Hide bubbles"/>
                            <RadioButton Name="RbStandardise" GroupName="Action" Content="Standardise (show at both ends)"/>
                            <Separator Margin="0,8"/>
                            <CheckBox Name="ChkBothEnds" Content="Apply to both grid ends" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Select all" Click="SelectAll_Click"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="Clear all" Click="ClearAll_Click"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Button Content="APPLY" Name="BtnApply" Click="Apply_Click"
                            Style="{StaticResource ActionButton}" Margin="0,0,0,10"/>

                    <TextBlock Name="TxtStatusResult" FontSize="10" Opacity="0.65"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Name="TxtViewCount" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                <ListBox Name="ListViews" BorderThickness="0" Background="Transparent"
                          Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="8" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,12"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextColor}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
