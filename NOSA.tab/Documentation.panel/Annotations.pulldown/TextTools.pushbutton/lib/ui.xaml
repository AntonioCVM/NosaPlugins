<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Tools" Height="700" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TEXT TOOLS" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Batch rename · Case converter" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontFamily" Value="Century Gothic"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </TabControl.Resources>

            <!-- ═══ TAB 1: BATCH RENAME ═══ -->
            <TabItem Header="Batch Rename">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,18,18,10">
                                <!-- Mode -->
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Mode" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <RadioButton Name="BR_RbFindReplace"   Content="Find &amp; Replace"   IsChecked="True"
                                                     Click="BR_Mode_Changed" GroupName="BR_Mode"/>
                                        <RadioButton Name="BR_RbPrefixSuffix"  Content="Add prefix / suffix"
                                                     Click="BR_Mode_Changed" GroupName="BR_Mode"/>
                                        <RadioButton Name="BR_RbSequential"    Content="Sequential numbering"
                                                     Click="BR_Mode_Changed" GroupName="BR_Mode"/>

                                        <!-- Find/Replace options -->
                                        <StackPanel Name="BR_PanelFindReplace" Margin="0,10,0,0">
                                            <TextBlock Text="Find:" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="BR_TxtFind" Height="26" Padding="4,2" FontSize="11"
                                                     BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Replace with:" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="BR_TxtReplace" Height="26" Padding="4,2" FontSize="11"
                                                     BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                                            <CheckBox Name="BR_ChkRegex" Content="Use regular expressions" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Prefix/Suffix options -->
                                        <StackPanel Name="BR_PanelPrefixSuffix" Visibility="Collapsed" Margin="0,10,0,0">
                                            <TextBlock Text="Prefix:" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="BR_TxtPrefix" Height="26" Padding="4,2" FontSize="11"
                                                     BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Suffix:" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="BR_TxtSuffix" Height="26" Padding="4,2" FontSize="11"
                                                     BorderBrush="{DynamicResource BorderColor}"/>
                                        </StackPanel>

                                        <!-- Sequential options -->
                                        <StackPanel Name="BR_PanelSequential" Visibility="Collapsed" Margin="0,10,0,0">
                                            <TextBlock Text="Pattern (# = digit):" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="BR_TxtPattern" Height="26" Padding="4,2" FontSize="11"
                                                     Text="ELEM-###" BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Start number:" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="BR_TxtStartNum" Height="26" Padding="4,2" FontSize="11"
                                                     Text="1" BorderBrush="{DynamicResource BorderColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Parameter -->
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Parameter" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <RadioButton Name="BR_RbMark"     Content="Mark"     IsChecked="True" GroupName="BR_Param"/>
                                        <RadioButton Name="BR_RbComments" Content="Comments" GroupName="BR_Param"/>
                                    </StackPanel>
                                </Border>

                                <!-- Source -->
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Elements" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <RadioButton Name="BR_RbSelection" Content="Current selection" IsChecked="True"
                                                     Click="BR_Source_Changed" GroupName="BR_Source"/>
                                        <RadioButton Name="BR_RbCategory"  Content="By category"
                                                     Click="BR_Source_Changed" GroupName="BR_Source"/>
                                        <ComboBox Name="BR_CboCategory" Height="26" FontSize="11" Margin="0,6,0,0"
                                                  IsEnabled="False" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="18,0,18,18">
                            <Button Name="BR_BtnPreview" Content="PREVIEW CHANGES"
                                    Click="BR_Preview_Click" Style="{DynamicResource SecBtn}" Margin="0,0,0,8"/>
                            <Button Name="BR_BtnApply" Content="APPLY CHANGES"
                                    Click="BR_Apply_Click" Style="{DynamicResource ActionBtn}"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Main -->
                    <Grid Grid.Column="2" Margin="14,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="BR_TxtPillTotal" Text="0 elements" FontSize="11"
                                           Foreground="#666" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="12" Background="#E8F5E9" Padding="10,4">
                                <TextBlock Name="BR_TxtPillChanges" Text="0 changes" FontSize="11"
                                           Foreground="#2E7D32" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                            <DataGrid Name="BR_GridPreview"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Element"   Binding="{Binding DisplayName}" Width="220"/>
                                    <DataGridTextColumn Header="Current"   Binding="{Binding OldValue}"    Width="*"/>
                                    <DataGridTextColumn Header="New value" Binding="{Binding NewValue}"    Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChange}" Value="True">
                                                <Setter Property="Background" Value="#10FF5F00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>

                        <TextBlock Name="BR_TxtStatus" Grid.Row="2" Text="Preview results will appear here."
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ TAB 2: CASE CONVERTER ═══ -->
            <TabItem Header="Case Converter">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,18,18,10">
                                <!-- Mode -->
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Transformation" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <RadioButton Name="CC_RbUpper"    Content="UPPERCASE" IsChecked="True" GroupName="CC_Mode"/>
                                        <RadioButton Name="CC_RbLower"    Content="lowercase"                  GroupName="CC_Mode"/>
                                        <RadioButton Name="CC_RbSentence" Content="Sentence case"              GroupName="CC_Mode"/>
                                        <RadioButton Name="CC_RbTitle"    Content="Title Case"                 GroupName="CC_Mode"/>
                                    </StackPanel>
                                </Border>

                                <!-- Target -->
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Target" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <RadioButton Name="CC_RbTextNotes" Content="Text notes"       IsChecked="True"
                                                     Click="CC_Target_Changed" GroupName="CC_Target"/>
                                        <RadioButton Name="CC_RbParam"     Content="String parameter"
                                                     Click="CC_Target_Changed" GroupName="CC_Target"/>
                                        <StackPanel Name="CC_PanelParam" Visibility="Collapsed" Margin="0,6,0,0">
                                            <TextBlock Text="Parameter name:" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Name="CC_TxtParamName" Height="26" Padding="4,2" FontSize="11"
                                                     BorderBrush="{DynamicResource BorderColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Scope -->
                                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Scope" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <RadioButton Name="CC_RbScopeSelection" Content="Current selection" IsChecked="True" GroupName="CC_Scope"/>
                                        <RadioButton Name="CC_RbScopeView"      Content="Active view"                        GroupName="CC_Scope"/>
                                        <RadioButton Name="CC_RbScopeProject"   Content="Entire project"                     GroupName="CC_Scope"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="18,0,18,18">
                            <Button Name="CC_BtnPreview" Content="PREVIEW"
                                    Click="CC_Preview_Click" Style="{DynamicResource SecBtn}" Margin="0,0,0,8"/>
                            <Button Name="CC_BtnApply" Content="APPLY"
                                    Click="CC_Apply_Click" Style="{DynamicResource ActionBtn}"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Main -->
                    <Grid Grid.Column="2" Margin="14,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="CC_TxtPillTotal"   Text="0 found"   FontSize="11"
                                           Foreground="#666" FontWeight="Bold"/>
                            </Border>
                            <Border CornerRadius="12" Background="#E8F5E9" Padding="10,4">
                                <TextBlock Name="CC_TxtPillChanges" Text="0 changes" FontSize="11"
                                           Foreground="#2E7D32" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                            <DataGrid Name="CC_GridPreview"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Before"   Binding="{Binding OldValue}" Width="*"/>
                                    <DataGridTextColumn Header="After"    Binding="{Binding NewValue}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Name="CC_TxtStatus" Grid.Row="2" Text="Preview will appear here."
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Shared loading overlay -->
        <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"/>
        </Border>
    </Grid>
</Window>
