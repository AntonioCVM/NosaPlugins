<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimension Walls v7.0" Height="660" Width="980"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR: Configuration ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="DIMENSION WALLS" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Auto-dimension straight and curved walls"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,20">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="1. Settings" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

                            <TextBlock Text="Dimension Type" FontSize="11" Opacity="0.65"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                            <ComboBox Name="ComboDimTypes" Height="28" Margin="0,0,0,12" DisplayMemberPath="Name"/>

                            <TextBlock Text="Offset (mm)" FontSize="11" Opacity="0.65"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                            <TextBox Name="TxtOffset" Height="28" Padding="5" VerticalContentAlignment="Center"
                                     Text="1000" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="2. Wall Types" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkStraight" Content="Straight Walls" IsChecked="True"/>
                            <CheckBox Name="ChkCurved" Content="Curved Walls (Radius + Arc)" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF9F0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Padding="10" CornerRadius="8" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Curved Walls:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="Creates Radial (Radius) and Linear (Arc Length) dimensions."
                                       FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnRun" Content="RUN DIMENSIONS" Height="40"
                            Style="{StaticResource ActionButton}" Click="Run_Click" Margin="0,0,0,20"/>

                    <Separator Margin="0,0,0,10"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN CONTENT: View Selection ═══ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Select Views" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Views to process" FontSize="11" Opacity="0.55" Foreground="{DynamicResource TextColor}"/>
            </StackPanel>

            <!-- Filter -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox Name="TxtFilterViews" Height="32" Padding="8" VerticalContentAlignment="Center"
                         BorderBrush="{DynamicResource BorderColor}"/>
                <TextBlock Text="🔍 Filter views..." IsHitTestVisible="False" Foreground="#999"
                           Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtFilterViews}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- List -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                <ListBox Name="ListViews" SelectionMode="Extended" BorderThickness="0"
                          Background="Transparent" Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="5,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox Name="ChkCheckAll" Content="Select All" Checked="CheckAll_Checked" Unchecked="CheckAll_Unchecked"
                          Foreground="{DynamicResource TextColor}"/>
                <TextBlock Name="TxtCount" Text="0 selected" Margin="15,0,0,0" Opacity="0.6"
                           Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Progress Overlay -->
        <Grid Name="OverlayProgress" Grid.ColumnSpan="3" Background="#CCFAFAFA" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8" Padding="40,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Processing..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Name="ProgressBar" Width="300" Height="8" Margin="0,15"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="Please wait..." FontSize="11" HorizontalAlignment="Center" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
