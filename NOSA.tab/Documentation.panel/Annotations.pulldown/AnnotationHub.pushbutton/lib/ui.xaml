<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotation Hub" Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <Style x:Key="ModCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextColor}"/>
        </Style>

        <Style x:Key="ModDesc" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"      Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,3,0,0"/>
        </Style>

        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background"        Value="#FFF0E8"/>
            <Setter Property="CornerRadius"      Value="10"/>
            <Setter Property="Padding"           Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="10,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ANNOTATION HUB" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Auto-dimensioning tools" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Padding="0" Margin="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize"     Value="12"/>
                    <Setter Property="FontFamily"   Value="Century Gothic"/>
                    <Setter Property="Padding"      Value="16,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground"   Value="{DynamicResource TextColor}"/>
                    <Setter Property="Background"   Value="Transparent"/>
                </Style>
            </TabControl.Resources>

            <!-- ═══ TAB 1: DIMENSION WALLS ═══ -->
            <TabItem Header="Wall Dimensions">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="20,20,20,10">
                            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,12"/>
                            <TextBlock Text="Dimension type" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <ComboBox Name="DW_ComboDimTypes" Height="28" Margin="0,0,0,12"
                                      DisplayMemberPath="Name"/>
                            <TextBlock Text="Offset (mm)" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBox Name="DW_TxtOffset" Height="28" Padding="5"
                                     VerticalContentAlignment="Center" Text="1000"
                                     BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,16"/>
                            <Separator Margin="0,0,0,12"/>
                            <TextBlock Text="Wall types" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                            <CheckBox Name="DW_ChkStraight" Content="Straight walls" IsChecked="True"
                                      Foreground="{DynamicResource TextColor}" Margin="0,2"/>
                            <CheckBox Name="DW_ChkCurved" Content="Curved walls (radius + arc length)"
                                      IsChecked="True" Foreground="{DynamicResource TextColor}"
                                      Margin="0,2"/>
                            <Border Background="#FFF9F0" BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Curved walls:" FontWeight="SemiBold" FontSize="11"
                                               Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="Creates radial (radius) and linear (arc length) dimensions."
                                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </Border>
                            <Button Name="DW_BtnRun" Content="RUN DIMENSIONS" Height="40"
                                    Margin="0,20,0,0" Style="{DynamicResource ActionBtn}"
                                    Click="DW_Run_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- View list -->
                    <Grid Grid.Column="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Select views" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Text="Floor plans and engineering plans only"
                                       FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                        <TextBox Name="DW_TxtFilter" Grid.Row="1" Height="32" Padding="8"
                                 VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                        <ListBox Name="DW_ListViews" Grid.Row="2" SelectionMode="Extended"
                                 BorderBrush="{DynamicResource BorderColor}" Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                              Margin="5,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Name="DW_ChkAll" Content="Select all"
                                      Checked="DW_CheckAll_Checked" Unchecked="DW_CheckAll_Unchecked"
                                      Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Name="DW_TxtCount" Text="" Margin="12,0,0,0"
                                       Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Progress overlay -->
                    <Grid Name="DW_OverlayProgress" Grid.ColumnSpan="2"
                          Background="#CCFAFAFA" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="6" Padding="24,16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Processing..." HorizontalAlignment="Center"
                                           FontSize="13" Foreground="{DynamicResource TextColor}"/>
                                <ProgressBar Width="200" Height="8" IsIndeterminate="True"
                                             Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ TAB 2: GA AUTO-DIMENSION ═══ -->
            <TabItem Header="GA Auto-Dimension">
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Info bar -->
                    <Border Grid.Row="0" Style="{DynamicResource ModCard}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="GA_TxtViewName" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  " FontSize="11" Opacity="0.3" VerticalAlignment="Center"/>
                            <TextBlock Name="GA_TxtGridCount" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Tolerance -->
                    <Border Grid.Row="1" Style="{DynamicResource ModCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="On-grid tolerance" Style="{DynamicResource ModTitle}"/>
                                <TextBlock Text="Maximum distance to a gridline for an element to be considered 'on grid'"
                                           Style="{DynamicResource ModDesc}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="±" VerticalAlignment="Center"
                                       Margin="12,0,6,0" FontSize="14" Opacity="0.5"/>
                            <TextBox Name="GA_TxtTolerance" Grid.Column="2" Text="50"
                                     Height="32" TextAlignment="Center" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="{DynamicResource BorderColor}"/>
                            <TextBlock Grid.Column="3" Text="mm" VerticalAlignment="Center"
                                       Margin="6,0,0,0" FontSize="12" Opacity="0.55"/>
                        </Grid>
                    </Border>

                    <!-- Module cards -->
                    <StackPanel Grid.Row="2">
                        <Border Style="{DynamicResource ModCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Name="GA_ChkMod1" Grid.Column="0" VerticalAlignment="Top"
                                          Margin="0,2,14,0" IsChecked="True"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Module 1 — Off-grid elements"
                                               Style="{DynamicResource ModTitle}"/>
                                    <TextBlock Text="Columns and foundations whose centre does not align with any gridline. Creates H and V dimensions to the nearest grid."
                                               Style="{DynamicResource ModDesc}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{DynamicResource CountBadge}"
                                        Visibility="{Binding ElementName=GA_Mod1Count, Path=Visibility}">
                                    <TextBlock Name="GA_Mod1Count" Text="" FontSize="10"
                                               Foreground="{DynamicResource AccentColor}" FontWeight="Bold"
                                               Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource ModCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Name="GA_ChkMod2" Grid.Column="0" VerticalAlignment="Top"
                                          Margin="0,2,14,0" IsChecked="True"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Module 2 — Structural wall length &amp; alignment"
                                               Style="{DynamicResource ModTitle}"/>
                                    <TextBlock Text="Overall length dimension for each structural wall, plus a perpendicular dimension to the nearest gridline defining its position."
                                               Style="{DynamicResource ModDesc}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{DynamicResource CountBadge}"
                                        Visibility="{Binding ElementName=GA_Mod2Count, Path=Visibility}">
                                    <TextBlock Name="GA_Mod2Count" Text="" FontSize="10"
                                               Foreground="{DynamicResource AccentColor}" FontWeight="Bold"
                                               Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource ModCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Name="GA_ChkMod3" Grid.Column="0" VerticalAlignment="Top"
                                          Margin="0,2,14,0" IsChecked="True"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Module 3 — Slab / floor corners"
                                               Style="{DynamicResource ModTitle}"/>
                                    <TextBlock Text="Dimensions each corner of a slab boundary to the nearest H and V gridline, fully defining the slab plan position."
                                               Style="{DynamicResource ModDesc}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{DynamicResource CountBadge}"
                                        Visibility="{Binding ElementName=GA_Mod3Count, Path=Visibility}">
                                    <TextBlock Name="GA_Mod3Count" Text="" FontSize="10"
                                               Foreground="{DynamicResource AccentColor}" FontWeight="Bold"
                                               Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource ModCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Name="GA_ChkMod4" Grid.Column="0" VerticalAlignment="Top"
                                          Margin="0,2,14,0" IsChecked="False"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Module 4 — Grid line spacing chains"
                                               Style="{DynamicResource ModTitle}"/>
                                    <TextBlock Text="One continuous dimension chain across all horizontal gridlines (Y spacings) and one across all vertical gridlines (X spacings)."
                                               Style="{DynamicResource ModDesc}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{DynamicResource CountBadge}"
                                        Visibility="{Binding ElementName=GA_Mod4Count, Path=Visibility}">
                                    <TextBlock Name="GA_Mod4Count" Text="" FontSize="10"
                                               Foreground="{DynamicResource AccentColor}" FontWeight="Bold"
                                               Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Name="GA_StatusPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,10">
                        <ProgressBar Name="GA_ProgBar" IsIndeterminate="True" Height="3"
                                     Foreground="{DynamicResource AccentColor}" BorderThickness="0" Margin="0,0,0,6"/>
                        <TextBlock Name="GA_TxtStatus" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                    </StackPanel>

                    <!-- Footer buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="GA_TxtResult" Grid.Column="0" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.65"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Name="GA_BtnDryRun" Grid.Column="1" Content="PREVIEW"
                                Style="{DynamicResource SecBtn}" Click="GA_DryRun_Click"/>
                        <Button Name="GA_BtnRun" Grid.Column="3" Content="CREATE DIMENSIONS"
                                Style="{DynamicResource ActionBtn}" Click="GA_Run_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      Foreground="{DynamicResource TextColor}"/>
        </Border>
    </Grid>
</Window>
