<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag All v3.1" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Steps & Options -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,20,20,10">
                <TextBlock Text="TAG ALL" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Batch Tagging" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel Margin="20,0,20,20">
                    
                    <!-- Categories -->
                    <TextBlock Text="1. Select Categories" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,5"/>
                    <ListBox Name="ListCategories" Height="300" SelectionMode="Extended" BorderBrush="{DynamicResource BorderColor}" Background="White">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="5,5,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="5,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Select multiple with Ctrl/Shift" FontSize="10" Foreground="Gray" Margin="0,2,0,15"/>

                    <!-- Global Options -->
                    <TextBlock Text="3. Options" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,10,0,5"/>
                    <CheckBox Name="ChkLeader" Content="Add Leaders"/>
                    <CheckBox Name="ChkSkipDuplicates" Content="Skip Existing Tags" IsChecked="True"/>
                    
                    <Separator Margin="0,20"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="RUN TAGGING" Name="BtnRun" Click="Run_Click" Style="{DynamicResource ActionButton}" Margin="20"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Config Area -->
                <RowDefinition Height="*"/>    <!-- Views -->
                <RowDefinition Height="Auto"/> <!-- Progress -->
            </Grid.RowDefinitions>

            <!-- Tag Configuration (Dynamic based on selection) -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="15" Margin="0,0,0,20" Background="#05000000" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="2. Configure Selected Categories" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    
                    <TextBlock Name="TxtConfigInfo" Text="Select categories in the sidebar to configure tag types." 
                             Foreground="{DynamicResource TextColor}" Opacity="0.6" TextWrapping="Wrap"/>
                    
                    <!-- This panel is populated dynamically or bound to current selection -->
                    <StackPanel Name="PanelTagConfig" Visibility="Collapsed">
                         <TextBlock Name="TxtCurrentCat" Text="Category: Walls" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                         <!-- Back to Combo Box -->
                         <ComboBox Name="ComboTagTypes" Height="28" Margin="0,0,0,10"/>
                         <Button Content="Set Tag Type for Selection" Name="BtnApplyTagInfo" Click="ApplyTagInfo_Click" 
                                 Background="#EEE" BorderBrush="#AAA" Foreground="#333" Padding="10,5"/>
                    </StackPanel>
                    
                    <!-- Summary of Assignments -->
                    <TextBlock Text="Active Configuration:" Margin="0,15,0,5" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    <DataGrid Name="GridAssignments" Height="100" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="White" BorderBrush="{DynamicResource BorderColor}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>
                            <DataGridTextColumn Header="Tag Family" Binding="{Binding TagName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- View Selection -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="4. Target Views" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,5"/>
                
                <!-- View Filter -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBox Name="TxtFilterViews" Height="26" Width="220" Padding="5,2"
                             VerticalContentAlignment="Center" TextChanged="FilterViews_TextChanged"/>
                    <ComboBox Name="ComboFilterLevel" Height="26" MinWidth="120" Margin="8,0,0,0"
                              SelectionChanged="FilterLevel_Changed"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="🔍 Search views..." IsHitTestVisible="False" Foreground="#999" Margin="8,0,0,5"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtFilterViews}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Name="ListViews" Grid.Row="2" SelectionMode="Extended" BorderBrush="{DynamicResource BorderColor}">
                     <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Progress -->
            <StackPanel Grid.Row="2" Margin="0,15,0,0" Name="PanelProgress" Visibility="Collapsed">
                <TextBlock Name="TxtStatus" Text="Ready" HorizontalAlignment="Right"
                           Margin="0,0,0,5" Foreground="{DynamicResource TextColor}" FontSize="11"/>
                <ProgressBar Name="ProgressBar" Height="10" Minimum="0" Maximum="100"
                             Foreground="{DynamicResource AccentColor}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
