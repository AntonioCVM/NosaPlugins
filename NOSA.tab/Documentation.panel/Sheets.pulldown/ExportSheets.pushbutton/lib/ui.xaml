<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Sheets Pro" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <!-- Colors (Will be replaced by dynamic resources from PyRevit/Code) -->
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <!-- Styles -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,0" BorderBrush="{DynamicResource AccentColor}" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,30,20,30">
                <TextBlock Text="EXPORT SHEETS" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="PRO" FontSize="12" Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Navigation -->
            <StackPanel Grid.Row="1">
                <Button Content="1. Sheets" Style="{DynamicResource NavButton}" Name="BtnTabSheets" Click="NavButton_Click"/>
                <Button Content="2. Naming" Style="{DynamicResource NavButton}" Name="BtnTabNaming" Click="NavButton_Click"/>
                <Button Content="3. Formats" Style="{DynamicResource NavButton}" Name="BtnTabFormats" Click="NavButton_Click"/>
                <Button Content="4. Output" Style="{DynamicResource NavButton}" Name="BtnTabConfig" Click="NavButton_Click"/>
                <Button Content="5. Log" Style="{DynamicResource NavButton}" Name="BtnTabLog" Click="NavButton_Click"/>
            </StackPanel>

            <!-- Status Info -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="20">
                <StackPanel Margin="0,0,0,15">
                     <TextBlock Text="Selection" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                     <TextBlock Name="LblStatusSelection" Text="0 Sheets" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,0,15">
                     <TextBlock Text="Formats" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                     <TextBlock Name="LblStatusFormats" Text="PDF" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Bottom Options -->
             <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <CheckBox Content="Dark Mode" Name="ChkDarkMode" Checked="Theme_Toggled" Unchecked="Theme_Toggled" Margin="0,5"/>
             </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Pages -->
            <Grid Grid.Row="0" Name="ContentGrid">
                
                <!-- Tab 1: Sheets -->
                <Grid Name="TabSheets" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,15" Orientation="Horizontal">
                        <TextBlock Text="Select Sheets/Views" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        
                        <RadioButton GroupName="Mode" Content="Sheets" Name="RbSheets" IsChecked="True" Checked="Mode_Changed" VerticalAlignment="Center" Margin="10,0"/>
                        <RadioButton GroupName="Mode" Content="Views" Name="RbViews" Checked="Mode_Changed" VerticalAlignment="Center" Margin="10,0"/>
                        
                        <TextBox Name="TxtSearch" Width="200" Margin="30,0,0,0" Padding="5" Tag="Search..." TextChanged="Search_Changed"/>
                    </StackPanel>
                    
                    <ListView Name="ListSheets" Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" Background="Transparent" SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Click="Sheet_Checked"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Number" Width="100" DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Rev" Width="50" DisplayMemberBinding="{Binding Revision}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    
                    <StackPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                             <Button Content="Select All" Click="SelectAll_Click" Margin="0,0,10,0"/>
                             <Button Content="Select None" Click="SelectNone_Click" Margin="0,0,10,0"/>
                             <Button Content="Check Selected Rows" Click="CheckSelectedRows_Click" Margin="0,0,10,0"/>
                             <Button Content="Invert Checks" Click="InvertChecks_Click" Margin="0,0,10,0"/>
                             <Button Content="Select Range..." Click="SelectRange_Click"/>
                        </StackPanel>
                        <Expander Header="Sheet Sets" Foreground="{DynamicResource TextColor}" Margin="0,8,0,0">
                            <Border Padding="8,6" Background="#05000000" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="ComboSheetSets" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Load" Width="60" Margin="0,0,5,0" Click="LoadSet_Click"/>
                                        <Button Content="Save as..." Width="80" Margin="0,0,5,0" Click="SaveSet_Click"/>
                                        <Button Content="Delete" Width="60" Click="DeleteSet_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>

                <!-- Tab 2: Naming -->
                <Grid Name="TabNaming" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Profile Management -->
                    <Border Grid.Row="0" Margin="0,0,0,15" Padding="10" Background="#05000000" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Naming Profile:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextColor}"/>
                            <ComboBox Name="ComboNamingProfiles" Width="200" SelectionChanged="NamingProfile_Selected" DisplayMemberPath="Name"/>
                            <Button Content="Save" Width="60" Margin="10,0,0,0" Click="SaveProfile_Click"/>
                            <Button Content="Delete" Width="60" Margin="5,0,0,0" Click="DeleteProfile_Click"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Available Parameters -->
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Available Parameters" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                            <ListBox Name="ListParams" MouseDoubleClick="Param_DoubleClick" BorderBrush="{DynamicResource BorderColor}" Background="Transparent"/>
                        </DockPanel>
                        
                        <!-- Template -->
                        <DockPanel Grid.Column="1" Margin="10,0,0,0">
                             <TextBlock Text="Naming Template" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                             
                             <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
                                  <TextBlock Text="Separator:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextColor}"/>
                                  <TextBox Name="TxtSeparator" Width="40" Text="-" TextChanged="Separator_Changed"/>
                             </StackPanel>
                             
                             <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                  <TextBlock Text="Preview:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                                  <TextBox Name="TxtPreview" IsReadOnly="True" Background="#05000000" Padding="10"/>
                             </StackPanel>

                             <ListBox Name="ListTemplate" MouseDoubleClick="Template_DoubleClick" BorderBrush="{DynamicResource BorderColor}" Background="Transparent"/>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Tab 3: Formats -->
                <StackPanel Name="TabFormats" Visibility="Collapsed">
                     <TextBlock Text="Export Formats" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource TextColor}"/>

                     <CheckBox Name="ChkPDF" Content="PDF (Portable Document Format)" Margin="0,10" IsChecked="True" Checked="Format_Changed" Unchecked="Format_Changed"/>
                     <CheckBox Name="ChkDWG" Content="DWG (AutoCAD Drawing)" Margin="0,10" Checked="Format_Changed" Unchecked="Format_Changed"/>
                     <CheckBox Name="ChkDXF" Content="DXF (Drawing Exchange Format)" Margin="0,10" Checked="Format_Changed" Unchecked="Format_Changed"/>

                     <Separator Margin="0,20,0,16"/>

                     <!-- Colour mode -->
                     <TextBlock Text="Colour mode" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                     <RadioButton GroupName="ColorMode" Name="RbUseModelColors" Content="Use model / view colours  (default)"
                                  IsChecked="True" Checked="ColorMode_Changed"
                                  Foreground="{DynamicResource TextColor}" Margin="0,4"/>
                     <RadioButton GroupName="ColorMode" Name="RbForceBlack"     Content="Force black lines  (documentation output)"
                                  Checked="ColorMode_Changed"
                                  Foreground="{DynamicResource TextColor}" Margin="0,4"/>

                     <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="4"
                             Background="#10FF5F00" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
                         <TextBlock Name="TxtColorModeHint"
                                    Text="Model colours: exports use the view's colour settings.&#x0a;Force black: overrides to black lines / B&amp;W PDF — useful for printed documentation."
                                    TextWrapping="Wrap" FontSize="11"
                                    Foreground="{DynamicResource TextColor}" Opacity="0.8"/>
                     </Border>

                     <Separator Margin="0,20,0,16"/>

                     <!-- Pre-export check -->
                     <TextBlock Text="Pre-export checks" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                     <CheckBox Name="ChkPreExportCheck" Content="Warn if views have temporary overrides / isolations active"
                               IsChecked="True" Foreground="{DynamicResource TextColor}" Margin="0,4"/>
                </StackPanel>

                <!-- Tab 4: Config -->
                <StackPanel Name="TabConfig" Visibility="Collapsed">
                     <TextBlock Text="Output Configuration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource TextColor}"/>
                     
                     <TextBlock Text="Output Folder:" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="Auto"/>
                         </Grid.ColumnDefinitions>
                         <TextBox Name="TxtFolder" Grid.Column="0" Padding="5"/>
                         <Button Content="..." Grid.Column="1" Width="40" Margin="5,0,0,0" Click="Browse_Click"/>
                     </Grid>
                </StackPanel>

                 <!-- Tab 5: Log -->
                 <Grid Name="TabLog" Visibility="Collapsed">
                      <Grid.RowDefinitions>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBox Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Grid.Row="0"/>
                      <ProgressBar Name="ExportProgress" Height="20" Grid.Row="1" Margin="0,10,0,0"/>
                 </Grid>

            </Grid>
            
            <!-- Bottom Action Bar -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
                 <DockPanel>
                      <Button DockPanel.Dock="Right" Content="START EXPORT" Style="{DynamicResource ActionButton}" Click="Export_Click"/>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                           <!-- Extra info or secondary buttons -->
                      </StackPanel>
                 </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
