<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing Index Generator v2.0" Height="680" Width="1080"
        MinHeight="540" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="220" MaxWidth="340"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>
        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,26,20,14">
                <TextBlock Text="DRAWING INDEX" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Sheet Register" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,10">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Filter sheets" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                            <TextBox Name="TxtFilter" Height="26" Padding="5,2"
                                     VerticalContentAlignment="Center" TextChanged="Filter_Changed"/>
                            <TextBlock Text="(leave empty for all sheets)" FontSize="10"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                       Margin="0,4,0,14"/>
                            <TextBlock Name="TxtCount" Text="0 sheets" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>
                            <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                                      Foreground="{DynamicResource TextColor}"/>
                            <Separator Margin="0,12,0,10"/>
                            <Button Name="BtnConfigCols" Content="☰  Show / Hide Columns"
                                    Click="ConfigCols_Click" Style="{StaticResource SecondaryButton}"
                                    FontSize="11" HorizontalAlignment="Stretch"
                                    Margin="0,0,0,4"/>
                            <StackPanel Name="ColCheckboxPanel" Visibility="Collapsed" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="2" Content="LOAD SHEETS" Name="BtnLoad"
                    Click="Load_Click" Style="{StaticResource ActionButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="3" Content="Apply Changes" Name="BtnApply"
                    Click="Apply_Click" Style="{StaticResource ActionButton}"
                    Margin="20,0,20,8" IsEnabled="False"/>
            <Button Grid.Row="4" Content="Save column layout" Name="BtnSaveColOrder"
                    Click="SaveColOrder_Click" Style="{StaticResource SecondaryButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="5" Content="Export CSV" Name="BtnCsv"
                    Click="ExportCsv_Click" Style="{StaticResource SecondaryButton}"
                    Margin="20,0,20,8" IsEnabled="False"/>
            <Button Grid.Row="6" Content="Export HTML" Name="BtnHtml"
                    Click="ExportHtml_Click" Style="{StaticResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- MAIN -->
        <Grid Grid.Column="2" Margin="24">
            <Border Style="{StaticResource Card}" Padding="1">
                <DataGrid Name="GridSheets" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CellEditEnding="Grid_CellEditEnding"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderThickness="0" GridLinesVisibility="Horizontal">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPending}" Value="True">
                                    <Setter Property="Background" Value="#FFF0D0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"           Binding="{Binding RowNum}"    Width="40"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Number"      Binding="{Binding Number}"    Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name"        Binding="{Binding SheetName}" Width="220"/>
                        <DataGridTextColumn Header="Project No." Binding="{Binding ProjNum}"   Width="90"/>
                        <DataGridTextColumn Header="Originator"  Binding="{Binding Originator}" Width="80"/>
                        <DataGridTextColumn Header="Func."       Binding="{Binding FuncBreak}" Width="55"/>
                        <DataGridTextColumn Header="Spatial"     Binding="{Binding SpatBreak}" Width="65"/>
                        <DataGridTextColumn Header="Form"        Binding="{Binding FormId}"    Width="45"/>
                        <DataGridTextColumn Header="Disc."       Binding="{Binding Discipline}" Width="45"/>
                        <DataGridTextColumn Header="Doc No."     Binding="{Binding DocNum}"    Width="70"/>
                        <DataGridTextColumn Header="Rev"         Binding="{Binding Revision}"  Width="50"/>
                        <DataGridTextColumn Header="Rev Date"    Binding="{Binding RevDate}"   Width="85"/>
                        <DataGridTextColumn Header="Rev Desc"    Binding="{Binding RevDesc}"   Width="160"/>
                        <DataGridTextColumn Header="Scale"       Binding="{Binding Scale}"     Width="65"/>
                        <DataGridTextColumn Header="Drawn By"    Binding="{Binding DrawnBy}"   Width="85"/>
                        <DataGridTextColumn Header="Checked By"  Binding="{Binding CheckedBy}" Width="85"/>
                        <DataGridTextColumn Header="Approved By" Binding="{Binding ApprovedBy}" Width="85"/>
                        <DataGridTextColumn Header="Issue Date"  Binding="{Binding IssueDate}" Width="85"/>
                        <DataGridTextColumn Header="Views"       Binding="{Binding ViewCount}" Width="50" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <!-- Loading -->
            <Grid Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource Card}" Padding="24,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Loading sheets..." HorizontalAlignment="Center"
                                   FontSize="13" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="12"
                                     IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                   FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
