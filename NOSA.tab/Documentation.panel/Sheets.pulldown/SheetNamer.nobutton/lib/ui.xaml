<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Namer — NOSA Protocol v2.2"
        Width="780" Height="660"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Century Gothic, Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgColor}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sheet Namer" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  NOSA File Naming Protocol v2.2"
                           Foreground="#FFD0A0" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Name="TxtVersion" Foreground="#FFD0A0" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{DynamicResource PanelColor}"
                    Margin="0,0,0,1">
            <Button Name="BtnTabBuild" Content="Single sheet" Width="120"
                    Background="{DynamicResource AccentColor}" Foreground="White"
                    BorderThickness="0" Click="Tab_Click" Tag="Build"
                    ToolTip="Build one sheet number from NOSA fields and apply to the active sheet"/>
            <Button Name="BtnTabBulk"  Content="Batch rename"  Width="120"
                    Background="Transparent" Foreground="{DynamicResource TextColor}"
                    BorderThickness="0" Click="Tab_Click" Tag="Bulk"
                    ToolTip="Review and apply NOSA v2.2 numbers across many sheets at once"/>
            <Button Name="BtnTabParse" Content="Fix existing"       Width="120"
                    Background="Transparent" Foreground="{DynamicResource TextColor}"
                    BorderThickness="0" Click="Tab_Click" Tag="Parse"
                    ToolTip="Parse sheets that already use NOSA numbering and correct individual fields"/>
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Margin="16,0,0,0"
                      VerticalAlignment="Center" Click="Theme_Toggled"/>
        </StackPanel>

        <!-- ======== SINGLE SHEET TAB ======== -->
        <Border Name="PanelBuild" Grid.Row="2" Style="{StaticResource Card}"
                Margin="8,8,8,0" Padding="12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,8"
                           Text="Single sheet: fill NOSA fields below, preview the number, then apply to the active sheet or a selection."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: F1, F2 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="F1 · Project No. (5 digits):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Name="TxtF1" MaxLength="5"
                           TextChanged="Field_Changed"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="F2 · Originator:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="0" Grid.Column="4" Text="NOSA" IsReadOnly="True"
                           Background="#F0F0F0"/>

                <!-- Row 2: F3, F4 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="F3 · Function (2 chars):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="2" Grid.Column="1" Name="CmbF3"
                           SelectionChanged="Field_Changed"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="F4 · Spatial (3 chars):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="2" Grid.Column="4" Name="CmbF4" IsEditable="True"
                           SelectionChanged="Field_Changed"/>

                <!-- Row 4: F5, F6 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="F5 · Form (1 char):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" Name="CmbF5"
                           SelectionChanged="Field_Changed"/>
                <TextBlock Grid.Row="4" Grid.Column="3" Text="F6 · Discipline (1 char):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="4" Grid.Column="4" Name="CmbF6"
                           SelectionChanged="Field_Changed"/>

                <!-- Row 6: F7, F8 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="F7 · Doc No. (4 digits):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="6" Grid.Column="1" Name="TxtF7" MaxLength="4"
                           TextChanged="Field_Changed"/>
                <TextBlock Grid.Row="6" Grid.Column="3" Text="F8 · Revision:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="6" Grid.Column="4" Name="CmbF8" IsEditable="True"
                           SelectionChanged="Field_Changed"/>

                <!-- Row 8: F9 -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="F9 · Description (Sheet Name):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="7"
                           Name="TxtF9" TextChanged="Field_Changed"/>
            </Grid>
            </StackPanel>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="3" Background="#FFF3E0" Margin="8,6,8,0" Padding="12,8"
                CornerRadius="10" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sheet Number:" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtPreviewNumber"
                           FontWeight="Bold" FontSize="13" Foreground="#CC3300"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sheet Name:" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtPreviewName"
                           FontStyle="Italic" Foreground="#444444"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Name="TxtValidation" Foreground="#CC0000" FontSize="11"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Apply target + apply buttons (Constructor) -->
        <Border Name="PanelBuildApply" Grid.Row="4" Style="{StaticResource Card}"
                Margin="8,6,8,0" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Apply to:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Name="RbActiveSheet" Content="Active sheet only"
                                 IsChecked="True" GroupName="ApplyTarget" Margin="0,0,16,0"/>
                    <RadioButton Name="RbSelectedSheets" Content="Selected sheets in list"
                                 GroupName="ApplyTarget" Margin="0,0,16,0"/>
                    <RadioButton Name="RbAllSheets" Content="All sheets"
                                 GroupName="ApplyTarget"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Name="BtnApplyNumber" Content="Apply Sheet Number"
                            Click="ApplyNumber_Click" Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0"/>
                    <Button Name="BtnApplyName" Content="Apply Sheet Name"
                            Click="ApplyName_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnApplyBoth" Content="Apply Both"
                            Click="ApplyBoth_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnSuggest" Content="🔍 Auto-suggest from active sheet"
                            Click="Suggest_Click" Style="{StaticResource SecondaryButton}"
                            ToolTip="Infer fields from the active sheet's name and views"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======== BATCH RENAME TAB ======== -->
        <Border Name="PanelBulk" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed"
                Style="{StaticResource Card}" Margin="8,8,8,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,6"
                           Text="Batch rename suggests NOSA v2.2 sheet numbers from existing data. Green = compliant, orange = suggested change, red = error. Run Preview before applying."/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,6">
                    <Button Name="BtnBulkRefresh" Content="Refresh" Click="BulkRefresh_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnBulkPreview" Content="Preview changes"
                            Click="BulkPreview_Click"
                            Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnBulkApplyAll" Content="Apply selected" IsEnabled="False"
                            Click="BulkApplyAll_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <TextBlock Name="TxtBulkStatus" Margin="4,0,0,0"
                               VerticalAlignment="Center" Foreground="#666"/>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="6" Padding="1">
                    <DataGrid Name="GridSheets" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Extended"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" RowHeight="24" FontSize="11">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding RowBrush}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✔" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Current Number" Binding="{Binding CurrentNumber}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="F1 Proj"  Binding="{Binding F1}"    Width="55"/>
                            <DataGridTextColumn Header="F3 Func"  Binding="{Binding F3}"    Width="50"/>
                            <DataGridTextColumn Header="F4 Spat"  Binding="{Binding F4}"    Width="50"/>
                            <DataGridTextColumn Header="F5"       Binding="{Binding F5}"    Width="35"/>
                            <DataGridTextColumn Header="F6"       Binding="{Binding F6}"    Width="35"/>
                            <DataGridTextColumn Header="F7"       Binding="{Binding F7}"    Width="50"/>
                            <DataGridTextColumn Header="F8 Rev"   Binding="{Binding F8}"    Width="55"/>
                            <DataGridTextColumn Header="New Number" Binding="{Binding NewNumber}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Message}" Width="180" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Background="#E8F5E9" Padding="8,2" CornerRadius="3" Margin="0,0,8,0">
                        <TextBlock Text="Green — OK" FontSize="10"/>
                    </Border>
                    <Border Background="#FFF3E0" Padding="8,2" CornerRadius="3" Margin="0,0,8,0">
                        <TextBlock Text="Orange — suggested change" FontSize="10"/>
                    </Border>
                    <Border Background="#FFEBEE" Padding="8,2" CornerRadius="3">
                        <TextBlock Text="Red — error" FontSize="10"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== FIX EXISTING TAB ======== -->
        <Border Name="PanelParse" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed"
                Style="{StaticResource Card}" Margin="8,8,8,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#666" FontSize="11"
                           Text="Fix existing reads sheet numbers that already follow the NOSA pattern, splits them into fields for editing, then re-applies. Only matching sheets are listed."/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="6" Padding="1">
                    <DataGrid Name="GridParse" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Extended"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" RowHeight="24" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✔" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Original" Binding="{Binding Original}"  Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="F1"       Binding="{Binding F1}"    Width="50"/>
                            <DataGridTextColumn Header="F3"       Binding="{Binding F3}"    Width="45"/>
                            <DataGridTextColumn Header="F4"       Binding="{Binding F4}"    Width="45"/>
                            <DataGridTextColumn Header="F5"       Binding="{Binding F5}"    Width="35"/>
                            <DataGridTextColumn Header="F6"       Binding="{Binding F6}"    Width="35"/>
                            <DataGridTextColumn Header="F7"       Binding="{Binding F7}"    Width="50"/>
                            <DataGridTextColumn Header="F8"       Binding="{Binding F8}"    Width="55"/>
                            <DataGridTextColumn Header="Generated" Binding="{Binding Generated}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Name="BtnParseRefresh" Content="Parse sheets" Click="ParseRefresh_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Name="BtnParseApply"   Content="Apply to selected"
                            Click="ParseApply_Click"
                            Style="{StaticResource ActionButton}"/>
                    <TextBlock Name="TxtParseStatus" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Result log -->
        <TextBox Grid.Row="5" Name="TxtLog" Height="60" Margin="8,6,8,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="11" Foreground="#555" Background="{DynamicResource PanelColor}"
                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>

        <!-- Footer -->
        <Border Grid.Row="6" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Click="Close_Click" Width="80"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.Row="0" Grid.RowSpan="7" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Style="{StaticResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Applying..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
