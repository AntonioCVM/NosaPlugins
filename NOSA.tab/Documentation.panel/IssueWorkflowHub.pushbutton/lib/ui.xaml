<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Issue Workflow Hub" Height="820" Width="1400"
        MinHeight="640" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Action / secondary button templates — both key spellings used across the
             5 absorbed tools are defined identically so no ported XAML needs rewriting. -->
        <ControlTemplate x:Key="_ActionBtnTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template"        Value="{StaticResource _ActionBtnTemplate}"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ActionButton}"/>

        <ControlTemplate x:Key="_SecBtnTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template"        Value="{StaticResource _SecBtnTemplate}"/>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn" BasedOn="{StaticResource SecondaryButton}"/>

        <!-- Outer hub sidebar navigation (5 steps) -->
        <Style x:Key="HubNavBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,12"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="4,0,0,0"
                                BorderBrush="Transparent" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RevisionTracker's own internal sub-tab nav (renamed from "NavBtn" to avoid
             ambiguity with the outer hub's own HubNavBtn) -->
        <Style x:Key="RT_NavBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,12"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="4,0,0,0"
                                BorderBrush="Transparent" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RT_FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.65"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="RT_FieldBox" TargetType="TextBox">
            <Setter Property="Height"      Value="28"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="SIM_FieldBox" TargetType="TextBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding"     Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="200" MaxWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="700"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,24,20,16">
                <TextBlock Text="ISSUE WORKFLOW" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="HUB" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Protocol → Gate → Revisions → Diff → Log" FontSize="10"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Button Name="BtnNavProtocol" Content="1   Protocol Check" Tag="Selected"
                        Style="{StaticResource HubNavBtn}" Click="NavBtn_Click"/>
                <Button Name="BtnNavGate" Content="2   Issue Gate"
                        Style="{StaticResource HubNavBtn}" Click="NavBtn_Click"/>
                <Button Name="BtnNavRevisions" Content="3   Revisions"
                        Style="{StaticResource HubNavBtn}" Click="NavBtn_Click"/>
                <Button Name="BtnNavDiff" Content="4   Package Diff"
                        Style="{StaticResource HubNavBtn}" Click="NavBtn_Click"/>
                <Button Name="BtnNavIssueLog" Content="5   Issue Log"
                        Style="{StaticResource HubNavBtn}" Click="NavBtn_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Column="2">

            <!-- ══════════════════════════════════════════════════════════
                 STEP 1 — PROTOCOL CHECK  (ex. DrawingProtocolChecker)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Name="PanelProtocol" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="DRAWING PROTOCOL CHECKER" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="NOSA File Naming Protocol v2.2 — field lengths, duplicates, disciplines"
                               FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Name="PC_TxtBanner" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Name="PC_TxtSummary" FontSize="11" Opacity="0.65" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                    <DataGrid Name="PC_GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" AlternatingRowBackground="#06000000"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet No." Binding="{Binding sheet_number}" Width="180"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding sheet_name}" Width="160"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="80"/>
                            <DataGridTextColumn Header="Issues" Binding="{Binding issues_text}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Button Content="RE-RUN CHECKS" Click="PC_Refresh_Click"
                            Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 STEP 2 — ISSUE GATE
                 ══════════════════════════════════════════════════════════ -->
            <Grid Name="PanelGate" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,20,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="230" MaxWidth="380"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: check cards -->
                    <Grid Grid.Column="0" Background="{DynamicResource BgColor}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,10">
                            <StackPanel>
                                <TextBlock Text="CHECKS" FontSize="9" FontWeight="Bold"
                                           Foreground="#AAAAAA" Margin="2,0,0,8"/>

                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                    <Border Name="IG_CardAccentProtocol" BorderThickness="5,0,0,0" CornerRadius="10,0,0,10">
                                        <Button Tag="protocol" Click="IG_Card_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="10,10" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Sheet Protocol" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                                                    <TextBlock Name="IG_TxtStatusProtocol" FontSize="10" Margin="0,2,0,0"/>
                                                    <TextBlock Name="IG_TxtCountProtocol" FontSize="9" Opacity="0.65"
                                                               Foreground="{DynamicResource TextColor}"/>
                                                </StackPanel>
                                                <TextBlock Name="IG_TxtIconProtocol" Grid.Column="1" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                    <Border Name="IG_CardAccentRevisions" BorderThickness="5,0,0,0" CornerRadius="10,0,0,10">
                                        <Button Tag="revisions" Click="IG_Card_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="10,10" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Revision Completeness" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                                                    <TextBlock Name="IG_TxtStatusRevisions" FontSize="10" Margin="0,2,0,0"/>
                                                    <TextBlock Name="IG_TxtCountRevisions" FontSize="9" Opacity="0.65"
                                                               Foreground="{DynamicResource TextColor}"/>
                                                </StackPanel>
                                                <TextBlock Name="IG_TxtIconRevisions" Grid.Column="1" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                    <Border Name="IG_CardAccentTitleblock" BorderThickness="5,0,0,0" CornerRadius="10,0,0,10">
                                        <Button Tag="titleblock" Click="IG_Card_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="10,10" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Title Block Parameters" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                                                    <TextBlock Name="IG_TxtStatusTitleblock" FontSize="10" Margin="0,2,0,0"/>
                                                    <TextBlock Name="IG_TxtCountTitleblock" FontSize="9" Opacity="0.65"
                                                               Foreground="{DynamicResource TextColor}"/>
                                                </StackPanel>
                                                <TextBlock Name="IG_TxtIconTitleblock" Grid.Column="1" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                    <Border Name="IG_CardAccentDuplicates" BorderThickness="5,0,0,0" CornerRadius="10,0,0,10">
                                        <Button Tag="duplicates" Click="IG_Card_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="10,10" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Duplicate Sheet Numbers" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                                                    <TextBlock Name="IG_TxtStatusDuplicates" FontSize="10" Margin="0,2,0,0"/>
                                                    <TextBlock Name="IG_TxtCountDuplicates" FontSize="9" Opacity="0.65"
                                                               Foreground="{DynamicResource TextColor}"/>
                                                </StackPanel>
                                                <TextBlock Name="IG_TxtIconDuplicates" Grid.Column="1" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Border>

                                <Button Content="Run All Checks" Click="IG_RunChecks_Click"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- RIGHT: detail -->
                    <Grid Grid.Column="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="14,10" Margin="0,0,0,10" Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Select Sheets"
                                        Click="IG_SelectSheets_Click"
                                        Style="{StaticResource SecondaryButton}" FontSize="10"
                                        ToolTip="Selects the sheets listed below in the Revit model (highlighted row only, or all rows if none is highlighted)"/>
                                <TextBlock Name="IG_TxtDetailTitle"
                                           Text="Select a check on the left to see details."
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextColor}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                            <DataGrid Name="IG_DetailGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserReorderColumns="False" CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      AlternatingRowBackground="#F6F6F6"
                                      RowBackground="{DynamicResource PanelColor}"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                                      BorderThickness="0" FontSize="11">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                        <Setter Property="Foreground" Value="#555555"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sheet No" Binding="{Binding SheetNumber}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}" Width="180" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Sev." Binding="{Binding Severity}" Width="52" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="1" Padding="14,8"
                        Background="{DynamicResource PanelColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Name="IG_BtnExport" Content="Proceed to Export Sheets →"
                                    Click="IG_Export_Click" IsEnabled="False"
                                    Style="{StaticResource ActionButton}" FontSize="11" Margin="0,0,8,0"/>
                            <Button Content="Close" Click="IG_Close_Click"
                                    Style="{StaticResource SecondaryButton}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Name="IG_TxtGateStatus" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 STEP 3 — REVISIONS  (ex. RevisionTracker, own 4-tab sub-hub)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Name="PanelRevisions" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="200" MaxWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- RT sub-nav sidebar -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,24,20,20">
                        <TextBlock Text="REVISION TRACKER" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text="v2.0 · Revit Revision System" FontSize="10"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button Name="RT_BtnTabRevisions" Content="📋  Revisions"
                                Style="{StaticResource RT_NavBtn}" Tag="Selected" Click="RT_NavBtn_Click"/>
                        <Button Name="RT_BtnTabSheets" Content="📄  Sheets"
                                Style="{StaticResource RT_NavBtn}" Click="RT_NavBtn_Click"/>
                        <Button Name="RT_BtnTabHistory" Content="🕐  History"
                                Style="{StaticResource RT_NavBtn}" Click="RT_NavBtn_Click"/>
                        <Button Name="RT_BtnTabAutoRules" Content="⚙  Auto-Rules"
                                Style="{StaticResource RT_NavBtn}" Click="RT_NavBtn_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="20,0,20,20">
                        <Separator Margin="0,0,0,10"/>
                        <StackPanel Name="RT_SideLoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <ProgressBar Name="RT_SideProgressBar" Width="160" Height="4"
                                         IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Name="RT_SideTxtStatus" Text="" FontSize="10"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <!-- RT content -->
                <Grid Grid.Column="2">

                    <!-- RT sub-tab 0: Revisions -->
                    <Grid Name="RT_TabRevisions" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Project Revisions" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                            <TextBlock Name="RT_TxtRevCount" Text="" Margin="12,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextColor}"
                                       Opacity="0.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                            <DataGrid Name="RT_GridRevisions"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      SelectionChanged="RT_RevisionGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding Sequence}" Width="40"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="Issued by" Binding="{Binding IssuedBy}" Width="130"/>
                                    <DataGridTextColumn Header="Issued to" Binding="{Binding IssuedTo}" Width="130"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="ISSUED">
                                                <Setter Property="Background" Value="#0A2060FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Open">
                                                <Setter Property="Background" Value="#0A00AA00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,14">
                            <Button Name="RT_BtnIssueRev" Content="✔ ISSUE" Style="{StaticResource ActionBtn}"
                                    Click="RT_IssueRev_Click" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Name="RT_BtnUnissueRev" Content="↩ REOPEN" Style="{StaticResource SecBtn}"
                                    Click="RT_UnissueRev_Click" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Name="RT_BtnDeleteRev" Content="Delete" Style="{StaticResource SecBtn}"
                                    Click="RT_DeleteRev_Click" IsEnabled="False"/>
                            <TextBlock Name="RT_TxtRevActionStatus" Text="" Margin="16,0,0,0"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                        </StackPanel>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Description" Style="{StaticResource RT_FieldLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Date (DD/MM/YYYY)" Style="{StaticResource RT_FieldLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Issued by" Style="{StaticResource RT_FieldLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Issued to" Style="{StaticResource RT_FieldLabel}"/>

                                <TextBox Name="RT_TxtNewDesc"     Grid.Row="1" Grid.Column="0" Style="{StaticResource RT_FieldBox}"/>
                                <TextBox Name="RT_TxtNewDate"     Grid.Row="1" Grid.Column="2" Style="{StaticResource RT_FieldBox}"/>
                                <TextBox Name="RT_TxtNewIssuedBy" Grid.Row="1" Grid.Column="4" Style="{StaticResource RT_FieldBox}"/>
                                <TextBox Name="RT_TxtNewIssuedTo" Grid.Row="1" Grid.Column="6" Style="{StaticResource RT_FieldBox}"/>
                                <Button  Name="RT_BtnCreateRev"  Grid.Row="1" Grid.Column="8"
                                         Content="+ CREATE REVISION"
                                         Style="{StaticResource ActionBtn}"
                                         Click="RT_CreateRev_Click"
                                         VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RT sub-tab 1: Sheets -->
                    <Grid Name="RT_TabSheets" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Sheet Revision Assignment"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,14"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Revision:" VerticalAlignment="Center"
                                       Margin="0,0,8,0" FontSize="11" Opacity="0.65"/>
                            <ComboBox Name="RT_CboRevision" Grid.Column="1" Height="30"
                                      DisplayMemberPath="Label"
                                      VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Prefix:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" FontSize="11" Opacity="0.65"/>
                            <TextBox Name="RT_TxtPrefix" Grid.Column="4" Height="30" Text="S"
                                     FontSize="12" Padding="6,4" BorderBrush="{DynamicResource BorderColor}"
                                     VerticalContentAlignment="Center" TextAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                            <DataGrid Name="RT_GridSheets"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AlternatingRowBackground="#06000000" Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sheet No."   Binding="{Binding Number}" Width="100"/>
                                    <DataGridTextColumn Header="Name"        Binding="{Binding Name}"   Width="*"/>
                                    <DataGridTextColumn Header="Revision"    Binding="{Binding HasRevisionText}" Width="80"/>
                                    <DataGridTextColumn Header="Discipline"  Binding="{Binding Discipline}" Width="100"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRevision}" Value="True">
                                                <Setter Property="Background" Value="#0A0055AA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,14,0,0">
                            <TextBlock Name="RT_TxtSheetStatus" Text="" Margin="0,0,14,0"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                            <Button Name="RT_BtnAutoAssign" Content="⚡ AUTO: prefix"
                                    Style="{StaticResource SecBtn}" Margin="0,0,8,0"
                                    Click="RT_AutoAssign_Click" IsEnabled="False"/>
                            <Button Name="RT_BtnAddToSel" Content="+ ADD TO SELECTION"
                                    Style="{StaticResource ActionBtn}" Margin="0,0,8,0"
                                    Click="RT_AddToSelected_Click" IsEnabled="False"/>
                            <Button Name="RT_BtnRemoveFromSel" Content="− REMOVE FROM SELECTION"
                                    Style="{StaticResource SecBtn}"
                                    Click="RT_RemoveFromSelected_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- RT sub-tab 2: History (snapshot diff) -->
                    <Grid Name="RT_TabHistory" Margin="24" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Saved snapshots"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                                <ListBox Name="RT_ListSnapshots"
                                         BorderThickness="0"
                                         Background="Transparent" FontSize="11"/>
                            </Border>
                            <Button Grid.Row="2" Content="📸 TAKE SNAPSHOT"
                                    Name="RT_BtnSnapshot" Click="RT_TakeSnapshot_Click"
                                    Style="{StaticResource ActionBtn}" Margin="0,10,0,6"/>
                            <Button Grid.Row="3" Content="Compare selected"
                                    Name="RT_BtnCompare" Click="RT_Compare_Click"
                                    Style="{StaticResource SecBtn}" Margin="0,0,0,6"
                                    IsEnabled="False"/>
                            <Button Grid.Row="4" Content="Delete Snapshot"
                                    Name="RT_BtnDeleteSnap" Click="RT_DeleteSnap_Click"
                                    Style="{StaticResource SecBtn}" IsEnabled="False"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border CornerRadius="10" Background="#E8FFE8" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Name="RT_TxtAdded" Text="0 Added" FontSize="11"
                                               Foreground="#226622" FontWeight="Bold"/>
                                </Border>
                                <Border CornerRadius="10" Background="#FFE8E8" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Name="RT_TxtRemoved" Text="0 Removed" FontSize="11"
                                               Foreground="#CC3333" FontWeight="Bold"/>
                                </Border>
                                <Border CornerRadius="10" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Name="RT_TxtChanged" Text="0 Changed" FontSize="11"
                                               Foreground="#E65C00" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Name="RT_TxtSnapInfo" Text="Select a snapshot and compare"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.5" FontSize="11"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                                <DataGrid Name="RT_GridDelta"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single"
                                          AlternatingRowBackground="#06000000" Background="Transparent"
                                          BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          SelectionChanged="RT_DeltaGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Change"    Binding="{Binding ChangeType}" Width="80"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}"   Width="160"/>
                                        <DataGridTextColumn Header="Name"    Binding="{Binding Name}"       Width="*"/>
                                        <DataGridTextColumn Header="Detail"   Binding="{Binding Detail}"     Width="260"/>
                                        <DataGridTextColumn Header="ID"        Binding="{Binding Id}"         Width="70"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChangeType}" Value="ADDED">
                                                    <Setter Property="Background" Value="#10009900"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangeType}" Value="REMOVED">
                                                    <Setter Property="Background" Value="#10CC0000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangeType}" Value="CHANGED">
                                                    <Setter Property="Background" Value="#10FF5F00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Select in model" Name="RT_BtnSelect"
                                        Click="RT_Select_Click" Style="{StaticResource SecBtn}"
                                        Margin="0,0,8,0" IsEnabled="False"/>
                                <Button Content="Export CSV" Name="RT_BtnExportDelta"
                                        Click="RT_ExportDelta_Click" Style="{StaticResource SecBtn}"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- RT sub-tab 3: Auto-Rules -->
                    <Grid Name="RT_TabAutoRules" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Auto-Assignment Rules" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Define rules: if sheet number starts with a prefix, automatically assign a revision.&#x0a;The revision is matched by the start of its Description."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sheet prefix" Style="{StaticResource RT_FieldLabel}"/>
                                    <TextBox Name="RT_TxtRulePrefix" Style="{StaticResource RT_FieldBox}"
                                             ToolTip="e.g. S, C-01, E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="→" FontSize="18" VerticalAlignment="Bottom"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"
                                           Foreground="{DynamicResource AccentColor}"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Revision description (or start of it)" Style="{StaticResource RT_FieldLabel}"/>
                                    <TextBox Name="RT_TxtRuleRevDesc" Style="{StaticResource RT_FieldBox}"
                                             ToolTip="e.g. Rev.Structures, P1, Issue A"/>
                                </StackPanel>
                                <Button Grid.Column="4" Content="Add rule" VerticalAlignment="Bottom"
                                        Style="{StaticResource ActionBtn}" Click="RT_AddRule_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Current rules:" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.65" Margin="0,0,0,6"/>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="1">
                            <ListBox Name="RT_LstRules" FontSize="12"
                                     BorderThickness="0"
                                     Background="Transparent" Padding="4"/>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Remove selected" Click="RT_RemoveRule_Click"
                                    Style="{StaticResource SecBtn}" Margin="0,0,8,0"/>
                            <Button Content="Save rules" Click="RT_SaveRules_Click_AutoRules"
                                    Style="{StaticResource SecBtn}" Margin="0,0,8,0"/>
                            <Button Content="▶ Apply rules to all sheets" Click="RT_ApplyRules_Click"
                                    Style="{StaticResource ActionBtn}"/>
                        </StackPanel>
                    </Grid>

                </Grid><!-- end RT content -->
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 STEP 4 — REVISION PACKAGE DIFF
                 ══════════════════════════════════════════════════════════ -->
            <Grid Name="PanelDiff" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="14,9">
                    <StackPanel>
                        <TextBlock Text="Revision Package Diff" FontSize="15" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Name="RPD_TxtBaselineInfo" FontSize="10" Foreground="#FFD0B0"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="14,10" Margin="14,14,14,0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button Name="RPD_BtnExport" DockPanel.Dock="Right" Content="Export Transmittal CSV"
                                Click="RPD_Export_Click" IsEnabled="False"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Compare" Click="RPD_Compare_Click"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Save Baseline"
                                Click="RPD_SaveBaseline_Click" Style="{StaticResource SecondaryButton}"/>
                        <CheckBox Name="RPD_ChkShowAll" Content="Show unchanged sheets"
                                  Foreground="{DynamicResource TextColor}" FontSize="11"
                                  VerticalAlignment="Center"
                                  Checked="RPD_ShowAll_Checked" Unchecked="RPD_ShowAll_Unchecked"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Margin="14,10,14,10" Style="{StaticResource Card}" Padding="1">
                    <DataGrid Name="RPD_DiffGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              AlternatingRowBackground="#F6F6F6"
                              RowBackground="{DynamicResource PanelColor}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                              BorderThickness="0" FontSize="11">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet No"   Binding="{Binding SheetNumber}" Width="80"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}"   Width="200"/>
                            <DataGridTextColumn Header="Change"     Binding="{Binding Change}"      Width="90"/>
                            <DataGridTextColumn Header="Prev. Rev"  Binding="{Binding OldRev}"      Width="72"/>
                            <DataGridTextColumn Header="New Rev"    Binding="{Binding NewRev}"      Width="72"/>
                            <DataGridTextColumn Header="Rev. Date"  Binding="{Binding NewDate}"     Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3" Padding="12,7"
                        Background="{DynamicResource PanelColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Close" Click="RPD_Close_Click"
                                Style="{StaticResource SecondaryButton}"/>
                        <TextBlock Name="RPD_TxtResult" FontSize="11"
                                   Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"
                                   Text="Save a baseline, then click Compare to see what changed."/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 STEP 5 — ISSUE LOG  (ex. SheetIssueManager)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Name="PanelIssueLog" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Border Width="4" Background="{DynamicResource AccentColor}" CornerRadius="2"/>
                            <TextBlock Text="Sheet Issue Manager" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColor}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Name="SIM_TxtTotal" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Close" Style="{StaticResource SecBtn}" Click="SIM_Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="250" MaxWidth="400"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Log new issue -->
                    <Grid Grid.Column="0" Background="{DynamicResource BgColor}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,14,14,14">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Log New Issue" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>

                                        <Label Content="Sheets (select in list):"/>
                                        <ListBox Name="SIM_LstSheets" Height="160" FontSize="11"
                                                 SelectionMode="Extended"
                                                 BorderBrush="{DynamicResource BorderColor}"
                                                 Margin="0,0,0,10"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 DisplayMemberPath="Display"/>

                                        <Label Content="Package / Issue code:"/>
                                        <TextBox Name="SIM_TxtPackage" Style="{StaticResource SIM_FieldBox}" Margin="0,0,0,8"/>

                                        <Label Content="Recipient:"/>
                                        <TextBox Name="SIM_TxtRecipient" Style="{StaticResource SIM_FieldBox}" Margin="0,0,0,8"/>

                                        <Label Content="Revision (leave blank to use latest):"/>
                                        <TextBox Name="SIM_TxtRevision" Style="{StaticResource SIM_FieldBox}" Margin="0,0,0,8"/>

                                        <Label Content="Issued by:"/>
                                        <TextBox Name="SIM_TxtIssuedBy" Style="{StaticResource SIM_FieldBox}" Margin="0,0,0,8"/>

                                        <Label Content="Notes:"/>
                                        <TextBox Name="SIM_TxtNotes" Height="52" TextWrapping="Wrap"
                                                 AcceptsReturn="True" FontSize="11" Padding="4"
                                                 BorderBrush="{DynamicResource BorderColor}"
                                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                        <Button Content="LOG ISSUE" Style="{StaticResource ActionBtn}"
                                                Click="SIM_LogIssue_Click" HorizontalAlignment="Stretch"/>
                                        <TextBlock Name="SIM_TxtFormStatus" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextColor}"
                                                   Opacity="0.7" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                    <!-- Issue log grid -->
                    <Grid Grid.Column="2" Margin="0,14,20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBox Name="SIM_TxtSearch" Width="200" Style="{StaticResource SIM_FieldBox}"
                                     Margin="0,0,8,0"
                                     GotFocus="SIM_Search_GotFocus" LostFocus="SIM_Search_LostFocus"
                                     TextChanged="SIM_Search_Changed"/>
                            <Button Content="Export CSV" Style="{StaticResource SecBtn}"
                                    Click="SIM_ExportCsv_Click" Margin="0,0,6,0"/>
                            <Button Content="Delete Selected" Style="{StaticResource SecBtn}"
                                    Click="SIM_DeleteSelected_Click" Margin="0,0,6,0"/>
                            <Button Content="Refresh" Style="{StaticResource SecBtn}"
                                    Click="SIM_Refresh_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                            <DataGrid Name="SIM_GridLog"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended"
                                      AlternatingRowBackground="#06000000"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      CanUserReorderColumns="False" FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date"       Binding="{Binding Date}"      Width="130"/>
                                    <DataGridTextColumn Header="Sheet"      Binding="{Binding Sheet}"     Width="80"/>
                                    <DataGridTextColumn Header="Revision"   Binding="{Binding Revision}"  Width="70"/>
                                    <DataGridTextColumn Header="Package"    Binding="{Binding Package}"   Width="100"/>
                                    <DataGridTextColumn Header="Recipient"  Binding="{Binding Recipient}" Width="130"/>
                                    <DataGridTextColumn Header="Issued By"  Binding="{Binding IssuedBy}"  Width="110"/>
                                    <DataGridTextColumn Header="Notes"      Binding="{Binding Notes}"     Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <TextBlock Name="SIM_TxtStatus" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
                </Border>
            </Grid>

            <!-- ══ Shared loading overlay (used by SetLoading for Protocol/Gate/Revisions/Diff) ══ -->
            <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA" Panel.ZIndex="100">
                <Border Style="{StaticResource Card}" Padding="28,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Processing…" HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProcessBar" Width="220" Height="8" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}" Background="#EEEEEE"/>
                        <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                                   FontSize="10" Opacity="0.6"
                                   Foreground="{DynamicResource TextColor}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid><!-- end content -->
    </Grid>
</Window>
