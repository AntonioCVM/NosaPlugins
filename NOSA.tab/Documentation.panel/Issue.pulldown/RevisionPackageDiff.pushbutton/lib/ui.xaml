<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revision Package Diff — NOSA"
        Height="560" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="14,9">
            <DockPanel>
                <CheckBox Name="ChkDarkMode" DockPanel.Dock="Right" Content="Dark"
                          Foreground="White" VerticalAlignment="Center" FontSize="11"
                          Click="Theme_Toggled"/>
                <StackPanel>
                    <TextBlock Text="Revision Package Diff" FontSize="15" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Name="TxtBaselineInfo" FontSize="10" Foreground="#FFD0B0"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Padding="14,10"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Name="BtnExport" DockPanel.Dock="Right" Content="Export Transmittal CSV"
                        Click="Export_Click" IsEnabled="False"
                        Padding="14,7" Margin="8,0,0,0"
                        Background="#E8E8E8" FontSize="11"
                        Foreground="{DynamicResource TextColor}" BorderThickness="0" Cursor="Hand"/>
                <Button DockPanel.Dock="Right" Content="Compare" Click="Compare_Click"
                        Padding="14,7" Margin="8,0,0,0"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White" FontSize="11" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
                <Button DockPanel.Dock="Right" Content="Save Baseline"
                        Click="SaveBaseline_Click" Padding="14,7"
                        Background="#3A3A3A" Foreground="White"
                        FontSize="11" BorderThickness="0" Cursor="Hand"/>
                <CheckBox Name="ChkShowAll" Content="Show unchanged sheets"
                          Foreground="{DynamicResource TextColor}" FontSize="11"
                          VerticalAlignment="Center"
                          Checked="ShowAll_Checked" Unchecked="ShowAll_Unchecked"/>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Name="DiffGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  AlternatingRowBackground="#F6F6F6"
                  RowBackground="{DynamicResource PanelColor}"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                  BorderThickness="0" FontSize="11">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#555"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sheet No"   Binding="{Binding SheetNumber}" Width="80"/>
                <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}"   Width="200"/>
                <DataGridTextColumn Header="Change"     Binding="{Binding Change}"      Width="90"/>
                <DataGridTextColumn Header="Prev. Rev"  Binding="{Binding OldRev}"      Width="72"/>
                <DataGridTextColumn Header="New Rev"    Binding="{Binding NewRev}"      Width="72"/>
                <DataGridTextColumn Header="Rev. Date"  Binding="{Binding NewDate}"     Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="12,7"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
                        Padding="12,6" Background="#E0E0E0" FontSize="11"
                        Foreground="{DynamicResource TextColor}" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Name="TxtResult" FontSize="11"
                           Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"
                           Text="Save a baseline, then click Compare to see what changed."/>
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.RowSpan="4" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Background="{DynamicResource PanelColor}" CornerRadius="6"
                    Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Processing…" HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="8" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Background="#EEE"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="10" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
