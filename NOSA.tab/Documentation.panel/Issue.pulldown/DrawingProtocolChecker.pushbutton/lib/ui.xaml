<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing Protocol Checker" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="DRAWING PROTOCOL CHECKER" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="NOSA File Naming Protocol v2.2 — field lengths, duplicates, disciplines"
                       FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextColor}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Name="TxtBanner" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Name="TxtSummary" FontSize="11" Opacity="0.65" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextColor}"/>
        </StackPanel>

        <DataGrid Name="GridResults" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" AlternatingRowBackground="#06000000"
                  BorderBrush="{DynamicResource BorderColor}" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sheet No." Binding="{Binding sheet_number}" Width="180"/>
                <DataGridTextColumn Header="Name" Binding="{Binding sheet_name}" Width="160"/>
                <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="80"/>
                <DataGridTextColumn Header="Issues" Binding="{Binding issues_text}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                      VerticalAlignment="Center"/>
            <Button Content="RE-RUN CHECKS" Click="Refresh_Click"
                    HorizontalAlignment="Right" Padding="14,8"
                    Background="{DynamicResource AccentColor}" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </Grid>

        <Grid Name="LoadingPanel" Grid.RowSpan="4" Visibility="Collapsed" Background="#CCFAFAFA">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
