<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Sheets Pro" Height="820" Width="1280"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="TextBlock" x:Key="PageTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="PageSubtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,0" BorderBrush="{DynamicResource AccentColor}" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="26,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="OutlineButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="190" MaxWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="620"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL — NAVIGATION ==================== -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,20">
                <TextBlock Text="EXPORT SHEETS" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="PRO · NOSA" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Navigation -->
            <StackPanel Grid.Row="1">
                <Button Content="1. Sheets" Style="{DynamicResource NavButton}" Name="BtnTabSheets" Click="NavButton_Click" Tag="Selected"/>
                <Button Content="2. Naming" Style="{DynamicResource NavButton}" Name="BtnTabNaming" Click="NavButton_Click"/>
                <Button Content="3. Formats" Style="{DynamicResource NavButton}" Name="BtnTabFormats" Click="NavButton_Click"/>
                <Button Content="4. Output" Style="{DynamicResource NavButton}" Name="BtnTabConfig" Click="NavButton_Click"/>
                <Button Content="5. Log" Style="{DynamicResource NavButton}" Name="BtnTabLog" Click="NavButton_Click"/>
            </StackPanel>

            <!-- Status Info -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="20">
                <StackPanel Margin="0,0,0,15">
                     <TextBlock Text="SELECTION" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                     <TextBlock Name="LblStatusSelection" Text="0 Sheets" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel>
                     <TextBlock Text="FORMATS" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                     <TextBlock Name="LblStatusFormats" Text="PDF" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Options -->
             <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <Separator Margin="0,10,0,10"/>
                <CheckBox Content="Dark Mode" Name="ChkDarkMode" Checked="Theme_Toggled" Unchecked="Theme_Toggled" Margin="0,5"/>
             </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ==================== RIGHT PANEL — CONTENT ==================== -->
        <Grid Grid.Column="2" Margin="26,24,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Pages -->
            <Grid Grid.Row="0" Name="ContentGrid">

                <!-- Tab 1: Sheets -->
                <Grid Name="TabSheets" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Select Sheets / Views" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="Mode" Content="Sheets" Name="RbSheets" IsChecked="True" Checked="Mode_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <RadioButton GroupName="Mode" Content="Views" Name="RbViews" Checked="Mode_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox Name="TxtSearch" Width="200" Margin="20,0,0,0" Padding="6,4" Tag="Search..." TextChanged="Search_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <ListView Name="ListSheets" BorderThickness="0" Background="Transparent" SelectionMode="Extended">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked}" Click="Sheet_Checked"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Number" Width="100" DisplayMemberBinding="{Binding Number}"/>
                                    <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Rev" Width="50" DisplayMemberBinding="{Binding Revision}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                 <Button Content="Select All" Style="{StaticResource OutlineButton}" Click="SelectAll_Click" Margin="0,0,8,0"/>
                                 <Button Content="Select None" Style="{StaticResource OutlineButton}" Click="SelectNone_Click" Margin="0,0,8,0"/>
                                 <Button Content="Check Selected Rows" Style="{StaticResource OutlineButton}" Click="CheckSelectedRows_Click" Margin="0,0,8,0"/>
                                 <Button Content="Invert Checks" Style="{StaticResource OutlineButton}" Click="InvertChecks_Click" Margin="0,0,8,0"/>
                                 <Button Content="Select Range..." Style="{StaticResource OutlineButton}" Click="SelectRange_Click"/>
                            </StackPanel>
                            <Expander Header="Sheet Sets" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="ComboSheetSets" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Load" Style="{StaticResource OutlineButton}" Margin="0,0,6,0" Click="LoadSet_Click"/>
                                        <Button Content="Save as..." Style="{StaticResource OutlineButton}" Margin="0,0,6,0" Click="SaveSet_Click"/>
                                        <Button Content="Issue Package..." Style="{StaticResource OutlineButton}" Margin="0,0,6,0" Click="SaveIssuePackage_Click"
                                                ToolTip="Save with issue metadata (date, purpose, revision)"/>
                                        <Button Content="Delete" Style="{StaticResource OutlineButton}" Click="DeleteSet_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tab 2: Naming -->
                <Grid Name="TabNaming" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Naming" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Naming Profile:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextColor}"/>
                                <ComboBox Name="ComboNamingProfiles" Width="200" SelectionChanged="NamingProfile_Selected" DisplayMemberPath="Name"/>
                                <Button Content="Save" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="SaveProfile_Click"/>
                                <Button Content="Delete" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="DeleteProfile_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NOSA Preset:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextColor}" FontSize="11"/>
                                <ComboBox Name="ComboNosaPresets" Width="220" VerticalContentAlignment="Center"
                                          SelectionChanged="NosaPreset_Selected"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock Text="Available Parameters" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <ListBox Name="ListParams" MouseDoubleClick="Param_DoubleClick" BorderThickness="0" Background="Transparent"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <DockPanel>
                                 <TextBlock Text="Naming Template" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                 <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
                                      <TextBlock Text="Separator:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextColor}"/>
                                      <TextBox Name="TxtSeparator" Width="40" Text="-" TextChanged="Separator_Changed"/>
                                 </StackPanel>

                                 <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                      <TextBlock Text="Preview:" Style="{StaticResource SectionTitle}" FontSize="12" Margin="0,0,0,6"/>
                                      <TextBox Name="TxtPreview" IsReadOnly="True" Background="{DynamicResource BgColor}" Padding="10"/>
                                 </StackPanel>

                                 <ListBox Name="ListTemplate" MouseDoubleClick="Template_DoubleClick" BorderThickness="0" Background="Transparent"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Tab 3: Formats -->
                <Grid Name="TabFormats" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Export Formats" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="File formats" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkPDF" Content="PDF (Portable Document Format)" Margin="0,6" IsChecked="True" Checked="Format_Changed" Unchecked="Format_Changed"/>
                            <CheckBox Name="ChkDWG" Content="DWG (AutoCAD Drawing)" Margin="0,6" Checked="Format_Changed" Unchecked="Format_Changed"/>
                            <CheckBox Name="ChkDXF" Content="DXF (Drawing Exchange Format)" Margin="0,6" Checked="Format_Changed" Unchecked="Format_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Colour mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <RadioButton GroupName="ColorMode" Name="RbUseModelColors" Content="Use model / view colours  (default)"
                                         IsChecked="True" Checked="ColorMode_Changed"
                                         Foreground="{DynamicResource TextColor}" Margin="0,4"/>
                            <RadioButton GroupName="ColorMode" Name="RbForceBlack"     Content="Force black lines  (documentation output)"
                                         Checked="ColorMode_Changed"
                                         Foreground="{DynamicResource TextColor}" Margin="0,4"/>

                            <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6"
                                    Background="#10FF5F00" BorderBrush="{DynamicResource AccentColor}" BorderThickness="0,0,0,0">
                                <TextBlock Name="TxtColorModeHint"
                                           Text="Model colours: exports use the view's colour settings.&#x0a;Force black: overrides to black lines / B&amp;W PDF — useful for printed documentation."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pre-export checks" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <CheckBox Name="ChkPreExportCheck" Content="Warn if views have temporary overrides / isolations active"
                                      IsChecked="True" Foreground="{DynamicResource TextColor}" Margin="0,4"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tab 4: Config -->
                <Grid Name="TabConfig" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Output Configuration" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Output Folder" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtFolder" Grid.Column="0" Padding="8,6"/>
                                <Button Content="..." Grid.Column="1" Style="{StaticResource OutlineButton}" Width="40" Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                 <!-- Tab 5: Log -->
                 <Grid Name="TabLog" Visibility="Collapsed">
                      <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="Export Log" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
                      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                          <TextBox Name="TxtLog" IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                      </Border>
                      <ProgressBar Name="ExportProgress" Height="20" Grid.Row="2"/>
                 </Grid>

            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
                 <DockPanel>
                      <Button DockPanel.Dock="Right" Content="START EXPORT" Style="{StaticResource ActionButton}" Click="Export_Click"/>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                 </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
