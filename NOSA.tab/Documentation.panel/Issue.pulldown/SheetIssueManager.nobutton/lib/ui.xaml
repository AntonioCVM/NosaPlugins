<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Issue Manager" Height="700" Width="1060"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding"     Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Border Width="4" Background="{DynamicResource AccentColor}" CornerRadius="2"/>
                    <TextBlock Text="Sheet Issue Manager" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Name="TxtTotal" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled" Margin="0,0,12,0"
                              Foreground="{DynamicResource TextColor}" FontSize="11"/>
                    <Button Content="Close" Style="{StaticResource SecBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" MaxWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LOG NEW ISSUE PANEL ═══ -->
            <Grid Grid.Column="0" Background="{DynamicResource BgColor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,14,14,14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Log New Issue" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>

                                <Label Content="Sheets (select in list):"/>
                                <ListBox Name="LstSheets" Height="160" FontSize="11"
                                         SelectionMode="Extended"
                                         BorderBrush="{DynamicResource BorderColor}"
                                         Margin="0,0,0,10"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         DisplayMemberPath="Display"/>

                                <Label Content="Package / Issue code:"/>
                                <TextBox Name="TxtPackage" Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

                                <Label Content="Recipient:"/>
                                <TextBox Name="TxtRecipient" Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

                                <Label Content="Revision (leave blank to use latest):"/>
                                <TextBox Name="TxtRevision" Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

                                <Label Content="Issued by:"/>
                                <TextBox Name="TxtIssuedBy" Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

                                <Label Content="Notes:"/>
                                <TextBox Name="TxtNotes" Height="52" TextWrapping="Wrap"
                                         AcceptsReturn="True" FontSize="11" Padding="4"
                                         BorderBrush="{DynamicResource BorderColor}"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                <Button Content="LOG ISSUE" Style="{StaticResource ActionBtn}"
                                        Click="LogIssue_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock Name="TxtFormStatus" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextColor}"
                                           Opacity="0.7" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- ═══ ISSUE LOG GRID ═══ -->
            <Grid Grid.Column="2" Margin="0,14,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBox Name="TxtSearch" Width="200" Style="{StaticResource FieldBox}"
                             Margin="0,0,8,0"
                             GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                             TextChanged="Search_Changed"/>
                    <Button Content="Export CSV" Style="{StaticResource SecBtn}"
                            Click="ExportCsv_Click" Margin="0,0,6,0"/>
                    <Button Content="Delete Selected" Style="{StaticResource SecBtn}"
                            Click="DeleteSelected_Click" Margin="0,0,6,0"/>
                    <Button Content="Refresh" Style="{StaticResource SecBtn}"
                            Click="Refresh_Click"/>
                </WrapPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                    <DataGrid Name="GridLog"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended"
                              AlternatingRowBackground="#06000000"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              CanUserReorderColumns="False" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"       Binding="{Binding Date}"      Width="130"/>
                            <DataGridTextColumn Header="Sheet"      Binding="{Binding Sheet}"     Width="80"/>
                            <DataGridTextColumn Header="Revision"   Binding="{Binding Revision}"  Width="70"/>
                            <DataGridTextColumn Header="Package"    Binding="{Binding Package}"   Width="100"/>
                            <DataGridTextColumn Header="Recipient"  Binding="{Binding Recipient}" Width="130"/>
                            <DataGridTextColumn Header="Issued By"  Binding="{Binding IssuedBy}"  Width="110"/>
                            <DataGridTextColumn Header="Notes"      Binding="{Binding Notes}"     Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Border>

        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" Background="#CCFAFAFA"
              Panel.ZIndex="100">
            <Border Style="{StaticResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                    <TextBlock Name="TxtStatus2" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
