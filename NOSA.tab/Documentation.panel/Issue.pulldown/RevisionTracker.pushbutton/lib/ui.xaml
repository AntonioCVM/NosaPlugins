<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revision Tracker v2.0" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#AAAAAA"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,12"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Foreground" Value="#FF5F00"/>
                    <Setter Property="Background" Value="#FFF0E8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.65"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height"      Value="28"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,24,20,20">
                <TextBlock Text="REVISION TRACKER" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="v2.0 · Revit Revision System" FontSize="10"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Button Name="BtnTabRevisions" Content="📋  Revisions"
                        Style="{DynamicResource NavBtn}" Tag="Selected"
                        Click="NavBtn_Click"/>
                <Button Name="BtnTabSheets" Content="📄  Sheets"
                        Style="{DynamicResource NavBtn}"
                        Click="NavBtn_Click"/>
                <Button Name="BtnTabHistory" Content="🕐  History"
                        Style="{DynamicResource NavBtn}"
                        Click="NavBtn_Click"/>
                <Button Name="BtnTabAutoRules" Content="⚙  Auto-Rules"
                        Style="{DynamicResource NavBtn}"
                        Click="NavBtn_Click"/>
            </StackPanel>

            <!-- Loading indicator + dark mode -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                          Margin="0,0,0,10"/>
                <StackPanel Name="SideLoadingPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center">
                <ProgressBar Name="SideProgressBar" Width="160" Height="4"
                             IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="SideTxtStatus" Text="" FontSize="10"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ══ CONTENT AREA ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- ── TAB 0: Revisiones ───────────────────────────────────────── -->
            <Grid Name="TabRevisions" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Project Revisions" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtRevCount" Text="" Margin="12,0,0,0"
                               FontSize="11" Foreground="{DynamicResource TextColor}"
                               Opacity="0.5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Revision grid -->
                <DataGrid Name="GridRevisions" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderBrush="{DynamicResource BorderColor}"
                          GridLinesVisibility="Horizontal"
                          SelectionChanged="RevisionGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No." Binding="{Binding Sequence}" Width="40"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Issued by" Binding="{Binding IssuedBy}" Width="130"/>
                        <DataGridTextColumn Header="Issued to" Binding="{Binding IssuedTo}" Width="130"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="ISSUED">
                                    <Setter Property="Background" Value="#0A2060FF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Open">
                                    <Setter Property="Background" Value="#0A00AA00"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Action bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,14">
                    <Button Name="BtnIssueRev" Content="✔ ISSUE" Style="{DynamicResource ActionBtn}"
                            Click="IssueRev_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Name="BtnUnissueRev" Content="↩ REOPEN" Style="{DynamicResource SecBtn}"
                            Click="UnissueRev_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Name="BtnDeleteRev" Content="Delete" Style="{DynamicResource SecBtn}"
                            Click="DeleteRev_Click" IsEnabled="False"/>
                    <TextBlock Name="TxtRevActionStatus" Text="" Margin="16,0,0,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                </StackPanel>

                <!-- Create form -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="16,14" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Description"
                                   Style="{DynamicResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Date (DD/MM/YYYY)"
                                   Style="{DynamicResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Issued by"
                                   Style="{DynamicResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Issued to"
                                   Style="{DynamicResource FieldLabel}"/>

                        <TextBox Name="TxtNewDesc"     Grid.Row="1" Grid.Column="0"
                                 Style="{DynamicResource FieldBox}" />
                        <TextBox Name="TxtNewDate"     Grid.Row="1" Grid.Column="2"
                                 Style="{DynamicResource FieldBox}" />
                        <TextBox Name="TxtNewIssuedBy" Grid.Row="1" Grid.Column="4"
                                 Style="{DynamicResource FieldBox}" />
                        <TextBox Name="TxtNewIssuedTo" Grid.Row="1" Grid.Column="6"
                                 Style="{DynamicResource FieldBox}" />
                        <Button  Name="BtnCreateRev"  Grid.Row="1" Grid.Column="8"
                                 Content="+ CREATE REVISION"
                                 Style="{DynamicResource ActionBtn}"
                                 Click="CreateRev_Click"
                                 VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── TAB 1: Hojas ────────────────────────────────────────────── -->
            <Grid Name="TabSheets" Margin="24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Sheet Revision Assignment"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,14"/>

                <!-- Controls -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Revision:" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontSize="11" Opacity="0.65"/>
                    <ComboBox Name="CboRevision" Grid.Column="1" Height="30"
                              DisplayMemberPath="Label"
                              SelectionChanged="CboRevision_Changed"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Prefix:" VerticalAlignment="Center"
                               Margin="0,0,6,0" FontSize="11" Opacity="0.65"/>
                    <TextBox Name="TxtPrefix" Grid.Column="4" Height="30" Text="S"
                             FontSize="12" Padding="6,4" BorderBrush="{DynamicResource BorderColor}"
                             VerticalContentAlignment="Center" TextAlignment="Center"/>
                </Grid>

                <!-- Sheet grid -->
                <DataGrid Name="GridSheets" Grid.Row="2"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderBrush="{DynamicResource BorderColor}"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sheet No."   Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="Name"        Binding="{Binding Name}"   Width="*"/>
                        <DataGridTextColumn Header="Revision"    Binding="{Binding HasRevisionText}" Width="80"/>
                        <DataGridTextColumn Header="Discipline"  Binding="{Binding Discipline}" Width="100"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRevision}" Value="True">
                                    <Setter Property="Background" Value="#0A0055AA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Action bar -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock Name="TxtSheetStatus" Text="" Margin="0,0,14,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                    <Button Name="BtnAutoAssign" Content="⚡ AUTO: prefix"
                            Style="{DynamicResource SecBtn}" Margin="0,0,8,0"
                            Click="AutoAssign_Click" IsEnabled="False"/>
                    <Button Name="BtnAddToSel" Content="+ ADD TO SELECTION"
                            Style="{DynamicResource ActionBtn}" Margin="0,0,8,0"
                            Click="AddToSelected_Click" IsEnabled="False"/>
                    <Button Name="BtnRemoveFromSel" Content="− REMOVE FROM SELECTION"
                            Style="{DynamicResource SecBtn}"
                            Click="RemoveFromSelected_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <!-- ── TAB 2: Historial (Snapshot Diff) ───────────────────────── -->
            <Grid Name="TabHistory" Margin="24" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Snapshot sidebar -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Saved snapshots"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ListBox Name="ListSnapshots" Grid.Row="1"
                             BorderBrush="{DynamicResource BorderColor}"
                             Background="White" FontSize="11"
                             SelectionChanged="Snapshot_SelectionChanged"/>
                    <Button Grid.Row="2" Content="📸 TAKE SNAPSHOT"
                            Name="BtnSnapshot" Click="TakeSnapshot_Click"
                            Style="{DynamicResource ActionBtn}" Margin="0,10,0,6"/>
                    <Button Grid.Row="3" Content="Compare selected"
                            Name="BtnCompare" Click="Compare_Click"
                            Style="{DynamicResource SecBtn}" Margin="0,0,0,6"
                            IsEnabled="False"/>
                    <Button Grid.Row="4" Content="Delete Snapshot"
                            Name="BtnDeleteSnap" Click="DeleteSnap_Click"
                            Style="{DynamicResource SecBtn}" IsEnabled="False"/>
                </Grid>

                <!-- Delta panel -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border CornerRadius="10" Background="#E8FFE8" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtAdded" Text="0 Added" FontSize="11"
                                       Foreground="#226622" FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="10" Background="#FFE8E8" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtRemoved" Text="0 Removed" FontSize="11"
                                       Foreground="#CC3333" FontWeight="Bold"/>
                        </Border>
                        <Border CornerRadius="10" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Name="TxtChanged" Text="0 Changed" FontSize="11"
                                       Foreground="#E65C00" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Name="TxtSnapInfo" Text="Select a snapshot and compare"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" FontSize="11"/>
                    </StackPanel>

                    <DataGrid Name="GridDelta" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderBrush="{DynamicResource BorderColor}"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="DeltaGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change"    Binding="{Binding ChangeType}" Width="80"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}"   Width="160"/>
                            <DataGridTextColumn Header="Name"    Binding="{Binding Name}"       Width="*"/>
                            <DataGridTextColumn Header="Detail"   Binding="{Binding Detail}"     Width="260"/>
                            <DataGridTextColumn Header="ID"        Binding="{Binding Id}"         Width="70"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="ADDED">
                                        <Setter Property="Background" Value="#10009900"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="REMOVED">
                                        <Setter Property="Background" Value="#10CC0000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="CHANGED">
                                        <Setter Property="Background" Value="#10FF5F00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Select in model" Name="BtnSelect"
                                Click="Select_Click" Style="{DynamicResource SecBtn}"
                                Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Content="Export CSV" Name="BtnExportDelta"
                                Click="ExportDelta_Click" Style="{DynamicResource SecBtn}"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── TAB 3: Auto-Rules ──────────────────────────────────────── -->
            <Grid Name="TabAutoRules" Margin="24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Auto-Assignment Rules" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Define rules: if sheet number starts with a prefix, automatically assign a revision.&#x0a;The revision is matched by the start of its Description."/>
                </StackPanel>

                <!-- Add rule form -->
                <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sheet prefix" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Name="TxtRulePrefix" Style="{DynamicResource FieldBox}"
                                     ToolTip="e.g. S, C-01, E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" FontSize="18" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"
                                   Foreground="{DynamicResource AccentColor}"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Revision description (or start of it)" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Name="TxtRuleRevDesc" Style="{DynamicResource FieldBox}"
                                     ToolTip="e.g. Rev.Structures, P1, Issue A"/>
                        </StackPanel>
                        <Button Grid.Column="4" Content="Add rule" VerticalAlignment="Bottom"
                                Style="{DynamicResource ActionBtn}" Click="AddRule_Click"/>
                    </Grid>
                </Border>

                <!-- Rules list header -->
                <TextBlock Grid.Row="2" Text="Current rules:" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.65" Margin="0,0,0,6"/>

                <!-- Rules list -->
                <ListBox Name="LstRules" Grid.Row="3" FontSize="12"
                         BorderBrush="{DynamicResource BorderColor}"
                         Background="White" Padding="4"/>

                <!-- Action buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Remove selected" Click="RemoveRule_Click"
                            Style="{DynamicResource SecBtn}" Margin="0,0,8,0"/>
                    <Button Content="Save rules" Click="SaveRules_Click_AutoRules"
                            Style="{DynamicResource SecBtn}" Margin="0,0,8,0"/>
                    <Button Content="▶ Apply rules to all sheets" Click="ApplyRules_Click"
                            Style="{DynamicResource ActionBtn}"/>
                </StackPanel>
            </Grid>

        </Grid><!-- end content area -->
    </Grid>
</Window>

