<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revision Package Diff — NOSA"
        Height="560" Width="840"
        MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="14,9">
            <DockPanel>
                <CheckBox Name="ChkDarkMode" DockPanel.Dock="Right" Content="Dark"
                          Foreground="White" VerticalAlignment="Center" FontSize="11"
                          Click="Theme_Toggled"/>
                <StackPanel>
                    <TextBlock Text="Revision Package Diff" FontSize="15" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Name="TxtBaselineInfo" FontSize="10" Foreground="#FFD0B0"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Padding="14,10" Margin="14,14,14,0"
                Style="{StaticResource Card}">
            <DockPanel>
                <Button Name="BtnExport" DockPanel.Dock="Right" Content="Export Transmittal CSV"
                        Click="Export_Click" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Compare" Click="Compare_Click"
                        Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Save Baseline"
                        Click="SaveBaseline_Click" Style="{StaticResource SecondaryButton}"/>
                <CheckBox Name="ChkShowAll" Content="Show unchanged sheets"
                          Foreground="{DynamicResource TextColor}" FontSize="11"
                          VerticalAlignment="Center"
                          Checked="ShowAll_Checked" Unchecked="ShowAll_Unchecked"/>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Margin="14,10,14,10" Style="{StaticResource Card}" Padding="1">
            <DataGrid Name="DiffGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      AlternatingRowBackground="#F6F6F6"
                      RowBackground="{DynamicResource PanelColor}"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                      BorderThickness="0" FontSize="11">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="Foreground" Value="#555"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sheet No"   Binding="{Binding SheetNumber}" Width="80"/>
                    <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}"   Width="200"/>
                    <DataGridTextColumn Header="Change"     Binding="{Binding Change}"      Width="90"/>
                    <DataGridTextColumn Header="Prev. Rev"  Binding="{Binding OldRev}"      Width="72"/>
                    <DataGridTextColumn Header="New Rev"    Binding="{Binding NewRev}"      Width="72"/>
                    <DataGridTextColumn Header="Rev. Date"  Binding="{Binding NewDate}"     Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="12,7"
                Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
                        Style="{StaticResource SecondaryButton}"/>
                <TextBlock Name="TxtResult" FontSize="11"
                           Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"
                           Text="Save a baseline, then click Compare to see what changed."/>
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Grid Name="LoadingPanel" Grid.RowSpan="4" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{StaticResource Card}"
                    Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing…" HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="8" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Background="#EEE"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="10" Opacity="0.6"
                               Foreground="{DynamicResource TextColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
