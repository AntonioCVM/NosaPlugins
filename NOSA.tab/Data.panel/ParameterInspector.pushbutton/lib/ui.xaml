<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Inspector v1.0" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="TextBox" x:Key="SearchBox">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Padding"        Value="8,4"/>
            <Setter Property="Height"         Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="PARAMETER" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="INSPECTOR" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtElementCount" Text="0 elements" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <TextBlock Text="Filters" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                    <CheckBox Name="ChkShowBuiltin" Content="Built-in params"  IsChecked="True"
                              Click="Filter_Changed"/>
                    <CheckBox Name="ChkShowShared"  Content="Shared params"    IsChecked="True"
                              Click="Filter_Changed"/>
                    <CheckBox Name="ChkShowProject"  Content="Project params"  IsChecked="True"
                              Click="Filter_Changed"/>
                    <CheckBox Name="ChkOnlyDiffs"    Content="Differences only" IsChecked="False"
                              Click="Filter_Changed"/>
                    <CheckBox Name="ChkOnlyWritable" Content="Writable only"   IsChecked="False"
                              Click="Filter_Changed"/>

                    <Separator Margin="0,14,0,12"/>

                    <TextBlock Text="Bulk Edit" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                    <TextBlock Text="New value:" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <TextBox Name="TxtNewValue" Height="26" Padding="6,3" FontSize="11"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BorderColor}"/>
                    <Button Content="Apply to Selected Row" Name="BtnApply"
                            Click="Apply_Click" Style="{DynamicResource SecondaryButton}"
                            Margin="0,8,0,0" IsEnabled="False"/>

                    <Separator Margin="0,14,0,12"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode"
                              Click="Theme_Toggled" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="LOAD SELECTION" Name="BtnLoad"
                    Click="Load_Click" Style="{DynamicResource ActionButton}"
                    Margin="20,0,20,8"/>
            <Button Grid.Row="3" Content="Copy From First" Name="BtnCopyFrom"
                    Click="CopyFrom_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,8" IsEnabled="False"
                    ToolTip="Copy all writable params from first selected element to the rest"/>
            <Button Grid.Row="4" Content="Export CSV" Name="BtnExport"
                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search + pills row -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="TxtSearch" Style="{DynamicResource SearchBox}"
                         Text="Search parameters..."
                         GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                         TextChanged="Search_Changed"
                         Foreground="Gray"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Name="TxtTotalParams" Text="0 params" FontSize="11"
                                   Foreground="#666" FontWeight="Bold"/>
                    </Border>
                    <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4">
                        <TextBlock Name="TxtDiffParams" Text="0 diffs" FontSize="11"
                                   Foreground="#CC3333" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Parameter grid -->
            <DataGrid Name="GridParams" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#06000000" Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Group"      Binding="{Binding Group}"   Width="130"/>
                    <DataGridTextColumn Header="Parameter"  Binding="{Binding Name}"    Width="200"/>
                    <DataGridTextColumn Header="Type"       Binding="{Binding Storage}" Width="70"/>
                    <DataGridTextColumn Header="R/W"        Binding="{Binding RW}"      Width="40"/>
                    <DataGridTextColumn Header="Value(s)"   Binding="{Binding ValueStr}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDiff}" Value="True">
                                <Setter Property="Background" Value="#18CC0000"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Loading panel -->
            <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Collecting parameters..." HorizontalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ProgressBar Name="ProcessBar" Width="240" Height="12"
                                 IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
