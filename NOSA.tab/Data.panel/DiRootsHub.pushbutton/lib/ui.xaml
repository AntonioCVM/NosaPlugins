<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiRoots-style tools hub" Width="462" Height="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Century Gothic" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
    </Window.Resources>
    <Grid Margin="26" Background="{DynamicResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="NOSA bulk editing" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="Jump into instance or ElementType workspaces"
                       Margin="0,8,0,0" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextColor}"/>
        </StackPanel>
        <Separator Grid.Row="1" Margin="0,18,0,18"/>
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <Button Name="BtnInstances" Margin="0,0,0,14" Padding="26,22" FontWeight="SemiBold"
                    FontSize="15" Cursor="Hand" Click="Instances_Click"/>
            <Button Name="BtnTypes" Margin="0,0,0,22" Padding="26,22" FontWeight="SemiBold"
                    FontSize="15" Cursor="Hand" Click="Types_Click"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.75" Foreground="{DynamicResource TextColor}"
                       Text="Instance grid lives on Data › Bulk Parameter. Type grid lives under Structures › Elements › Structural Types."/>
            <Separator Margin="0,18,0,12"/>
            <CheckBox Name="ChkDarkMode" FontSize="11" Content="Dark mode" Click="Theme_Toggled"/>
        </StackPanel>
    </Grid>
</Window>
