<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worksharing Audit" Height="720" Width="1160"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="TextBlock" x:Key="WA_SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="WORKSHARING AUDIT" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Element ownership, editing history, and default-workset hygiene" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT PANEL: SCOPE, ACTIONS & FILTERS ═══ -->
            <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,10">

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Scope" Style="{StaticResource WA_SectionTitle}"/>
                                <CheckBox Name="ChkEntireModel" Content="Scan entire model (slower)"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Unchecked scans the active view only."
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.55"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Actions" Style="{StaticResource WA_SectionTitle}"/>
                                <Button Content="Run Audit" Name="BtnAudit"
                                        Click="Audit_Click" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>
                                <Button Content="Export to CSV" Name="BtnExport"
                                        Click="Export_Click" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="Filters" Style="{StaticResource WA_SectionTitle}"/>
                                <TextBlock Text="Search (category / name / owner):" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                <TextBox Name="TxtSearch" Height="26" Padding="4,2" FontSize="11"
                                         VerticalContentAlignment="Center" Margin="0,0,0,10"
                                         TextChanged="Filter_Changed"/>
                                <CheckBox Name="ChkOnlyCheckedOut" Content="Only checked-out elements"
                                          Click="Filter_Changed" Margin="0,0,0,6"/>
                                <CheckBox Name="ChkOnlyDefaultWorkset" Content="Only default-workset elements"
                                          Click="Filter_Changed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- ═══ RIGHT PANEL: RESULTS ═══ -->
            <Grid Grid.Column="2" Margin="20,16,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="TxtSummary"
                           Text="Run an audit to list element ownership and editing history."
                           FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1" Margin="0,0,0,16">
                    <DataGrid Name="GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category"        Binding="{Binding Category}"       Width="130"/>
                            <DataGridTextColumn Header="Id"              Binding="{Binding ElemId}"          Width="80"/>
                            <DataGridTextColumn Header="Element"         Binding="{Binding ElemName}"        Width="150"/>
                            <DataGridTextColumn Header="Workset"         Binding="{Binding Workset}"         Width="130"/>
                            <DataGridTextColumn Header="Creator"         Binding="{Binding Creator}"         Width="110"/>
                            <DataGridTextColumn Header="Last changed by" Binding="{Binding LastChangedBy}"   Width="120"/>
                            <DataGridTextColumn Header="Checkout"        Binding="{Binding Checkout}"        Width="120"/>
                            <DataGridTextColumn Header="On default WS?"  Binding="{Binding OnDefaultStr}"    Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OnDefault}" Value="True">
                                        <Setter Property="Background" Value="#12FF5F00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Checkout}" Value="Owned by other">
                                        <Setter Property="Background" Value="#12FF0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Shared loading overlay (NOSAWindow standard) -->
        <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      Foreground="{DynamicResource TextColor}"/>
        </Border>
    </Grid>
</Window>
