<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Setup Wizard v1.0" Height="640" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.65"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height"      Value="28"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="White" Margin="0,0,0,1">
            <StackPanel Margin="28,20,28,20">
                <TextBlock Text="PROJECT SETUP WIZARD" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="One-click NOSA project configuration — select the steps to run"
                           FontSize="11" Opacity="0.55"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,10">

                <!-- Project Information -->
                <Border Background="White" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Name="ChkProjectInfo" IsChecked="True" Margin="0,0,0,12">
                            <TextBlock Text="Set project information" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}"/>
                        </CheckBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Project Name" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Name="TxtName" Style="{DynamicResource FieldBox}"/>
                                <TextBlock Text="Project Number" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Name="TxtNumber" Style="{DynamicResource FieldBox}"/>
                                <TextBlock Text="Building Code (e.g. EC2, BS8110)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Name="TxtCode" Style="{DynamicResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Client" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Name="TxtClient" Style="{DynamicResource FieldBox}"/>
                                <TextBlock Text="Site Address" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Name="TxtAddress" Style="{DynamicResource FieldBox}"/>
                                <TextBlock Text="Status (e.g. PLANNING APPLICATION)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Name="TxtStatus" Style="{DynamicResource FieldBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Worksets -->
                <Border Background="White" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Name="ChkWorksets" IsChecked="True" Margin="0,0,0,6">
                            <TextBlock Text="Create NOSA worksets" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}"/>
                        </CheckBox>
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
Creates: NOSA_Structure · NOSA_Architecture · NOSA_MEP · NOSA_Links · NOSA_Coordination · Shared Levels and Grids.
Skips any workset that already exists. Requires worksharing to be enabled.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Levels -->
                <Border Background="White" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Name="ChkLevels" IsChecked="True" Margin="0,0,0,6">
                            <TextBlock Text="Create standard levels" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}"/>
                        </CheckBox>
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
Creates Foundation (−1500 mm) · Ground Floor (0) · First Floor (+3000 mm) · Roof (+6000 mm).
Only runs if fewer than 2 levels currently exist in the model.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Sheets -->
                <Border Background="White" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Name="ChkSheets" IsChecked="True" Margin="0,0,0,6">
                            <TextBlock Text="Create standard sheets" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}"/>
                        </CheckBox>
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
Creates: 00-00 Cover Sheet · 00-01 Drawing Index.
Uses the first title block type available in the project.
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="28,16" Margin="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Name="ChkDarkMode" Grid.Column="0" Content="Dark Mode"
                          Click="Theme_Toggled" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                           Text="Select the steps above, then click Configure."/>
                <Button Grid.Column="2" Content="▶ CONFIGURE PROJECT"
                        Style="{DynamicResource ActionBtn}" Click="Configure_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
