<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Sync v1.0" Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="EXCEL" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="SYNC" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextColor}"
                           Opacity="0.6" Margin="0,4,0,0"
                           Text="CSV → Revit Parameters"/>
            </StackPanel>

            <!-- Controls -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <!-- File -->
                    <TextBlock Text="CSV File" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                    <Button Content="Browse CSV..." Name="BtnBrowse"
                            Click="Browse_Click" Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,0,6"/>
                    <TextBlock Name="TxtFilePath" Text="No file selected"
                               FontSize="10" Foreground="Gray" TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <!-- Key column -->
                    <TextBlock Text="Key column:" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <ComboBox Name="CboKeyCol" Height="26" FontSize="11"
                              SelectionChanged="KeyCol_Changed" Margin="0,0,0,10"/>

                    <!-- Match by -->
                    <TextBlock Text="Match elements by:" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                    <RadioButton Name="RdoMark"     Content="Mark parameter" IsChecked="True"/>
                    <RadioButton Name="RdoUniqueId" Content="UniqueId"/>

                    <Separator Margin="0,14,0,12"/>

                    <Button Content="LOAD &amp; PREVIEW" Name="BtnLoad"
                            Click="Load_Click" Style="{DynamicResource ActionButton}"
                            Margin="0,0,0,8"/>
                    <Button Content="APPLY TO MODEL" Name="BtnApply"
                            Click="Apply_Click" Style="{DynamicResource ActionButton}"
                            Margin="0,0,0,0" IsEnabled="False"/>

                    <Separator Margin="0,12,0,8"/>
                    <TextBlock Name="TxtStatus" Text="" FontSize="10"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap" Opacity="0.7"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Dark mode -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- CSV Preview header -->
            <TextBlock Grid.Row="0" Text="CSV Preview" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

            <!-- CSV Preview content -->
            <Grid Grid.Row="1">
                <TextBox Name="TxtPreview" IsReadOnly="True" FontFamily="Consolas"
                         FontSize="11" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                         Padding="8" TextWrapping="NoWrap"/>

                <!-- Loading overlay -->
                <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                    <Border Background="White" CornerRadius="6" Padding="24,16"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Working..." HorizontalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,12"/>
                            <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Name="TxtLoadingStatus" Text="" HorizontalAlignment="Center"
                                       FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Mapping header -->
            <TextBlock Grid.Row="2" Text="Column Mapping  (CSV column → Revit parameter name)"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,18,0,8"/>

            <!-- Mapping rows (built dynamically in code) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="MappingPanel" Margin="0,0,0,0"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
