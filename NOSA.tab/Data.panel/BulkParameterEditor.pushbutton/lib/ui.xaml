<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Bulk Parameter Editor v2.0" Height="744" Width="1240"

        WindowStartupLocation="CenterScreen"

        Background="{DynamicResource BgColor}" FontFamily="Century Gothic"

        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>

        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextColor" Color="#333333"/>

        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>

        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="ActionButton">

            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Padding" Value="14,8"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Padding" Value="10,6"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>

            <Setter Property="Cursor" Value="Hand"/>

        </Style>

        <Style TargetType="TextBox" x:Key="FieldBox">

            <Setter Property="Height" Value="26"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="Padding" Value="4,2"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="356"/>

            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="1*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="18,26,18,14">

                <TextBlock Text="BULK PARAMETER" FontSize="15" FontWeight="Bold"

                           Foreground="{DynamicResource AccentColor}"/>

                <TextBlock Text="EDITOR" FontSize="15" FontWeight="Bold"

                           Foreground="{DynamicResource AccentColor}"/>

                <TextBlock Name="TxtStatusHint" FontSize="10" TextWrapping="Wrap"

                           Foreground="{DynamicResource TextColor}" Opacity="0.62" Margin="0,8,0,0"/>

            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="18,0,18,12">

                    <TextBlock Text="Presets (category + filters + parameters)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>

                    <ComboBox Name="ComboPresetPick" Height="26" Margin="0,0,0,8"

                              SelectionChanged="PresetLoad_Changed"/>

                    <StackPanel Orientation="Horizontal">

                        <TextBox Name="TxtPresetSaveName" Width="160" Margin="0,0,8,12" Style="{DynamicResource FieldBox}"

                                 ToolTip="Name your preset"/>

                        <Button Content="Save preset" Click="PresetSave_Click" Width="146" Margin="0,0,0,12" Style="{DynamicResource SecondaryButton}"/>

                    </StackPanel>



                    <TextBlock Text="Category" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>

                    <ComboBox Name="ComboCategory" Height="28" DisplayMemberPath="Title"

                              SelectionChanged="Category_Changed"/>



                    <CheckBox Name="ChkRestrictSelection" Margin="0,10,0,4"

                              Content="Limit scan to current Revit selection (category ∩ selection)"

                              Foreground="{DynamicResource TextColor}"/>

                    <CheckBox Name="ChkExcludeNonModifiable" Margin="0,0,0,4"

                              Content="Exclude non-modifiable instances (borrowed / read-only workset)"

                              Foreground="{DynamicResource TextColor}"/>

                    <CheckBox Name="ChkOpenWorksetsOnly" Margin="0,0,0,6"

                              Content="Exclude elements on closed worksets (workshared projects)"

                              Foreground="{DynamicResource TextColor}"/>

                    <TextBlock FontSize="9" FontStyle="Italic" TextWrapping="Wrap"

                               Foreground="{DynamicResource TextColor}" Opacity="0.7"

                               Text="Active document only; linked models cannot be queried from this collector."/>



                    <TextBlock Text="Filter family/substr (contains)" FontSize="10" Margin="0,12,0,3"/>

                    <TextBox Name="TxtFamFilter" Style="{DynamicResource FieldBox}"/>

                    <TextBlock Text="Filter type / instance name (contains)" FontSize="10" Margin="0,8,0,3"/>

                    <TextBox Name="TxtTypeFilter" Style="{DynamicResource FieldBox}"/>



                    <Button Content="SCAN ELEMENTS" Name="BtnScan" Click="Scan_Click"

                            Style="{DynamicResource SecondaryButton}" Margin="0,12,0,0"/>

                    <TextBlock Name="TxtRowCount" Text="0 instances" Margin="0,8,0,0"

                               FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"/>

                    <Separator Margin="0,14,0,12"/>

                    <TextBlock Text="Parameter filter &amp; scope" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                    <TextBox Name="TxtParamFilter" Height="26" Margin="0,0,0,8" Style="{DynamicResource FieldBox}"

                             TextChanged="ParamFilter_TextChanged" ToolTip="Filters list by substring (contains)"/>

                    <ComboBox Name="ComboParamScope" Height="26" Margin="0,0,0,8"

                              SelectionChanged="ParamScope_Changed"/>

                    <TextBlock Text="Primary parameter (editable)" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,4"/>

                    <ComboBox Name="ComboParam" Height="26" Margin="0,0,0,8"

                              IsEditable="True" SelectionChanged="Param_SelectionChanged"/>

                    <TextBlock Text="Secondary column (read-only reference)" FontSize="10" Margin="0,0,0,4"/>

                    <ComboBox Name="ComboParamAux" Height="26" Margin="0,0,0,8"

                              SelectionChanged="AuxParam_SelectionChanged"/>

                    <CheckBox Name="ChkWritableOnlyDiscover" Content="Discover writable-only when scanning"

                              Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>

                    <Separator Margin="0,6,0,12"/>

                    <TextBlock Text="Apply same value (optional)" FontSize="10" Margin="0,0,0,3"/>

                    <TextBox Name="TxtApplyAll" Style="{DynamicResource FieldBox}" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <Button Content="Fill New from field (all rows)" Padding="10,6" FontSize="10"

                                Click="FillAll_Click" Style="{DynamicResource SecondaryButton}"

                                Margin="0,0,8,0"/>

                        <CheckBox Name="ChkWritableApply" VerticalAlignment="Center"

                                  Content="Hide read-only in grid" IsChecked="True"

                                  Foreground="{DynamicResource TextColor}"/>

                    </StackPanel>

                    <CheckBox Name="ChkDryRunPreview" Margin="0,0,0,10" Content="Detailed preview dialog before APPLY"

                              IsChecked="True" Foreground="{DynamicResource TextColor}"/>

                    <Button Content="APPLY CHANGES" Name="BtnApply" Click="Apply_Click"

                            Style="{DynamicResource ActionButton}" Margin="0,0,0,8"/>

                    <Button Content="EXPORT CSV…" Click="Export_Click" Style="{DynamicResource SecondaryButton}"/>

                </StackPanel>

            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="18,0,18,18">

                <Separator Margin="0,0,0,10"/>

                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>

            </StackPanel>

        </Grid>

        <Grid Grid.Column="1">

            <DataGrid Name="GridMain" AutoGenerateColumns="False"

                      Margin="22" CanUserAddRows="False"

                      SelectionMode="Extended"

                      BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"

                      GridLinesVisibility="Horizontal" Background="Transparent"

                      AlternatingRowBackground="#07000000"

                      BeginningEdit="Grid_Main_BeginningEdit">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Family : Type" Binding="{Binding FamType}" Width="280" IsReadOnly="True"/>

                    <DataGridTextColumn Header="Name" Binding="{Binding InstName}" Width="140" IsReadOnly="True"/>

                    <DataGridTextColumn Header="Elem Id" Binding="{Binding ElemId}" Width="90" IsReadOnly="True"/>

                    <DataGridTextColumn Header="Aux ref" Binding="{Binding AuxVal}" Width="160" IsReadOnly="True"/>

                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentVal}" Width="180" IsReadOnly="True"/>

                    <DataGridTextColumn Header="New" Binding="{Binding NewVal}" Width="240"/>

                </DataGrid.Columns>

            </DataGrid>

            <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA"

                  Margin="22" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                <Border Padding="24,14" HorizontalAlignment="Center" VerticalAlignment="Center"

                        Background="#FFFFFFFF" CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

                    <StackPanel>

                        <TextBlock Name="TxtLoadingMsg" HorizontalAlignment="Center" FontWeight="SemiBold"/>

                        <ProgressBar Width="210" Height="10" Margin="0,14,0,0" IsIndeterminate="True"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>

