<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Cleanup Pro v2.0" Height="700" Width="1060"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="b" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background"  Value="#20FF5F00"/>
                                <Setter Property="Foreground"  Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter TargetName="b" Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#CC3333"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#CC3333"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="210" MaxWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="MODEL CLEANUP PRO" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Find &amp; remove waste from the model"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Name="BtnTabOrphans"   Content="Orphan Views"      Style="{DynamicResource NavButton}" Tag="Selected" Click="NavButton_Click"/>
                    <Button Name="BtnTabFamilies"  Content="Unused Families"   Style="{DynamicResource NavButton}" Click="NavButton_Click"/>
                    <Button Name="BtnTabTemplates" Content="Unused Templates"  Style="{DynamicResource NavButton}" Click="NavButton_Click"/>
                    <Button Name="BtnTabCAD"       Content="CAD Imports"       Style="{DynamicResource NavButton}" Click="NavButton_Click"/>
                    <Button Name="BtnTabRooms"     Content="Unplaced Rooms"    Style="{DynamicResource NavButton}" Click="NavButton_Click"/>
                    <Button Name="BtnTabWarnings"  Content="Trivial Warnings"  Style="{DynamicResource NavButton}" Click="NavButton_Click"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,10,20,20">
                <Button Content="SCAN MODEL" Name="BtnScan"
                        Click="Scan_Click" Style="{StaticResource ActionButton}"
                        Margin="0,0,0,10"/>
                <CheckBox Name="ChkDryRun" Content="Dry Run (preview only)"
                          ToolTip="Shows what would be deleted without making any changes"
                          Margin="0,0,0,8"/>
                <Button Content="Delete Selected" Name="BtnPurge"
                        Click="Purge_Click" Style="{StaticResource DangerButton}"
                        IsEnabled="False" Margin="0,0,0,8"
                        ToolTip="Delete selected rows (Ctrl+click or Shift+click to multi-select)"/>
                <Button Content="Quick Purge All" Name="BtnQuickPurgeAll"
                        Click="QuickPurgeAll_Click" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,0,14"
                        ToolTip="Scan model and delete ALL orphan views, unused families, templates, CAD imports and unplaced rooms in one step"/>
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary pills -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,6">
                    <TextBlock Name="TxtOrphans"   Text="0 orphan views"     FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFF3E0" Padding="10,4" Margin="0,0,8,6">
                    <TextBlock Name="TxtFamilies"  Text="0 unused types"     FontSize="11" Foreground="#E65C00" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,8,6">
                    <TextBlock Name="TxtTemplates" Text="0 unused templates" FontSize="11" Foreground="#666" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,6">
                    <TextBlock Name="TxtCAD"       Text="0 CAD imports"      FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4" Margin="0,0,8,6">
                    <TextBlock Name="TxtRooms"     Text="0 unplaced rooms"   FontSize="11" Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#F0F0F0" Padding="10,4" Margin="0,0,0,6">
                    <TextBlock Name="TxtWarnings"  Text="0 trivial warnings" FontSize="11" Foreground="#666" FontWeight="Bold"/>
                </Border>
            </WrapPanel>

            <!-- Content area — stacked DataGrids, only one visible at a time -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                <Grid>

                    <!-- Orphan Views -->
                    <DataGrid Name="TabOrphans" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding VType}" Width="130"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}"  Width="*"/>
                            <DataGridTextColumn Header="ID"   Binding="{Binding Id}"    Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Unused Families -->
                    <DataGrid Name="TabFamilies" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="Family"   Binding="{Binding Family}"   Width="*"/>
                            <DataGridTextColumn Header="Type"     Binding="{Binding TypeName}" Width="*"/>
                            <DataGridTextColumn Header="ID"       Binding="{Binding Id}"       Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Unused Templates -->
                    <DataGrid Name="TabTemplates" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Template Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="ID"            Binding="{Binding Id}"   Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- CAD Imports -->
                    <DataGrid Name="TabCAD" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"  Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="View"  Binding="{Binding View}" Width="*"/>
                            <DataGridTextColumn Header="Kind"  Binding="{Binding Kind}" Width="70"/>
                            <DataGridTextColumn Header="ID"    Binding="{Binding Id}"   Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Unplaced Rooms -->
                    <DataGrid Name="TabRooms" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="80"/>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"   Width="*"/>
                            <DataGridTextColumn Header="Level"  Binding="{Binding Level}"  Width="150"/>
                            <DataGridTextColumn Header="ID"     Binding="{Binding Id}"     Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Trivial Warnings -->
                    <DataGrid Name="TabWarnings" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Elements"    Binding="{Binding ElementCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading overlay -->
                    <Grid Name="LoadingPanel" Visibility="Collapsed"
                          Background="#AAFAFAFA" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Scanning model..." HorizontalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                            <ProgressBar Name="ProcessBar" Width="200" Height="12"
                                         IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                       FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextColor}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom toolbar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Select in Model" Name="BtnSelect" Click="Select_Click"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" IsEnabled="False"/>
                <Button Content="Export CSV" Name="BtnExport" Click="Export_Click"
                        Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
