<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type Renamer" Height="680" Width="1000"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TYPE RENAMER" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="230" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Controls panel -->
            <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Category" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                <ComboBox Name="CboCategory" FontSize="11"
                                          SelectionChanged="Category_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Mode" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                <RadioButton Name="RbFindReplace" Content="Find &amp; Replace"
                                             GroupName="Mode" Checked="Mode_Changed"/>
                                <RadioButton Name="RbPrefixSuffix" Content="Add Prefix / Suffix"
                                             GroupName="Mode" Checked="Mode_Changed"/>

                                <StackPanel Name="PnlFindReplace" Margin="0,10,0,0">
                                    <TextBlock Text="Find:" FontSize="11" Opacity="0.65"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtFind" Style="{StaticResource FieldBox}" Margin="0,0,0,8"
                                             TextChanged="Rule_Changed"/>
                                    <TextBlock Text="Replace with:" FontSize="11" Opacity="0.65"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtReplace" Style="{StaticResource FieldBox}"
                                             TextChanged="Rule_Changed"/>
                                </StackPanel>

                                <StackPanel Name="PnlPrefixSuffix" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Prefix:" FontSize="11" Opacity="0.65"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtPrefix" Style="{StaticResource FieldBox}" Margin="0,0,0,8"
                                             TextChanged="Rule_Changed"/>
                                    <TextBlock Text="Suffix:" FontSize="11" Opacity="0.65"
                                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                    <TextBox Name="TxtSuffix" Style="{StaticResource FieldBox}"
                                             TextChanged="Rule_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="SELECT ALL" Style="{StaticResource SecondaryButton}"
                                Click="SelectAll_Click" Margin="0,0,0,8"/>
                        <Button Content="APPLY RENAME" Style="{StaticResource ActionButton}"
                                Click="ApplyRename_Click"/>
                        <TextBlock Name="TxtFormStatus" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}"
                                   Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Preview grid -->
            <Grid Grid.Column="2" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preview — select types to rename"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Grid.Column="1" Text="Search:" FontSize="11"
                               VerticalAlignment="Center" Opacity="0.6" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Column="2" Name="TxtSearch" Width="160" FontSize="11"
                             Padding="4,2" VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BorderColor}"
                             TextChanged="Search_Changed"/>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                    <DataGrid Name="GridTypes"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              AlternatingRowBackground="#06000000"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              CanUserReorderColumns="False" FontSize="11"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Current name" Binding="{Binding Name}"    Width="*"/>
                            <DataGridTextColumn Header="New name"     Binding="{Binding NewName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Border>

        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" Background="#CCFAFAFA"
              Panel.ZIndex="100">
            <Border Background="White" CornerRadius="8" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Renaming types..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
