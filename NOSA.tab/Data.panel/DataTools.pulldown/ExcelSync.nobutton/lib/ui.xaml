<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Sync v1.0" Height="680" Width="960"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ModeButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="230" MaxWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + mode -->
            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="EXCEL SYNC" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Name="BtnModeParams" Content="Parameters" Tag="Active"
                            Click="Mode_Click" Style="{DynamicResource ModeButton}"
                            Margin="0,0,6,0"/>
                    <Button Name="BtnModeTable" Content="Import Table"
                            Click="Mode_Click" Style="{DynamicResource ModeButton}"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,10">

                <StackPanel Name="PanelModeParams">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CSV File" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <Button Content="Browse CSV..." Name="BtnBrowse"
                                    Click="Browse_Click" Style="{DynamicResource SecondaryButton}"
                                    Margin="0,0,0,6"/>
                            <TextBlock Name="TxtFilePath" Text="No file selected"
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Key column:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                            <ComboBox Name="CboKeyCol" Height="26" FontSize="11"
                                      SelectionChanged="KeyCol_Changed" Margin="0,0,0,10"/>

                            <TextBlock Text="Match elements by:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                            <RadioButton Name="RdoMark"     Content="Mark parameter" IsChecked="True"/>
                            <RadioButton Name="RdoUniqueId" Content="UniqueId"/>
                        </StackPanel>
                    </Border>

                    <Button Content="LOAD &amp; PREVIEW" Name="BtnLoad"
                            Click="Load_Click" Style="{DynamicResource ActionButton}"
                            Margin="0,0,0,8"/>
                    <Button Content="APPLY TO MODEL" Name="BtnApply"
                            Click="Apply_Click" Style="{DynamicResource ActionButton}"
                            Margin="0,0,0,10" IsEnabled="False"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Export Revit → Excel" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                            <TextBlock Text="Parameters to export (one per line):" FontSize="10"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" Opacity="0.7"/>
                            <TextBox Name="TxtExportParams" Height="80" FontSize="11"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Padding="4" ToolTip="Enter Revit parameter names to export, one per line"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     Margin="0,0,0,8"/>
                            <Button Content="EXPORT FROM MODEL" Name="BtnExport"
                                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                                    Margin="0,0,0,0"
                                    ToolTip="Write current Revit parameter values to a new CSV file"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Name="TxtStatus" Text="" FontSize="10"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Name="PanelModeTable" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Excel workbook" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                            <Button Content="Browse Excel..." Name="BtnTblBrowse"
                                    Click="TblBrowse_Click" Style="{DynamicResource SecondaryButton}"
                                    Margin="0,0,0,6"/>
                            <TextBlock Name="TxtTblFilePath" Text="No file selected"
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Worksheet:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                            <ComboBox Name="CboTblSheet" Height="26" FontSize="11"
                                      SelectionChanged="TblSheet_Changed" Margin="0,0,0,10"/>
                            <TextBlock Text="Key column:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                            <ComboBox Name="CboTblKeyCol" Height="26" FontSize="11"
                                      SelectionChanged="TblKeyCol_Changed" Margin="0,0,0,10"/>
                            <TextBlock Text="Match elements by:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                            <RadioButton Name="RdoTblMark" Content="Mark parameter" IsChecked="True"/>
                            <RadioButton Name="RdoTblUniqueId" Content="UniqueId"/>
                        </StackPanel>
                    </Border>

                    <Button Content="LOAD TABLE" Name="BtnTblLoad"
                            Click="TblLoad_Click" Style="{DynamicResource ActionButton}"
                            Margin="0,0,0,8"/>
                    <Button Content="APPLY TABLE TO MODEL" Name="BtnTblApply"
                            Click="TblApply_Click" Style="{DynamicResource ActionButton}"
                            IsEnabled="False"/>

                    <TextBlock Name="TxtTblStatus" Text="" FontSize="10"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,0"/>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Dark mode -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Name="TxtPreviewHeader" Text="Data Preview" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource Card}" Padding="1">
                    <TextBox Name="TxtPreview" IsReadOnly="True" FontFamily="Consolas"
                             FontSize="11" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8" TextWrapping="NoWrap"/>
                </Border>

                <!-- Loading overlay -->
                <Grid Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                    <Border Background="White" CornerRadius="6" Padding="24,16"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Working..." HorizontalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,12"/>
                            <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Name="TxtLoadingStatus" Text="" HorizontalAlignment="Center"
                                       FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Name="TxtMappingHeader"
                       Text="Column Mapping  (column → Revit parameter name)"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,18,0,8"/>

            <Border Grid.Row="3" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="MappingPanel" Margin="0,0,0,0"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
