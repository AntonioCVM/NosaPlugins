<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workset Health" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding"    Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Background="{DynamicResource AccentColor}"/>
                    <TextBlock Text="Workset Health" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Name="TxtSubtitle" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextColor}" Opacity="0.6"
                               Margin="0,0,6,0"/>
                    <TextBox Name="TxtSearch" Width="150" FontSize="11" Padding="4,2"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BorderColor}"
                             TextChanged="Search_Changed" Margin="0,0,12,0"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Content="Close" Style="{StaticResource SecBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main grid -->
        <DataGrid Grid.Row="1" Name="GridWorksets" Margin="12,12,12,4"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended"
                  AlternatingRowBackground="#06000000"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  CanUserReorderColumns="False" FontSize="11"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Workset"        Binding="{Binding Name}"     Width="220"/>
                <DataGridTextColumn Header="Elements"       Binding="{Binding Count}"    Width="80"/>
                <DataGridTextColumn Header="Owner"          Binding="{Binding Owner}"    Width="120"/>
                <DataGridTextColumn Header="Editable"       Binding="{Binding Editable}" Width="80"/>
                <DataGridTextColumn Header="Open"           Binding="{Binding Open}"     Width="70"/>
                <DataGridTextColumn Header="Default visible" Binding="{Binding Visible}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Move panel -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Move selected workset's elements to:" FontSize="11"
                           Foreground="{DynamicResource TextColor}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Name="CboTargetWorkset" Width="220" FontSize="11"
                          DisplayMemberPath="Name" Margin="0,0,8,0"/>
                <Button Content="Move Elements" Style="{StaticResource ActionBtn}"
                        Click="MoveElements_Click" Margin="0,0,8,0"/>
                <Button Content="Refresh" Style="{StaticResource SecBtn}"
                        Click="Refresh_Click"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource PanelColor}"
                Padding="12,6">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Border>

        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" Background="#CCFAFAFA"
              Panel.ZIndex="100">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Analysing worksets..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
