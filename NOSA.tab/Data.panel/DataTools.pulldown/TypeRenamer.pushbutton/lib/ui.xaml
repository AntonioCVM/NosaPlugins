<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type Renamer" Height="660" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding"    Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Background="{DynamicResource AccentColor}"/>
                    <TextBlock Text="Type Renamer" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Content="Close" Style="{StaticResource SecBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls panel -->
            <Border Grid.Column="0" Background="{DynamicResource PanelColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">
                        <TextBlock Text="Category" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                        <ComboBox Name="CboCategory" FontSize="11" Margin="0,0,0,14"
                                  SelectionChanged="Category_Changed"/>

                        <TextBlock Text="Mode" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                        <RadioButton Name="RbFindReplace" Content="Find &amp; Replace"
                                     GroupName="Mode" Checked="Mode_Changed"/>
                        <RadioButton Name="RbPrefixSuffix" Content="Add Prefix / Suffix"
                                     GroupName="Mode" Checked="Mode_Changed"/>

                        <StackPanel Name="PnlFindReplace" Margin="0,10,0,0">
                            <TextBlock Text="Find:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtFind" Style="{StaticResource FieldBox}" Margin="0,0,0,8"
                                     TextChanged="Rule_Changed"/>
                            <TextBlock Text="Replace with:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtReplace" Style="{StaticResource FieldBox}" Margin="0,0,0,0"
                                     TextChanged="Rule_Changed"/>
                        </StackPanel>

                        <StackPanel Name="PnlPrefixSuffix" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Prefix:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtPrefix" Style="{StaticResource FieldBox}" Margin="0,0,0,8"
                                     TextChanged="Rule_Changed"/>
                            <TextBlock Text="Suffix:" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="TxtSuffix" Style="{StaticResource FieldBox}" Margin="0,0,0,0"
                                     TextChanged="Rule_Changed"/>
                        </StackPanel>

                        <Separator Margin="0,16,0,12"/>

                        <Button Content="SELECT ALL" Style="{StaticResource SecBtn}"
                                Click="SelectAll_Click" Margin="0,0,0,6"/>
                        <Button Content="APPLY RENAME" Style="{StaticResource ActionBtn}"
                                Click="ApplyRename_Click"/>
                        <TextBlock Name="TxtFormStatus" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}"
                                   Opacity="0.7" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview grid -->
            <Grid Grid.Column="1" Margin="12,12,12,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preview — select types to rename"
                               FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Grid.Column="1" Text="Search:" FontSize="11"
                               VerticalAlignment="Center" Opacity="0.6" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Column="2" Name="TxtSearch" Width="160" FontSize="11"
                             Padding="4,2" VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BorderColor}"
                             TextChanged="Search_Changed"/>
                </Grid>
                <DataGrid Grid.Row="1" Name="GridTypes"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          AlternatingRowBackground="#06000000"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="False" FontSize="11"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Current name" Binding="{Binding Name}"    Width="*"/>
                        <DataGridTextColumn Header="New name"     Binding="{Binding NewName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Name="TxtStatus" FontSize="11"
                       Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
        </Border>

        <Grid Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" Background="#CCFAFAFA"
              Panel.ZIndex="100">
            <Border Background="White" CornerRadius="6" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Renaming types..." HorizontalAlignment="Center" FontSize="13"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
