<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shared Parameter Manager" Height="720" Width="1080"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Colour tokens defined locally (not just inherited from the
             merged NosaTheme.xaml) so ApplyTheme()/Theme_Toggled can
             mutate them directly — see NosaTheme.xaml's own header
             comment: it only reaches a plugin's local Resources entries,
             not its MergedDictionaries. Card / ActionButton /
             SecondaryButton and every implicit control style come from
             the merged NosaTheme.xaml and are referenced below via
             DynamicResource (not StaticResource, since that dictionary is
             only merged in after this XAML is parsed). -->
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="TextBlock" x:Key="SPM_SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SHARED PARAMETER MANAGER" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Read, audit, and manage the project's shared parameters" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT PANEL: ACTIONS & FILTERS ═══ -->
            <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,10">

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Shared Parameter File" Style="{StaticResource SPM_SectionTitle}"/>
                                <TextBlock Name="TxtFilePath" Text="(no shared parameter file set)"
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                           Margin="0,0,0,10"/>
                                <Button Content="Load Shared Parameter File..." Name="BtnLoadFile"
                                        Click="LoadFile_Click" Style="{DynamicResource ActionButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Actions" Style="{StaticResource SPM_SectionTitle}"/>
                                <Button Content="Audit Current Bindings" Name="BtnAudit"
                                        Click="Audit_Click" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>
                                <Button Content="Export to CSV" Name="BtnExport"
                                        Click="Export_Click" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="Filters" Style="{StaticResource SPM_SectionTitle}"/>
                                <TextBlock Text="Search by name:" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                                <TextBox Name="TxtSearch" Height="26" Padding="4,2" FontSize="11"
                                         VerticalContentAlignment="Center" Margin="0,0,0,10"
                                         TextChanged="Filter_Changed"/>
                                <CheckBox Name="ChkOnlyIssues" Content="Show only issues (not bound / orphaned / conflict)"
                                          Click="Filter_Changed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- ═══ RIGHT PANEL: RESULTS ═══ -->
            <Grid Grid.Column="2" Margin="20,16,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="TxtSummary"
                           Text="Run an audit to compare the shared parameter file against the project's bindings."
                           FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1" Margin="0,0,0,16">
                    <DataGrid Name="GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter Name" Binding="{Binding ParamName}" Width="*"/>
                            <DataGridTextColumn Header="GUID"           Binding="{Binding Guid}"      Width="220"/>
                            <DataGridTextColumn Header="Group"          Binding="{Binding Group}"     Width="140"/>
                            <DataGridTextColumn Header="Data Type"      Binding="{Binding DataType}"  Width="130"/>
                            <DataGridTextColumn Header="Bound"          Binding="{Binding BoundStr}"  Width="60"/>
                            <DataGridTextColumn Header="Status"         Binding="{Binding Status}"    Width="130"/>
                            <DataGridTextColumn Header="Categories"     Binding="{Binding Categories}" Width="200"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Not bound">
                                        <Setter Property="Background" Value="#0AFFC107"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Orphaned binding">
                                        <Setter Property="Background" Value="#12FF5F00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="GUID conflict">
                                        <Setter Property="Background" Value="#18FF0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Shared loading overlay (NOSAWindow standard) -->
        <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      Foreground="{DynamicResource TextColor}"/>
        </Border>
    </Grid>
</Window>
