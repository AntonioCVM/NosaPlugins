<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — General Notes (0900)" Height="780" Width="760"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Project values of the 0900 General notes" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextColor}"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" Foreground="{DynamicResource TextColor}"
                       Text="Saved as NOSA_GN_* parameters of Project Information (usable in schedules and title blocks) and written into the 0900 notes. The anchorage &amp; lap table is recalculated (EC2 + UK NA) when its concrete class changes. The Sheet Export Hub warns when 0900 no longer matches."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Name="BtnClose" Content="Close" Click="Close_Click" Padding="16,8" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Name="BtnApply" Content="Apply to 0900" Click="Apply_Click" Padding="16,8"
                    Background="{DynamicResource AccentColor}" Foreground="White" FontWeight="Bold"/>
            <TextBlock Name="TxtStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextColor}"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Sections included in this project" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{DynamicResource TextColor}"
                           Text="Untick what does not apply: it is hidden on 0900 (never deleted) and the notes below it in the same column move up. Tick it again to bring it back."/>
                <WrapPanel Name="PanelSections"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource PanelColor}">
            <StackPanel Name="PanelFields" Margin="12"/>
        </ScrollViewer>
    </DockPanel>
</Window>
