<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Rebar Automate" Height="900" Width="1320"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Colour tokens defined locally so ApplyTheme()/Theme_Toggled can
             mutate them directly — see NosaTheme.xaml's header comment.
             Card / ActionButton and every implicit control style come from
             the merged NosaTheme.xaml, referenced below via DynamicResource. -->
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="TextBlock" x:Key="RA_SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="RA_FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" x:Key="RA_NumField">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Grid" x:Key="RA_FieldRow">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RA_GroupTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="RA_Intro">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="RA_Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button" x:Key="RA_LinkButton">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander" x:Key="RA_Expander">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <!-- side navigation (Phase 10): one item per element, then drawings, schedules and checks -->
        <Style TargetType="TabItem" x:Key="RA_NavItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Bd" Background="Transparent" BorderThickness="4,0,0,0"
                                BorderBrush="Transparent" Padding="16,11,16,11" Margin="0,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FF5F00"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FF5F00"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl" x:Key="RA_Nav">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PanelColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                                <StackPanel IsItemsHost="True" Margin="0,12,0,0"/>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BgColor}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RA_NavItem}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: what the tool is, the document, the standard and the theme -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentColor}" CornerRadius="4" Width="30" Height="30" Margin="0,0,12,0">
                        <Path Data="M5,6 L19,6 M5,12 L19,12 M5,18 L19,18 M8,4 L8,20 M16,4 L16,20" Stroke="White"
                              StrokeThickness="2" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REBAR AUTOMATE" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtDocInfo" Text="Automatic reinforcement to IStructE SMDSC 4th ed. and EC2 (UK NA)"
                                   FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Standard" Style="{StaticResource RA_FieldLabel}" Margin="0,0,8,0" Opacity="0.7"/>
                    <ComboBox Name="CmbStandard" Width="170" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selection bar: what the window will act on -->
        <Border Grid.Row="1" Background="{DynamicResource BgColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Name="DotSelection" Width="9" Height="9" Fill="#BDBDBD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Name="TxtSelection" Text="Nothing selected in the model." FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Name="BtnRefreshSelection" Content="Refresh selection" Style="{StaticResource RA_LinkButton}"
                        ToolTip="Read the model selection again (after selecting other elements in Revit)."/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Name="MainTabControl" Style="{StaticResource RA_Nav}" Background="Transparent">
        <TabItem Name="TabProject">
        <TabItem.Header>
            <StackPanel Orientation="Horizontal">
                <Path Data="M12,2 L14,5 L18,4 L18,8 L22,10 L19,13 L21,17 L17,17 L15,21 L12,18 L9,21 L7,17 L3,17 L5,13 L2,10 L6,8 L6,4 L10,5 Z M12,9 A3,3 0 1 0 12.01,9 Z" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                      StrokeLineJoin="Round" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Project" VerticalAlignment="Center"/>
            </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Settings shared by every element of this document. The rebar standard is chosen in the header." Style="{StaticResource RA_Intro}"/>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Marks, revision and concrete" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock Text="Configure mark prefix, revision, and project status. These settings persist per document."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Partition:" VerticalAlignment="Center" Margin="0,0,8,8"
                                       ToolTip="Schedule / drawing the bar marks belong to. Marks are numbered 01, 02 ... within each partition (BS 8666); also written to the native Rebar Partition."/>
                            <TextBox Grid.Row="0" Grid.Column="1" Name="TxtMarkPrefix" MaxLength="10" Margin="0,0,16,8"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Revision:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Name="TxtRevision" MaxLength="5" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbProjectStatus" Margin="0,0,16,0"/>

                            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Name="BtnSaveProjectHeader" Content="Save project settings" Margin="0,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kicker Height (mm):" VerticalAlignment="Center" Margin="0,8,8,0"
                                       ToolTip="Column and wall kicker cast with the foundation. Starter and dowel laps are measured above it (IStructE SMDSC: 75 mm). 0 = no kicker."/>
                            <TextBox Grid.Row="2" Grid.Column="1" Name="TxtKickerHeight" MaxLength="5" Margin="0,8,16,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Lap rules:" VerticalAlignment="Center" Margin="0,8,8,0"
                                       ToolTip="EC2: l0 = alpha6 x lb,rqd from the host's concrete (fbd, bond position, % lapped). BS 8110: Table 3.27 multiples. Every lap is at least max(15 bar diameters, 300 mm)."/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Name="CmbLapRules" Margin="0,8,16,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Default fck (MPa):" VerticalAlignment="Center" Margin="0,8,8,0"
                                       ToolTip="Used for hosts whose structural material has no concrete strength (32 = C32/40)."/>
                            <TextBox Grid.Row="3" Grid.Column="3" Name="TxtDefaultFck" MaxLength="4" Margin="0,8,0,0"/>

                            <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Name="ChkWaterRetaining"
                                      Content="Water-retaining structure (EC2-3)" VerticalAlignment="Center" Margin="0,8,16,0"
                                      Foreground="{DynamicResource TextColor}"
                                      ToolTip="Walls and slabs: cover at least 40 mm, tension bars at 250 mm or less, distribution bars at 150 mm or less, minimum thickness of the tightness class; construction and movement joints to be drawn (EC2 Part 3)."/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Tightness class:" VerticalAlignment="Center" Margin="0,8,8,0"
                                       ToolTip="EC2-3 Table 7.105: 0 some leakage acceptable; 1 limited leakage (wk1 0.2 to 0.05 mm); 2 minimal leakage; 3 none."/>
                            <ComboBox Grid.Row="4" Grid.Column="3" Name="CmbTightness" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="NOSA families" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock Text="The annotation and coupler families the drawings use, packaged with NOSA." Style="{StaticResource RA_Hint}"/>
                        <Button Name="BtnLoadContent" Content="Load NOSA families"
                                Click="LoadContent_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                ToolTip="Load the packaged NOSA annotation families (data/content_manifest.json), replacing missing or out-of-date copies."/>
                        <TextBlock Name="TxtContentStatus" Text="" FontSize="11"
                                   Foreground="{DynamicResource AccentColor}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Name="TabSlabs">
        <TabItem.Header>
            <StackPanel Orientation="Horizontal">
                <Path Data="M2,9 L22,9 L22,14 L2,14 Z M4,14 L4,20 M20,14 L20,20" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                      StrokeLineJoin="Round" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Slabs" VerticalAlignment="Center"/>
            </StackPanel>
        </TabItem.Header>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,16,24">
                    <TextBlock Name="TxtSlabsIntro" Text="Select floors and foundation slabs (rafts) in the model." Style="{StaticResource RA_Intro}"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="DESIGN REINFORCEMENT" Style="{StaticResource RA_GroupTitle}" Margin="0"/>
                        <Button Name="BtnDefaultsSlabs" Content="Reset to defaults" Style="{StaticResource RA_LinkButton}"
                                HorizontalAlignment="Right" ToolTip="Put back the values this tab opens with."/>
                    </Grid>
            <Border Style="{DynamicResource Card}" Margin="0,0,0,12" Name="CardLimitsSlabs">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Detailing limits (EC2, UK NA)" Style="{StaticResource RA_SectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Name="TxtLimitsSlabs" Text="Select an element to see its minimum steel and maximum pitch." FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnMinSlabs" Content="Apply EC2 minimum" Margin="12,0,0,0" Padding="12,4"
                            VerticalAlignment="Center"
                            ToolTip="Fill the mats with the lightest bar and pitch meeting the EC2 minimum for the selected thickness (9.2.1.1 / 9.3.1.1). A minimum, not a design: check against the calculation."/>
                </Grid>
            </Border>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Bottom mat" Style="{StaticResource RA_SectionTitle}"/>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bar size, X direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDiaX" Text="16" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bar size, Y direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDiaY" Text="16" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pitch, both directions (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtSpacing" Text="150" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <CheckBox Name="ChkBottomHooks" Content="90° hooks at the ends" Click="Preview_Changed"
                                      Foreground="{DynamicResource TextColor}" Margin="0,2,0,0"/>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Maximum stock length (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtMaxStockLength" Text="12000" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkIncludeTopMat" Content="Top mat" Click="IncludeTopMat_Click"
                                      FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                            <StackPanel Name="PanelTopMat" IsEnabled="False">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bar size, X direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtTopDiaX" Text="12" Style="{StaticResource RA_NumField}"
                                             TextChanged="Preview_Changed"/>
                                </Grid>

                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bar size, Y direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtTopDiaY" Text="12" Style="{StaticResource RA_NumField}"
                                             TextChanged="Preview_Changed"/>
                                </Grid>

                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pitch, both directions (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtTopSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                             TextChanged="Preview_Changed"/>
                                </Grid>

                                <CheckBox Name="ChkTopHooks" Content="90° hooks at the ends" Click="Preview_Changed"
                                          Foreground="{DynamicResource TextColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Tag="footings" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkIncludeDowels" Content="Dowels (column starter bars)" Click="IncludeDowels_Click"
                                      FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                            <StackPanel Name="PanelDowels" IsEnabled="False">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dowel diameter (mm) — used only if the Columns tab values are invalid" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtDowelDiameter" Text="16" Style="{StaticResource RA_NumField}"/>
                                </Grid>

                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dowel count if no column above (4 or 8)" Style="{StaticResource RA_FieldLabel}"/>
                                    <ComboBox Grid.Column="1" Name="CmbDowelCount">
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="8"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Anchor length in footing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtDowelAnchor" Text="400" Style="{StaticResource RA_NumField}"/>
                                </Grid>

                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Visible splice length above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtDowelSplice" Text="Auto" Style="{StaticResource RA_NumField}"/>
                                </Grid>
                                <TextBlock Text="Under each column resting on the footing: one dowel per column vertical (Columns tab: quantity, bar and link diameters), lapped on its inner side. With no column above, a cage of this section is centred on the footing:"
                                           TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,6,0,2" Foreground="{DynamicResource TextColor}"/>
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Column width if none above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtDowelColWidth" Text="400" Style="{StaticResource RA_NumField}"/>
                                </Grid>
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Column depth if none above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtDowelColDepth" Text="400" Style="{StaticResource RA_NumField}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}" Tag="floors" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkPunching" Content="Punching shear stud rails (EC2 6.4)"
                                      ToolTip="Checks every column under the floor (EC2 6.4, UK NA) and places Shear Stud Rail and Shear Stud families where reinforcement is needed: first perimeter 0.5d from the face, perimeters 0.75d apart, the last within 1.5d of u_out, studs no further apart than 1.5d inside u1 and 2d outside. VEd and beta come from each column's NOSA_Punching_VEd / NOSA_Punching_Beta, else from these fields."
                                      FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VEd where the column has none (kN, 0 = skip)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtPunchVEd" Text="0" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Beta where the column has none (1.15 / 1.4 / 1.5)" Style="{StaticResource RA_FieldLabel}"/>
