                                    <CheckBox Name="ChkTopOverSupports" Content="Top bars only over supports"
                                              FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                    <TextBlock Text="IStructE SMDSC MD S1 / S2 simplified curtailment: walls and beams under the slab along X/Y are found; the top bars across each reach 0.3 x the span either side (to the edge past the end supports) and the top bars along it stay in that band. The bottom mat stays continuous. Untick for a full top mat."
                                               FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextColor}" Opacity="0.5"/>
                                    <CheckBox Name="ChkAlternateBottom" Content="Bottom bars 0.8 x span, alternately reversed"
                                              FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,10,0,6"/>
                                    <TextBlock Text="IStructE SMDSC MD S1: over interior walls, beams (and the column lines of a flat slab) the bottom bars are 0.8 x span + 0.5 x tension lap, every other bar reversed, so half the bars lap over each support. A single span keeps continuous bars."
                                               FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextColor}" Opacity="0.5"/>
                                    <CheckBox Name="ChkFlatSlab" Content="Flat slab column and middle strips"
                                              FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,10,0,6"/>
                                    <TextBlock Text="IStructE SMDSC 4th ed. 6.2.2.9, Fig. 6.4 and MD S5: the pitches given are the averages. Over the columns under the slab the top bars put 75 % in the column strips (half the shorter panel), two thirds of it in their central half; the bottom bars 55 %. At least two bottom bars must pass through each column."
                                               FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextColor}" Opacity="0.5"/>
                                    <CheckBox Name="ChkFabric" Content="Welded fabric (BS 4483) instead of a bar mat"
                                              FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,10,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fabric:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextColor}"/>
                                        <ComboBox Grid.Column="1" Name="CmbFabricRef" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="Face:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextColor}"/>
                                        <ComboBox Grid.Column="3" Name="CmbFabricFace" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="4" Text="Main wires:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextColor}"/>
                                        <ComboBox Grid.Column="5" Name="CmbFabricDir"/>
                                    </Grid>
                                    <TextBlock Text="IStructE SMDSC 4.2.5 / 5.4.5: 4.8 x 2.4 m sheets laid by Revit over the floor and its openings, main wires lapped a full tension lap, secondary wires to Table 5.8. A193 for ground-bearing slabs. The fabric replaces the bar mat of that face; the other face keeps its bars."
                                               FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextColor}" Opacity="0.5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource Card}" Tag="floors" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Name="ChkCornerTorsion" Content="Torsion bars at held-down outer corners"
                                              FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                    <TextBlock Text="IStructE SMDSC 4th ed. Fig. 6.7 / EC2 9.3.1.3: at every right-angled outer corner, over a fifth of the shorter span, the top holds 3/4 of the bottom steel in both directions. Extra top bars of the bottom size are added under the top mat where it falls short. Tick only when the corners are held down."
                                               FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextColor}" Opacity="0.5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource Card}" Tag="floors" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Name="ChkOpeningDiagonals" Content="45° diagonal bars at opening corners"
                                              Click="IncludeOpeningDiagonals_Click"
                                              FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                                    <StackPanel Name="PanelOpeningDiagonals" IsEnabled="False">
                                        <Grid Style="{StaticResource RA_FieldRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Diagonal bar diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                            <TextBox Grid.Column="1" Name="TxtOpeningDiagonalDia" Text="12" Style="{StaticResource RA_NumField}"/>
                                        </Grid>
                                        <TextBlock Text="One 45° bar at each corner of every opening larger than 200x200 mm, on the inner face of the bottom mat and of the top mat (if any), extending an anchorage length either side of the corner (IStructE SMDSC MD OP1). Recommended for slabs deeper than 250 mm with openings of 500 mm or more."
                                                   FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource Card}" Tag="footings" Margin="0,0,0,12">
