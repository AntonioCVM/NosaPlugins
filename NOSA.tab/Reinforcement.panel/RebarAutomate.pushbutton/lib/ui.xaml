<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Rebar Automate" Height="880" Width="1040"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Colour tokens defined locally so ApplyTheme()/Theme_Toggled can
             mutate them directly — see NosaTheme.xaml's header comment.
             Card / ActionButton and every implicit control style come from
             the merged NosaTheme.xaml, referenced below via DynamicResource. -->
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="TextBlock" x:Key="RA_SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="RA_FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" x:Key="RA_NumField">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Grid" x:Key="RA_FieldRow">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="REBAR AUTOMATE" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Automatic reinforcement generation" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Standard bar: global normativa selector, OUTSIDE the tabs so it
             governs every tab's generation (Phase F2). Populated in code
             (rebarautomate_ui.py, post-LoadComponent — NOSA rule: no
             SelectedIndex/SelectionChanged wired in XAML) from
             standards.list_available(); persisted to rebar_project.json. -->
        <Border Grid.Row="1" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Standard:" Style="{StaticResource RA_FieldLabel}" Margin="0,0,8,0"/>
                <ComboBox Name="CmbStandard" Width="180" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body: unified Dashboard TabControl. Footings & Slabs (Phase
             2) covers BOTH OST_StructuralFoundation and OST_Floors from
             one shared form — the backend dispatches on each selected
             element's own category. Columns/Beams remain placeholders
             until their own phases (3/4); Detailing & Tools is the
             Phase 5 dashboard, placeholders for now. -->
        <TabControl Grid.Row="2" Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0">

        <!-- ═══ FOOTINGS & SLABS ═══ -->
        <TabItem Header="Footings &amp; Slabs">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN — controls, scrollable -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,20">

                <TextBlock Text="Select one or more Structural Foundations and/or Floors in the model, set the parameters below, then run. Both categories share the parameters below; the tool dispatches to the correct engine per element."
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.65"
                           Margin="0,0,0,16"/>

                <!-- ═══ BOTTOM MAT ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Bottom Mat" Style="{StaticResource RA_SectionTitle}"/>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bar Diameter - X Direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtDiaX" Text="16" Style="{StaticResource RA_NumField}"
                                     TextChanged="Preview_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bar Diameter - Y Direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtDiaY" Text="16" Style="{StaticResource RA_NumField}"
                                     TextChanged="Preview_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spacing, Both Directions (mm)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtSpacing" Text="150" Style="{StaticResource RA_NumField}"
                                     TextChanged="Preview_Changed"/>
                        </Grid>

                        <CheckBox Name="ChkBottomHooks" Content="Include 90° Hooks" Click="Preview_Changed"
                                  Foreground="{DynamicResource TextColor}" Margin="0,2,0,0"/>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max Stock Length, mm (Floors only)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtMaxStockLength" Text="12000" Style="{StaticResource RA_NumField}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ TOP MAT ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Name="ChkIncludeTopMat" Content="Include Top Mat" Click="IncludeTopMat_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                        <StackPanel Name="PanelTopMat" IsEnabled="False">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bar Diameter - X Direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtTopDiaX" Text="12" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bar Diameter - Y Direction (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtTopDiaY" Text="12" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing, Both Directions (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtTopSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <CheckBox Name="ChkTopHooks" Content="Include 90° Hooks" Click="Preview_Changed"
                                      Foreground="{DynamicResource TextColor}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ PERIMETER CLOSURE U-BARS ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Name="ChkIncludePerimeterUBars" Content="Add Perimeter Closure U-Bars" Click="IncludePerimeterUBars_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                        <StackPanel Name="PanelPerimeterUBars" IsEnabled="False">
                            <TextBlock Text="Orthogonal Direction (X-Bars Anchoring)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.85" Margin="0,0,0,4"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="U-Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtXAnchorUBarDia" Text="10" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="U-Bar Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtXAnchorUBarSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <TextBlock Text="Parallel Direction (Y-Bars Anchoring)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.85" Margin="0,10,0,4"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="U-Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtYAnchorUBarDia" Text="10" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="U-Bar Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtYAnchorUBarSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                         TextChanged="Preview_Changed"/>
                            </Grid>

                            <TextBlock Text="Perimeter U-Bars anchor the bottom mat to the top mat at each edge. The Orthogonal and Parallel Direction U-Bars cross at the corners while respecting the same B1/B2/T1/T2 layer hierarchy as the main mats, so they weave past one another without physical collision. Requires Include Top Mat to be checked."
                                       FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ OPENING CORNER DIAGONALS (Floors only) ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Name="ChkOpeningDiagonals" Content="Add 45° Diagonal Bars at Opening Corners (Floors only)"
                                  Click="IncludeOpeningDiagonals_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                        <StackPanel Name="PanelOpeningDiagonals" IsEnabled="False">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Diagonal Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtOpeningDiagonalDia" Text="12" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <TextBlock Text="One 45° bar at each corner of every opening larger than 200x200 mm, on the inner face of the bottom mat and of the top mat (if any), extending an anchorage length either side of the corner (IStructE SMDSC 6.x). Recommended for slabs deeper than 250 mm with openings of 500 mm or more."
                                       FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ SIDE REBAR (Footings only) ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Name="ChkIncludeSideRebar" Content="Include Side Rebar — anti-crack / skin (Footings only)" Click="IncludeSideRebar_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                        <StackPanel Name="PanelSideRebar" IsEnabled="False">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Side Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtSideDiameter" Text="10" Style="{StaticResource RA_NumField}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vertical Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtSideSpacing" Text="300" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ DOWELS (Footings only) ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Name="ChkIncludeDowels" Content="Include Dowels — column splice bars (Footings only)" Click="IncludeDowels_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                        <StackPanel Name="PanelDowels" IsEnabled="False">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dowel Diameter (mm) — used only if the Columns tab values are invalid" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDowelDiameter" Text="16" Style="{StaticResource RA_NumField}"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dowel Count if no Column Above (4 or 8)" Style="{StaticResource RA_FieldLabel}"/>
                                <ComboBox Grid.Column="1" Name="CmbDowelCount">
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="8"/>
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Anchor Length in Footing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDowelAnchor" Text="400" Style="{StaticResource RA_NumField}"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Visible Splice Length Above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDowelSplice" Text="Auto" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <TextBlock Text="Under each column resting on the footing: one dowel per column vertical (Columns tab: quantity, bar and link diameters), lapped on its inner side. With no column above, a cage of this section is centred on the footing:"
                                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,6,0,2" Foreground="{DynamicResource TextColor}"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Column Width if None Above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDowelColWidth" Text="400" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Column Depth if None Above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtDowelColDepth" Text="400" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <CheckBox Name="ChkGenerateSections" Content="Generate Detail Sections — 2 orthogonal sections, centred (Footings only)"
                              Foreground="{DynamicResource TextColor}"/>
                </Border>

                <Button Name="BtnRunFooting" Content="GENERATE REINFORCEMENT"
                        Click="RunReinforcement_Click" Style="{DynamicResource ActionButton}"
                        HorizontalAlignment="Stretch" Height="52" FontSize="14" FontWeight="Bold"
                        Margin="0,4,0,16"/>

                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="Result" Style="{StaticResource RA_SectionTitle}"/>
                        <!-- BUG FIX (2026-09-01) — a plain TextBlock can't be
                             selected/copied, and the code-behind used to
                             truncate to 12 issues + "...and N more" so a long
                             run's own tracking log never fit on screen at
                             all. Now a read-only, full-log TextBox (still
                             inside this column's own outer ScrollViewer, so
                             it just grows with its content — no truncation,
                             every created/skipped item is listed and can be
                             selected/copied). Same fix applied identically
                             to TxtColumnResult/TxtBeamResult/TxtWallResult. -->
                        <TextBox Name="TxtResult" Text="No run yet."
                                 FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextColor}" Opacity="0.75"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN — Section Preview, fixed in view (no scroll needed
             to see the effect of a parameter change on the left) -->
        <Border Grid.Column="1" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <StackPanel Margin="16,20,20,20">
                <TextBlock Text="Section Preview" Style="{StaticResource RA_SectionTitle}"/>
                <TextBlock Name="TxtAdoptedSolution" Text="Adopted Solution: —"
                           FontSize="11" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="320">
                    <!-- PHASE 2.5 fix — the Canvas draws onto a FIXED
                         virtual surface (matching PreviewCanvas.Width/
                         Height read in ui.py's own scale calculation,
                         not the unreliable ActualWidth/ActualHeight,
                         which can be 0 or narrower than assumed at
                         first render); the Viewbox then scales that
                         fixed surface UNIFORMLY to fit whatever space
                         is actually available, so content can never
                         run wider than its container and get clipped
                         on the right. -->
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="PreviewCanvas" Width="700" Height="320"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Illustrative only — bar count and section width shown are not the real model geometry."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        </Grid>
        </TabItem>

        <!-- ═══ COLUMNS (Phase 3) ═══ -->
        <TabItem Header="Columns">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN — controls, scrollable -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,20">

                <TextBlock Text="Select one or more Structural Columns in the model, set the parameters below, then run."
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.65"
                           Margin="0,0,0,16"/>

                <!-- ═══ VERTICAL BARS ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Vertical Bars" Style="{StaticResource RA_SectionTitle}"/>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtColBarDia" Text="20" Style="{StaticResource RA_NumField}"
                                     TextChanged="ColumnPreview_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Quantity (total bars)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtColBarCount" Text="8" Style="{StaticResource RA_NumField}"
                                     TextChanged="ColumnPreview_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ LINKS / TIES ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Links / Ties" Style="{StaticResource RA_SectionTitle}"/>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Link Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtColLinkDia" Text="10" Style="{StaticResource RA_NumField}"
                                     TextChanged="ColumnPreview_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource RA_FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Centre Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                            <TextBox Grid.Column="1" Name="TxtColLinkSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                     TextChanged="ColumnPreview_Changed"/>
                        </Grid>

                        <CheckBox Name="ChkColDensify" Content="Densify at nodes" Click="ColumnDensify_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,2,0,0"/>

                        <StackPanel Name="PanelColDensify" IsEnabled="False" Margin="0,10,0,0">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Densified Spacing at Nodes (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtColDenseSpacing" Text="100" Style="{StaticResource RA_NumField}"
                                         TextChanged="ColumnPreview_Changed"/>
                            </Grid>
                            <TextBlock Text="Splits the column into 3 zones (bottom node, centre, top node), with denser links at each node — the beam/slab connection zones — and the spacing above in the centre span."
                                       FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.5"/>
                        </StackPanel>

                        <CheckBox Name="ChkColCrossties" Content="Include Interior Crossties"
                                  Click="ColumnCrossties_Click"
                                  Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                        <TextBlock Text="For columns with intermediate (non-corner) bars: ties each one to its direct mirror across the section, at the same zones/spacing as the main links. Anchored with normative 135°/90° hooks, not a bare line."
                                   FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,10"/>

                        <StackPanel Name="PanelColCrossties" IsEnabled="False">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Crosstie Layout" Style="{StaticResource RA_FieldLabel}"/>
                                <ComboBox Grid.Column="1" Name="CboCrosstieLayout">
                                    <ComboBoxItem Content="Tie all intermediate bars"/>
                                    <ComboBoxItem Content="Tie alternate bars"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ LAP SPLICES / STARTERS ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Lap Splices" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock Text="Every floor the column crosses now gets its own lap splice automatically — that part is no longer optional. This checkbox only concerns the column's OWN final top."
                                   FontSize="9" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                        <CheckBox Name="ChkColStarterBars" Content="Extend lap splice at ultimate roof level"
                                  Foreground="{DynamicResource TextColor}"
                                  Checked="ColumnPreview_Changed" Unchecked="ColumnPreview_Changed"/>
                        <TextBlock Text="Checked: leaves a projecting starter above the column's own final top, in case the building grows a storey later. Unchecked: the last segment's bars simply die straight, under the last floor's own cover — no projection above the roof."
                                   FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,10"/>

                        <CheckBox Name="ChkColCrankedLaps" Content="Crank laps at floors (1:6)" IsChecked="True"
                                  Foreground="{DynamicResource TextColor}"
                                  Checked="ColumnPreview_Changed" Unchecked="ColumnPreview_Changed"/>
                        <TextBlock Text="Bars of 20 mm and over crank one diameter inward at 1:6, finishing just below the slab's top face, so the bar above starts straight at its cover; 16 mm and under lap straight, side by side. A smaller column above always cranks by the reduction. The lap is measured above the kicker. At the top of the last column the bars end in an L foot inside the slab, turned into the slab at edges and corners."
                                   FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ STARTER BARS INTO FOUNDATION (Phase F7.18) ═══ -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Name="ChkColFoundationStarters" Content="Add L-Shaped Starter Bars into Foundation Below"
                                  Click="ColFoundationStarters_Click"
                                  FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                        <TextBlock Text="One hooked starter per column vertical, contact-lapped on its inner side and hosted on the isolated footing, strip footing or floor/mat slab detected below; the 90&#176; foot points outwards and the lap is measured above the foundation top. Skipped (reported) where no foundation is found, or where the footing already has dowels under this column."
                                   FontSize="9" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                        <StackPanel Name="PanelColFoundationStarters" IsEnabled="False">
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Anchor Length in Foundation (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtColFoundationAnchor" Text="400" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Visible Splice Length Above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtColFoundationSplice" Text="Auto" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Name="BtnRunColumn" Content="GENERATE REINFORCEMENT"
                        Click="RunColumnReinforcement_Click" Style="{DynamicResource ActionButton}"
                        HorizontalAlignment="Stretch" Height="52" FontSize="14" FontWeight="Bold"
                        Margin="0,4,0,16"/>

                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="Result" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBox Name="TxtColumnResult" Text="No run yet."
                                 FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextColor}" Opacity="0.75"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN — Section + Elevation Preview, fixed in view -->
        <Border Grid.Column="1" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,20,20,20">
                <TextBlock Text="Section Preview" Style="{StaticResource RA_SectionTitle}"/>
                <TextBlock Name="TxtColumnAdoptedSolution" Text="Adopted Solution: —"
                           FontSize="11" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="240">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="ColumnPreviewCanvas" Width="700" Height="240"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Illustrative only — a representative rectangular section, not the real model geometry."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,16"/>

                <TextBlock Text="Elevation Preview" Style="{StaticResource RA_SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="360">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="ColumnElevationCanvas" Width="420" Height="360"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Shows the vertical bars (with starter bars projecting above the head, if included) and the link/tie spacing along the column's height, including node densification."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        </Grid>
        </TabItem>

        <!-- ═══ BEAMS (Phase F7) ═══ -->
        <TabItem Header="Beams">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN — controls, scrollable. Normalised (2026-09-02) to
             the same 2-column layout as Footings/Slabs and Columns — see
             ROADMAP.md's "Normalización de ventanas" backlog entry: only
             the layout/Style attributes below changed, every x:Name/Click
             is untouched. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,20">

                    <TextBlock Text="Select one or more Structural Framing (beams) in the model, set the parameters below, then run. Straight rectangular beams only in v1."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}" Opacity="0.65"
                               Margin="0,0,0,16"/>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Longitudinal Bars" Style="{StaticResource RA_SectionTitle}"/>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bar diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamBarDia" Text="20" Style="{StaticResource RA_NumField}"
                                         TextChanged="BeamPreview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Top bars (count)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamTopCount" Text="3" Style="{StaticResource RA_NumField}"
                                         TextChanged="BeamPreview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bottom bars (count)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamBottomCount" Text="3" Style="{StaticResource RA_NumField}"
                                         TextChanged="BeamPreview_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Stirrups (Links)" Style="{StaticResource RA_SectionTitle}"/>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Stirrup diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamStirrupDia" Text="8" Style="{StaticResource RA_NumField}"
                                         TextChanged="BeamPreview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamStirrupSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                         TextChanged="BeamPreview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="End offset (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamEndOffset" Text="50" Style="{StaticResource RA_NumField}"
                                         TextChanged="BeamPreview_Changed"/>
                            </Grid>

                            <CheckBox Name="ChkBeamDensify" Content="Densify stirrups at support ends"
                                      IsChecked="True" Margin="0,8,0,4"
                                      Click="BeamDensify_Click"
                                      Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Name="PanelBeamDensify">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dense spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtBeamDenseSpacing" Text="100" Style="{StaticResource RA_NumField}"
                                             TextChanged="BeamPreview_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Confine length (mm, 0=auto)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtBeamConfineLength" Text="0" Style="{StaticResource RA_NumField}"
                                             TextChanged="BeamPreview_Changed"/>
                                </Grid>
                                <TextBlock Text="Auto confine length = 2 × beam height. Dense zones at each end; middle uses normal spacing."
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.55" Margin="0,0,0,4"/>
                            </StackPanel>

                            <CheckBox Name="ChkBeamInteriorTies" Content="Include interior links / crossties"
                                      Margin="0,8,0,4" Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Text="Same rule as columns: interior bars paired outermost-inwards by closed interior links, an odd middle bar held by a 135°/135° crosstie; every tie wraps the bars from outside and follows the stirrup zones."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.55" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkBeamContinuous" Content="Continuous beam over several spans"
                                      FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"
                                      ToolTip="Select every span of the line: beams on one straight line, end to end across their supports."/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Support Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}" ToolTip="Extra top bars over each intermediate support."/>
                                <TextBox Grid.Column="1" Name="TxtBeamSupportDia" Text="16" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Support Bars (number)" Style="{StaticResource RA_FieldLabel}" ToolTip="Placed between the hanger bars, then in a second layer if they do not fit."/>
                                <TextBox Grid.Column="1" Name="TxtBeamSupportCount" Text="2" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Support Bar Reach (x L)" Style="{StaticResource RA_FieldLabel}" ToolTip="Past each support face, as a fraction of the longer adjacent clear span (IStructE simplified rules: 0.25)."/>
                                <TextBox Grid.Column="1" Name="TxtBeamSupportFraction" Text="0.25" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="9" FontStyle="Italic" Opacity="0.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextColor}"
                                       Text="The top bars become continuous hanger bars along the whole line, lapped in the central third of a span; extra bars over every intermediate support; each span's bottom bars run straight 10 phi into the intermediate supports (EC2 9.2.1.5) and keep their legs at the end columns. Links and densified zones stay per span."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Stock / Laps" Style="{StaticResource RA_SectionTitle}"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max stock length (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtBeamStockLength" Text="12000" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnRunBeamReinforcement" Content="GENERATE REINFORCEMENT"
                            Click="RunBeamReinforcement_Click" Style="{DynamicResource ActionButton}"
                            HorizontalAlignment="Stretch" Height="52" FontSize="14" FontWeight="Bold"
                            Margin="0,4,0,16"/>

                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBox Name="TxtBeamResult" Text="No run yet."
                                     FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextColor}" Opacity="0.75"/>
                        </StackPanel>
                    </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN — Section Preview, fixed in view (normalised to
             the same Viewbox-scaled pattern as Footings/Columns; the
             Canvas's own Width/Height stay unchanged — _draw_simple_
             section_preview reads canvas.Width/.Height directly, never
             ActualWidth/.ActualHeight, so wrapping in a Viewbox is a pure
             visual change). -->
        <Border Grid.Column="1" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,20,20,20">
                <TextBlock Text="Section Preview" Style="{StaticResource RA_SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="240">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="BeamPreviewCanvas" Width="700" Height="220"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Illustrative only — a representative rectangular section, not the real model geometry."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,16"/>

                <!-- Elevation Preview (2026-09-02, explicit live request
                     — "sería interesante ver un alzado de la viga"),
                     mirroring the Columns tab's own Section+Elevation
                     pair. -->
                <TextBlock Text="Elevation Preview" Style="{StaticResource RA_SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="220">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="BeamElevationCanvas" Width="700" Height="220"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Shows the top and bottom longitudinal bars along the beam's length and the stirrup spacing, including end densification if enabled."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        </Grid>
        </TabItem>

        <!-- ═══ WALLS (Phase F7) ═══ -->
        <TabItem Header="Walls">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN — controls, scrollable. Normalised (2026-09-02) to
             the same 2-column layout as Footings/Slabs, Columns and Beams
             — see ROADMAP.md's "Normalización de ventanas" backlog entry:
             only layout/Style attributes changed, every x:Name/Click is
             untouched. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,20">

                    <TextBlock Text="Select one or more Walls in the model, set the mesh parameters below, then run. Straight walls only in v1."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}" Opacity="0.65"
                               Margin="0,0,0,16"/>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Vertical Mesh" Style="{StaticResource RA_SectionTitle}"/>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtWallVertDia" Text="12" Style="{StaticResource RA_NumField}"
                                         TextChanged="WallPreview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtWallVertSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                         TextChanged="WallPreview_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Horizontal Mesh" Style="{StaticResource RA_SectionTitle}"/>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtWallHorizDia" Text="12" Style="{StaticResource RA_NumField}"
                                         TextChanged="WallPreview_Changed"/>
                            </Grid>

                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtWallHorizSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                         TextChanged="WallPreview_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Layers" Style="{StaticResource RA_SectionTitle}"/>
                            <CheckBox Name="ChkWallBothFaces" Content="Place mesh on both faces"
                                      IsChecked="True" Margin="0,0,0,4"
                                      Click="WallPreview_Changed"
                                      Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Text="When unchecked, mesh is placed on the exterior face only."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.55"/>
                            <CheckBox Name="ChkWallVertOuter" Content="Vertical bars in the outer layer (touching cover)"
                                      IsChecked="True" Margin="0,8,0,4"
                                      Click="WallPreview_Changed"
                                      Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Text="When unchecked, horizontal bars sit in the outer layer instead (vertical goes behind). End/Top U-bars follow the same layer assignment as the mesh they anchor."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.55"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ties" Style="{StaticResource RA_SectionTitle}"/>
                            <!-- Edge bars removed 2026-09-02 (explicit
                                 request — "ya tenemos rebar sets, no
                                 es necesario") — see wall_rebar.py's
                                 own history for the removed feature. -->
                            <CheckBox Name="ChkWallTies" Content="Add through-wall ties (both faces)"
                                      IsChecked="False" Margin="0,8,0,4"
                                      Click="WallTies_Click"
                                      Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Name="PanelWallTies" IsEnabled="False">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tie diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallTieDia" Text="8" Style="{StaticResource RA_NumField}"
                                             TextChanged="WallPreview_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tie spacing along wall (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallTieSpacing" Text="400" Style="{StaticResource RA_NumField}"
                                             TextChanged="WallPreview_Changed"/>
                                </Grid>
                            </StackPanel>
                            <CheckBox Name="ChkWallEndUBars" Content="Add end U-bars (wrap thickness at free ends)"
                                      IsChecked="True" Margin="0,8,0,4"
                                      Click="WallEndUBars_Click"
                                      Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Name="PanelWallEndUBars">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U-bar diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallUBarDia" Text="12" Style="{StaticResource RA_NumField}"
                                             TextChanged="WallPreview_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U-bar spacing (mm) — not used: one U-bar beside each mesh bar" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallUBarSpacing" Text="200" Style="{StaticResource RA_NumField}"
                                             TextChanged="WallPreview_Changed"/>
                                </Grid>
                            </StackPanel>
                            <CheckBox Name="ChkWallStarters" Content="Extend vertical bars straight down into the foundation (no hook)"
                                      IsChecked="False" Margin="0,8,0,4"
                                      Click="WallStarters_Click"
                                      Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Name="PanelWallStarters" IsEnabled="False">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Length if no foundation below (mm, 0=auto)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallStarterLength" Text="Auto" Style="{StaticResource RA_NumField}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Phase F7.18 (2026-09-02) — distinct from
                                 the plain straight extension above: an
                                 L-shaped (hooked) starter per vertical
                                 bar position, reaching down into a
                                 DETECTED foundation (isolated/strip
                                 footing or floor/mat slab) below. -->
                            <CheckBox Name="ChkWallFoundationStarters" Content="Add L-Shaped Starter Bars into Foundation Below"
                                      IsChecked="False" Margin="0,12,0,4"
                                      Click="WallFoundationStarters_Click"
                                      Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Text="One hooked starter per wall vertical (both faces), contact-lapped on its inner side and hosted on the foundation detected below; the 90&#176; foot points outwards across the footing and the lap is measured above the foundation top. Skipped (reported) where no foundation is found below."
                                       FontSize="9" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,4,0,4"/>
                            <StackPanel Name="PanelWallFoundationStarters" IsEnabled="False">
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Anchor Length in Foundation (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallFoundationAnchor" Text="400" Style="{StaticResource RA_NumField}"/>
                                </Grid>
                                <Grid Style="{StaticResource RA_FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Visible Splice Length Above (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                    <TextBox Grid.Column="1" Name="TxtWallFoundationSplice" Text="Auto" Style="{StaticResource RA_NumField}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Stock / Laps" Style="{StaticResource RA_SectionTitle}"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max stock length (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtWallStockLength" Text="12000" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <TextBlock Text="Bars longer than stock length are split with normative laps (required for complete bending schedules and steel tonnage)."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.55"/>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnRunWallReinforcement" Content="GENERATE REINFORCEMENT"
                            Click="RunWallReinforcement_Click" Style="{DynamicResource ActionButton}"
                            HorizontalAlignment="Stretch" Height="52" FontSize="14" FontWeight="Bold"
                            Margin="0,4,0,16"/>

                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBox Name="TxtWallResult" Text="No run yet."
                                     FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextColor}" Opacity="0.75"/>
                        </StackPanel>
                    </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN — Section + Elevation Preview, fixed in view.
             BUG FIX (2026-09-02, live report — "la vista de los walls
             preview no está centrada, también sería conveniente que se
             viese una sección, el nombre... dice Section Preview cuando
             es un alzado") — this panel used to hold ONE canvas, drawn
             by _draw_wall_elevation_preview (a front-view ELEVATION),
             mislabelled "Section Preview". Split into two, mirroring the
             Columns tab's own Section+Elevation pair: a genuine
             cross-section (horizontal cut through the wall's own
             thickness — rebar_preview.compute_wall_section_preview,
             already written, never wired into the UI until now) first,
             then the existing front-view canvas correctly relabelled
             "Elevation Preview" (kept as WallPreviewCanvas — same
             x:Name, only its own TextBlock label text changed). -->
        <Border Grid.Column="1" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,20,20,20">
                <TextBlock Text="Section Preview" Style="{StaticResource RA_SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="340">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="WallSectionCanvas" Width="260" Height="420"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="A vertical cut through the wall's own thickness — vertical bars as continuous lines (one per face), horizontal bars as dots at their own spacing, plus tie/U-bar detail if enabled."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,16"/>

                <TextBlock Text="Elevation Preview" Style="{StaticResource RA_SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="220">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="WallPreviewCanvas" Width="700" Height="220"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Illustrative only — a representative wall front view, not the real model geometry."
                           FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        </Grid>
        </TabItem>

        <!-- ═══ STAIRS (T7.8) — cast-in-place stairs, bars hosted on the Stairs element ═══ -->
        <TabItem Header="Stairs">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,20">

                    <TextBlock Text="Select one or more cast-in-place (monolithic) Stairs in the model, then run. Straight flights with their landings are reinforced; winders and curved runs are skipped. Cover is the stair's own Rebar Cover."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}" Opacity="0.65"
                               Margin="0,0,0,16"/>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Main Bars — Bottom (soffit)" Style="{StaticResource RA_SectionTitle}"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtStairMainDia" Text="12" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtStairMainSpacing" Text="200" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Main Bars — Top" Style="{StaticResource RA_SectionTitle}"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtStairTopDia" Text="12" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtStairTopSpacing" Text="200" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Distribution Bars (both faces, landings across)" Style="{StaticResource RA_SectionTitle}"/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Diameter (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtStairDistDia" Text="8" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spacing (mm)" Style="{StaticResource RA_FieldLabel}"/>
                                <TextBox Grid.Column="1" Name="TxtStairDistSpacing" Text="200" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkStairStarters" Content="Starter bars at the base (both faces)"
                                      FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"
                                      ToolTip="Flights that start on a foundation, slab or beam (no landing below) get starters lapped with their bottom and top bars."/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Support" Style="{StaticResource RA_FieldLabel}"/>
                                <ComboBox Grid.Column="1" Name="CboStairStarterType"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Starter Diameter (mm)" Style="{StaticResource RA_FieldLabel}" ToolTip="Usually the diameter of the flight bars it laps."/>
                                <TextBox Grid.Column="1" Name="TxtStairStarterDia" Text="12" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lap Length (mm)" Style="{StaticResource RA_FieldLabel}" ToolTip="Auto = EC2 lap l0 for the stair concrete (never below max(15 phi, 300 mm))."/>
                                <TextBox Grid.Column="1" Name="TxtStairStarterLap" Text="Auto" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Drilled Embedment (mm)" Style="{StaticResource RA_FieldLabel}" ToolTip="Post-installed only. Auto = the tension anchorage length lbd; confirm with the resin manufacturer (EAD 330087 / TR 069) and the support edge distance."/>
                                <TextBox Grid.Column="1" Name="TxtStairStarterEmbed" Text="Auto" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="9" FontStyle="Italic" Opacity="0.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextColor}"
                                       Text="Cast-in: L bars with the foot on the support's bottom mat (foot max(12 phi, 450 mm); bottom-face feet point up the flight, top-face feet back), rising at each bar's knee and cranked to the slope, contact-lapped l0. Post-installed: pre-bent bars, straight part bonded with resin into a drilled hole. The flight bars then start at the knee."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Name="ChkStairLandingUBars" Content="U-bars on the landing free edges"
                                      FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"
                                      ToolTip="Every landing edge no flight reaches is closed like a slab free edge."/>
                            <Grid Style="{StaticResource RA_FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="U-Bar Diameter (mm)" Style="{StaticResource RA_FieldLabel}" ToolTip="One U per edge bar, contact-lapped with it."/>
                                <TextBox Grid.Column="1" Name="TxtStairUBarDia" Text="10" Style="{StaticResource RA_NumField}"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="9" FontStyle="Italic" Opacity="0.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextColor}"
                                       Text="EC2 9.3.1.4: legs max(40 phi, 2h). The landing and flight bars then stop straight inside the U instead of ending with a closing leg."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ends" Style="{StaticResource RA_SectionTitle}"/>
                            <CheckBox Name="ChkStairSlabAnchor" Content="Lap into the floor slab where a flight ends without a landing" IsChecked="True"
                                      ToolTip="The flight bars run on into the slab by a tension anchorage length (they leave the stair). Untick when the slab is reinforced to receive the flight."/>
                            <TextBlock TextWrapping="Wrap" FontSize="9" FontStyle="Italic" Opacity="0.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextColor}"
                                       Text="Knees (EC2 / IStructE): bars on the re-entrant face are never bent round the corner — they run straight on and anchor in the opposite face (bottom bars into the upper landing top, landing bottom bars into the flight). Bars on the convex face are continuous. Top and bottom flight bars are staggered half a spacing so they never meet in a landing. Landings get transverse bars on both faces and their own bars where no flight continues through (stairwell gap)."/>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnRunStairReinforcement" Content="GENERATE REINFORCEMENT"
                            Click="RunStairReinforcement_Click" Style="{DynamicResource ActionButton}"
                            HorizontalAlignment="Stretch" Height="52" FontSize="14" FontWeight="Bold"
                            Margin="0,4,0,16"/>

                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Result" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBox Name="TxtStairResult" Text="No run yet."
                                     FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextColor}" Opacity="0.75"/>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,20,20,20">
                <TextBlock Text="Section Preview" Style="{StaticResource RA_SectionTitle}"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Background="{DynamicResource BgColor}" Height="420">
                    <Viewbox Stretch="Uniform">
                        <Canvas Name="StairSectionCanvas" Width="340" Height="560"
                                Background="Transparent" ClipToBounds="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Name="TxtStairPreviewNote" FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,6,0,0"
                           Text="Longitudinal section along the first flight of the selected stair (or a typical flight)."/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        </Grid>
        </TabItem>

        <!-- ═══ DETAILING & TOOLS (Dashboard — placeholders, Phase 5) ═══ -->
        <TabItem Header="Detailing &amp; Tools">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">

                    <TextBlock Text="Global tools for reinforcement already placed in the model — not tied to a specific category."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,16"/>

                    <!-- PHASE F3 — Project Marking Settings -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Project Marking Settings" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBlock Text="Configure mark prefix, revision, and project status. These settings persist per document."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Partition:" VerticalAlignment="Center" Margin="0,0,8,8"
                                           ToolTip="Schedule / drawing the bar marks belong to. Marks are numbered 01, 02 ... within each partition (BS 8666); also written to the native Rebar Partition."/>
                                <TextBox Grid.Row="0" Grid.Column="1" Name="TxtMarkPrefix" MaxLength="10" Margin="0,0,16,8"/>
                                
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Revision:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Name="TxtRevision" MaxLength="5" Margin="0,0,0,8"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbProjectStatus" Margin="0,0,16,0"/>
                                
                                <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Name="BtnSaveProjectHeader" Content="Save Project Settings" Margin="0,0,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kicker Height (mm):" VerticalAlignment="Center" Margin="0,8,8,0"
                                           ToolTip="Column and wall kicker cast with the foundation. Starter and dowel laps are measured above it (IStructE SMDSC: 75 mm). 0 = no kicker."/>
                                <TextBox Grid.Row="2" Grid.Column="1" Name="TxtKickerHeight" MaxLength="5" Margin="0,8,16,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lap rules:" VerticalAlignment="Center" Margin="0,8,8,0"
                                           ToolTip="EC2: l0 = alpha6 x lb,rqd from the host's concrete (fbd, bond position, % lapped). BS 8110: Table 3.27 multiples. Every lap is at least max(15 bar diameters, 300 mm)."/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Name="CmbLapRules" Margin="0,8,16,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Default fck (MPa):" VerticalAlignment="Center" Margin="0,8,8,0"
                                           ToolTip="Used for hosts whose structural material has no concrete strength (32 = C32/40)."/>
                                <TextBox Grid.Row="3" Grid.Column="3" Name="TxtDefaultFck" MaxLength="4" Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PHASE F1 — basic batch manager: one row per batch_id found
                         among this plugin's own elements (rebar_batch.RebarBatch.
                         list_batches). "Select in Model" / "Delete Batch" act on
                         the currently selected row. -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Batch Manager" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBlock Text="Every reinforcement run creates one batch — select a row below to select or delete everything from that run."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                            <ListBox Name="LstBatches" Height="120" Margin="0,0,0,8"/>
                            <UniformGrid Columns="5">
                                <Button Name="BtnRefreshBatches" Content="Refresh"
                                        Click="RefreshBatches_Click" Margin="0,0,4,0"/>
                                <Button Name="BtnSelectBatch" Content="Select in Model"
                                        Click="SelectBatch_Click" Margin="4,0,4,0"/>
                                <Button Name="BtnDeleteBatch" Content="Delete Batch"
                                        Click="DeleteBatch_Click" Margin="4,0,4,0"/>
                                <Button Name="BtnRenumberPartition" Content="Renumber Partition"
                                        Click="RenumberPartition_Click" Margin="4,0,0,0"
                                        ToolTip="Give every non-finalized bar of this partition a BS 8666 mark (01, 02 ...). Finalized bars keep theirs."/>
                                <Button Name="BtnPartitions" Content="Partitions..."
                                        Click="Partitions_Click" Margin="4,0,0,0"
                                        ToolTip="Name the BBS member of every reinforced host and schedule identical hosts once, with No. of mbrs = N."/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- PHASE F5 — Bar Bending Schedule (BBS) -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Bar Bending Schedule (BBS)" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBlock Text="Generate a full bar bending schedule for all NOSA rebars in the project. Export to CSV or Excel."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                            <Button Name="BtnGenerateSchedule" Content="Generate Schedule..."
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <TextBlock Name="TxtScheduleSummary" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.8"
                                       TextWrapping="Wrap" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- PHASE F8 — BVBS export (CNC bending machines) -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BVBS Export" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBlock Text="Export all NOSA rebars as a .abs file for CNC bending machines. Format not yet validated against an official BVBS validator or a real machine — confirm before sending to fabrication."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                            <Button Name="BtnExportBvbs" Content="Export BVBS (.abs)..."
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Modification Tools" Style="{StaticResource RA_SectionTitle}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Name="BtnLap" Visibility="Collapsed" Content="Lap (Join Collinear Bars)" Click="Lap_Click" Margin="0,0,4,8"/>
                                <Button Name="BtnSplit" Visibility="Collapsed" Content="Split (To Commercial Length)" Click="Split_Click" Margin="4,0,0,8"/>
                                <Button Name="BtnExtend" Visibility="Collapsed" Content="Extend (Hooks/Legs)" Click="Extend_Click" Margin="0,4,4,0"/>
                                <Button Name="BtnCopyToSimilar" Visibility="Collapsed" Content="Copy to Similar Hosts" Click="CopyToSimilar_Click" Margin="4,4,0,0"/>
                            </UniformGrid>
                            <Button Name="BtnDeleteHostRebars" Visibility="Collapsed" Content="Delete Host Rebars"
                                    Click="DeleteHostRebars_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Visibility" Style="{StaticResource RA_SectionTitle}"/>
                            <Button Name="BtnToggleSolids" Visibility="Collapsed" Content="Show/Hide Rebar as Solids"
                                    Click="ToggleSolids_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Create Views" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextColor}"
                                       Text="Select reinforced elements in the model, then create their views in one click: column section + two elevations; beam elevation + sections at mid-span and near the support (one elevation per line of spans); footing / slab plan + two sections; wall elevation + section; stair section per flight + plan. NOSA RC Section / RC PLAN templates, scale chosen to fit (details at 1:10, elevations and plans larger as needed), bars shown unobscured."/>
                            <CheckBox Name="ChkViewsTags" Content="Tag the bars (no overlapping tags)" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox Name="ChkViewsSheets" Content="Place on a new A1 sheet per element (4000 series)" IsChecked="True" Margin="0,0,0,8"/>
                            <Button Name="BtnCreateViews" Content="CREATE VIEWS FOR SELECTION"
                                    Click="CreateViews_Click" Style="{DynamicResource ActionButton}"
                                    HorizontalAlignment="Stretch" Height="40"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Detailing" Style="{StaticResource RA_SectionTitle}"/>
                            <TextBlock Text="Annotate selected rebars in the active view, or create orthogonal detail sections through selected hosts. Uses the annotation families already loaded in this project."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>

                            <TextBlock Text="Rebar tag type:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <ComboBox Name="CmbRebarTagType" Margin="0,0,0,8"/>

                            <TextBlock Text="Multi-rebar annotation type:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <ComboBox Name="CmbMraType" Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Name="BtnAutoTag" Content="Auto Tag Selection"
                                        Click="AutoTag_Click" Margin="0,0,4,0"/>
                                <Button Name="BtnAutoMRA" Content="Auto MRA..."
                                        Click="AutoMRA_Click" Margin="4,0,0,0"/>
                            </UniformGrid>
                            <Button Name="BtnAutoSections" Content="Auto Detail Sections (X + Y)..."
                                    Click="AutoSections_Click" HorizontalAlignment="Stretch"/>
                            <Button Name="BtnLoadContent" Content="Load NOSA Families"
                                    Click="LoadContent_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    ToolTip="Load the packaged NOSA annotation families (data/content_manifest.json), replacing missing or out-of-date copies."/>
                            <TextBlock Name="TxtContentStatus" Text="" FontSize="11"
                                       Foreground="{DynamicResource AccentColor}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Name="TxtDetailingStatus" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Opacity="0.8"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        </TabControl>

        <!-- Shared loading overlay (NOSAWindow standard) -->
        <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <CheckBox Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                      Foreground="{DynamicResource TextColor}"/>
        </Border>
    </Grid>
</Window>
