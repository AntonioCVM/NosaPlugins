                <Path Data="M4,3 L20,3 L20,21 L4,21 Z M4,8 L20,8 M4,13 L20,13 M4,17 L20,17 M10,3 L10,21" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                      StrokeLineJoin="Round" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Schedules &amp; export" VerticalAlignment="Center"/>
            </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Bar schedules and fabrication files for the reinforcement in the model." Style="{StaticResource RA_Intro}"/>
                                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Bar bending schedules (BS 8666)" Style="{StaticResource RA_SectionTitle}"/>
                                            <TextBlock Text="Generate a full bar bending schedule for all NOSA rebars in the project. Export to CSV or Excel."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                                            <Button Name="BtnGenerateSchedule" Content="Generate schedule..."
                                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                                                        <Button Name="BtnBarSchedules" Content="Create A4 bar schedules (5500 series)"
                                                    Click="BarSchedules_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                                    ToolTip="IStructE SMDSC 4.5.1: separate A4 schedules for each reinforcement drawing, referenced drawing + schedule + revision (4502-01-A), members whole and level by level, status P until changed on the sheet. Run Create Views with sheets first."/>
                                            <Button Name="BtnShapeImages" Content="BS 8666 shape images for the BBS"
                                                    Click="ShapeImages_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                    ToolTip="Draw the BS 8666 sketch (dimension letters A, B, C…) of every rebar shape, set it as the shape's image and add the Shape Image column to the BBS schedules."/>
                                            <Button Name="BtnTypeSchedules" Content="Column and base schedules (tabular method)"
                                                    Click="TypeSchedules_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                    ToolTip="IStructE SMDSC 4.1.1 / 6.4.4 / 6.7.4: every reinforced column and base gets the calling-up of its bars, and two schedules list one row per type with its references and number off."/>
                <TextBlock Name="TxtScheduleSummary" Text="" FontSize="11"
                                                       Foreground="{DynamicResource TextColor}" Opacity="0.8"
                                                       TextWrapping="Wrap" Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Fabrication export (BVBS)" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock Text="A .abs file for CNC bending machines, and one folder for the fabricator: the BBS as Excel (with BS 8666 sketches) and CSV, plus the BVBS file. Confirm the BVBS file with the fabricator before use." Style="{StaticResource RA_Hint}"/>
                        <Button Name="BtnExportBvbs" Content="Export BVBS (.abs)..."
                                HorizontalAlignment="Stretch"/>
                        <Button Name="BtnExportPackage" Content="Export fabrication package (BBS + BVBS)..."
                                HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                ToolTip="One folder for the fabricator: the BBS as Excel (with BS 8666 sketches) and CSV, plus the BVBS file for the bending machine. No model is shared."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Name="TabCheck">
        <TabItem.Header>
            <StackPanel Orientation="Horizontal">
                <Path Data="M12,2 L20,5 L20,12 C20,17 16,21 12,22 C8,21 4,17 4,12 L4,5 Z M8,12 L11,15 L16,9" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                      StrokeLineJoin="Round" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Check &amp; manage" VerticalAlignment="Center"/>
            </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Quality checks, runs, modifications and visibility of the bars in the model." Style="{StaticResource RA_Intro}"/>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Checks" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock Text="Read-only checks of the reinforcement already in the model." Style="{StaticResource RA_Hint}"/>
                        <Button Name="BtnRebarQA" Content="Rebar QA (SMDSC checks)..."
                                Click="RebarQA_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                ToolTip="Cover, clear spacing with the real bar size, pitches and steel ratios, vibrator gaps, stock length, clashes and congestion, per host and drawing (IStructE SMDSC 4.4 / 4.6). Read-only."/>
                        <Button Name="BtnRebarHub" Content="Model rebar: schedules, bar marks &amp; EC2 audit..."
                                Click="RebarHub_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                ToolTip="All the reinforcement in the model (not only RebarAutomate's): BS 8666 schedule by mark or host, duplicate bar marks and renumbering, and an EC2 audit of cover, reinforcement ratios and unreinforced elements."/>
                        <Button Name="BtnRobustness" Content="Robustness ties (SMDSC 5.1.10)..."
                                Click="Robustness_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                ToolTip="Peripheral, internal, column and vertical tie forces and steel (EC2 9.10, UK NA), and the continuous lapped ties the bars of the selected floors give. Read-only."/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Runs (batches)" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock Text="Every reinforcement run creates one batch — select a row below to select or delete everything from that run."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,8"/>
                        <ListBox Name="LstBatches" Height="120" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5">
                            <Button Name="BtnRefreshBatches" Content="Refresh"
                                    Click="RefreshBatches_Click" Margin="0,0,4,0"/>
                            <Button Name="BtnSelectBatch" Content="Select in model"
                                    Click="SelectBatch_Click" Margin="4,0,4,0"/>
                            <Button Name="BtnDeleteBatch" Content="Delete batch"
                                    Click="DeleteBatch_Click" Margin="4,0,4,0"/>
                            <Button Name="BtnRenumberPartition" Content="Renumber partition"
                                    Click="RenumberPartition_Click" Margin="4,0,0,0"
                                    ToolTip="Give every non-finalized bar of this partition a BS 8666 mark (01, 02 ...). Finalized bars keep theirs."/>
                            <Button Name="BtnPartitions" Content="Partitions..."
                                    Click="Partitions_Click" Margin="4,0,0,0"
                                    ToolTip="Name the BBS member of every reinforced host and schedule identical hosts once, with No. of mbrs = N."/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Modify bars" Style="{StaticResource RA_SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextColor}"
                                   Text="Split cuts the selected straight bars that exceed the stock length, with laps staggered as in the generators (alternate bars, 50 % lapped). Delete Host Rebars removes the bars of the selected hosts; Finalized bars are kept."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stock length (mm):" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColor}"/>
                            <TextBox Grid.Column="1" Name="TxtModifyStockLength" Text="12000" Style="{StaticResource RA_NumField}"/>
                        </Grid>
                        <UniformGrid Columns="2">
                            <Button Name="BtnSplit" Content="Split to stock length" Click="Split_Click" Margin="0,0,4,0"/>
                            <Button Name="BtnDeleteHostRebars" Content="Delete host rebars" Click="DeleteHostRebars_Click" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Visibility" Style="{StaticResource RA_SectionTitle}"/>
                        <Button Name="BtnToggleSolids" Content="Show / hide rebar as solids (3D view)"
                                Click="ToggleSolids_Click" HorizontalAlignment="Stretch"
                                ToolTip="In the active 3D view: show the selected bars (or all bars in the view) as unobscured solids, or back to wires."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action bar: the result of the last run, its QA grade, the next step and GENERATE, always here -->
        <Border Grid.Row="3" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Name="DotStatus" Width="10" Height="10" Fill="#BDBDBD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Name="TxtActionStatus" Text="Ready." FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"
                           ToolTip="The first line of the last run; the full log is under Run log."/>
                <Border Grid.Column="2" Name="BadgeQA" CornerRadius="12" Padding="12,3" Margin="12,0"
                        Background="#BDBDBD" Visibility="Collapsed" VerticalAlignment="Center"
                        ToolTip="Buildability of the selection from the reinforcement QA (SMDSC 4th ed. 4.4 / 4.6): A+ ready to issue, A minor points, B to review, C not buildable as drawn.">
                    <TextBlock Name="TxtQAGrade" Text="QA" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Button Grid.Column="3" Name="BtnNextStep" Content="Create drawings  ▸" Height="38" Padding="16,0"
                        Margin="0,0,10,0" Visibility="Collapsed"
                        ToolTip="Next step: the reinforcement drawings of the selection."/>
                <Button Grid.Column="4" Name="BtnGenerate" Content="GENERATE" Style="{DynamicResource ActionButton}"
                        Height="38" Width="190" FontSize="14" FontWeight="Bold"
                        ToolTip="Generate the reinforcement of the selected elements with this tab's values."/>
            </Grid>
        </Border>
    </Grid>
</Window>