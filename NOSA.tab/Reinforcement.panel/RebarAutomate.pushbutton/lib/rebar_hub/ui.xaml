<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebar Hub — NOSA" Height="800" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <!-- Sidebar nav buttons (main hub sections) -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="border" BorderThickness="4,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-style sub-tab buttons (BS Schedule/Marks, Audit Cover/Ratio/Unrein) -->
        <Style TargetType="Button" x:Key="ModeButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"   Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="RowBackground"            Value="{DynamicResource PanelColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgColor}"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="190" MaxWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="560"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,25,20,16">
                <TextBlock Text="REBAR HUB" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="BS 8666 · Schedule · EC2 Audit" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Button Name="BtnMainBS"    Tag="BS"    Content="BS 8666 Schedule" Style="{DynamicResource NavButton}" Click="MainTab_Click"/>
                <Button Name="BtnMainSched" Tag="Sched" Content="Rebar Schedule"   Style="{DynamicResource NavButton}" Click="MainTab_Click"/>
                <Button Name="BtnMainAudit" Tag="Audit" Content="EC2 Audit"       Style="{DynamicResource NavButton}" Click="MainTab_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled" Margin="0,0,0,10"/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="2" Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <!-- ══ BS 8666 Panel ══ -->
                <Grid Name="PanelBS" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BS toolbar card -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="{DynamicResource BgColor}" CornerRadius="14" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Name="BtnBsTabSched" Tag="Sched" Content="Schedule" Style="{DynamicResource ModeButton}" Click="BsTab_Click"/>
                                        <Button Name="BtnBsTabMarks" Tag="Marks" Content="Bar Marks" Style="{DynamicResource ModeButton}" Click="BsTab_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="Load Rebar" Style="{DynamicResource ActionButton}"
                                        Click="BsLoad_Click" Margin="0,0,8,0"/>
                                <Button Content="Export Excel (BS 8666)" Style="{DynamicResource SecondaryButton}"
                                        Click="BsExportExcel_Click" Margin="0,0,16,0"/>
                                <TextBlock Text="Proj No:" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                                <TextBox Name="TxtBsProjectNo" Width="80" Style="{StaticResource FieldBox}"
                                         Margin="0,0,10,0"/>
                                <TextBlock Text="Rev:" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                                <TextBox Name="TxtBsRevision" Width="60" Style="{StaticResource FieldBox}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- BS Schedule sub-panel -->
                    <Border Name="PanelBsSched" Grid.Row="1" Visibility="Visible" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="GridBsSchedule">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mark"      Binding="{Binding Mark}"      Width="80"/>
                                <DataGridTextColumn Header="Ø (mm)"    Binding="{Binding DiamLabel}"  Width="70"/>
                                <DataGridTextColumn Header="Qty"       Binding="{Binding Quantity}"   Width="50"/>
                                <DataGridTextColumn Header="Shape"     Binding="{Binding Shape}"      Width="60"/>
                                <DataGridTextColumn Header="Shape Desc" Binding="{Binding ShapeDesc}" Width="140"/>
                                <DataGridTextColumn Header="Length (m)" Binding="{Binding TotalLenM}" Width="90"/>
                                <DataGridTextColumn Header="Mass (kg)" Binding="{Binding MassKg}"    Width="90"/>
                                <DataGridTextColumn Header="Levels"    Binding="{Binding Levels}"    Width="120"/>
                                <DataGridTextColumn Header="Hosts"     Binding="{Binding Hosts}"     Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Bar Marks sub-panel -->
                    <Grid Name="PanelBsMarks" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <WrapPanel>
                                <Button Content="Refresh Marks" Style="{DynamicResource ActionButton}"
                                        Click="BsLoadMarks_Click" Margin="0,0,8,0"/>
                                <Button Content="Detect Duplicates" Style="{DynamicResource SecondaryButton}"
                                        Click="BsDetectDupes_Click" Margin="0,0,16,0"/>
                                <TextBlock Text="Prefix:" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                                <TextBox Name="TxtBsMarkPrefix" Width="60" Text="S"
                                         Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="Start:" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                                <TextBox Name="TxtBsMarkStart" Width="50" Text="1"
                                         Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <Button Content="Renumber Selected" Style="{DynamicResource ActionButton}"
                                        Click="BsRenumber_Click"/>
                            </WrapPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                            <DataGrid Name="GridBsMarks">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✔" Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Mark"     Binding="{Binding Mark}"        Width="80"/>
                                    <DataGridTextColumn Header="Ø (mm)"   Binding="{Binding Diameter}"    Width="70"/>
                                    <DataGridTextColumn Header="Qty"      Binding="{Binding Quantity}"    Width="50"/>
                                    <DataGridTextColumn Header="Shape"    Binding="{Binding Shape}"       Width="60"/>
                                    <DataGridTextColumn Header="Levels"   Binding="{Binding Levels}"      Width="120"/>
                                    <DataGridTextColumn Header="Warning"  Binding="{Binding DupeWarning}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Name="PanelBsDuplicates" Grid.Row="2" Visibility="Collapsed"
                                Background="#FFF3E0" Padding="10,8" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Name="TxtBsDuplicates" FontSize="11" TextWrapping="Wrap"
                                       Foreground="#BF360C"/>
                        </Border>
                    </Grid>

                    <!-- BS status bar -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Name="TxtBsSchedStatus" Style="{StaticResource HintText}"
                                   Visibility="{Binding Visibility, ElementName=PanelBsSched}"/>
                        <TextBlock Name="TxtBsMarksStatus" Style="{StaticResource HintText}"
                                   Visibility="{Binding Visibility, ElementName=PanelBsMarks}"/>
                    </Grid>
                </Grid>

                <!-- ══ Rebar Schedule Panel ══ -->
                <Grid Name="PanelSched" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <WrapPanel>
                            <TextBlock Text="Group by:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,8,0"/>
                            <RadioButton Name="RbRsGroupHost"     Content="Host element"
                                         IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Name="RbRsGroupDiameter" Content="Diameter"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Name="RbRsGroupShape"    Content="Shape code"
                                         VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="Host:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                            <ComboBox Name="CboRsHostCat" Width="160" Height="26" FontSize="11"
                                      Margin="0,0,12,0"/>
                            <TextBlock Text="Level:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                            <ComboBox Name="CboRsLevel" Width="120" Height="26" FontSize="11"
                                      Margin="0,0,12,0"/>
                            <TextBlock Text="Phase:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,4,0"/>
                            <ComboBox Name="CboRsPhase" Width="120" Height="26" FontSize="11"
                                      Margin="0,0,12,0"/>
                            <CheckBox Name="ChkRsSubtotals" Content="Show subtotals"
                                      VerticalAlignment="Center" FontSize="11" Margin="0,0,16,0"/>
                            <Button Content="Generate" Style="{DynamicResource ActionButton}"
                                    Name="BtnRsGenerate" Click="RsGenerate_Click" Margin="0,0,8,0"/>
                            <Button Content="Export Excel" Style="{DynamicResource SecondaryButton}"
                                    Name="BtnRsXlsx" IsEnabled="False"
                                    Click="RsExportXlsx_Click" Margin="0,0,8,0"/>
                            <Button Content="Export CSV" Style="{DynamicResource SecondaryButton}"
                                    Name="BtnRsCsv" IsEnabled="False"
                                    Click="RsExportCsv_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="GridRsSchedule" SelectionChanged="RsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Host"          Binding="{Binding host_mark_str}"  Width="140"/>
                                <DataGridTextColumn Header="Category"      Binding="{Binding host_cat_str}"   Width="100"/>
                                <DataGridTextColumn Header="Level"         Binding="{Binding host_level_str}" Width="100"/>
                                <DataGridTextColumn Header="Bar Mark"      Binding="{Binding bar_mark_str}"   Width="80"/>
                                <DataGridTextColumn Header="Ø"             Binding="{Binding dia_str}"        Width="60"/>
                                <DataGridTextColumn Header="Shape"         Binding="{Binding shape_str}"      Width="60"/>
                                <DataGridTextColumn Header="Qty"           Binding="{Binding n_bars_str}"     Width="50"/>
                                <DataGridTextColumn Header="Cut len (mm)"  Binding="{Binding cut_str}"        Width="90"/>
                                <DataGridTextColumn Header="Total len (m)" Binding="{Binding total_len_str}"  Width="90"/>
                                <DataGridTextColumn Header="Wt/m (kg)"     Binding="{Binding wt_per_m_str}"   Width="80"/>
                                <DataGridTextColumn Header="Total wt (kg)" Binding="{Binding total_wt_str}"   Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Name="ProgRs" Width="120" Height="8"
                                         IsIndeterminate="True" Visibility="Collapsed"
                                         Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0"/>
                            <TextBlock Name="TxtRsProgress" Style="{StaticResource HintText}" Margin="0,0,20,0"/>
                            <TextBlock Text="Bars:" Style="{StaticResource HintText}" Margin="0,0,4,0"/>
                            <TextBlock Name="TxtRsTotalBars" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentColor}" FontWeight="Bold"
                                       Margin="0,0,16,0"/>
                            <TextBlock Text="Length:" Style="{StaticResource HintText}" Margin="0,0,4,0"/>
                            <TextBlock Name="TxtRsTotalLength" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentColor}" FontWeight="Bold"
                                       Margin="0,0,16,0"/>
                            <TextBlock Text="Weight:" Style="{StaticResource HintText}" Margin="0,0,4,0"/>
                            <TextBlock Name="TxtRsTotalWeight" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentColor}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ EC2 Audit Panel ══ -->
                <Grid Name="PanelAudit" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <WrapPanel>
                            <TextBlock Text="Exposure class:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,6,0"/>
                            <ComboBox Name="CboAudExposure" Width="80" Height="26" FontSize="11"
                                      Margin="0,0,16,0"/>
                            <TextBlock Text="Custom cover (mm):" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,6,0"/>
                            <TextBox Name="TxtAudCustomCover" Width="70"
                                     Style="{StaticResource FieldBox}" Margin="0,0,16,0"/>
                            <Button Name="BtnAudRun" Content="Run Audit"
                                    Style="{DynamicResource ActionButton}" Click="AudRun_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource BgColor}" CornerRadius="14" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="BtnAudTabCover"  Content="Cover Check"  Style="{DynamicResource ModeButton}" Click="AudTab_Click"/>
                                    <Button Name="BtnAudTabRatio"  Content="Rebar Ratio"  Style="{DynamicResource ModeButton}" Click="AudTab_Click"/>
                                    <Button Name="BtnAudTabUnrein" Content="Unreinforced" Style="{DynamicResource ModeButton}" Click="AudTab_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Name="PanelAudProgress" Visibility="Collapsed"
                                    Background="#FFF3E0" CornerRadius="4" Padding="8,2" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Auditing…" FontSize="11" VerticalAlignment="Center"
                                               Foreground="#BF360C"/>
                                    <ProgressBar Width="80" Height="6" IsIndeterminate="True"
                                                 Foreground="{DynamicResource AccentColor}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                        <Grid>
                            <DataGrid Name="GridAudCover" Visibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status"   Binding="{Binding status}"    Width="60"/>
                                    <DataGridTextColumn Header="Element"  Binding="{Binding elem_name}"  Width="160"/>
                                    <DataGridTextColumn Header="Cover (mm)" Binding="{Binding cover_mm}" Width="90"/>
                                    <DataGridTextColumn Header="Min (mm)" Binding="{Binding req_mm}"    Width="80"/>
                                    <DataGridTextColumn Header="Gap (mm)" Binding="{Binding gap_mm}"    Width="80"/>
                                    <DataGridTextColumn Header="Bar"      Binding="{Binding bar_id}"    Width="80"/>
                                    <DataGridTextColumn Header="Level"    Binding="{Binding level}"     Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Name="GridAudRatio" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status"     Binding="{Binding status}"     Width="60"/>
                                    <DataGridTextColumn Header="Element"    Binding="{Binding elem_name}"   Width="160"/>
                                    <DataGridTextColumn Header="ρ actual"   Binding="{Binding rho_actual}"  Width="90"/>
                                    <DataGridTextColumn Header="ρ min"      Binding="{Binding rho_min}"     Width="80"/>
                                    <DataGridTextColumn Header="ρ max"      Binding="{Binding rho_max}"     Width="80"/>
                                    <DataGridTextColumn Header="Level"      Binding="{Binding level}"       Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Name="GridAudUnrein" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Element"  Binding="{Binding elem_name}" Width="200"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding category}"  Width="140"/>
                                    <DataGridTextColumn Header="Level"    Binding="{Binding level}"     Width="120"/>
                                    <DataGridTextColumn Header="Mark"     Binding="{Binding mark}"      Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="TxtAudCoverFail" FontSize="11" FontWeight="Bold"
                                       Foreground="#BF360C" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Name="TxtAudSummary" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                            <Button Name="BtnAudSelectFail" Content="Select FAIL in Revit"
                                    Style="{DynamicResource SecondaryButton}" IsEnabled="False"
                                    Click="AudSelectFail_Click" Margin="0,0,8,0"/>
                            <Button Name="BtnAudExport" Content="Export CSV"
                                    Style="{DynamicResource SecondaryButton}" IsEnabled="False"
                                    Click="AudExport_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Log card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="10,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBox Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="10"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextColor}"
                             FontFamily="Consolas, Courier New"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Loading Overlay ───────────────────────────────────────────── -->
        <Grid Name="LoadingPanel" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="#CCFAFAFA">
            <Border Background="{DynamicResource PanelColor}" CornerRadius="10" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Processing…" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                 IsIndeterminate="True" Margin="0,8,0,0"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
