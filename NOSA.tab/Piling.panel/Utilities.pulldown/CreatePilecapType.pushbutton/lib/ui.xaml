<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Pile Cap" Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Padding"   Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="20,28,20,16">
                <TextBlock Text="CREATE" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="PILE CAP" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtDims" Text="— configure below —" FontSize="10"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <!-- Arrangement -->
                    <TextBlock Text="Arrangement" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

                    <TextBlock Text="Piles across (H):" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <TextBox Name="TxtNH" Text="2" Style="{DynamicResource FieldBox}"
                             TextChanged="Params_Changed" Margin="0,0,0,8"/>

                    <TextBlock Text="Piles along (V):" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <TextBox Name="TxtNV" Text="2" Style="{DynamicResource FieldBox}"
                             TextChanged="Params_Changed" Margin="0,0,0,8"/>

                    <TextBlock Text="Pile spacing (mm):" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <TextBox Name="TxtSpacing" Text="900" Style="{DynamicResource FieldBox}"
                             TextChanged="Params_Changed" Margin="0,0,0,8"/>

                    <TextBlock Text="Edge clearance (mm):" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <TextBox Name="TxtClearance" Text="150" Style="{DynamicResource FieldBox}"
                             TextChanged="Params_Changed" Margin="0,0,0,8"/>

                    <TextBlock Text="Cutoff below cap top (mm):" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"
                               TextWrapping="Wrap"/>
                    <TextBox Name="TxtCutoff" Text="75" Style="{DynamicResource FieldBox}"
                             Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,12"/>

                    <!-- Element types -->
                    <TextBlock Text="Element Types" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

                    <TextBlock Text="Pile type:" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <ComboBox Name="CboPileType" Height="28" FontSize="10"
                              DisplayMemberPath="Name" Margin="0,0,0,8"/>

                    <TextBlock Text="Cap slab type (Floor):" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <ComboBox Name="CboCapType" Height="28" FontSize="10"
                              DisplayMemberPath="Name" Margin="0,0,0,8"/>

                    <TextBlock Text="Level:" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                    <ComboBox Name="CboLevel" Height="28" FontSize="10"
                              DisplayMemberPath="Name" Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,12"/>
                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                              Margin="0,0,0,4"/>

                </StackPanel>
            </ScrollViewer>

            <!-- PLACE button -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <Button Content="PLACE PILE CAP" Name="BtnPlace"
                        Click="Place_Click" Style="{DynamicResource ActionButton}"
                        FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN: canvas preview + info ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Canvas schematic in a Viewbox so it scales with window -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Background="White" CornerRadius="4">
                <Viewbox Stretch="Uniform">
                    <Canvas Name="PileCanvas" Width="400" Height="260"
                            Background="#F4F4F4"/>
                </Viewbox>
            </Border>

            <!-- Info panel below canvas -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock Name="TxtInfoPiles" Text="Piles: 4"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtInfoCap" Text="Cap: 1200 × 1200 mm"
                           FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.8"/>
                <TextBlock Name="TxtInfoNote"
                           Text="Click PLACE PILE CAP, then click a point in the model to set the centre."
                           FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Loading overlay -->
            <Grid Name="LoadingPanel" Grid.RowSpan="2" Visibility="Collapsed"
                  Background="#CCFAFAFA">
                <Border Background="White" CornerRadius="6" Padding="24,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Creating pile cap..." HorizontalAlignment="Center"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
