<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pile Master" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        
        <!-- Styles -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,0" BorderBrush="{DynamicResource AccentColor}" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,25">
                <TextBlock Text="PILE MASTER" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Foundation Tools v1.0" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Navigation -->
            <StackPanel Grid.Row="1">
                <Button Content="1. Coordinates" Style="{DynamicResource NavButton}" Name="BtnTabCoords" Click="NavButton_Click" Tag="Selected"/>
                <Button Content="2. Numbering" Style="{DynamicResource NavButton}" Name="BtnTabNumbering" Click="NavButton_Click"/>
                <Button Content="3. Visibility" Style="{DynamicResource NavButton}" Name="BtnTabVisibility" Click="NavButton_Click"/>
            </StackPanel>

            <!-- Status Info -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="20">
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Scope" FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                    <ComboBox Name="cmbScope" SelectedIndex="2" Margin="0,5,0,0">
                        <ComboBoxItem Content="Active View"/>
                        <ComboBoxItem Content="Selection"/>
                        <ComboBoxItem Content="Entire Project"/>
                    </ComboBox>
                </StackPanel>
                
                <Button Content="🔄 Refresh Data" Click="RefreshData_Click" 
                        Background="#F0F0F0" Foreground="#333" BorderThickness="0" 
                        Padding="10,8" Cursor="Hand" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Pages -->
            <Grid Grid.Row="0" Name="ContentGrid">
                
                <!-- Tab 1: Coordinates -->
                <Grid Name="TabCoords" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Coordinate &amp; Rotation" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock TextWrapping="Wrap" Text="X and Y are written as text in millimetres with thousands separators and 3 decimals (e.g. 1,000,000,000.254). Use Text-type shared parameters for X/Y; rotation stays numeric (radians)." Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="25">
                        <StackPanel>
                            <TextBlock Text="Parameter Names" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextColor}" Margin="0,0,0,15"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X Coordinate:" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Grid.Column="1" Name="tbParamX" Text="X coordinate"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y Coordinate:" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Grid.Column="1" Name="tbParamY" Text="Y coordinate"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rotation Angle:" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Grid.Column="1" Name="tbParamRot" Text="Rotation angle"/>
                            </Grid>

                            <Border Background="#FFF8F0" BorderBrush="{DynamicResource AccentColor}" BorderThickness="0,0,0,0" Padding="12" Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextColor}" FontSize="12" Opacity="0.8"
                                           Text="ℹ Coordination = absolute shared coordinates (best for linked models). Survey / Project Base follow the same idea as Spot Coordinates for that reference. Rotation uses the shared XY plane when a project location exists. Values are mm text with grouping."/>
                            </Border>

                            <TextBlock Text="Coordinate reference" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,6"/>
                            <ComboBox Name="cmbCoordType" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="Coordination (shared) — recommended"/>
                                <ComboBoxItem Content="Survey Point"/>
                                <ComboBoxItem Content="Project Base Point"/>
                            </ComboBox>

                            <CheckBox Name="chkProcessGroups" Content="Process elements inside Model Groups" IsChecked="True"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tab 2: Numbering -->
                <Grid Name="TabNumbering" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Automatic Numbering" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="Sequential numbering based on spatial position (Top-Left → Bottom-Right)." Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Mode Selection" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="chkPile" Content="Piles (Mark parameter)" IsChecked="True" Margin="0,0,25,0"/>
                                <CheckBox Name="chkPileCap" Content="Pilecaps (Comments parameter)" IsChecked="True"/>
                            </StackPanel>
                            <CheckBox Name="chkOnlyEmpty" Content="Only renumber empty elements (preserve existing)" IsChecked="False" Margin="0,10,0,0" FontStyle="Italic" Opacity="0.8"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15">
                        <DockPanel>
                            <TextBlock Text="Prefix Configuration" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                            <DataGrid Name="dgPrefixes" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      BorderBrush="{DynamicResource BorderColor}" Background="Transparent" 
                                      AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Tab 3: Visibility -->
                <Grid Name="TabVisibility" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Scope Visibility Manager" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="Manage visibility across zones. Creates 'Show_in_X' Yes/No parameters automatically." Foreground="{DynamicResource TextColor}" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15">
                        <DockPanel>
                            <TextBlock Text="Select Scope Boxes (Zones)" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                            <TextBlock Name="tbZoneInfo" DockPanel.Dock="Bottom" Text="Select scope boxes to define active zones." Foreground="{DynamicResource TextColor}" Opacity="0.7" FontStyle="Italic" Margin="0,10,0,0"/>
                            <ListBox Name="lbScopeBoxes" SelectionMode="Multiple" BorderBrush="{DynamicResource BorderColor}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnScopeCheck" Unchecked="OnScopeCheck" Margin="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

            </Grid>
            
            <!-- Bottom Action Bar -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
                <DockPanel>
                    <Button Name="BtnAction" DockPanel.Dock="Right" Content="UPDATE COORDINATES" Style="{DynamicResource ActionButton}" Click="ActionButton_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status or secondary info -->
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
