<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pile Master" Height="760" Width="1140"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Colors (swapped at runtime by NOSAWindow.ApplyTheme via Dark Mode toggle) -->
        <SolidColorBrush x:Key="BgColor" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <!-- Typography -->
        <Style TargetType="TextBlock" x:Key="PageTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="PageSubtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <!-- Card border for content panels -->
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Sidebar nav buttons -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,0" BorderBrush="{DynamicResource AccentColor}" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#20FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (outline) button, matches SEH's Export CSV / Refresh list buttons -->
        <Style TargetType="Button" x:Key="OutlineButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <Style TargetType="ToggleButton" x:Key="LiveToggle">
            <Setter Property="Background"       Value="#CCCCCC"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Width"            Value="90"/>
            <Setter Property="Height"           Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#22AA44"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="190" MaxWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="560"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL — NAVIGATION ==================== -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,25,20,20">
                <TextBlock Text="PILE MASTER" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Foundation Tools · NOSA" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Navigation -->
            <StackPanel Grid.Row="1">
                <Button Content="1. Coordinates" Style="{DynamicResource NavButton}" Name="BtnTabCoords" Click="NavButton_Click" Tag="Selected"/>
                <Button Content="2. Numbering" Style="{DynamicResource NavButton}" Name="BtnTabNumbering" Click="NavButton_Click"/>
                <Button Content="3. Visibility" Style="{DynamicResource NavButton}" Name="BtnTabVisibility" Click="NavButton_Click"/>
                <Button Content="4. Report" Style="{DynamicResource NavButton}" Name="BtnTabReport" Click="NavButton_Click"/>
                <Button Content="5. Schedule" Style="{DynamicResource NavButton}" Name="BtnTabSchedule" Click="NavButton_Click"/>
            </StackPanel>

            <!-- Scope + Refresh -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="20">
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="SCOPE" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                    <ComboBox Name="cmbScope" Margin="0,6,0,0">
                        <ComboBoxItem Content="Active View"/>
                        <ComboBoxItem Content="Selection"/>
                        <ComboBoxItem Content="Entire Project"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="🔄 Refresh Data" Click="RefreshData_Click" Style="{StaticResource OutlineButton}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="20,0,20,20">
                <Separator Margin="0,10,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ==================== RIGHT PANEL — CONTENT ==================== -->
        <Grid Grid.Column="2" Margin="26,24,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Pages -->
            <Grid Grid.Row="0" Name="ContentGrid">

                <!-- Tab 1: Coordinates -->
                <Grid Name="TabCoords" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Coordinate &amp; Rotation" Style="{StaticResource PageTitle}"/>
                        <TextBlock TextWrapping="Wrap" Text="X and Y are written as text in millimetres with thousands separators and 3 decimals (e.g. 1,000,000,000.254). Use Text-type shared parameters for X/Y; rotation stays numeric (radians)." Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Live Coordinates toggle -->
                    <Border Grid.Row="1" Name="LiveCoordsPanel"
                            Background="#F4FFF6" BorderBrush="#AADDBB"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,12" Margin="0,0,0,16">
                        <DockPanel>
                            <ToggleButton Name="TglLiveCoords"
                                          DockPanel.Dock="Right"
                                          Style="{DynamicResource LiveToggle}"
                                          Content="ENABLE"
                                          Click="ToggleLiveCoords_Click"
                                          VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Name="LiveDot" Width="10" Height="10"
                                             Fill="#CCCCCC" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Live Coordinates"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Name="TxtLiveStatus"
                                           Text="Inactive — enable to auto-update coords when piles move or are created."
                                           FontSize="11" Foreground="{DynamicResource TextColor}"
                                           Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="26">
                        <StackPanel>
                            <TextBlock Text="Parameter Names" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X Coordinate:" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Grid.Column="1" Name="tbParamX" Text="X coordinate"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y Coordinate:" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Grid.Column="1" Name="tbParamY" Text="Y coordinate"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rotation Angle:" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <TextBox Grid.Column="1" Name="tbParamRot" Text="Rotation angle"/>
                            </Grid>

                            <Border Background="#FFF8F0" BorderBrush="{DynamicResource AccentColor}" BorderThickness="3,0,0,0" CornerRadius="0,4,4,0" Padding="12" Margin="0,0,0,14">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextColor}" FontSize="12" Opacity="0.8"
                                           Text="ℹ Coordination = absolute shared coordinates (best for linked models). Survey / Project Base follow the same idea as Spot Coordinates for that reference. Rotation uses the shared XY plane when a project location exists. Values are mm text with grouping."/>
                            </Border>

                            <TextBlock Text="Coordinate reference" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox Name="cmbCoordType" Margin="0,0,0,14">
                                <ComboBoxItem Content="Coordination (shared) — recommended"/>
                                <ComboBoxItem Content="Survey Point"/>
                                <ComboBoxItem Content="Project Base Point"/>
                            </ComboBox>

                            <CheckBox Name="chkProcessGroups" Content="Process elements inside Model Groups" IsChecked="True"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tab 2: Numbering -->
                <Grid Name="TabNumbering" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Automatic Numbering" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Sequential numbering based on spatial position (Top-Left → Bottom-Right)." Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Mode Selection" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="chkPile" Content="Piles (Mark parameter)" IsChecked="True" Margin="0,0,25,0"/>
                                <CheckBox Name="chkPileCap" Content="Pilecaps (Comments parameter)" IsChecked="True"/>
                            </StackPanel>
                            <CheckBox Name="chkOnlyEmpty" Content="Only renumber empty elements (preserve existing)" IsChecked="False" Margin="0,10,0,0" FontStyle="Italic" Opacity="0.8"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <TextBlock Text="Prefix Configuration" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <DataGrid Name="dgPrefixes" AutoGenerateColumns="False" CanUserAddRows="False"
                                      BorderBrush="{DynamicResource BorderColor}" Background="Transparent"
                                      AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Tab 4: Report -->
                <Grid Name="TabReport" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Pile Report" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Coordinates, geometry and load status for all piles in the model." Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Report filters -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                            <ComboBox Name="CboReportLevel" Width="180" Height="26" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextColor}"/>
                            <ComboBox Name="CboReportSort" Width="120" Height="26" FontSize="11" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Mark"  IsSelected="True"/>
                                <ComboBoxItem Content="Level"/>
                                <ComboBoxItem Content="X"/>
                                <ComboBoxItem Content="Y"/>
                            </ComboBox>
                            <Button Content="▶ GENERATE" Name="BtnGenerateReport"
                                    Style="{StaticResource ActionButton}" Padding="16,7"
                                    FontSize="11" Margin="20,0,0,0"
                                    Click="GenerateReport_Click"/>
                            <TextBlock Name="TxtReportStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Name="GridReport" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              AlternatingRowBackground="#06000000"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderColor}"
                              GridLinesVisibility="Horizontal" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No."       Binding="{Binding no_str}"      Width="38"/>
                            <DataGridTextColumn Header="Mark"      Binding="{Binding mark_str}"    Width="70"/>
                            <DataGridTextColumn Header="Family"    Binding="{Binding family_str}"  Width="130"/>
                            <DataGridTextColumn Header="Type"      Binding="{Binding type_str}"    Width="120"/>
                            <DataGridTextColumn Header="Level"     Binding="{Binding level_str}"   Width="70"/>
                            <DataGridTextColumn Header="X (mm)"    Binding="{Binding x_str}"       Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Y (mm)"    Binding="{Binding y_str}"       Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Z Head"    Binding="{Binding z_head_str}"  Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Z Toe"     Binding="{Binding z_toe_str}"   Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Length (mm)" Binding="{Binding length_str}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ø (mm)"    Binding="{Binding diam_str}"    Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Incl."     Binding="{Binding incl_str}"    Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Load Status" Binding="{Binding load_str}"  Width="*"/>
                            <DataGridTextColumn Header="Comments"  Binding="{Binding comments_str}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Export bar -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 Export Excel" Name="BtnReportXlsx"
                                    Style="{StaticResource ActionButton}" Padding="16,9"
                                    FontSize="11" IsEnabled="False"
                                    Click="ReportXlsx_Click" Margin="0,0,10,0"/>
                            <Button Content="Export CSV" Name="BtnReportCsv"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="14,7" FontSize="11" IsEnabled="False"
                                    Click="ReportCsv_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tab 3: Visibility -->
                <Grid Name="TabVisibility" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Scope Visibility Manager" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Manage visibility across zones. Creates 'Show_in_X' Yes/No parameters automatically." Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <TextBlock Text="Select Scope Boxes (Zones)" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock Name="tbZoneInfo" DockPanel.Dock="Bottom" Text="Select scope boxes to define active zones." Style="{StaticResource HintText}" FontStyle="Italic" Margin="0,10,0,0"/>
                            <ListBox Name="lbScopeBoxes" SelectionMode="Multiple" BorderBrush="{DynamicResource BorderColor}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnScopeCheck" Unchecked="OnScopeCheck" Margin="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Tab 4: Schedule -->
                <Grid Name="TabSchedule" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Pile Schedule" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Create or open a Revit schedule view for structural foundations (piles)."
                                   Style="{StaticResource HintText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Create / Open NOSA Schedule" Name="BtnSchedCreate"
                                Style="{DynamicResource ActionButton}" Padding="16,10"
                                Click="ScheduleCreate_Click" Margin="0,0,10,0"/>
                        <Button Content="Refresh list" Name="BtnSchedRefresh"
                                Style="{StaticResource OutlineButton}"
                                Padding="14,8" Click="ScheduleRefresh_Click"/>
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Foundation schedules in project"
                                       Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <TextBlock Name="TxtSchedStatus" DockPanel.Dock="Bottom"
                                       Text="Click Refresh list to scan the project."
                                       Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <ListBox Name="LstSchedules" BorderThickness="0"
                                     Background="Transparent" MouseDoubleClick="ScheduleOpen_Click"/>
                        </DockPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0" Name="ActionBar">
                <DockPanel>
                    <Button Name="BtnAction" DockPanel.Dock="Right" Content="UPDATE COORDINATES" Style="{DynamicResource ActionButton}" Click="ActionButton_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="TxtActionStatus" FontSize="12" Foreground="{DynamicResource TextColor}" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
