<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Toolkit" Height="680" Width="1020"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SITE TOOLKIT" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Topography, property lines, and site reference points" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.55"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs — Name only; SelectedIndex/SelectionChanged are wired in
             code after LoadComponent, never as XAML attributes (Selector
             controls fire selection events mid-parse otherwise). -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <TabControl Name="TabsMain" Background="Transparent" BorderThickness="0">

                <TabItem Header="Topography">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Name="TxtTopoSummary" Text=""
                                   FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                            <DataGrid Name="GridTopo" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type"          Binding="{Binding Kind}"       Width="140"/>
                                    <DataGridTextColumn Header="Id"            Binding="{Binding ElemId}"     Width="80"/>
                                    <DataGridTextColumn Header="Name"          Binding="{Binding ElemName}"   Width="150"/>
                                    <DataGridTextColumn Header="Min elev. (mm)" Binding="{Binding ZMin}"      Width="120"/>
                                    <DataGridTextColumn Header="Max elev. (mm)" Binding="{Binding ZMax}"      Width="120"/>
                                    <DataGridTextColumn Header="Footprint (m², approx.)" Binding="{Binding Footprint}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Property Lines">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Name="TxtPropSummary" Text=""
                                   FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                            <DataGrid Name="GridProp" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id"                Binding="{Binding ElemId}"       Width="80"/>
                                    <DataGridTextColumn Header="Name"              Binding="{Binding ElemName}"     Width="180"/>
                                    <DataGridTextColumn Header="Segments"          Binding="{Binding Segments}"     Width="100"/>
                                    <DataGridTextColumn Header="Perimeter (mm)"    Binding="{Binding Perimeter}"    Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Site Reference">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Project Base Point and Survey Point, read directly from the model."
                                   FontSize="11" Foreground="{DynamicResource TextColor}" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="1">
                            <DataGrid Name="GridSite" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Point"          Binding="{Binding Label}"     Width="160"/>
                                    <DataGridTextColumn Header="East/West (mm)" Binding="{Binding EastWest}"  Width="140"/>
                                    <DataGridTextColumn Header="North/South (mm)" Binding="{Binding NorthSouth}" Width="150"/>
                                    <DataGridTextColumn Header="Elevation (mm)" Binding="{Binding Elevation}" Width="130"/>
                                    <DataGridTextColumn Header="Angle to true north (°)" Binding="{Binding Angle}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Shared loading overlay (NOSAWindow standard) -->
        <Grid Grid.Row="1" Name="LoadingPanel" Visibility="Collapsed"
              Background="#CCFAFAFA" Panel.ZIndex="100">
            <Border Style="{DynamicResource Card}" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                    <ProgressBar Name="ProcessBar" Width="220" Height="10" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Refresh" Name="BtnRefresh"
                        Click="Refresh_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="Export Active Tab to CSV" Name="BtnExport"
                        Click="Export_Click"/>
                <CheckBox Grid.Column="3" Name="ChkDarkMode" Content="Dark mode" Click="Theme_Toggled"
                          Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
