<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA — Survey Export" Height="720" Width="1160"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.6"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SURVEY EXPORT" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="BtnModeSurvey" Content="Survey Layout" Tag="Active"
                                Click="ModeSurvey_Click" Style="{StaticResource ModeButton}" Margin="0,0,8,0"/>
                        <Button Name="BtnModePile" Content="Pile Survey"
                                Click="ModePile_Click" Style="{StaticResource ModeButton}"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox Grid.Column="1" Name="ChkDarkMode" Content="Dark Mode"
                          Click="Theme_Toggled" VerticalAlignment="Top"
                          Foreground="{DynamicResource TextColor}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1">

            <!-- ══════════ SURVEY LAYOUT PANEL ══════════ -->
            <Grid Name="PanelSurvey">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="210" MaxWidth="340"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="520"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,20,20,10">

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="FILTERS" Style="{DynamicResource SHead}"/>

                                    <TextBlock Text="Category" Style="{DynamicResource SideLabel}"/>
                                    <ComboBox Name="SV_CboCategory" Height="28" FontSize="11"
                                              VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Text="Level" Style="{DynamicResource SideLabel}"/>
                                    <ComboBox Name="SV_CboLevel" Height="28" FontSize="11"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SORT BY" Style="{DynamicResource SHead}"/>
                                    <RadioButton Name="SV_RbMark"  Content="Mark"     GroupName="SV_Sort"
                                                 IsChecked="True" FontSize="11" Margin="0,0,0,4"/>
                                    <RadioButton Name="SV_RbLevel" Content="Level"    GroupName="SV_Sort"
                                                 FontSize="11" Margin="0,0,0,4"/>
                                    <RadioButton Name="SV_RbX"     Content="X →"      GroupName="SV_Sort"
                                                 FontSize="11" Margin="0,0,0,4"/>
                                    <RadioButton Name="SV_RbY"     Content="Y ↑"      GroupName="SV_Sort"
                                                 FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="PRECISION" Style="{DynamicResource SHead}"/>
                                    <TextBlock Text="Coordinate decimals (mm)"
                                               Style="{DynamicResource SideLabel}"/>
                                    <ComboBox Name="SV_CboDecimals" Height="28" FontSize="11"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1" IsSelected="True"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Button Name="SV_BtnGenerate" Content="▶ GENERATE"
                                    Style="{DynamicResource ActionBtn}"
                                    Click="SV_Generate_Click"/>

                            <ProgressBar Name="SV_ProgBar" Height="3" Margin="0,8,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}"
                                         BorderThickness="0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="20,0,20,20">
                        <Button Name="SV_BtnXlsx" Content="Export Excel"
                                Style="{DynamicResource ActionBtn}"
                                Click="SV_ExportXlsx_Click" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button Name="SV_BtnCsv" Content="Export CSV"
                                Style="{DynamicResource SecBtn}"
                                Click="SV_ExportCsv_Click" IsEnabled="False" Margin="0,0,0,10"/>
                        <Separator Margin="0,0,0,10"/>
                        <TextBlock Text="Survey vs Model" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,4"/>
                        <TextBox Name="SV_TxtTolerance" Height="26" FontSize="11" Padding="4,2"
                                 Text="10" ToolTip="Tolerance in mm — differences above this are flagged"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Tolerance (mm)" FontSize="9"
                                   Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,0,0,8"/>
                        <Button Name="SV_BtnCompareSurvey" Content="Compare Survey CSV..."
                                Style="{DynamicResource SecBtn}"
                                Click="SV_CompareSurvey_Click" IsEnabled="False"
                                ToolTip="Load a surveyed-coordinates CSV and compare to model positions"/>
                    </StackPanel>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <!-- MAIN -->
                <Grid Grid.Column="2" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="SV_GridSurvey"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" FontSize="11"
                                  SelectionChanged="SV_Grid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mark"     Binding="{Binding mark}"     Width="80"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding category}" Width="90"/>
                                <DataGridTextColumn Header="Level"    Binding="{Binding level}"    Width="80"/>
                                <DataGridTextColumn Header="Type"     Binding="{Binding etype}"     Width="*"/>
                                <DataGridTextColumn Header="Material" Binding="{Binding material}" Width="100"/>
                                <DataGridTextColumn Header="X (mm)"   Binding="{Binding x_mm}"   Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Y (mm)"   Binding="{Binding y_mm}"   Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Z (mm)"   Binding="{Binding z_mm}"   Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Rot. (°)" Binding="{Binding rot_deg}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Comments" Binding="{Binding comments}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="SV_TxtStatus" Grid.Column="0"
                                   Text="Select a category filter and press ▶ GENERATE."
                                   FontSize="11" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.6" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="SV_BtnSelect"
                                Content="Select in model"
                                Style="{DynamicResource SecBtn}"
                                Click="SV_Select_Click" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ══════════ PILE SURVEY PANEL ══════════ -->
            <Grid Name="PanelPile" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="200" MaxWidth="340"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="540"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,20,20,10">

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="FILTERS" Style="{DynamicResource SHead}"/>
                                    <TextBlock Text="Level" Style="{DynamicResource SideLabel}"/>
                                    <ComboBox Name="PS_CboLevel" Height="28" FontSize="11"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="DETECTION" Style="{DynamicResource SHead}"/>
                                    <RadioButton Name="PS_RbAuto"    Content="Auto (family name)"
                                                 GroupName="PS_Det" IsChecked="True"
                                                 FontSize="10" Margin="0,0,0,4"/>
                                    <RadioButton Name="PS_RbFlagged" Content="Only NOSA_IsPile=1"
                                                 GroupName="PS_Det"
                                                 FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SORT BY" Style="{DynamicResource SHead}"/>
                                    <RadioButton Name="PS_RbMark" Content="Mark"
                                                 GroupName="PS_Sort" IsChecked="True"
                                                 FontSize="11" Margin="0,0,0,4"/>
                                    <RadioButton Name="PS_RbX"    Content="X Head"
                                                 GroupName="PS_Sort" FontSize="11" Margin="0,0,0,4"/>
                                    <RadioButton Name="PS_RbY"    Content="Y Head"
                                                 GroupName="PS_Sort" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Decimals (mm)" Style="{DynamicResource SideLabel}"/>
                                    <ComboBox Name="PS_CboDecimals" Height="28" FontSize="11"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1" IsSelected="True"/>
                                        <ComboBoxItem Content="2"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Button Name="PS_BtnGenerate" Content="▶ EXPORT"
                                    Style="{DynamicResource ActionBtn}"
                                    Click="PS_Generate_Click"/>

                            <ProgressBar Name="PS_ProgBar" Height="3" Margin="0,8,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentColor}"
                                         BorderThickness="0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="20,0,20,20">
                        <Button Name="PS_BtnXlsx" Content="📥 Excel"
                                Style="{DynamicResource ActionBtn}"
                                Click="PS_ExportXlsx_Click" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button Name="PS_BtnCsv" Content="CSV (Leica/Trimble)"
                                Style="{DynamicResource SecBtn}"
                                Click="PS_ExportCsv_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <!-- MAIN -->
                <Grid Grid.Column="2" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                        <DataGrid Name="PS_GridPiles"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  AlternatingRowBackground="#06000000" Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" FontSize="11"
                                  SelectionChanged="PS_Grid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mark"    Binding="{Binding mark}"     Width="80"/>
                                <DataGridTextColumn Header="Type"     Binding="{Binding etype}"     Width="*"/>
                                <DataGridTextColumn Header="Level"    Binding="{Binding level}"    Width="80"/>
                                <DataGridTextColumn Header="X Head"   Binding="{Binding x_head}"   Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Y Head"   Binding="{Binding y_head}"   Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Z Head"   Binding="{Binding z_head}"   Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Z Toe"  Binding="{Binding z_toe}"    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Long. (mm)" Binding="{Binding length_mm}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ø (mm)"   Binding="{Binding diam_mm}"  Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Incl.(°)" Binding="{Binding incl_deg}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Azimuth(°)" Binding="{Binding azim_deg}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="PS_TxtStatus" Grid.Column="0"
                                   Text="Click ▶ EXPORT to detect and list piles."
                                   FontSize="11" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.6" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="PS_BtnSelect"
                                Content="Select in model"
                                Style="{DynamicResource SecBtn}"
                                Click="PS_Select_Click" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
