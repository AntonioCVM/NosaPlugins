<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilecap Load Checker v2.1" Height="800" Width="1080"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>
        <Style TargetType="TextBox" x:Key="RuleBox">
            <Setter Property="Height"                   Value="24"/>
            <Setter Property="Padding"                  Value="4,2"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,25,20,12">
                <TextBlock Text="PILECAP CHECKER" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Geometry &amp; Load Rules" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Filters" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Exclude phase:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,3"/>
                            <ComboBox Name="CmbPhase" DisplayMemberPath="Name"
                                      Margin="0,0,0,10" Height="26" FontSize="11"/>

                            <TextBlock Text="Include element types:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <CheckBox Name="ChkIncludeCaps"  Content="Isolated pilecaps"  IsChecked="True"/>
                            <CheckBox Name="ChkIncludeStrip" Content="Strip foundations"  IsChecked="False"/>
                            <CheckBox Name="ChkIncludeWalls" Content="Retaining walls"    IsChecked="False"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Rules (BS 8004 / EC7)" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Min pile spacing (×diameter):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtSpacing"   Style="{DynamicResource RuleBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="Min edge distance (×diameter):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtEdge"      Style="{DynamicResource RuleBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="Min cap depth (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtDepth"     Style="{DynamicResource RuleBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="Max aspect ratio:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtAspect"    Style="{DynamicResource RuleBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="Min cutoff embedment (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtEmbedment" Style="{DynamicResource RuleBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Single-pile bearing capacity (kN):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtBearingCap" Style="{DynamicResource RuleBox}" Margin="0,0,0,10"
                                     ToolTip="Used to calculate utilisation ratio = N / (capacity × pile count)"/>

                            <Button Content="Save as default" Click="SaveRules_Click"
                                    Style="{DynamicResource SecondaryButton}"
                                    HorizontalAlignment="Left" FontSize="11" Padding="10,5"/>
                        </StackPanel>
                    </Border>

                    <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                              Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="RUN CHECK" Name="BtnRun"
                    Click="Run_Click" Style="{DynamicResource ActionButton}" Margin="20,0,20,8"/>
            <Button Grid.Row="3" Content="Export CSV" Name="BtnExport"
                    Click="Export_Click" Style="{DynamicResource SecondaryButton}"
                    Margin="20,0,20,20" IsEnabled="False"/>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══ MAIN ═══ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary pills -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border CornerRadius="12" Background="#DDFFDD" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Name="TxtOK" Text="0 OK" FontSize="11"
                               Foreground="#226622" FontWeight="Bold"/>
                </Border>
                <Border CornerRadius="12" Background="#FFEEEE" Padding="10,4">
                    <TextBlock Name="TxtFail" Text="0 FAIL" FontSize="11"
                               Foreground="#CC3333" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- Results grid -->
            <Grid Grid.Row="1">
                <Border Style="{StaticResource Card}" Padding="1">
                    <DataGrid Name="GridResults"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#06000000" Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"    Width="55"/>
                            <DataGridTextColumn Header="Type"       Binding="{Binding Etype}"     Width="60"/>
                            <DataGridTextColumn Header="Name"       Binding="{Binding Name}"      Width="160"/>
                            <DataGridTextColumn Header="Piles"      Binding="{Binding PileCount}" Width="45"/>
                            <DataGridTextColumn Header="N (kN)"     Binding="{Binding N_kN}"      Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mx (kN·m)"  Binding="{Binding Mx_kNm}"    Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="My (kN·m)"  Binding="{Binding My_kNm}"    Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Util."      Binding="{Binding Util}"       Width="55"/>
                            <DataGridTextColumn Header="Load"       Binding="{Binding Semaphore}"  Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="OK">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="WARNING">
                                                <Setter Property="Foreground" Value="#FF9800"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="FAIL">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Geometry issues" Binding="{Binding IssueText}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                        <Setter Property="Background" Value="#10CC0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>

                <!-- Loading overlay -->
                <Grid Name="LoadingPanel" Visibility="Collapsed"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Checking pilecaps..." HorizontalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="12"
                                     IsIndeterminate="True" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" Text="" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextColor}"
                                   Opacity="0.6" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Edit pilecap parameters panel (shown when a row is selected) -->
            <Border Grid.Row="2" Name="EditPanel" Visibility="Collapsed"
                    Background="#FFF8F4" BorderBrush="{DynamicResource AccentColor}"
                    BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Padding="14,12"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Edit Selected Pilecap Parameters" FontSize="12"
                               FontWeight="Bold" Foreground="{DynamicResource AccentColor}"
                               Margin="0,0,0,8"/>
                    <DataGrid Name="GridEditParams" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              AlternatingRowBackground="#06000000" Background="White"
                              BorderBrush="{DynamicResource BorderColor}"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParamName}"
                                                Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Value"     Binding="{Binding Value}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Unit"      Binding="{Binding Unit}"
                                                Width="60"  IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Apply to Pilecap" Name="BtnApplyParams"
                            Click="ApplyParams_Click"
                            Style="{DynamicResource ActionButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Bottom action bar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Select in Model" Name="BtnSelect" Click="Select_Click"
                        Style="{DynamicResource SecondaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
