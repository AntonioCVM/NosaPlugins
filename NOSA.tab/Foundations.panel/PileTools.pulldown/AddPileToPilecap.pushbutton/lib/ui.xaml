<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Piling v1.0" Height="720" Width="1000"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="Padding"   Value="6,2"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="ADD PILING" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Place piles under a foundation slab" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,10">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Arrangement pattern" FontSize="11" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <ComboBox Name="CboPattern" SelectionChanged="Preview_Changed" Margin="0,0,0,12"/>

                            <TextBlock Text="Spacing (mm)" FontSize="11" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <TextBox Name="TxtSpacing" Style="{DynamicResource FieldBox}"
                                     LostFocus="Preview_Changed" Margin="0,0,0,10"/>

                            <TextBlock Text="Embedment (mm)" FontSize="11" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <TextBox Name="TxtEmbedment" Style="{DynamicResource FieldBox}"
                                     LostFocus="Preview_Changed" Margin="0,0,0,10"/>

                            <TextBlock Text="Edge clearance (mm)" FontSize="11" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <TextBox Name="TxtClearance" Style="{DynamicResource FieldBox}"
                                     LostFocus="Preview_Changed"
                                     ToolTip="Minimum distance from a pile centre to the slab edge. Drives the automatic pile count on non-rectangular caps, and the 'Suggest optimal distribution' button on rectangular ones."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Pile type" FontSize="11" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                            <ComboBox Name="CboPileType" Margin="0,0,0,12"/>

                            <Button Name="BtnSelectSlab" Content="SELECT FOUNDATION SLAB"
                                    Style="{DynamicResource SecondaryButton}"
                                    Click="SelectSlab_Click" Margin="0,0,0,8"/>

                            <TextBlock Name="TxtSlabInfo" Text="No slab selected"
                                       FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pile distribution (editable)" FontSize="11" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"
                                       TextWrapping="Wrap"
                                       ToolTip="Requested grid — any pile that would fall outside the slab or inside its edge clearance is automatically skipped (see the piles-created count in the preview)."/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Piles U" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
                                    <TextBox Name="TxtPilesU" Style="{DynamicResource FieldBox}"
                                             IsEnabled="False" LostFocus="Preview_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Piles V" FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.7"/>
                                    <TextBox Name="TxtPilesV" Style="{DynamicResource FieldBox}"
                                             IsEnabled="False" LostFocus="Preview_Changed"/>
                                </StackPanel>
                            </Grid>
                            <Button Name="BtnSuggestDistribution" Content="Suggest optimal distribution"
                                    Style="{DynamicResource SecondaryButton}"
                                    Click="SuggestDistribution_Click" IsEnabled="False" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnCreate" Content="CREATE PILES &amp; GROUP"
                            Style="{DynamicResource ActionButton}"
                            Click="Create_Click" IsEnabled="False" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="260"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Preview" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1" Margin="0,0,0,16">
                <Grid>
                    <Canvas Name="PileCanvas" Width="360" Height="220"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"/>
                    <TextBlock Name="TxtPreviewInfo" Text="Select a foundation slab to preview piles."
                               FontSize="10" Foreground="{DynamicResource TextColor}" Opacity="0.6" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,6"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="Log" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="1">
                <TextBox Name="TxtLog" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Padding="10"/>
            </Border>

            <Grid Grid.Row="3" Name="LoadingPanel" Visibility="Collapsed" Background="#CCFAFAFA">
                <Border Background="White" CornerRadius="6" Padding="24,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Creating piles..." HorizontalAlignment="Center" FontSize="13"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}" Margin="0,12,0,0"/>
                        <TextBlock Name="TxtStatus" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
