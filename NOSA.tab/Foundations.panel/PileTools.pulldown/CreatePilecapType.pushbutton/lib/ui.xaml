<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Pile Cap" Height="800" Width="1040"
        MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ModeButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height"    Value="26"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Padding"   Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="260" MaxWidth="420"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- ══════ SIDEBAR ══════ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + mode toggle -->
            <StackPanel Grid.Row="0" Margin="20,22,20,12">
                <TextBlock Text="CREATE PILE CAP" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtDims" Text="— configure below —" FontSize="10"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6"
                           Margin="0,4,0,10" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="BtnModeReg" Grid.Column="0" Content="Regular"
                            Tag="Active" Click="ModeRegular_Click"
                            Style="{DynamicResource ModeButton}"/>
                    <Button Name="BtnModeIrr" Grid.Column="2" Content="Irregular"
                            Click="ModeIrregular_Click"
                            Style="{DynamicResource ModeButton}"/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,10">

                    <!-- ══ REGULAR / IRREGULAR ══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- ══ REGULAR ══ -->
                            <StackPanel Name="PanelRegular">
                                <TextBlock Text="Arrangement" FontWeight="Bold" FontSize="11"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                <TextBlock Text="Piles across (H):" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                <TextBox Name="TxtNH" Text="2" Style="{DynamicResource FieldBox}"
                                         TextChanged="Params_Changed" Margin="0,0,0,8"/>
                                <TextBlock Text="Piles along (V):" FontSize="11"
                                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                <TextBox Name="TxtNV" Text="2" Style="{DynamicResource FieldBox}"
                                         TextChanged="Params_Changed"/>
                            </StackPanel>

                            <!-- ══ IRREGULAR ══ -->
                            <StackPanel Name="PanelIrregular" Visibility="Collapsed">
                                <TextBlock Text="Shape" FontWeight="Bold" FontSize="11"
                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,6"/>
                                <ComboBox Name="CboShape" Height="26" FontSize="11"
                                          SelectionChanged="Shape_Changed" Margin="0,0,0,6"/>
                                <TextBlock Name="TxtShapeDesc" Text="" FontSize="10"
                                           Foreground="{DynamicResource TextColor}" Opacity="0.65"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Param A (always visible) -->
                                <StackPanel Name="RowParamA" Margin="0,0,0,6">
                                    <TextBlock Name="TxtParamALabel" Text="Param A:" FontSize="11"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox Name="TxtParamA" Text="3"
                                             Style="{DynamicResource FieldBox}"
                                             TextChanged="Params_Changed"/>
                                </StackPanel>

                                <!-- Param B (always visible) -->
                                <StackPanel Name="RowParamB" Margin="0,0,0,6">
                                    <TextBlock Name="TxtParamBLabel" Text="Param B:" FontSize="11"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox Name="TxtParamB" Text="3"
                                             Style="{DynamicResource FieldBox}"
                                             TextChanged="Params_Changed"/>
                                </StackPanel>

                                <!-- Separator between length and width params -->
                                <Separator Margin="0,4,0,8"
                                           Visibility="{Binding Visibility,
                                                        ElementName=RowParamC}"/>

                                <!-- Param C — arm widths -->
                                <StackPanel Name="RowParamC" Margin="0,0,0,6">
                                    <TextBlock Name="TxtParamCLabel" Text="Param C:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}"
                                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox Name="TxtParamC" Text="1"
                                             Style="{DynamicResource FieldBox}"
                                             TextChanged="Params_Changed"/>
                                </StackPanel>

                                <!-- Param D — second arm width -->
                                <StackPanel Name="RowParamD">
                                    <TextBlock Name="TxtParamDLabel" Text="Param D:" FontSize="11"
                                               Foreground="{DynamicResource TextColor}"
                                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox Name="TxtParamD" Text="1"
                                             Style="{DynamicResource FieldBox}"
                                             TextChanged="Params_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══ SHARED DIMENSIONS ══ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Dimensions" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

                            <TextBlock Text="Pile spacing (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtSpacing" Text="900" Style="{DynamicResource FieldBox}"
                                     TextChanged="Params_Changed" Margin="0,0,0,8"/>

                            <TextBlock Text="Edge clearance (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <TextBox Name="TxtClearance" Text="150" Style="{DynamicResource FieldBox}"
                                     TextChanged="Params_Changed" Margin="0,0,0,8"/>

                            <TextBlock Text="Cutoff below cap top (mm):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}"
                                       TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBox Name="TxtCutoff" Text="75" Style="{DynamicResource FieldBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ ELEMENT TYPES ══ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Element Types" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

                            <TextBlock Text="Pile type:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <ComboBox Name="CboPileType" Height="26" FontSize="10"
                                      DisplayMemberPath="Name" Margin="0,0,0,8"/>

                            <TextBlock Text="Cap slab type (Floor):" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <ComboBox Name="CboCapType" Height="26" FontSize="10"
                                      DisplayMemberPath="Name" Margin="0,0,0,8"/>

                            <TextBlock Text="Level:" FontSize="11"
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                            <ComboBox Name="CboLevel" Height="26" FontSize="10"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Border>

                    <CheckBox Name="ChkDarkMode" Content="Dark Mode"
                              Click="Theme_Toggled" Margin="0,10,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <!-- PLACE button -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,10"/>
                <Button Content="PLACE PILE CAP" Name="BtnPlace"
                        Click="Place_Click" Style="{DynamicResource ActionButton}"
                        FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ══════ MAIN: canvas + info ══════ -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                <Viewbox Stretch="Uniform">
                    <Canvas Name="PileCanvas" Width="400" Height="280"
                            Background="#F5F5F5"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Name="TxtInfoPiles" Text="Piles: 4"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Name="TxtInfoCap" Text="Cap: 1200 × 1200 mm"
                           FontSize="11" Foreground="{DynamicResource TextColor}"
                           Opacity="0.8"/>
                <TextBlock Text="Click PLACE PILE CAP, then pick a point in the model for the cap centre."
                           FontSize="10" Foreground="{DynamicResource TextColor}"
                           Opacity="0.55" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Loading overlay -->
            <Grid Name="LoadingPanel" Grid.RowSpan="2" Visibility="Collapsed"
                  Background="#CCFAFAFA">
                <Border Background="White" CornerRadius="6" Padding="24,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Creating pile cap..."
                                   HorizontalAlignment="Center"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <ProgressBar Name="ProcessBar" Width="200" Height="10"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Name="TxtStatus" Text=""
                                   HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
