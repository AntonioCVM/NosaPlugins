<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Survey Layout Table v1.0" Height="700" Width="1140"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}" FontFamily="Century Gothic, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270"
                           ShadowDepth="2" BlurRadius="14" Opacity="0.08"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.6"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="210" MaxWidth="340"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,25,20,12">
                <TextBlock Text="SURVEY LAYOUT" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                <TextBlock Text="Element coordinates" FontSize="11"
                           Foreground="{DynamicResource TextColor}" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,0,20,10">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FILTERS" Style="{DynamicResource SHead}"/>

                            <TextBlock Text="Category" Style="{DynamicResource SideLabel}"/>
                            <ComboBox Name="CboCategory" Height="28" FontSize="11"
                                      VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Text="Level" Style="{DynamicResource SideLabel}"/>
                            <ComboBox Name="CboLevel" Height="28" FontSize="11"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SORT BY" Style="{DynamicResource SHead}"/>
                            <RadioButton Name="RbMark"  Content="Mark"     GroupName="Sort"
                                         IsChecked="True" FontSize="11" Margin="0,0,0,4"/>
                            <RadioButton Name="RbLevel" Content="Level"    GroupName="Sort"
                                         FontSize="11" Margin="0,0,0,4"/>
                            <RadioButton Name="RbX"     Content="X →"      GroupName="Sort"
                                         FontSize="11" Margin="0,0,0,4"/>
                            <RadioButton Name="RbY"     Content="Y ↑"      GroupName="Sort"
                                         FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PRECISION" Style="{DynamicResource SHead}"/>
                            <TextBlock Text="Coordinate decimals (mm)"
                                       Style="{DynamicResource SideLabel}"/>
                            <ComboBox Name="CboDecimals" Height="28" FontSize="11"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1" IsSelected="True"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnGenerate" Content="▶ GENERATE"
                            Style="{DynamicResource ActionBtn}"
                            Click="Generate_Click"/>

                    <ProgressBar Name="ProgBar" Height="3" Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"
                                 BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Button Name="BtnXlsx" Content="Export Excel"
                        Style="{DynamicResource ActionBtn}"
                        Click="ExportXlsx_Click" IsEnabled="False" Margin="0,0,0,8"/>
                <Button Name="BtnCsv" Content="Export CSV"
                        Style="{DynamicResource SecBtn}"
                        Click="ExportCsv_Click" IsEnabled="False" Margin="0,0,0,10"/>
                <Separator Margin="0,0,0,10"/>
                <TextBlock Text="Survey vs Model" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}" Opacity="0.65" Margin="0,0,0,4"/>
                <TextBox Name="TxtTolerance" Height="26" FontSize="11" Padding="4,2"
                         Text="10" ToolTip="Tolerance in mm — differences above this are flagged"
                         BorderBrush="{DynamicResource BorderColor}"
                         Margin="0,0,0,4"/>
                <TextBlock Text="Tolerance (mm)" FontSize="9"
                           Foreground="{DynamicResource TextColor}" Opacity="0.5" Margin="0,0,0,8"/>
                <Button Name="BtnCompareSurvey" Content="Compare Survey CSV..."
                        Style="{DynamicResource SecBtn}"
                        Click="CompareSurvey_Click" IsEnabled="False"
                        ToolTip="Load a surveyed-coordinates CSV and compare to model positions"
                        Margin="0,0,0,10"/>
                <Separator Margin="0,0,0,10"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"
                          Foreground="{DynamicResource TextColor}"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- MAIN -->
        <Grid Grid.Column="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                <DataGrid Name="GridSurvey"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          AlternatingRowBackground="#06000000" Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal" FontSize="11"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mark"     Binding="{Binding mark}"     Width="80"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding category}" Width="90"/>
                        <DataGridTextColumn Header="Level"    Binding="{Binding level}"    Width="80"/>
                        <DataGridTextColumn Header="Type"     Binding="{Binding etype}"     Width="*"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding material}" Width="100"/>
                        <DataGridTextColumn Header="X (mm)"   Binding="{Binding x_mm}"   Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Y (mm)"   Binding="{Binding y_mm}"   Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Z (mm)"   Binding="{Binding z_mm}"   Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Rot. (°)" Binding="{Binding rot_deg}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Comments" Binding="{Binding comments}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="TxtStatus" Grid.Column="0"
                           Text="Select a category filter and press ▶ GENERATE."
                           FontSize="11" Foreground="{DynamicResource TextColor}"
                           Opacity="0.6" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="BtnSelect"
                        Content="Select in model"
                        Style="{DynamicResource SecBtn}"
                        Click="Select_Click" IsEnabled="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
