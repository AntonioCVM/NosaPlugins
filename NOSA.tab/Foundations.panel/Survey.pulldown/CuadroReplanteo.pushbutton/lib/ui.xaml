<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Survey Layout Table v1.0" Height="660" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Century Gothic, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity"    Value="0.6"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Margin"     Value="0,14,0,8"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,20,16,0">
                <TextBlock Text="SURVEY LAYOUT" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                <TextBlock Text="Element coordinates" FontSize="10"
                           Opacity="0.5" Margin="0,2,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">

                    <TextBlock Text="FILTERS" Style="{DynamicResource SHead}"/>

                    <TextBlock Text="Category" Style="{DynamicResource SideLabel}"/>
                    <ComboBox Name="CboCategory" Height="28" FontSize="11"
                              VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Level" Style="{DynamicResource SideLabel}"/>
                    <ComboBox Name="CboLevel" Height="28" FontSize="11"
                              VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="SORT BY" Style="{DynamicResource SHead}"/>
                    <RadioButton Name="RbMark"  Content="Mark"     GroupName="Sort"
                                 IsChecked="True" FontSize="11" Margin="0,0,0,4"/>
                    <RadioButton Name="RbLevel" Content="Level"    GroupName="Sort"
                                 FontSize="11" Margin="0,0,0,4"/>
                    <RadioButton Name="RbX"     Content="X →"      GroupName="Sort"
                                 FontSize="11" Margin="0,0,0,4"/>
                    <RadioButton Name="RbY"     Content="Y ↑"      GroupName="Sort"
                                 FontSize="11" Margin="0,0,0,4"/>

                    <TextBlock Text="PRECISION" Style="{DynamicResource SHead}"/>
                    <TextBlock Text="Coordinate decimals (mm)"
                               Style="{DynamicResource SideLabel}"/>
                    <ComboBox Name="CboDecimals" Height="28" FontSize="11"
                              VerticalContentAlignment="Center" Margin="0,0,0,14">
                        <ComboBoxItem Content="0"/>
                        <ComboBoxItem Content="1" IsSelected="True"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                    </ComboBox>

                    <Button Name="BtnGenerate" Content="▶ GENERATE"
                            Style="{DynamicResource ActionBtn}"
                            Click="Generate_Click"/>

                    <ProgressBar Name="ProgBar" Height="3" Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentColor}"
                                 BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="16,0,16,16">
                <Button Name="BtnXlsx" Content="Export Excel"
                        Style="{DynamicResource ActionBtn}"
                        Click="ExportXlsx_Click" IsEnabled="False" Margin="0,0,0,6"/>
                <Button Name="BtnCsv" Content="Export CSV"
                        Style="{DynamicResource SecBtn}"
                        Click="ExportCsv_Click" IsEnabled="False" Margin="0,0,0,6"/>
                <Separator Margin="0,4,0,8"/>
                <TextBlock Text="Survey vs Model" FontSize="10" FontWeight="SemiBold"
                           Opacity="0.65" Margin="0,0,0,4"/>
                <TextBox Name="TxtTolerance" Height="26" FontSize="11" Padding="4,2"
                         Text="10" ToolTip="Tolerance in mm — differences above this are flagged"
                         Margin="0,0,0,6"/>
                <TextBlock Text="Tolerance (mm)" FontSize="9" Opacity="0.5" Margin="0,-4,0,6"/>
                <Button Name="BtnCompareSurvey" Content="Compare Survey CSV..."
                        Style="{DynamicResource SecBtn}"
                        Click="CompareSurvey_Click" IsEnabled="False"
                        ToolTip="Load a surveyed-coordinates CSV and compare to model positions"/>
                <Separator Margin="0,10,0,8"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- MAIN -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Name="GridSurvey" Grid.Row="0" Margin="12,12,12,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      AlternatingRowBackground="#06000000" Background="Transparent"
                      BorderBrush="{DynamicResource BorderColor}"
                      GridLinesVisibility="Horizontal" FontSize="11"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mark"     Binding="{Binding mark}"     Width="80"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding category}" Width="90"/>
                    <DataGridTextColumn Header="Level"    Binding="{Binding level}"    Width="80"/>
                    <DataGridTextColumn Header="Type"     Binding="{Binding etype}"     Width="*"/>
                    <DataGridTextColumn Header="Material" Binding="{Binding material}" Width="100"/>
                    <DataGridTextColumn Header="X (mm)"   Binding="{Binding x_mm}"   Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Y (mm)"   Binding="{Binding y_mm}"   Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Z (mm)"   Binding="{Binding z_mm}"   Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Rot. (°)" Binding="{Binding rot_deg}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Comments" Binding="{Binding comments}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1" Margin="12,8,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="TxtStatus" Grid.Column="0"
                           Text="Select a category filter and press ▶ GENERATE."
                           FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="BtnSelect"
                        Content="Select in model"
                        Style="{DynamicResource SecBtn}"
                        Click="Select_Click" IsEnabled="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

