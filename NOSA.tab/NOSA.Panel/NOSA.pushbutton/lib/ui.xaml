<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOSA Dashboard" Height="620" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        FontFamily="Century Gothic"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="BgColor"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PanelColor"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor"   Color="#333333"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF5F00"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="20,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="bd" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Background" Value="#18FF5F00"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter TargetName="bd" Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand area -->
            <Border Grid.Row="0" Background="{DynamicResource AccentColor}" Padding="20,24,20,20">
                <StackPanel>
                    <TextBlock Name="TxtBrandName" Text="N O S A" FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Structural Engineers" FontSize="10" Foreground="White"
                               Opacity="0.85" Margin="0,2,0,0"/>
                    <TextBlock Name="TxtVersion" Text="v3.0" FontSize="11"
                               Foreground="White" Opacity="0.7" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Nav buttons -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Button Name="BtnOverview"    Content="Overview"    Tag="Active"
                        Style="{DynamicResource NavButton}" Click="Nav_Click"/>
                <Button Name="BtnEnvironment" Content="Environment"
                        Style="{DynamicResource NavButton}" Click="Nav_Click"/>
                <Button Name="BtnHealth"      Content="Health"
                        Style="{DynamicResource NavButton}" Click="Nav_Click"/>
                <Button Name="BtnPlugins"     Content="Plugins"
                        Style="{DynamicResource NavButton}" Click="Nav_Click"/>
                <Button Name="BtnAbout"       Content="About"
                        Style="{DynamicResource NavButton}" Click="Nav_Click"/>
            </StackPanel>

            <!-- Bottom controls -->
            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                <Separator Margin="0,0,0,12"/>
                <CheckBox Name="ChkDarkMode" Content="Dark Mode" Click="Theme_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,28">

                <!-- ── OVERVIEW ── -->
                <StackPanel Name="PanelOverview" Visibility="Visible">
                    <TextBlock Text="Overview" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4"/>
                    <TextBlock Name="TxtBundleDate" Text="" FontSize="11"
                               Foreground="{DynamicResource TextColor}" Opacity="0.55" Margin="0,0,0,20"/>

                    <!-- Stat cards -->
                    <WrapPanel Margin="0,0,0,24">
                        <Border Background="{DynamicResource AccentColor}" CornerRadius="6"
                                Padding="20,14" Margin="0,0,12,12" MinWidth="130">
                            <StackPanel>
                                <TextBlock Name="TxtPluginCount" Text="—" FontSize="28"
                                           FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Plugins" FontSize="11" Foreground="White" Opacity="0.85"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelColor}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                Padding="20,14" Margin="0,0,12,12" MinWidth="130">
                            <StackPanel>
                                <TextBlock Name="TxtPanelCount" Text="—" FontSize="28"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                                <TextBlock Text="Panels" FontSize="11" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelColor}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                Padding="20,14" Margin="0,0,12,12" MinWidth="130">
                            <StackPanel>
                                <TextBlock Name="TxtModuleCount" Text="—" FontSize="28"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                                <TextBlock Text="Shared modules" FontSize="11" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Panel breakdown -->
                    <TextBlock Text="Panels" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,10"/>
                    <ItemsControl Name="ListPanels">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextColor}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CountStr}"
                                                   Foreground="{DynamicResource AccentColor}"
                                                   FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── ENVIRONMENT ── -->
                <StackPanel Name="PanelEnvironment" Visibility="Collapsed">
                    <TextBlock Text="Environment" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,20"/>
                    <ItemsControl Name="ListEnv">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   Opacity="0.6" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── HEALTH ── -->
                <StackPanel Name="PanelHealth" Visibility="Collapsed">
                    <TextBlock Text="Health checks" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,20"/>
                    <ItemsControl Name="ListHealth">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                   Foreground="{Binding IconColor}"
                                                   FontSize="14" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="11" Opacity="0.55"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── PLUGINS ── -->
                <StackPanel Name="PanelPlugins" Visibility="Collapsed">
                    <TextBlock Text="Plugins" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,20"/>
                    <ItemsControl Name="ListAllPlugins">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Panel}"
                                                   Foreground="{DynamicResource AccentColor}"
                                                   FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── ABOUT ── -->
                <StackPanel Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Text="About NOSA" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,20"/>

                    <!-- Company card -->
                    <Border Background="{DynamicResource PanelColor}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="24,20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="NOSA Structural Engineers" FontSize="16"
                                       FontWeight="Bold" Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Address" Opacity="0.55"
                                           Foreground="{DynamicResource TextColor}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="9th Floor ICC, Suite 9.1, 2A Main Street, Gibraltar"
                                           Foreground="{DynamicResource TextColor}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phone" Opacity="0.55"
                                           Foreground="{DynamicResource TextColor}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="+350 58008085"
                                           Foreground="{DynamicResource TextColor}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Web" Opacity="0.55"
                                           Foreground="{DynamicResource TextColor}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="www.nosa.gi"
                                           Foreground="{DynamicResource AccentColor}" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Email" Opacity="0.55"
                                           Foreground="{DynamicResource TextColor}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="info@nosa.gi"
                                           Foreground="{DynamicResource AccentColor}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Brand palette -->
                    <TextBlock Text="Brand palette" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border Width="80" Height="50" CornerRadius="4" Margin="0,0,10,10"
                                Background="#FF5F00">
                            <TextBlock Text="#FF5F00" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,6"/>
                        </Border>
                        <Border Width="80" Height="50" CornerRadius="4" Margin="0,0,10,10"
                                Background="#FFC09B">
                            <TextBlock Text="#FFC09B" Foreground="#333333" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,6"/>
                        </Border>
                        <Border Width="80" Height="50" CornerRadius="4" Margin="0,0,10,10"
                                Background="#414042">
                            <TextBlock Text="#414042" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,6"/>
                        </Border>
                        <Border Width="80" Height="50" CornerRadius="4" Margin="0,0,10,10"
                                Background="#C0C0C0">
                            <TextBlock Text="#C0C0C0" Foreground="#333333" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,6"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
